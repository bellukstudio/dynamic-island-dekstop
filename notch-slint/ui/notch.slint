                    root.save-greeting(true, "random", "cewek", "Halo, semangat menjalani hari!");
                } }
                Chip { label: "Pratinjau"; clicked => { root.test-greeting(greeting-mode-input.text, greeting-custom-input.text, greeting-voice-input.text); } }
            }
            HorizontalLayout {
                Chip { label: "Simpan pengaturan greeting"; selected: true; clicked => { root.save-greeting(greeting-enabled-input.text == "true", greeting-mode-input.text, greeting-voice-input.text, greeting-custom-input.text); } }
            }
            Text { text: root.greeting-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Conversation Moments"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            cm-enabled-input := TextInput { text: root.conversation-enabled ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Aktifkan komentar kontekstual"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: cm-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: cm-enabled-input.text == "true"; clicked => { cm-enabled-input.text = cm-enabled-input.text == "true" ? "false" : "true"; } }
            }
            cm-play-input := TextInput { text: root.conversation-on-play ? "true" : "false"; visible: false; }
            cm-track-input := TextInput { text: root.conversation-on-track-change ? "true" : "false"; visible: false; }
            cm-pause-input := TextInput { text: root.conversation-on-pause ? "true" : "false"; visible: false; }
            cm-return-input := TextInput { text: root.conversation-on-return ? "true" : "false"; visible: false; }
            cm-weather-input := TextInput { text: root.conversation-on-weather-change ? "true" : "false"; visible: false; }
            cm-rain-input := TextInput { text: root.conversation-on-rain-soon ? "true" : "false"; visible: false; }
            cm-battery-input := TextInput { text: root.conversation-on-low-battery ? "true" : "false"; visible: false; }
            cm-charging-input := TextInput { text: root.conversation-on-charging ? "true" : "false"; visible: false; }
            VerticalLayout {
                spacing: 3px;
                PageToggle { label: "Saat musik mulai diputar"; checked: cm-play-input.text == "true"; toggled(v) => { cm-play-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat lagu berganti"; checked: cm-track-input.text == "true"; toggled(v) => { cm-track-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat musik dijeda atau selesai"; checked: cm-pause-input.text == "true"; toggled(v) => { cm-pause-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat kembali setelah lama tidak aktif"; checked: cm-return-input.text == "true"; toggled(v) => { cm-return-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat kondisi cuaca berubah"; checked: cm-weather-input.text == "true"; toggled(v) => { cm-weather-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat hujan segera diperkirakan"; checked: cm-rain-input.text == "true"; toggled(v) => { cm-rain-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat baterai turun ke 15%"; checked: cm-battery-input.text == "true"; toggled(v) => { cm-battery-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat laptop mulai mengisi daya"; checked: cm-charging-input.text == "true"; toggled(v) => { cm-charging-input.text = v ? "true" : "false"; } }
            }
            Text { text: "Anggap kembali setelah (5–120 menit)"; color: Theme.text-faint; font-size: 9px; }
            cm-return-min-input := TextInput { text: root.conversation-return-after-min; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda antar komentar (1–60 menit)"; color: Theme.text-faint; font-size: 9px; }
            cm-cooldown-input := TextInput { text: root.conversation-cooldown-min; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Coba momen"; clicked => { root.test-conversation("Asyik, kita ketemu momen baru! ✨", "Uji Conversation Moments"); } }
                Chip { label: "Coba momen cuaca"; clicked => { root.test-conversation("Cuaca berubah, jangan lupa sesuaikan aktivitasmu ☀️", "Uji momen cuaca"); } }
            }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    cm-enabled-input.text = "true";
                    cm-play-input.text = "true";
                    cm-track-input.text = "true";
                    cm-pause-input.text = "false";
                    cm-return-input.text = "true";
                    cm-weather-input.text = "true";
                    cm-rain-input.text = "true";
                    cm-battery-input.text = "true";
                    cm-charging-input.text = "false";
                    cm-return-min-input.text = "10";
                    cm-cooldown-input.text = "3";
                    root.save-conversation(true, true, true, false, true, true, true, true, false, "10", "3");
                } }
                Chip { label: "Simpan Conversation Moments"; clicked => {
                    root.save-conversation(cm-enabled-input.text == "true", cm-play-input.text == "true", cm-track-input.text == "true", cm-pause-input.text == "true", cm-return-input.text == "true", cm-weather-input.text == "true", cm-rain-input.text == "true", cm-battery-input.text == "true", cm-charging-input.text == "true", cm-return-min-input.text, cm-cooldown-input.text);
                } }
            }
            Text { text: root.conversation-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Focus Companion"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            fc-enabled-input := TextInput { text: root.focus-companion-enabled ? "true" : "false"; visible: false; }
            fc-start-input := TextInput { text: root.focus-companion-on-start ? "true" : "false"; visible: false; }
            fc-halfway-input := TextInput { text: root.focus-companion-on-halfway ? "true" : "false"; visible: false; }
            fc-complete-input := TextInput { text: root.focus-companion-on-focus-complete ? "true" : "false"; visible: false; }
            fc-break-input := TextInput { text: root.focus-companion-on-break-end ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Aktifkan teman fokus Pomodoro"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: fc-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: fc-enabled-input.text == "true"; clicked => { fc-enabled-input.text = fc-enabled-input.text == "true" ? "false" : "true"; } }
            }
            VerticalLayout {
                spacing: 3px;
                PageToggle { label: "Saat sesi fokus dimulai"; checked: fc-start-input.text == "true"; toggled(v) => { fc-start-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat mencapai setengah sesi"; checked: fc-halfway-input.text == "true"; toggled(v) => { fc-halfway-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat sesi fokus selesai"; checked: fc-complete-input.text == "true"; toggled(v) => { fc-complete-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat waktu istirahat selesai"; checked: fc-break-input.text == "true"; toggled(v) => { fc-break-input.text = v ? "true" : "false"; } }
            }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    fc-enabled-input.text = "true";
                    fc-start-input.text = "true";
                    fc-halfway-input.text = "true";
                    fc-complete-input.text = "true";
                    fc-break-input.text = "true";
                    root.save-focus-companion(true, true, true, true, true);
                } }
                Chip { label: "Coba Focus Companion"; clicked => { root.test-focus-companion("Yuk, fokus satu hal dulu. Kamu pasti bisa! 🎯", "Uji Focus Companion"); } }
                Chip { label: "Simpan Focus Companion"; clicked => {
                    root.save-focus-companion(fc-enabled-input.text == "true", fc-start-input.text == "true", fc-halfway-input.text == "true", fc-complete-input.text == "true", fc-break-input.text == "true");
                } }
            }
            Text { text: root.focus-companion-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Jadwal shalat"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Provinsi"; color: Theme.text-faint; font-size: 9px; }
            prayer-province-input := TextInput { text: root.prayer-province; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Kabupaten / Kota"; color: Theme.text-faint; font-size: 9px; }
            prayer-city-input := TextInput { text: root.prayer-city; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Mode notifikasi waktu shalat"; color: Theme.text-faint; font-size: 9px; }
            prayer-mode-input := TextInput { text: root.prayer-mode; visible: false; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Nada"; selected: prayer-mode-input.text == "tone"; clicked => { prayer-mode-input.text = "tone"; } }
                Chip { label: "Adzan"; selected: prayer-mode-input.text == "adzan"; clicked => { prayer-mode-input.text = "adzan"; } }
                Chip { label: "Senyap"; selected: prayer-mode-input.text == "silent"; clicked => { prayer-mode-input.text = "silent"; } }
            }
            Text { text: "Pengingat sebelum adzan"; color: Theme.text-faint; font-size: 9px; }
            prayer-remind-input := TextInput { text: root.prayer-remind-before; visible: false; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Aktif"; selected: prayer-remind-input.text == "true"; clicked => { prayer-remind-input.text = "true"; } }
                Chip { label: "Nonaktif"; selected: prayer-remind-input.text != "true"; clicked => { prayer-remind-input.text = "false"; } }
            }
            Text { text: "Menit sebelum waktu shalat (1–120)"; color: Theme.text-faint; font-size: 9px; }
            prayer-min-input := TextInput { text: root.prayer-remind-min; color: Theme.text; font-size: 11px; single-line: true; }
        }
    }
    Text { text: "Pomodoro"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Durasi fokus / istirahat / istirahat panjang (menit)"; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            pomo-focus-input := TextInput { text: root.pomodoro-focus; color: Theme.text; font-size: 11px; single-line: true; }
            pomo-break-input := TextInput { text: root.pomodoro-break; color: Theme.text; font-size: 11px; single-line: true; }
            pomo-long-input := TextInput { text: root.pomodoro-long-break; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jumlah ronde sebelum istirahat panjang"; color: Theme.text-faint; font-size: 9px; }
            pomo-rounds-input := TextInput { text: root.pomodoro-rounds; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 5px;
                Chip {
                    label: "Reset default";
                    clicked => {
                        prayer-province-input.text = "Jawa Barat";
                        prayer-city-input.text = "Kota Bandung";
                        prayer-mode-input.text = "tone";
                        prayer-remind-input.text = "false";
                        prayer-min-input.text = "10";
                        pomo-focus-input.text = "25";
                        pomo-break-input.text = "5";
                        pomo-long-input.text = "15";
                        pomo-rounds-input.text = "4";
                        root.save-routines("tone", "false", "10", "25", "5", "15", "4", "Jawa Barat", "Kota Bandung");
                    }
                }
                Chip { label: "Simpan jadwal & Pomodoro"; clicked => { root.save-routines(prayer-mode-input.text, prayer-remind-input.text, prayer-min-input.text, pomo-focus-input.text, pomo-break-input.text, pomo-long-input.text, pomo-rounds-input.text, prayer-province-input.text, prayer-city-input.text); } }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 5px;
        Chip {
            label: "Reset default";
            clicked => {
                hub-input.text = "Ctrl+Alt+N";
                settings-input.text = "Ctrl+Alt+,";
                pomo-input.text = "Ctrl+Alt+P";
                prayer-input.text = "Ctrl+Alt+A";
                root.save-shortcuts("Ctrl+Alt+N", "Ctrl+Alt+,", "Ctrl+Alt+P", "Ctrl+Alt+A");
            }
        }
        Chip {
            label: "Simpan";
            clicked => {
                root.save-shortcuts(hub-input.text, settings-input.text, pomo-input.text, prayer-input.text);
            }
        }
    }
    Text {
        text: root.save-status;
        color: Theme.text-faint;
        font-size: 10px;
        wrap: word-wrap;
    }
    Text {
        text: "Shortcut langsung aktif setelah disimpan. Pastikan setiap kombinasi tidak bentrok dengan aplikasi lain.";
        color: Theme.text-faint;
        font-size: 9px;
        wrap: word-wrap;
    }
}

component CompressPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> status: "Pilih gambar atau dokumen Office untuk dikompres";
    callback run(string);
    callback pick-file();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    Text { text: "Compress"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Kompresi batch gambar, PDF & Office · target pengurangan 30%"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: "Daftar file JPG/JPEG/PNG/BMP/PDF/DOCX/XLSX/PPTX (bisa beberapa file)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput {
                text: root.file-path;
                color: Theme.text;
                font-size: 11px;
                single-line: false;
            }
            Text { text: "Hasil disimpan sebagai nama_compressed.<format> (Office tetap memakai ekstensi aslinya) di folder yang sama."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Kompres"; clicked => { root.run(path-input.text); } }
    }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
}
component ConvertPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> target-format: "auto";
    in property <string> overrides-text: "";
    in property <string> status: "Pilih gambar, PDF, atau dokumen Office untuk dikonversi";
    in property <string> progress-text: "";
    in property <string> history-text: "Belum ada riwayat konversi";
    in property <string> files-text: "Belum ada file dipilih";
    in property <string> output-dir-text: "";
    in property <string> eta-text: "";
    in property <string> queue-text: "Antrean kosong";
    in property <string> preview-page-text: "Halaman 1 / 1";
    in property <string> preview-status: "";
    in property <string> preview-zoom-text: "110 DPI";
    in property <float> progress-value: 0;
    in property <image> source-preview;
    in property <image> result-preview;
    callback run(string, string, string, string, string);
    callback pick-output-dir();
    callback preview-prev();
    callback preview-next();
    callback preview-zoom-in();
    callback preview-zoom-out();
    callback pick-file();
    callback reveal();
    callback cancel();
    callback pause();
    callback resume();
    callback clear-queue();
    callback remove-queue-file(string);
    callback retry-failed();
    callback retry-one-failed(string);
    callback cancel-one-file(string);
    callback add-files();
    callback move-queue-file(string, int);
    callback remove-finished();
    callback export-history();
    callback clear-history();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 7px;
    Text { text: "Convert"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Konversi gambar, PDF, dan dokumen Office"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Text { text: "Tip: seret file langsung dari Windows Explorer ke jendela ini, atau gunakan Pilih file."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 5px;
            Text { text: "File sumber (bisa pilih beberapa file sekaligus)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput { text: root.file-path; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Format tujuan global: auto (disarankan) atau PNG/JPG/WebP/BMP/GIF/PDF."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            format-input := TextInput { text: root.target-format; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Override per file: nama-file=png@80; dokumen.pdf=jpg@70 (kualitas 40–100)"; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            overrides-input := TextInput { text: root.overrides-text; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Kualitas JPEG/PDF (40–100)"; color: Theme.text-faint; font-size: 10px; }
            quality-input := TextInput { text: "90"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Resolusi halaman PDF (DPI, 36–400)"; color: Theme.text-faint; font-size: 10px; }
            dpi-input := TextInput { text: "150"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Folder output (kosong = di samping file sumber)"; color: Theme.text-faint; font-size: 10px; }
            HorizontalLayout {
                Text { text: root.output-dir-text == "" ? "Folder sumber (default)" : root.output-dir-text; color: Theme.text; font-size: 10px; wrap: word-wrap; }
                Chip { label: "Pilih folder"; clicked => { root.pick-output-dir(); } }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Tambah file"; clicked => { root.add-files(); } }
        Chip { label: "Konversi"; clicked => { root.run(path-input.text, format-input.text, quality-input.text, dpi-input.text, overrides-input.text); } }
        Chip { label: "Jeda"; clicked => { root.pause(); } }
        Chip { label: "Lanjut"; clicked => { root.resume(); } }
        Chip { label: "Hapus antrean"; clicked => { root.clear-queue(); } }
        queue-remove-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Hapus file"; clicked => { root.remove-queue-file(queue-remove-input.text); } }
        Chip { label: "Naik"; clicked => { root.move-queue-file(queue-remove-input.text, -1); } }
        Chip { label: "Turun"; clicked => { root.move-queue-file(queue-remove-input.text, 1); } }
        Chip { label: "Bersihkan selesai"; clicked => { root.remove-finished(); } }
        Chip { label: "Coba ulang gagal"; clicked => { root.retry-failed(); } }
        retry-failed-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Retry file"; clicked => { root.retry-one-failed(retry-failed-input.text); } }
        cancel-file-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Cancel file"; clicked => { root.cancel-one-file(cancel-file-input.text); } }
        Chip { label: "Batalkan"; clicked => { root.cancel(); } }
        Chip { label: "Buka folder hasil"; clicked => { root.reveal(); } }
    }
    Rectangle {
        height: 7px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.progress-value, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
            animate width { duration: 180ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        Text { text: root.eta-text; color: Theme.text-faint; font-size: 9px; horizontal-stretch: 1; }
        Text { text: root.progress-text; color: Theme.accent; font-size: 10px; }
    }
    Text { text: root.queue-text; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text { text: "Preview"; color: Theme.text; font-size: 11px; font-weight: 700; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Sumber"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.source-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Hasil"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.result-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Chip { label: "‹"; clicked => { root.preview-prev(); } }
                Text { text: root.preview-page-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "›"; clicked => { root.preview-next(); } }
                Chip { label: "−"; clicked => { root.preview-zoom-out(); } }
                Text { text: root.preview-zoom-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "+"; clicked => { root.preview-zoom-in(); } }
            }
            Text { text: root.preview-status; color: #ffb36b; font-size: 9px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text { text: "Daftar file"; color: Theme.text; font-size: 11px; font-weight: 700; }
            Text { text: root.files-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            HorizontalLayout {
                Text { text: "Riwayat konversi"; color: Theme.text; font-size: 11px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Chip { label: "Ekspor CSV"; clicked => { root.export-history(); } }
                Chip { label: "Bersihkan"; clicked => { root.clear-history(); } }
            }
            Text { text: root.history-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
}
component TransferPage inherits VerticalLayout {
    in property <string> status: "Server belum aktif";
    in property <string> address: "";
    in property <string> shared-count-text: "0";
    callback start-server();
    callback stop();
    callback add-files();
    callback open-inbox();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    Text { text: "File Transfer"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Berbagi file melalui jaringan lokal"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: root.status; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: root.address; color: Theme.accent; font-size: 10px; wrap: word-wrap; }
            Text { text: "File dibagikan: " + root.shared-count-text; color: Theme.text-faint; font-size: 10px; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Mulai server"; clicked => { root.start-server(); } }
        Chip { label: "Hentikan"; clicked => { root.stop(); } }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Tambah file"; clicked => { root.add-files(); } }
        Chip { label: "Folder masuk"; clicked => { root.open-inbox(); } }
    }
    Text { text: "Perangkat lain yang satu jaringan dapat membuka alamat di atas untuk mengunduh atau mengirim file."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
}
component AndroidPage inherits VerticalLayout {
    in property <string> status: "Periksa perangkat Android";
    in property <string> devices: "";
    in property <string> entries: "";
    in property <string> current-path: "/sdcard/Download";
    in property <string> selected-serial: "";
    callback refresh();
    callback list(string);
    callback push(string, string);
    callback pull(string);
    callback select-device(string);
    callback mirror();
    callback stop-mirror();
    alignment: start;
    padding-left: 12px;
    padding-right: 12px;
    spacing: 6px;
    Text { text: "Android"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "ADB · USB / Wireless debugging"; color: Theme.accent; font-size: 10px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            Text { text: root.status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Perangkat terdeteksi"; color: Theme.text; font-size: 10px; }
            devices-input := TextInput { text: root.devices; color: Theme.text; font-size: 9px; single-line: false; }
            serial-input := TextInput { text: root.selected-serial; color: Theme.text; font-size: 10px; single-line: true; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Deteksi"; clicked => { root.refresh(); } }
        Chip { label: "Pilih"; clicked => { root.select-device(serial-input.text); } }
    }
    Rectangle {
        background: #ffffff0b;
        border-radius: 9px;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            Text { text: "Jalur HP"; color: Theme.text-faint; font-size: 9px; }
            path-input := TextInput { text: root.current-path; color: Theme.text; font-size: 10px; single-line: true; }
            Chip { label: "Baca folder"; clicked => { root.list(path-input.text); } }
            Text { text: root.entries; color: Theme.text; font-size: 9px; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Kirim file ke HP"; clicked => { root.push(serial-input.text, path-input.text); } }
        Chip { label: "Ambil file dari HP"; clicked => { root.pull(path-input.text); } }
        Chip { label: "Mirroring"; clicked => { root.mirror(); } }
        Chip { label: "Stop mirror"; clicked => { root.stop-mirror(); } }
    }
}
// Indikator privasi ala Tauri (privacy.css): lencana bulat, hijau = kamera, oranye = mikrofon,
// ikon gelap di dalam dan cincin berdenyut. Mode `dot` hanya titik kecil (dipakai saat hub terbuka).
component PrivacyBadge inherits Rectangle {
    in property <color> tone;
    in property <string> icon;
    in property <length> size: 16px;
    in property <bool> dot: false;
    in property <float> pulse: 0.0;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tone;
    Rectangle {
        x: -(2px + 2.5px * root.pulse);
        y: -(2px + 2.5px * root.pulse);
        width: root.size + 2 * (2px + 2.5px * root.pulse);
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: root.tone.with-alpha(0.34 - 0.24 * root.pulse);
    }
    if !root.dot: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.64;
        height: root.size * 0.64;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: #000000c7;
        stroke-width: root.size * 0.11;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component PrivacyIndicator inherits Rectangle {
    in property <bool> mic: false;
    in property <bool> cam: false;
    in property <length> size: 16px;
    in property <bool> dot: false;
    property <length> gap: root.dot ? 3px : 5px;
    property <int> count: (root.mic ? 1 : 0) + (root.cam ? 1 : 0);
    // Hanya dievaluasi saat indikator tampil, jadi tidak membuat render terus-menerus saat tidak ada aktivitas.
    property <float> pulse: 0.5 - 0.5 * Math.cos(Math.mod(animation-tick() / 1ms, 2000.0) / 2000.0 * 360deg);
    width: root.count * root.size + (root.count > 1 ? root.gap : 0px);
    height: root.size;
    if root.cam: PrivacyBadge {
        x: 0px;
        tone: #30d158;
        icon: Icons.badge-cam;
        size: root.size;
        dot: root.dot;
        pulse: root.pulse;
    }
    if root.mic: PrivacyBadge {
        x: root.cam ? root.size + root.gap : 0px;
        tone: #ff9f0a;
        icon: Icons.badge-mic;
        size: root.size;
        dot: root.dot;
        pulse: root.pulse;
    }
}

// Kartu sensor (mikrofon / kamera) pada Privacy Hub.
component PrivacySensor inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> state-on: "Sedang digunakan";
    in property <string> state-off: "Tidak aktif";
    in property <bool> on: false;
    in property <color> tone: #e5a84b;
    border-radius: 14px;
    background: root.on ? root.tone.with-alpha(0.14) : #ffffff0b;
    border-width: 1px;
    border-color: root.on ? root.tone.with-alpha(0.5) : #ffffff14;
    animate background { duration: 220ms; }
    animate border-color { duration: 220ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            width: 34px;
            alignment: center;
            Rectangle {
            height: 34px;
            border-radius: 11px;
            background: root.on ? root.tone.with-alpha(0.26) : Theme.chip;
            animate background { duration: 220ms; }
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.on ? root.tone : Theme.text-dim;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.label; color: Theme.text; font-size: 12px; font-weight: 700; overflow: elide; }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                VerticalLayout {
                    width: 6px;
                    alignment: center;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: root.on ? root.tone : Theme.text-faint;
                    }
                }
                Text {
                    text: root.on ? root.state-on : root.state-off;
                    color: root.on ? root.tone : Theme.text-faint;
                    font-size: 9.5px;
                    font-weight: root.on ? 700 : 500;
                    overflow: elide;
                }
            }
        }
    }
}

// Privacy Hub: perisai berdenyut + status, kartu mikrofon/kamera, dan durasi sesi.
// Hanya memakai `active` / `source` / `elapsed` dari monitor di privacy.rs (tanpa perubahan Rust).
// Area halaman 580 x 148 px, jadi tata letaknya horizontal.
component PrivacyPage inherits Rectangle {
    in property <bool> active: false;
    in property <string> source: "";
    in property <string> elapsed: "00:00";
    property <bool> mic-on: root.active && (root.source == "MIC" || root.source == "MIC + CAM");
    property <bool> cam-on: root.active && (root.source == "CAM" || root.source == "MIC + CAM");
    property <color> tone: root.active ? #e5a84b : Theme.ok;
    // Hanya berjalan saat aktif, jadi tidak membuat render terus-menerus ketika aman.
    property <float> phase: Math.mod(animation-tick() / 1ms, 1800.0) / 1800.0;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 4px;
        padding-bottom: 10px;
        spacing: 12px;

        // Kiri: perisai
        Rectangle {
            width: 146px;
            border-radius: 18px;
            background: @linear-gradient(150deg, root.tone.with-alpha(0.26), root.tone.with-alpha(0.05));
            border-width: 1px;
            border-color: root.tone.with-alpha(0.38);
            clip: true;
            animate background { duration: 300ms; }

            if root.active: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px + (68px - self.height) / 2;
                width: 46px + 58px * root.phase;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: root.tone.with-alpha(0.55 * (1.0 - root.phase));
            }
            if root.active: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px + (68px - self.height) / 2;
                width: 46px + 58px * Math.mod(root.phase + 0.5, 1.0);
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: root.tone.with-alpha(0.4 * (1.0 - Math.mod(root.phase + 0.5, 1.0)));
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px;
                width: 68px;
                height: 68px;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 23px;
                    background: root.tone.with-alpha(0.22);
                }
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.privacy;
                    fill: root.tone.with-alpha(0.18);
                    stroke: root.tone;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + 1px;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.active ? "M 12 8 V 13 M 12 16.2 L 12.01 16.2" : "M 8.5 12 L 11 14.5 L 15.5 9.5";
                    fill: transparent;
                    stroke: root.tone;
                    stroke-width: 2.2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
            VerticalLayout {
                y: 80px;
                height: parent.height - 80px;
                alignment: start;
                spacing: 1px;
                Text { text: root.active ? "AKTIF" : "AMAN"; color: root.tone; font-size: 14px; font-weight: 800; horizontal-alignment: center; letter-spacing: 1.5px; }
                Text { text: root.active ? "Sensor sedang dipakai" : "Tidak ada sensor aktif"; color: Theme.text-dim; font-size: 9px; horizontal-alignment: center; }
            }
        }

        // Kanan: judul, sensor, durasi
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                Text { text: "Privacy Hub"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    width: badge-text.preferred-width + 20px;
                    Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: root.tone.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.tone.with-alpha(0.4);
                    badge-text := Text {
                        text: root.active ? (root.source == "" ? "RAPAT" : root.source) : "TERLINDUNGI";
                        color: root.tone;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                PrivacySensor {
                    horizontal-stretch: 1;
                    icon: Icons.mic;
                    label: "Mikrofon";
                    on: root.mic-on;
                    tone: #e5a84b;
                }
                PrivacySensor {
                    horizontal-stretch: 1;
                    icon: Icons.camera;
                    label: "Kamera";
                    on: root.cam-on;
                    tone: #ef6b73;
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 12px;
                background: #ffffff0b;
                if root.active: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text { text: "DURASI SESI"; color: Theme.text-faint; font-size: 9px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.elapsed; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                }
                if !root.active: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: "Mendeteksi sesi audio aktif dan sensor kamera Windows. Status diperbarui otomatis.";
                        color: Theme.text-faint;
                        font-size: 9px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
component PrayerSeg inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked;
    preferred-width: seg-text.preferred-width + 14px;
    min-width: seg-text.preferred-width + 14px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.text.with-alpha(0.2) : transparent;
    seg-text := Text {
        text: root.label;
        color: root.on || ta.has-hover ? Theme.text : Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PrayerPage inherits VerticalLayout {
    in property <[PrayerItem]> items;
    in property <[PrayerItem]> imsakiyah;
    in property <string> next-name: "Memuat jadwal...";
    in property <string> next-time: "--:--";
    in property <string> next-when: "";
    in property <string> countdown: "--:--:--";
    in property <string> meta: "Imsak --:-- \u{00B7} Terbit --:--";
    in property <string> city: "";
    in property <string> status: "";
    in property <bool> ramadan: false;
    in property <string> ramadan-date: "";
    in property <string> imsak-countdown: "--:--:--";
    in property <string> buka-countdown: "--:--:--";
    in property <string> imsak-time: "";
    in property <string> buka-time: "";
    in property <string> mode: "tone";
    in property <bool> remind-before: true;
    in property <string> remind-min: "10";
    in property <string> dhikr-arabic: "";
    in property <string> dhikr-latin: "";
    in property <string> dhikr-meaning: "";
    in property <int> dhikr-idx: 0;
    callback refresh();
    callback set-mode(string);
    callback set-remind(bool);
    callback set-remind-min(int);
    callback toggle-ramadan();
    callback dhikr-next();
    callback dhikr-prev();
    // `.p-prayer`: padding 2 26 12 24, jarak 18; kiri 176 px (hitung mundur + kota), kanan (busur + kontrol).
    // Tombol Ramadan memperluas hub (780 x 540) dan menampilkan panel sahur/buka, imsakiyah, dzikir.
    padding-left: 24px;
    padding-right: 26px;
    padding-top: 2px;
    padding-bottom: 12px;
    spacing: 10px;

    HorizontalLayout {
        spacing: 14px;
        vertical-stretch: root.ramadan ? 0 : 1;
        min-height: 104px;
        VerticalLayout {
            width: 160px;
            alignment: space-between;
            padding-top: 2px;
            VerticalLayout {
                spacing: 2px;
                Text { text: root.next-name; color: Theme.accent; font-size: 14px; font-weight: 700; overflow: elide; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.countdown; color: Theme.text; font-size: 27px; font-weight: 700; vertical-alignment: bottom; }
                    VerticalLayout {
                        alignment: end;
                        Text { text: root.next-time; color: Theme.text; font-size: 13px; font-weight: 700; }
                        Text { text: root.next-when; color: Theme.text-faint; font-size: 10.5px; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    Text { text: root.city; color: Theme.text; font-size: 12.5px; font-weight: 700; overflow: elide; }
                    Text { text: root.status != "" ? root.status : "Dari config"; color: root.status != "" ? #ff8282 : Theme.text-faint; font-size: 10.5px; overflow: elide; }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: 0px;
                    border-radius: 8px;
                    background: rf-ta.has-hover ? Theme.chip-hover : Theme.chip;
                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 13px;
                        height: 13px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.reset;
                        fill: transparent;
                        stroke: Theme.text;
                        stroke-width: 1.5px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                    rf-ta := TouchArea { clicked => { root.refresh(); } }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: space-between;
            Text { text: root.meta; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 70px;
                    // Busur titik-titik (dasar `.pr-path`), titik 5 waktu shalat, dan label di bawahnya.
                    for k in 29: Rectangle {
                        x: k / 28 * 300px - 1px;
                        y: 31px - 22px * Math.sin(k / 28 * 180deg) - 1px;
                        width: 2px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.text.with-alpha(0.35);
                    }
                    for item[i] in root.items: Rectangle {
                        x: (i + 0.5) / 5 * 300px - self.width / 2;
                        y: 31px - 22px * Math.sin((i + 0.5) / 5 * 180deg) - self.height / 2;
                        width: item.state == 1 ? 14px : 8px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: item.state == 1 ? Theme.accent.with-alpha(0.25) : (item.state == 2 ? Theme.text.with-alpha(0.25) : Theme.text.with-alpha(0.55));
                        border-width: item.state == 1 ? 1.5px : 0px;
                        border-color: Theme.accent;
                        if item.state == 1: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                    }
                    for item[i] in root.items: VerticalLayout {
                        x: i * 60px;
                        y: 36px;
                        width: 60px;
                        height: 32px;
                        alignment: start;
                        opacity: item.state == 2 ? 0.35 : (item.state == 1 ? 1.0 : 0.65);
                        Text { text: item.name; color: item.state == 1 ? Theme.accent : Theme.text; font-size: 10.5px; horizontal-alignment: center; }
                        Text { text: item.time; color: Theme.text; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 28px;
                Rectangle {
                    preferred-width: segs.preferred-width + 4px;
                    min-width: segs.min-width + 4px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.chip;
                    segs := HorizontalLayout {
                        padding: 2px;
                        PrayerSeg { label: "Adzan"; on: root.mode == "adzan"; clicked => { root.set-mode("adzan"); } }
                        PrayerSeg { label: "Nada"; on: root.mode == "tone"; clicked => { root.set-mode("tone"); } }
                        PrayerSeg { label: "Senyap"; on: root.mode == "silent"; clicked => { root.set-mode("silent"); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.remind-min + " mnt sebelum";
                        color: Theme.text-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                        TouchArea { clicked => { root.set-remind-min(5); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 15px;
                            border-radius: 8px;
                            background: root.remind-before ? Theme.accent : Theme.chip;
                            Rectangle {
                                x: root.remind-before ? parent.width - self.width - 2px : 2px;
                                y: 2px;
                                width: 11px;
                                height: 11px;
                                border-radius: 6px;
                                background: root.remind-before ? #000000 : Theme.text-dim;
                                animate x { duration: 120ms; }
                            }
                            TouchArea { clicked => { root.set-remind(!root.remind-before); } }
                        }
                    }
                }
                Rectangle {
                    preferred-width: rm-row.preferred-width;
                    min-width: rm-row.min-width;
                    max-width: rm-row.preferred-width;
                    horizontal-stretch: 0;
                    height: 28px;
                    border-radius: 14px;
                    background: root.ramadan ? Theme.accent.with-alpha(0.3) : (rm-ta.has-hover ? Theme.chip-hover : Theme.chip);
                    rm-row := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        padding-left: 10px;
                        padding-right: 10px;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 13px;
                                height: 13px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z";
                                fill: root.ramadan ? Theme.accent : transparent;
                                stroke: root.ramadan ? Theme.accent : Theme.text;
                                stroke-width: 1.8px;
                                stroke-line-join: round;
                            }
                        }
                        Text { text: "Ramadan"; color: root.ramadan ? Theme.accent : Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    }
                    rm-ta := TouchArea { clicked => { root.toggle-ramadan(); } }
                }
            }
        }
    }

    if root.ramadan: VerticalLayout {
        vertical-stretch: 1;
        spacing: 10px;
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Path {
                width: 20px;
                height: 20px;
                y: 10px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z";
                fill: Theme.accent;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Mode Ramadan"; color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { text: "Hitung mundur sahur dan buka puasa, imsakiyah, serta dzikir setelah adzan."; color: Theme.text-faint; font-size: 11px; overflow: elide; }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 17px;
                        border-radius: 9px;
                        background: Theme.accent;
                        Rectangle { x: parent.width - self.width - 2px; y: 2px; width: 13px; height: 13px; border-radius: 7px; background: #000000; }
                        TouchArea { clicked => { root.toggle-ramadan(); } }
                    }
                }
                Text { text: "Aktif"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            height: 74px;
            spacing: 12px;
            for c[i] in [0, 1]: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                border-radius: 14px;
                border-width: 1px;
                border-color: #50dcaa59;
                background: @linear-gradient(120deg, #14785a47 0%, #14785a0f 100%);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        width: 28px;
                        alignment: center;
                        Path {
                            width: 26px;
                            height: 26px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: i == 0 ? "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z" : "M 3 18 H 21 M 6.5 18 A 5.5 5.5 0 0 1 17.5 18 M 12 5 V 8 M 4.5 10.5 L 6.5 12.5 M 19.5 10.5 L 17.5 12.5";
                            fill: transparent;
                            stroke: #7dffc8;
                            stroke-width: 1.6px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text { text: i == 0 ? "Menuju Imsak (Sahur)" : "Menuju Maghrib (Buka Puasa)"; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                        Text { text: i == 0 ? root.imsak-countdown : root.buka-countdown; color: Theme.text; font-size: 22px; font-weight: 700; }
                        Text { text: i == 0 ? "Imsak " + root.imsak-time : "Maghrib " + root.buka-time; color: Theme.text-faint; font-size: 10.5px; }
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            Rectangle {
                horizontal-stretch: 1.1;
                preferred-width: 0px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.text.with-alpha(0.10);
                background: Theme.text.with-alpha(0.035);
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Imsakiyah Hari Ini"; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: root.ramadan-date; color: Theme.text-faint; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                    }
                    GridLayout {
                        spacing: 6px;
                        for item[i] in root.imsakiyah: Rectangle {
                            row: Math.floor(i / 4);
                            col: Math.mod(i, 4);
                            height: 40px;
                            border-radius: 10px;
                            background: i == 0 ? Theme.accent.with-alpha(0.22) : Theme.chip;
                            VerticalLayout {
                                alignment: center;
                                Text { text: item.name; color: i == 0 ? Theme.accent : Theme.text-dim; font-size: 10.5px; horizontal-alignment: center; }
                                Text { text: item.time; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    Text { text: "Jadwal mengikuti lokasi dan data salat yang sudah tersimpan di Notch. Countdown sahur berakhir pada waktu imsak."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.text.with-alpha(0.10);
                background: Theme.text.with-alpha(0.035);
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Dzikir Setelah Adzan"; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: "\u{2039}"; color: Theme.text-dim; font-size: 16px; TouchArea { clicked => { root.dhikr-prev(); } } }
                        Text { text: (root.dhikr-idx + 1) + "/3"; color: Theme.text-faint; font-size: 11px; vertical-alignment: center; }
                        Text { text: "\u{203A}"; color: Theme.text-dim; font-size: 16px; TouchArea { clicked => { root.dhikr-next(); } } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 12px;
                        background: Theme.chip;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 5px;
                            alignment: center;
                            Text { text: root.dhikr-arabic; color: Theme.text; font-size: 22px; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: root.dhikr-latin; color: Theme.accent; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: root.dhikr-meaning; color: Theme.text-faint; font-size: 10.5px; horizontal-alignment: center; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for d[i] in 3: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: i == root.dhikr-idx ? Theme.accent : Theme.text.with-alpha(0.25); }
                    }
                }
            }
        }
    }
}
component PlaceholderPage inherits VerticalLayout {
    in property <string> name;
    alignment: center;
    spacing: 4px;
    Text { text: root.name; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
    Text { text: "Belum tersedia di versi Slint"; color: Theme.text-faint; font-size: 12px; horizontal-alignment: center; }
}

// Halaman uji render: teks Arab (teks asli) dan emoji (gambar). Muncul jika "uji" ada di `pages`.
component RenderTestPage inherits VerticalLayout {
    in property <image> coffee;
    in property <image> tomato;
    in property <image> moon;
    alignment: center;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image { source: root.coffee; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.tomato; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.moon; width: 28px; height: 28px; image-fit: contain; }
    }
    Text {
        text: "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ";
        color: Theme.ok;
        font-size: 22px;
        horizontal-alignment: center;
    }
}

export component NotchWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Notch";

    in property <bool> expanded: false;
    in property <bool> adhan-active: false;
    in property <string> adhan-prayer: "";
    in property <int> adhan-phase: 0;
    in property <bool> meeting-active: false;
    in property <string> meeting-elapsed: "00:00";
    in property <string> meeting-source: "";
    in property <string> meeting-finished: "";
    // 0 = atas, 1 = melayang, 2 = bawah, 3 = kiri, 4 = kanan.
    in property <int> dock: 0;
    in property <bool> play-interaction-active: false;
    in property <bool> dragging: false;
    in property <bool> suppress-next-pill-click: false;
    in property <bool> dock-play-enabled: true;
    in property <bool> play-test-request: false;
    // Skala bentuk (config `scale`): radius hub 32 px dan telinga 10 px dikalikan nilai ini, seperti di Tauri.
    in property <float> ui-scale: 1.0;
    // Gambar hiasan tema (cahaya, scan, rim) yang dirender Rust dengan mask sudut akurat.
    in property <image> decor;
    in property <bool> has-decor: false;
    in-out property <string> page-id: "media";
    in property <[string]> tabs;

    in property <string> media-title: "Tidak ada media";
    in property <string> media-artist: "Putar musik untuk memulai";
    in property <string> media-pos-text: "0:00";
    in property <string> media-dur-text: "0:00";
    in property <float> media-position: 0;
    in property <float> media-length: 0;
    in property <float> media-progress: 0;
    in property <bool> media-active: false;
    in property <bool> media-playing: false;
    in property <image> media-art;
    in property <bool> media-has-art: false;
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> sec-text: "00";
    in property <string> date-short: "";
    // Wajah idle berupa jam + tanggal (menggantikan mata) saat hub terakhir ditutup di halaman Jam.
    in property <bool> idle-clock: false;
    // Notch menciut saat musik diputar: pil lebar (dock atas/melayang) atau kubah berisi cover bulat (bawah/samping).
    // Dock atas/melayang: nudge dan pengingat tampil di dalam badan notch (tanpa awan percakapan).
    // Dock bawah/samping memakai SpeechBubble.
    property <bool> nudge-inline: root.dock < 2 && !root.expanded && !root.dragging && !root.greeting-inline-visible
        && !root.meeting-active && !root.adhan-active && (root.nudge-visible || root.reminder-alert-visible);
    property <bool> inline-msg: root.greeting-inline-visible || root.nudge-inline;
    property <bool> priv-mic: root.meeting-active && (root.meeting-source == "MIC" || root.meeting-source == "MIC + CAM");
    property <bool> priv-cam: root.meeting-active && (root.meeting-source == "CAM" || root.meeting-source == "MIC + CAM");
    property <bool> media-mini: root.media-playing && !root.expanded && !root.dragging && !root.inline-msg;
    in property <string> day-text: "";
    in property <StatsView> stats;
    in property <CurrencyView> currency;
    in-out property <string> currency-amount;
    in-out property <bool> notes-expanded: false;
    in property <[StockRow]> stock-gainers;
    in property <[StockRow]> stock-losers;
    in property <[CurrencyAlertItem]> currency-alerts;
    in property <[CurrencyItem]> currency-items;
    in property <[FxChartPoint]> fx-chart-points;
    in property <string> pomo-text: "25:00";
    in property <string> pomo-label: "";
    in property <float> pomo-progress: 0;
    in property <bool> pomo-running: false;
    in property <bool> pomo-rest: false;
    // Gambar mata (8 mood x 20 skin) dirender Rust: 130 x 34 horizontal atau 34 x 130 untuk dock samping.
    in property <image> eyes-image;
    in property <string> eyes-mood: "normal";
    in property <float> eyes-offset-x: 0;
    in property <float> eyes-offset-y: 0;
    in property <float> eyes-scale-x: 1.0;
    in property <float> eyes-scale-y: 1.0;
    // Transform badan untuk Bottom Play / Side Play native.
    in property <float> play-offset: 0;
    in property <float> play-body-scale-x: 1.0;
    in property <float> play-body-scale-y: 1.0;

    in property <float> cpu: 0;
    in property <float> ram: 0;
    in property <float> disk: 0;
    in property <string> cpu-text: "-";
    in property <string> ram-text: "-";
    in property <string> disk-text: "-";
    in property <string> net-text: "";
    in property <string> sys-text: "";

    in property <bool> battery-present: true;
    in property <int> battery-percent: 0;
    in property <bool> battery-charging: false;
    in property <[NoteItem]> notes;
    in property <[ClipboardItem]> clipboard-items;
    in property <bool> clipboard-available: true;
    in property <[ReminderItem]> reminders;
    in property <bool> reminder-alert-visible: false;
    in property <string> reminder-alert-text;
    in property <string> reminder-alert-sub;
    in property <string> reminder-status;
    in property <int> reminder-weekdays-mask: 62;
    in property <[bool]> reminder-weekday-selected;
    in-out property <string> reminder-draft;
    in-out property <string> reminder-date-time;
    in-out property <string> reminder-repeat-mode: "none";
    in property <string> weather-city: "Bandung";
    in property <string> weather-temp: "--°";
    in property <string> weather-condition: "Memuat cuaca...";
    in property <string> weather-feels: "";
    in property <string> weather-humidity: "";
    in property <string> weather-rain: "";
    in property <string> weather-icon: "";
    in property <string> weather-status: "";
    in property <string> weather-lat: "-6.9175";
    in property <string> weather-lon: "107.6191";
