    Text { text: "Conversation Moments"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            cm-enabled-input := TextInput { text: root.conversation-enabled ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Aktifkan komentar kontekstual"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: cm-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: cm-enabled-input.text == "true"; clicked => { cm-enabled-input.text = cm-enabled-input.text == "true" ? "false" : "true"; } }
            }
            cm-play-input := TextInput { text: root.conversation-on-play ? "true" : "false"; visible: false; }
            cm-track-input := TextInput { text: root.conversation-on-track-change ? "true" : "false"; visible: false; }
            cm-pause-input := TextInput { text: root.conversation-on-pause ? "true" : "false"; visible: false; }
            cm-return-input := TextInput { text: root.conversation-on-return ? "true" : "false"; visible: false; }
            cm-weather-input := TextInput { text: root.conversation-on-weather-change ? "true" : "false"; visible: false; }
            cm-rain-input := TextInput { text: root.conversation-on-rain-soon ? "true" : "false"; visible: false; }
            cm-battery-input := TextInput { text: root.conversation-on-low-battery ? "true" : "false"; visible: false; }
            cm-charging-input := TextInput { text: root.conversation-on-charging ? "true" : "false"; visible: false; }
            VerticalLayout {
                spacing: 3px;
                PageToggle { label: "Saat musik mulai diputar"; checked: cm-play-input.text == "true"; toggled(v) => { cm-play-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat lagu berganti"; checked: cm-track-input.text == "true"; toggled(v) => { cm-track-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat musik dijeda atau selesai"; checked: cm-pause-input.text == "true"; toggled(v) => { cm-pause-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat kembali setelah lama tidak aktif"; checked: cm-return-input.text == "true"; toggled(v) => { cm-return-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat kondisi cuaca berubah"; checked: cm-weather-input.text == "true"; toggled(v) => { cm-weather-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat hujan segera diperkirakan"; checked: cm-rain-input.text == "true"; toggled(v) => { cm-rain-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat baterai turun ke 15%"; checked: cm-battery-input.text == "true"; toggled(v) => { cm-battery-input.text = v ? "true" : "false"; } }
                PageToggle { label: "Saat laptop mulai mengisi daya"; checked: cm-charging-input.text == "true"; toggled(v) => { cm-charging-input.text = v ? "true" : "false"; } }
            }
            Text { text: "Anggap kembali setelah (5–120 menit)"; color: Theme.text-faint; font-size: 9px; }
            cm-return-min-input := TextInput { text: root.conversation-return-after-min; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda antar komentar (1–60 menit)"; color: Theme.text-faint; font-size: 9px; }
            cm-cooldown-input := TextInput { text: root.conversation-cooldown-min; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Coba momen"; clicked => { root.test-conversation("Asyik, kita ketemu momen baru! ✨", "Uji Conversation Moments"); } }
                Chip { label: "Coba momen cuaca"; clicked => { root.test-conversation("Cuaca berubah, jangan lupa sesuaikan aktivitasmu ☀️", "Uji momen cuaca"); } }
            }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    cm-enabled-input.text = "true";
                    cm-play-input.text = "true";
                    cm-track-input.text = "true";
                    cm-pause-input.text = "false";
                    cm-return-input.text = "true";
                    cm-weather-input.text = "true";
                    cm-rain-input.text = "true";
                    cm-battery-input.text = "true";
                    cm-charging-input.text = "false";
                    cm-return-min-input.text = "10";
                    cm-cooldown-input.text = "3";
                    root.save-conversation(true, true, true, false, true, true, true, true, false, "10", "3");
                } }
                Chip { label: "Simpan Conversation Moments"; clicked => {
                    root.save-conversation(cm-enabled-input.text == "true", cm-play-input.text == "true", cm-track-input.text == "true", cm-pause-input.text == "true", cm-return-input.text == "true", cm-weather-input.text == "true", cm-rain-input.text == "true", cm-battery-input.text == "true", cm-charging-input.text == "true", cm-return-min-input.text, cm-cooldown-input.text);
                } }
            }
            Text { text: root.conversation-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
