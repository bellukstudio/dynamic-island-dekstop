                Chip { label: "Senyap"; selected: prayer-mode-input.text == "silent"; clicked => { prayer-mode-input.text = "silent"; } }
            }
            Text { text: "Pengingat sebelum adzan"; color: Theme.text-faint; font-size: 9px; }
            prayer-remind-input := TextInput { text: root.prayer-remind-before; visible: false; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Aktif"; selected: prayer-remind-input.text == "true"; clicked => { prayer-remind-input.text = "true"; } }
                Chip { label: "Nonaktif"; selected: prayer-remind-input.text != "true"; clicked => { prayer-remind-input.text = "false"; } }
            }
            Text { text: "Menit sebelum waktu shalat (1–120)"; color: Theme.text-faint; font-size: 9px; }
            prayer-min-input := TextInput { text: root.prayer-remind-min; color: Theme.text; font-size: 11px; single-line: true; }
        }
    }
    Text { text: "Pomodoro"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Durasi fokus / istirahat / istirahat panjang (menit)"; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            pomo-focus-input := TextInput { text: root.pomodoro-focus; color: Theme.text; font-size: 11px; single-line: true; }
            pomo-break-input := TextInput { text: root.pomodoro-break; color: Theme.text; font-size: 11px; single-line: true; }
            pomo-long-input := TextInput { text: root.pomodoro-long-break; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jumlah ronde sebelum istirahat panjang"; color: Theme.text-faint; font-size: 9px; }
            pomo-rounds-input := TextInput { text: root.pomodoro-rounds; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 5px;
                Chip {
                    label: "Reset default";
                    clicked => {
                        prayer-province-input.text = "Jawa Barat";
                        prayer-city-input.text = "Kota Bandung";
                        prayer-mode-input.text = "tone";
                        prayer-remind-input.text = "false";
                        prayer-min-input.text = "10";
                        pomo-focus-input.text = "25";
                        pomo-break-input.text = "5";
                        pomo-long-input.text = "15";
                        pomo-rounds-input.text = "4";
                        root.save-routines("tone", "false", "10", "25", "5", "15", "4", "Jawa Barat", "Kota Bandung");
                    }
                }
                Chip { label: "Simpan jadwal & Pomodoro"; clicked => { root.save-routines(prayer-mode-input.text, prayer-remind-input.text, prayer-min-input.text, pomo-focus-input.text, pomo-break-input.text, pomo-long-input.text, pomo-rounds-input.text, prayer-province-input.text, prayer-city-input.text); } }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 5px;
        Chip {
            label: "Reset default";
            clicked => {
                hub-input.text = "Ctrl+Alt+N";
                settings-input.text = "Ctrl+Alt+,";
                pomo-input.text = "Ctrl+Alt+P";
                prayer-input.text = "Ctrl+Alt+A";
                root.save-shortcuts("Ctrl+Alt+N", "Ctrl+Alt+,", "Ctrl+Alt+P", "Ctrl+Alt+A");
            }
        }
        Chip {
            label: "Simpan";
            clicked => {
                root.save-shortcuts(hub-input.text, settings-input.text, pomo-input.text, prayer-input.text);
            }
        }
    }
    Text {
        text: root.save-status;
        color: Theme.text-faint;
        font-size: 10px;
        wrap: word-wrap;
    }
    Text {
        text: "Shortcut langsung aktif setelah disimpan. Pastikan setiap kombinasi tidak bentrok dengan aplikasi lain.";
        color: Theme.text-faint;
        font-size: 9px;
        wrap: word-wrap;
    }
}

component CompressPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> status: "Pilih gambar atau dokumen Office untuk dikompres";
    callback run(string);
    callback pick-file();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    Text { text: "Compress"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Kompresi batch gambar, PDF & Office · target pengurangan 30%"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: "Daftar file JPG/JPEG/PNG/BMP/PDF/DOCX/XLSX/PPTX (bisa beberapa file)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput {
                text: root.file-path;
                color: Theme.text;
                font-size: 11px;
                single-line: false;
            }
            Text { text: "Hasil disimpan sebagai nama_compressed.<format> (Office tetap memakai ekstensi aslinya) di folder yang sama."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Kompres"; clicked => { root.run(path-input.text); } }
    }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
}
component ConvertPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> target-format: "auto";
    in property <string> overrides-text: "";
    in property <string> status: "Pilih gambar, PDF, atau dokumen Office untuk dikonversi";
    in property <string> progress-text: "";
    in property <string> history-text: "Belum ada riwayat konversi";
    in property <string> files-text: "Belum ada file dipilih";
    in property <string> output-dir-text: "";
    in property <string> eta-text: "";
    in property <string> queue-text: "Antrean kosong";
    in property <string> preview-page-text: "Halaman 1 / 1";
    in property <string> preview-status: "";
    in property <string> preview-zoom-text: "110 DPI";
    in property <float> progress-value: 0;
    in property <image> source-preview;
    in property <image> result-preview;
    callback run(string, string, string, string, string);
    callback pick-output-dir();
    callback preview-prev();
    callback preview-next();
    callback preview-zoom-in();
    callback preview-zoom-out();
    callback pick-file();
    callback reveal();
    callback cancel();
    callback pause();
    callback resume();
    callback clear-queue();
    callback remove-queue-file(string);
    callback retry-failed();
    callback retry-one-failed(string);
    callback cancel-one-file(string);
    callback add-files();
    callback move-queue-file(string, int);
    callback remove-finished();
    callback export-history();
    callback clear-history();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 7px;
    Text { text: "Convert"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Konversi gambar, PDF, dan dokumen Office"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Text { text: "Tip: seret file langsung dari Windows Explorer ke jendela ini, atau gunakan Pilih file."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 5px;
            Text { text: "File sumber (bisa pilih beberapa file sekaligus)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput { text: root.file-path; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Format tujuan global: auto (disarankan) atau PNG/JPG/WebP/BMP/GIF/PDF."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            format-input := TextInput { text: root.target-format; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Override per file: nama-file=png@80; dokumen.pdf=jpg@70 (kualitas 40–100)"; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            overrides-input := TextInput { text: root.overrides-text; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Kualitas JPEG/PDF (40–100)"; color: Theme.text-faint; font-size: 10px; }
            quality-input := TextInput { text: "90"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Resolusi halaman PDF (DPI, 36–400)"; color: Theme.text-faint; font-size: 10px; }
            dpi-input := TextInput { text: "150"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Folder output (kosong = di samping file sumber)"; color: Theme.text-faint; font-size: 10px; }
            HorizontalLayout {
                Text { text: root.output-dir-text == "" ? "Folder sumber (default)" : root.output-dir-text; color: Theme.text; font-size: 10px; wrap: word-wrap; }
                Chip { label: "Pilih folder"; clicked => { root.pick-output-dir(); } }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Tambah file"; clicked => { root.add-files(); } }
        Chip { label: "Konversi"; clicked => { root.run(path-input.text, format-input.text, quality-input.text, dpi-input.text, overrides-input.text); } }
        Chip { label: "Jeda"; clicked => { root.pause(); } }
        Chip { label: "Lanjut"; clicked => { root.resume(); } }
        Chip { label: "Hapus antrean"; clicked => { root.clear-queue(); } }
        queue-remove-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Hapus file"; clicked => { root.remove-queue-file(queue-remove-input.text); } }
        Chip { label: "Naik"; clicked => { root.move-queue-file(queue-remove-input.text, -1); } }
        Chip { label: "Turun"; clicked => { root.move-queue-file(queue-remove-input.text, 1); } }
        Chip { label: "Bersihkan selesai"; clicked => { root.remove-finished(); } }
        Chip { label: "Coba ulang gagal"; clicked => { root.retry-failed(); } }
        retry-failed-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Retry file"; clicked => { root.retry-one-failed(retry-failed-input.text); } }
        cancel-file-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Cancel file"; clicked => { root.cancel-one-file(cancel-file-input.text); } }
        Chip { label: "Batalkan"; clicked => { root.cancel(); } }
        Chip { label: "Buka folder hasil"; clicked => { root.reveal(); } }
    }
    Rectangle {
        height: 7px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.progress-value, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
            animate width { duration: 180ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        Text { text: root.eta-text; color: Theme.text-faint; font-size: 9px; horizontal-stretch: 1; }
        Text { text: root.progress-text; color: Theme.accent; font-size: 10px; }
    }
    Text { text: root.queue-text; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text { text: "Preview"; color: Theme.text; font-size: 11px; font-weight: 700; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Sumber"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.source-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Hasil"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.result-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Chip { label: "‹"; clicked => { root.preview-prev(); } }
                Text { text: root.preview-page-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "›"; clicked => { root.preview-next(); } }
                Chip { label: "−"; clicked => { root.preview-zoom-out(); } }
                Text { text: root.preview-zoom-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "+"; clicked => { root.preview-zoom-in(); } }
            }
            Text { text: root.preview-status; color: #ffb36b; font-size: 9px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text { text: "Daftar file"; color: Theme.text; font-size: 11px; font-weight: 700; }
            Text { text: root.files-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            HorizontalLayout {
                Text { text: "Riwayat konversi"; color: Theme.text; font-size: 11px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Chip { label: "Ekspor CSV"; clicked => { root.export-history(); } }
                Chip { label: "Bersihkan"; clicked => { root.clear-history(); } }
            }
            Text { text: root.history-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
}
component TransferPage inherits VerticalLayout {
    in property <string> status: "Server belum aktif";
    in property <string> address: "";
    in property <string> shared-count-text: "0";
    callback start-server();
    callback stop();
    callback add-files();
    callback open-inbox();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    Text { text: "File Transfer"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Berbagi file melalui jaringan lokal"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: root.status; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: root.address; color: Theme.accent; font-size: 10px; wrap: word-wrap; }
            Text { text: "File dibagikan: " + root.shared-count-text; color: Theme.text-faint; font-size: 10px; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Mulai server"; clicked => { root.start-server(); } }
        Chip { label: "Hentikan"; clicked => { root.stop(); } }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Tambah file"; clicked => { root.add-files(); } }
        Chip { label: "Folder masuk"; clicked => { root.open-inbox(); } }
    }
    Text { text: "Perangkat lain yang satu jaringan dapat membuka alamat di atas untuk mengunduh atau mengirim file."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
}
component AndroidPage inherits VerticalLayout {
    in property <string> status: "Periksa perangkat Android";
    in property <string> devices: "";
    in property <string> entries: "";
    in property <string> current-path: "/sdcard/Download";
    in property <string> selected-serial: "";
    callback refresh();
    callback list(string);
    callback push(string, string);
    callback pull(string);
    callback select-device(string);
    callback mirror();
    callback stop-mirror();
    alignment: start;
    padding-left: 12px;
    padding-right: 12px;
    spacing: 6px;
    Text { text: "Android"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "ADB · USB / Wireless debugging"; color: Theme.accent; font-size: 10px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            Text { text: root.status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Perangkat terdeteksi"; color: Theme.text; font-size: 10px; }
            devices-input := TextInput { text: root.devices; color: Theme.text; font-size: 9px; single-line: false; }
            serial-input := TextInput { text: root.selected-serial; color: Theme.text; font-size: 10px; single-line: true; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Deteksi"; clicked => { root.refresh(); } }
        Chip { label: "Pilih"; clicked => { root.select-device(serial-input.text); } }
    }
    Rectangle {
        background: #ffffff0b;
        border-radius: 9px;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            Text { text: "Jalur HP"; color: Theme.text-faint; font-size: 9px; }
            path-input := TextInput { text: root.current-path; color: Theme.text; font-size: 10px; single-line: true; }
            Chip { label: "Baca folder"; clicked => { root.list(path-input.text); } }
            Text { text: root.entries; color: Theme.text; font-size: 9px; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: start;
        Chip { label: "Kirim file ke HP"; clicked => { root.push(serial-input.text, path-input.text); } }
        Chip { label: "Ambil file dari HP"; clicked => { root.pull(path-input.text); } }
        Chip { label: "Mirroring"; clicked => { root.mirror(); } }
        Chip { label: "Stop mirror"; clicked => { root.stop-mirror(); } }
    }
}
component PrivacyPage inherits VerticalLayout {
    in property <bool> active: false;
    in property <string> source: "";
    in property <string> elapsed: "00:00";
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 10px;
    spacing: 9px;

    Text { text: "Privasi & aktivitas perangkat"; color: Theme.text; font-size: 16px; font-weight: 700; }
    Rectangle {
        height: 72px;
        border-radius: 12px;
        background: root.active ? #d9770624 : #16a34a18;
        border-width: 1px;
        border-color: root.active ? #f59e0b70 : #22c55e55;
        HorizontalLayout {
            padding: 10px;
            spacing: 9px;
            Rectangle {
                width: 9px; height: 9px; border-radius: 5px;
                background: root.active ? #f59e0b : #22c55e;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 3px;
                Text { text: root.active ? "Aktivitas terdeteksi" : "Tidak ada aktivitas terdeteksi"; color: Theme.text; font-size: 13px; font-weight: 700; }
                Text { text: root.active ? "Mikrofon atau kamera sedang digunakan" : "Mikrofon dan kamera sedang tidak digunakan"; color: Theme.text-faint; font-size: 10px; }
            }
        }
    }
    if root.active: Rectangle {
        border-radius: 10px;
        background: Theme.chip;
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text { text: "SUMBER AKTIVITAS"; color: Theme.text-faint; font-size: 9px; font-weight: 700; }
            Text { text: root.source == "" ? "RAPAT" : root.source; color: Theme.accent; font-size: 15px; font-weight: 700; }
            Text { text: "Durasi sesi"; color: Theme.text-faint; font-size: 9px; }
            Text { text: root.elapsed; color: Theme.text; font-size: 21px; font-weight: 700; }
        }
    }
    Text {
        text: "Deteksi menggunakan sesi audio aktif dan laporan aktivitas sensor kamera Windows. Status diperbarui otomatis.";
        color: Theme.text-faint; font-size: 9px; wrap: word-wrap;
    }
    Text {
        text: "Catatan: aplikasi yang menggunakan mikrofon melalui jalur audio tertentu dapat tidak terdeteksi oleh indikator ini.";
        color: Theme.text-faint; font-size: 8px; wrap: word-wrap;
    }
}
component PrayerPage inherits VerticalLayout {
    in property <[PrayerItem]> items;
    in property <string> next-name: "Memuat jadwal...";
    in property <string> next-time: "--:--";
    in property <string> countdown: "--:--:--";
    in property <string> status: "";
    in property <bool> ramadan: false;
    in property <string> ramadan-date: "";
    in property <string> imsak-countdown: "--:--:--";
    in property <string> buka-countdown: "--:--:--";
    in property <string> imsak-time: "";
    in property <string> buka-time: "";
    in property <string> mode: "tone";
    in property <bool> remind-before: true;
    in property <string> remind-min: "10";
    in property <string> dhikr-arabic: "";
    in property <string> dhikr-latin: "";
    in property <string> dhikr-meaning: "";
    callback refresh();
    callback set-mode(string);
    callback set-remind(bool);
    callback set-remind-min(int);
    callback toggle-ramadan();
    callback dhikr-next();
    spacing: 8px;
    padding: 12px;
    Text { text: "Jadwal shalat"; color: Theme.text; font-size: 16px; font-weight: 700; }
    Rectangle {
        height: 78px; border-radius: 12px; background: Theme.chip;
        VerticalLayout {
            padding: 10px; spacing: 2px;
            Text { text: "WAKTU BERIKUTNYA · " + root.next-name; color: Theme.text-faint; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                Text { text: root.next-time; color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.countdown; color: Theme.accent; font-size: 19px; font-weight: 700; }
            }
        }
    }
    Rectangle {
        height: 128px; border-radius: 10px; background: Theme.chip;
        VerticalLayout {
            padding: 8px; spacing: 3px;
            for item in root.items: HorizontalLayout {
                height: 19px; spacing: 6px;
                Text { text: item.name; color: item.state == 1 ? Theme.accent : Theme.text; font-size: 11px; horizontal-stretch: 1; }
                Text { text: item.time; color: item.state == 2 ? Theme.text-faint : Theme.text; font-size: 11px; }
                Text { text: item.state == 2 ? "✓" : (item.state == 1 ? "BERIKUTNYA" : ""); color: Theme.accent; font-size: 8px; }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        Chip { label: "Perbarui jadwal"; clicked => { root.refresh(); } }
        Chip { label: root.ramadan ? "Matikan Ramadan" : "Mode Ramadan"; selected: root.ramadan; clicked => { root.toggle-ramadan(); } }
    }
    if root.ramadan: Rectangle {
        height: 70px; border-radius: 10px; background: #d9770620;
        HorizontalLayout {
            padding: 8px; spacing: 8px;
            VerticalLayout {
                Text { text: "IMSAK · " + root.imsak-time; color: Theme.text; font-size: 9px; }
                Text { text: root.imsak-countdown; color: Theme.accent; font-size: 16px; font-weight: 700; }
            }
            Rectangle { width: 1px; background: Theme.text-faint; }
            VerticalLayout {
                Text { text: "BUKA · " + root.buka-time; color: Theme.text; font-size: 9px; }
                Text { text: root.buka-countdown; color: Theme.accent; font-size: 16px; font-weight: 700; }
            }
        }
    }
    HorizontalLayout {
        spacing: 5px;
        Text { text: "Mode"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
        Chip { label: "Nada"; selected: root.mode == "tone"; clicked => { root.set-mode("tone"); } }
        Chip { label: "Adzan"; selected: root.mode == "adzan"; clicked => { root.set-mode("adzan"); } }
        Chip { label: "Senyap"; selected: root.mode == "silent"; clicked => { root.set-mode("silent"); } }
    }
    HorizontalLayout {
        spacing: 6px;
        Chip { label: root.remind-before ? "Pengingat: aktif" : "Pengingat: mati"; selected: root.remind-before; clicked => { root.set-remind(!root.remind-before); } }
        Chip { label: "−"; clicked => { root.set-remind-min(-1); } }
        Text { text: root.remind-min + " menit"; color: Theme.text; font-size: 10px; vertical-alignment: center; }
        Chip { label: "+"; clicked => { root.set-remind-min(1); } }
    }
    Rectangle {
        height: 1px; background: Theme.text-faint;
    }
    Text { text: "DZIKIR"; color: Theme.text-faint; font-size: 9px; font-weight: 700; }
    Text { text: root.dhikr-arabic; color: Theme.accent; font-size: 19px; horizontal-alignment: center; }
    Text { text: root.dhikr-latin; color: Theme.text; font-size: 10px; horizontal-alignment: center; }
    Text { text: root.dhikr-meaning; color: Theme.text-faint; font-size: 9px; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        Chip { label: "Dzikir berikutnya"; clicked => { root.dhikr-next(); } }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.status; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
    }
}
component PlaceholderPage inherits VerticalLayout {
    in property <string> name;
    alignment: center;
    spacing: 4px;
    Text { text: root.name; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
    Text { text: "Belum tersedia di versi Slint"; color: Theme.text-faint; font-size: 12px; horizontal-alignment: center; }
}

// Halaman uji render: teks Arab (teks asli) dan emoji (gambar). Muncul jika "uji" ada di `pages`.
component RenderTestPage inherits VerticalLayout {
    in property <image> coffee;
    in property <image> tomato;
    in property <image> moon;
    alignment: center;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image { source: root.coffee; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.tomato; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.moon; width: 28px; height: 28px; image-fit: contain; }
    }
    Text {
        text: "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ";
        color: Theme.ok;
        font-size: 22px;
        horizontal-alignment: center;
    }
}

export component NotchWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Notch";

    in property <bool> expanded: false;
    in property <bool> adhan-active: false;
    in property <string> adhan-prayer: "";
    in property <int> adhan-phase: 0;
    in property <bool> meeting-active: false;
    in property <string> meeting-elapsed: "00:00";
    in property <string> meeting-source: "";
    in property <string> meeting-finished: "";
    // 0 = atas, 1 = melayang, 2 = bawah, 3 = kiri, 4 = kanan.
    in property <int> dock: 0;
    in property <bool> play-interaction-active: false;
    in property <bool> dragging: false;
    in property <bool> suppress-next-pill-click: false;
    in property <bool> dock-play-enabled: true;
    in property <bool> play-test-request: false;
    // Skala bentuk (config `scale`): radius hub 32 px dan telinga 10 px dikalikan nilai ini, seperti di Tauri.
    in property <float> ui-scale: 1.0;
    // Gambar hiasan tema (cahaya, scan, rim) yang dirender Rust dengan mask sudut akurat.
    in property <image> decor;
    in property <bool> has-decor: false;
    in-out property <string> page-id: "media";
    in property <[string]> tabs;

    in property <string> media-title: "Tidak ada media";
    in property <string> media-artist: "Putar musik untuk memulai";
