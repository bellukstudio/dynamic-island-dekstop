// Notch (Slint). Hub dengan tab dinamis (mengikuti `pages` di config.toml), bahu melengkung,
// dan tema dari `[appearance]`. Semua warna berasal dari `Theme`, yang diisi Rust saat start.

export struct NoteItem { id: string, text: string }
export struct ShelfItem { path: string, name: string, dir: bool }
export struct ClipboardItem { preview: string, text: string }
export struct ReminderItem { id: string, text: string, due: string, done: bool }
export struct PrayerItem { name: string, time: string, state: int }
// Satu sel kalender. kind: 0 = biasa, 1 = libur, 2 = cuti bersama, 3 = hari peringatan.
export struct CalCell { day: int, in-month: bool, sun: bool, today: bool, sel: bool, kind: int }

export global Theme {
    in-out property <color> body: #000000;
    in-out property <color> text: #ffffff;
    in-out property <color> text-dim: #ffffff9e;
    in-out property <color> text-faint: #ffffff6b;
    in-out property <color> accent: #788cff;
    in-out property <color> on-accent: #ffffff;
    in-out property <color> ok: #7bdc9a;
    in-out property <color> chip: #ffffff1a;
    in-out property <color> chip-hover: #ffffff2e;
    in-out property <color> track: #ffffff1f;
}

// Ikon garis (kotak 24x24), digambar dengan Path agar tidak perlu decoder gambar/SVG.
global Icons {
    out property <string> media: "M 9 18 V 5 L 21 3 V 16 M 3 18 A 3 3 0 1 0 9 18 A 3 3 0 1 0 3 18 M 15 16 A 3 3 0 1 0 21 16 A 3 3 0 1 0 15 16";
    out property <string> clock: "M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 M 12 6 V 12 L 16 14";
    out property <string> prayer: "M 4 21 V 11 L 12 4 L 20 11 V 21 Z M 9 21 V 14 H 15 V 21";
    out property <string> weather: "M 7 18 A 4 4 0 0 1 7 10 A 6 6 0 0 1 18.5 11 A 3.5 3.5 0 0 1 18 18 Z";
    out property <string> battery: "M 4 7 H 16 A 2 2 0 0 1 18 9 V 15 A 2 2 0 0 1 16 17 H 4 A 2 2 0 0 1 2 15 V 9 A 2 2 0 0 1 4 7 Z M 22 11 V 13";
    out property <string> shelf: "M 3 4 H 21 V 8 H 3 Z M 5 8 V 20 H 19 V 8 M 10 12 H 14";
    out property <string> reminder: "M 6 16 V 11 A 6 6 0 0 1 18 11 V 16 L 20 18 H 4 Z M 10 21 H 14";
    out property <string> notes: "M 6 2 H 14 L 20 8 V 20 A 2 2 0 0 1 18 22 H 6 A 2 2 0 0 1 4 20 V 4 A 2 2 0 0 1 6 2 Z M 8 13 H 16 M 8 17 H 13";
    out property <string> clipboard: "M 8 4 H 16 V 7 H 8 Z M 6 5 H 18 V 21 H 6 Z";
    out property <string> timer: "M 10 2 H 14 M 12 14 L 15 11 M 4 14 A 8 8 0 1 0 20 14 A 8 8 0 1 0 4 14";
    out property <string> grid: "M 3 3 H 10 V 10 H 3 Z M 14 3 H 21 V 10 H 14 Z M 14 14 H 21 V 21 H 14 Z M 3 14 H 10 V 21 H 3 Z";
    out property <string> wrench: "M 14.7 6.3 A 4 4 0 0 0 20 3.5 L 16.5 7 L 15 5.5 L 18.5 2 A 4 4 0 0 0 13.5 8.3 L 3.5 18.3 A 1.8 1.8 0 0 0 6 20.8 Z";
    out property <string> stats: "M 12 14 L 16 10 M 3.34 19 A 10 10 0 1 1 20.66 19";
    out property <string> lyrics: "M 4 6 H 20 M 4 12 H 16 M 4 18 H 12";
    out property <string> privacy: "M 12 3 L 20 6 V 12 A 9 9 0 0 1 12 21 A 9 9 0 0 1 4 12 V 6 Z";
    out property <string> android: "M 6 9 H 18 V 18 H 6 Z M 8 5 L 6 2 M 16 5 L 18 2 M 9 12 V 13 M 15 12 V 13 M 9 18 V 21 M 15 18 V 21";
    out property <string> transfer: "M 4 7 H 20 M 16 3 L 20 7 L 16 11 M 20 17 H 4 M 8 13 L 4 17 L 8 21";
    out property <string> convert: "M 5 7 H 19 L 16 4 M 19 7 L 16 10 M 19 17 H 5 L 8 14 M 5 17 L 8 20";
    out property <string> compress: "M 4 4 L 10 10 M 4 4 V 9 M 4 4 H 9 M 20 4 L 14 10 M 20 4 V 9 M 20 4 H 15 M 4 20 L 10 14 M 4 20 V 15 M 4 20 H 9 M 20 20 L 14 14 M 20 20 V 15 M 20 20 H 15";
    out property <string> currency: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 16 8 C 15 6 9 6 8 9 C 7 12 17 11 16 15 C 15 18 9 18 8 16 M 12 5 V 19";
    out property <string> settings: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 5 M 12 19 V 22 M 2 12 H 5 M 19 12 H 22 M 5 5 L 7 7 M 17 17 L 19 19 M 19 5 L 17 7 M 7 17 L 5 19";
    out property <string> test: "M 12 3 V 21 M 4 7.5 L 20 16.5 M 20 7.5 L 4 16.5";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> mic: "M 12 2 A 3 3 0 0 0 9 5 V 12 A 3 3 0 0 0 15 12 V 5 A 3 3 0 0 0 12 2 Z M 19 10 V 12 A 7 7 0 0 1 5 12 V 10 M 12 19 V 22";
    out property <string> wifi: "M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 20 L 12.1 20";
    out property <string> bluetooth: "M 7 7 L 17 17 L 12 22 V 2 L 17 7 L 7 17";
    out property <string> awake: "M 4 8 H 17 V 15 A 4 4 0 0 1 13 19 H 8 A 4 4 0 0 1 4 15 Z M 17 10 H 19 A 2 2 0 0 1 19 14 H 17 M 7 2 V 5 M 11 2 V 5";
    out property <string> moon: "M 21 12.8 A 9 9 0 1 1 11.2 3 A 7 7 0 0 0 21 12.8 Z";
    out property <string> lock: "M 5 11 H 19 V 21 H 5 Z M 8 11 V 7 A 4 4 0 0 1 16 7 V 11";
    out property <string> center: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 6 M 12 18 V 22 M 2 12 H 6 M 18 12 H 22";
    out property <string> reset: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 V 8 H 8";
    out property <string> copy: "M 8 4 H 16 A 2 2 0 0 1 18 6 V 18 A 2 2 0 0 1 16 20 H 8 A 2 2 0 0 1 6 18 V 6 A 2 2 0 0 1 8 4 Z M 4 16 H 3 A 2 2 0 0 1 1 14 V 4 A 2 2 0 0 1 3 2 H 13 A 2 2 0 0 1 15 4 V 5";

    pure public function for-page(id: string) -> string {
        if id == "media" { return Icons.media; }
        if id == "clock" { return Icons.clock; }
        if id == "prayer" { return Icons.prayer; }
        if id == "weather" { return Icons.weather; }
        if id == "battery" { return Icons.battery; }
        if id == "shelf" { return Icons.shelf; }
        if id == "reminder" { return Icons.reminder; }
        if id == "notes" { return Icons.notes; }
        if id == "clipboard" { return Icons.clipboard; }
        if id == "timer" { return Icons.timer; }
        if id == "quick" { return Icons.grid; }
        if id == "tools" { return Icons.wrench; }
        if id == "stats" { return Icons.stats; }
        if id == "lyrics" { return Icons.lyrics; }
        if id == "privacy" { return Icons.privacy; }
        if id == "android" { return Icons.android; }
        if id == "transfer" { return Icons.transfer; }
        if id == "convert" { return Icons.convert; }
        if id == "compress" { return Icons.compress; }
        if id == "currency" { return Icons.currency; }
        if id == "settings" { return Icons.settings; }
        return Icons.test;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    height: 28px;
    min-width: 64px;
    border-radius: 14px;
    background: root.selected ? Theme.accent.with-alpha(0.24) : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    Text {
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked;
    // Menyusut otomatis kalau tab terlalu banyak untuk lebar pil (preferensi 30 px, minimum 20 px).
    preferred-width: 30px;
    min-width: 20px;
    max-width: 30px;
    height: 30px;
    border-radius: 9px;
    background: active ? Theme.accent.with-alpha(0.22) : (ta.has-hover ? Theme.chip : transparent);
    border-width: active ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.45);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.active ? Theme.text : Theme.text-dim;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// "Telinga" cekung di sisi pil (radius 10 px seperti `--e` di position.css). Menyatukan notch dengan
// tepi layar: di atas saat menempel ke atas, di bawah (dibalik) saat menempel ke dasar layar.
component Ear inherits Path {
    in property <bool> right: false;
    in property <bool> bottom: false;
    in property <float> s: 1.0;      // skala dari config (telinga 10 px x scale)
    width: 10px * s;
    height: 10px * s;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: Theme.body;
    commands: bottom ? (right ? "M 10 10 L 0 10 L 0 0 A 10 10 0 0 0 10 10 Z" : "M 0 10 L 10 10 L 10 0 A 10 10 0 0 1 0 10 Z")
                     : (right ? "M 10 0 L 0 0 L 0 10 A 10 10 0 0 1 10 0 Z" : "M 0 0 L 10 0 L 10 10 A 10 10 0 0 0 0 0 Z");
}

component StatBar inherits VerticalLayout {
    in property <string> label;
    in property <float> value;   // 0..100
    in property <string> text;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.text-dim; font-size: 11px; horizontal-stretch: 1; }
        Text { text: root.text; color: Theme.text; font-size: 11px; horizontal-alignment: right; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> commands;
    in property <length> size: 36px;
    in property <bool> primary: false;
    in property <bool> outline: false;   // ikon garis (tanpa isian)
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? Theme.text : (ta.has-hover ? Theme.chip-hover : transparent);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.42;
        height: root.size * 0.42;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: root.outline ? transparent : (root.primary ? Theme.body : Theme.text);
        stroke: root.primary ? Theme.body : Theme.text;
        stroke-width: root.outline ? 2px : 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component MediaPlayer inherits HorizontalLayout {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    callback open-lyrics;

    padding-left: 20px;
    padding-right: 20px;
    spacing: 16px;
    alignment: center;

    Rectangle {
        width: 108px;
        height: 92px;
        border-radius: 18px;
        background: Theme.chip;
        if root.has-art: Image { source: root.art; width: 108px; height: 92px; image-fit: cover; }
        if !root.has-art: Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 40px;
            height: 40px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.media;
            fill: transparent;
            stroke: Theme.text-faint;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        alignment: stretch;
        spacing: 3px;
        Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; overflow: elide; }
        Text { text: root.artist; color: Theme.text-dim; font-size: 12px; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.pos-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                height: 14px;
                background: transparent;
                Rectangle {
                    x: 0px;
                    y: 5px;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.text;
                    }
                }
                seek-area := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); }
                    moved => { if self.pressed { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); } }
                }
            }
            Text { text: root.dur-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            RoundButton { commands: "M 19 20 L 9 12 L 19 4 Z M 5 19 V 5"; clicked => { root.prev(); } }
            RoundButton {
                primary: true;
                size: 42px;
                commands: root.playing ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
                clicked => { root.toggle(); }
            }
            RoundButton { commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.next(); } }
            Rectangle { width: 6px; }
            Chip { label: "Lirik"; min-width: 56px; height: 30px; clicked => { root.open-lyrics(); } }
        }
    }
}
component LyricsPanel inherits Rectangle {
    in property <[string]> lines;
    in property <int> active: -1;
    callback back;
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 28px;
            alignment: start;
            Chip { label: "\u{2039} Media"; min-width: 76px; clicked => { root.back(); } }
            Text { text: "Lirik"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
        }
        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: "Lirik belum tersedia untuk lagu ini";
                color: Theme.text-faint;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-y: max(0px, root.active * 36px - self.height / 2 + 18px);
            content-width: self.width;
            content-height: max(self.height, root.lines.length * 36px);
            VerticalLayout {
                width: parent.width;
                spacing: 0px;
                for line[i] in root.lines: Rectangle {
                    height: 36px;
                    background: i == root.active ? Theme.chip : transparent;
                    border-radius: 9px;
                    Text {
                        text: line;
                        width: parent.width - 16px;
                        x: 8px;
                        y: 0px;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-alignment: center;
                        font-size: i == root.active ? 18px : 13px;
                        font-weight: i == root.active ? 700 : 400;
                        color: i == root.active ? Theme.text : Theme.text-faint;
                    }
                }
            }
        }
    }
}

// Halaman Media: pemutar + panel lirik di dalamnya (tombol "Lirik" membuka, "Media" kembali).
component MediaPage inherits Rectangle {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    in property <[string]> lyric-lines;
    in property <int> lyric-active: -1;
    in-out property <bool> lyrics-open: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    MediaPlayer {
        width: parent.width;
        height: parent.height;
        visible: !root.lyrics-open;
        art: root.art; has-art: root.has-art; title: root.title; artist: root.artist;
        pos-text: root.pos-text; dur-text: root.dur-text; progress: root.progress; playing: root.playing;
        prev => { root.prev(); } toggle => { root.toggle(); } next => { root.next(); }
        seek(v) => { root.seek(v); }
        open-lyrics => { root.lyrics-open = true; }
    }
    if root.lyrics-open: LyricsPanel {
        lines: root.lyric-lines;
        active: root.lyric-active;
        back => { root.lyrics-open = false; }
    }
}

component ClockPage inherits HorizontalLayout {
    in property <string> clock-text;
    in property <string> date-text;
    callback open-calendar;
    padding-left: 28px;
    padding-right: 28px;
    alignment: stretch;
    Text { text: root.clock-text; color: Theme.text; font-size: 52px; font-weight: 700; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    // Klik tanggal membuka kalender bulanan (seperti di Tauri)
    Rectangle {
        width: 170px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.date-text; color: da.has-hover ? Theme.text : Theme.text-dim; font-size: 14px; horizontal-alignment: right; }
            Text { text: "Kalender \u{203A}"; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; }
        }
        da := TouchArea { clicked => { root.open-calendar(); } }
    }
}

component CalDay inherits Rectangle {
    in property <CalCell> c;
    callback clicked;
    width: 40px;
    height: 18px;
    border-radius: 9px;
    // jenis terpenting menentukan warna: libur > cuti > peringatan
    background: c.today ? Theme.accent
        : c.kind == 1 && c.in-month ? #ff6b6b29
        : c.kind == 2 && c.in-month ? #ffb34029
        : (ta.has-hover && c.in-month ? Theme.chip : transparent);
    border-width: c.sel ? 1.5px : 0px;
    border-color: Theme.text.with-alpha(0.7);
    Text {
        text: "\{c.day}";
        font-size: 11px;
        font-weight: c.today || (c.in-month && (c.kind == 1 || c.kind == 2)) ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: c.today ? #000000
            : !c.in-month ? Theme.text-faint
            : c.kind == 1 ? #ff6b6b
            : c.kind == 2 ? #ffb340
            : c.sun ? #ff7a7a : Theme.text;
    }
    // titik kecil di bawah angka untuk hari peringatan
    Rectangle {
        visible: c.kind == 3 && c.in-month;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: c.today ? #000000 : Theme.accent;
        x: (parent.width - self.width) / 2;
        y: parent.height - 4px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component CalendarPage inherits Rectangle {
    in property <[CalCell]> cells;
    in property <[string]> weekdays;
    in property <string> title;
    in property <string> foot-date;
    in property <string> foot-name;
    in property <int> foot-kind;
    callback prev;
    callback next;
    callback today;
    callback select(int);
    callback close;

    // Kisi 7 x 6 di kiri
    for wd[i] in root.weekdays: Text {
        x: 24px + i * 40px;
        y: 0px;
        width: 40px;
        height: 14px;
        text: wd;
        font-size: 10px;
        horizontal-alignment: center;
        color: i == 0 ? #ff7a7a : Theme.text-faint;
    }
    for cell[i] in root.cells: CalDay {
        x: 24px + Math.mod(i, 7) * 40px;
        y: 16px + Math.floor(i / 7) * 19px;
        c: cell;
        clicked => { root.select(i); }
    }

    // Judul, navigasi, dan keterangan di kanan
    VerticalLayout {
        x: 330px;
        y: 0px;
        width: parent.width - 330px - 20px;
        spacing: 10px;
        Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; height: 24px; overflow: elide; }
        HorizontalLayout {
            spacing: 6px;
            height: 26px;
            alignment: start;
            RoundButton { size: 26px; outline: true; commands: "M 15 5 L 8 12 L 15 19"; clicked => { root.prev(); } }
            RoundButton { size: 26px; outline: true; commands: "M 9 5 L 16 12 L 9 19"; clicked => { root.next(); } }
            Chip { label: "Hari ini"; height: 26px; clicked => { root.today(); } }
            RoundButton { size: 26px; outline: true; commands: Icons.close; clicked => { root.close(); } }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 10px;
                height: 10px;
                y: 3px;
                border-radius: 5px;
                background: root.foot-kind == 1 ? #ff6b6b
                    : root.foot-kind == 2 ? #ffb340
                    : root.foot-kind == 3 ? Theme.accent : Theme.text-faint;
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: root.foot-date; color: Theme.text-dim; font-size: 11px; }
                Text { text: root.foot-name; color: Theme.text; font-size: 13px; wrap: word-wrap; max-height: 44px; overflow: elide; }
            }
        }
    }
}

component TimerPage inherits VerticalLayout {
    in property <string> pomo-text;
    in property <string> pomo-label;
    in property <float> pomo-progress;   // 0..1
    in property <bool> pomo-running;
    in property <bool> pomo-rest;
    callback toggle;
    callback reset;
    callback skip;
    alignment: center;
    spacing: 10px;
    padding-left: 28px;
    padding-right: 28px;

    HorizontalLayout {
        Text { text: root.pomo-text; color: Theme.text; font-size: 44px; font-weight: 700; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.pomo-label; color: Theme.text-dim; font-size: 12px; vertical-alignment: bottom; horizontal-alignment: right; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.pomo-progress, 0, 1);
            height: parent.height;
            border-radius: 3px;
            background: root.pomo-rest ? Theme.ok : Theme.accent;
            animate width { duration: 500ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 18px;
        RoundButton { outline: true; size: 38px; commands: Icons.reset; clicked => { root.reset(); } }
        RoundButton {
            primary: true;
            size: 44px;
            commands: root.pomo-running ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
            clicked => { root.toggle(); }
        }
        RoundButton { size: 38px; commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.skip(); } }
    }
}

component StatsPage inherits VerticalLayout {
    in property <float> cpu;
    in property <float> ram;
    in property <float> disk;
    in property <string> cpu-text;
    in property <string> ram-text;
    in property <string> disk-text;
    in property <string> net-text;
    in property <string> sys-text;
    alignment: center;
    spacing: 7px;
    padding-left: 28px;
    padding-right: 28px;
    StatBar { label: "CPU"; value: root.cpu; text: root.cpu-text; }
    StatBar { label: "RAM"; value: root.ram; text: root.ram-text; }
    StatBar { label: "Penyimpanan"; value: root.disk; text: root.disk-text; }
    HorizontalLayout {
        Text { text: root.net-text; color: Theme.text-dim; font-size: 11px; horizontal-stretch: 1; }
        Text { text: root.sys-text; color: Theme.text-faint; font-size: 11px; horizontal-alignment: right; }
    }
}

component BatteryPage inherits VerticalLayout {
    in property <bool> present: true;
    in property <int> percent: 0;
    in property <bool> charging: false;
    alignment: start;
    spacing: 8px;
    padding-left: 28px;
    padding-right: 28px;
    if !root.present: Text {
        text: "Tidak ada baterai (PC desktop)";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
    }
    if root.present: HorizontalLayout {
        Text {
            text: root.percent + "%";
            color: root.percent <= 20 && !root.charging ? #ff6b6b : Theme.text;
            font-size: 44px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.charging ? "Sedang mengisi" : "Tidak mengisi";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: bottom;
            horizontal-alignment: right;
        }
    }
    if root.present: Rectangle {
        width: parent.width;
        height: 10px;
        border-radius: 5px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            height: parent.height;
            border-radius: 5px;
            background: root.charging ? #ffd23f : (root.percent <= 20 ? #ff6b6b : Theme.ok);
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component WeatherPage inherits HorizontalLayout {
    in property <string> city;
    in property <string> temperature;
    in property <string> condition;
    in property <string> feels;
    in property <string> humidity;
    in property <string> rain;
    in property <string> icon;
    in property <string> status;
    callback refresh();

    padding-left: 26px;
    padding-right: 26px;
    padding-top: 12px;
    padding-bottom: 10px;
    spacing: 18px;

    VerticalLayout {
        width: 176px;
        alignment: center;
        spacing: 3px;
        Text { text: root.city; color: Theme.text-dim; font-size: 12px; horizontal-alignment: center; }
        Text { text: root.temperature; color: Theme.text; font-size: 42px; font-weight: 700; horizontal-alignment: center; }
        Text { text: root.condition; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
    }

    Rectangle {
        width: 1px;
        background: Theme.track;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 7px;
        Text { text: root.feels; color: Theme.text; font-size: 13px; }
        Text { text: root.humidity; color: Theme.text-dim; font-size: 12px; }
        Text { text: root.rain; color: Theme.accent; font-size: 12px; font-weight: 600; }
        Chip { label: "Perbarui cuaca"; clicked => { root.refresh(); } }
        Text {
            text: root.status;
            color: #ff9b8f;
            font-size: 10px;
            wrap: word-wrap;
            visible: root.status != "";
        }
    }

    Path {
        width: 42px;
        height: 42px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: Theme.text;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        visible: root.icon != "";
    }
}

component ShelfPage inherits VerticalLayout {
    in property <[ShelfItem]> items;
    in property <string> status: "File yang disimpan di sini tidak disalin";
    callback add();
    callback open(string);
    callback reveal(string);
    callback remove(string);
    callback clear();
    padding-left: 12px; padding-right: 12px; padding-top: 6px; spacing: 6px;
    HorizontalLayout {
        Text { text: "Shelf"; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-stretch: 1; }
        Chip { label: "Tambah file"; clicked => { root.add(); } }
        Chip { label: "Bersihkan"; clicked => { root.clear(); } }
    }
    Text { text: root.status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
    if root.items.length == 0: Text { text: "Belum ada file. Tambahkan file atau folder untuk menyimpannya di Shelf."; color: Theme.text-faint; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    for item in root.items: Rectangle {
        height: 44px; border-radius: 9px; background: #ffffff0b;
        HorizontalLayout {
            padding-left: 8px; padding-right: 6px; spacing: 5px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 2px;
                Text { text: item.dir ? "📁 " + item.name : "📄 " + item.name; color: Theme.text; font-size: 10px; overflow: elide; }
                Text { text: item.path; color: Theme.text-faint; font-size: 8px; overflow: elide; }
            }
            Chip { label: "Buka"; clicked => { root.open(item.path); } }
            Chip { label: "Lokasi"; clicked => { root.reveal(item.path); } }
            RoundButton { size: 22px; commands: Icons.close; outline: true; clicked => { root.remove(item.path); } }
        }
    }
}
component NotesPage inherits VerticalLayout {
    in property <[NoteItem]> notes;
    in property <[ShelfItem]> shelf-items;
    in property <string> shelf-status: "File yang disimpan di sini tidak disalin";
    callback add(string);
    callback remove(string);
    padding-left: 24px;
    padding-right: 24px;
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        height: 30px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 15px;
            background: Theme.chip;
            input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    root.add(self.text);
                    self.text = "";
                }
            }
            if input.text == "": Text {
                x: 12px;
                text: "Tulis catatan lalu Enter...";
                color: Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
        Chip { label: "Tambah"; clicked => { root.add(input.text); input.text = ""; } }
    }

    if root.notes.length == 0: Text {
        text: "Belum ada catatan";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for n in root.notes: HorizontalLayout {
        height: 24px;
        spacing: 6px;
        Text { text: n.text; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        RoundButton { size: 24px; commands: Icons.close; outline: true; clicked => { root.remove(n.id); } }
    }
}

component ReminderPage inherits VerticalLayout {
    in property <[ReminderItem]> items;
    in property <bool> alert-visible: false;
    in property <string> alert-text;
    in property <string> alert-sub;
    in property <string> status;
    in property <int> weekdays-mask: 62;
    in property <[bool]> weekday-selected;
    in-out property <string> draft;
    in-out property <string> date-time;
    in-out property <string> repeat-mode: "none";
    callback add(string, string, string, int);
    callback toggle(string);
    callback remove(string);
    callback clear-done();
    callback stop-alert();
    callback snooze-alert();
    callback toggle-weekday(int);

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 2px;
    spacing: 3px;

    if root.alert-visible: Rectangle {
        height: 34px;
        border-radius: 11px;
        background: #d9770628;
        border-width: 1px;
        border-color: #f59e0b88;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 5px;
            spacing: 4px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: root.alert-text; color: Theme.text; font-size: 11px; font-weight: 700; overflow: elide; }
                Text { text: root.alert-sub; color: Theme.text-dim; font-size: 9px; overflow: elide; }
            }
            Chip { label: "Tunda"; clicked => { root.snooze-alert(); } }
            Chip { label: "Selesai"; selected: true; clicked => { root.stop-alert(); } }
        }
    }

    HorizontalLayout {
        height: 26px;
        spacing: 5px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 13px;
            background: Theme.chip;
            input := TextInput {
                x: 9px;
                width: parent.width - 18px;
                text <=> root.draft;
                color: Theme.text;
                font-size: 11px;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); }
            }
            if input.text == "": Text {
                x: 9px;
                text: "Ingatkan aku untuk…";
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        Chip { label: "Tambah"; clicked => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); } }
        Chip { label: "Bersih"; clicked => { root.clear-done(); } }
    }

    HorizontalLayout {
        height: 24px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 12px;
            background: Theme.chip;
            dt := TextInput {
                x: 8px;
                width: parent.width - 16px;
                text <=> root.date-time;
                color: Theme.text;
                font-size: 10px;
                vertical-alignment: center;
                single-line: true;
            }
            if dt.text == "": Text {
                x: 8px;
                text: "DD/MM/YYYY HH:MM (opsional)";
                color: Theme.text-faint;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
        Chip { label: "Sekali"; selected: root.repeat-mode == "none"; clicked => { root.repeat-mode = "none"; } }
        Chip { label: "Harian"; selected: root.repeat-mode == "daily"; clicked => { root.repeat-mode = "daily"; } }
        Chip { label: "Mingguan"; selected: root.repeat-mode == "weekly"; clicked => { root.repeat-mode = "weekly"; } }
        Chip { label: "Bulanan"; selected: root.repeat-mode == "monthly"; clicked => { root.repeat-mode = "monthly"; } }
    }

    if root.status != "": Text {
        text: root.status;
        color: Theme.text-dim;
        font-size: 9px;
        horizontal-alignment: left;
        height: 13px;
    }

    if root.repeat-mode == "weekly": HorizontalLayout {
        height: 20px;
        spacing: 3px;
        for day[idx] in ["Min", "Sen", "Sel", "Rab", "Kam", "Jum", "Sab"]: Chip {
            label: day;
            selected: root.weekday-selected[idx];
            clicked => { root.toggle-weekday(idx); }
        }
    }

    if root.items.length == 0: Text {
        text: "Belum ada pengingat";
        color: Theme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
    }
    for item in root.items: HorizontalLayout {
        height: 20px;
        spacing: 4px;
        opacity: item.done ? 0.5 : 1;
        Text { text: item.text; color: Theme.text; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: item.due; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
        RoundButton {
            size: 18px;
            commands: item.done ? Icons.reset : "M 4 12 L 9 17 L 20 6";
            outline: true;
            clicked => { root.toggle(item.id); }
        }
        RoundButton { size: 18px; commands: Icons.close; outline: true; clicked => { root.remove(item.id); } }
    }
}

component ClipboardPage inherits VerticalLayout {
    in property <[ClipboardItem]> items;
    in property <bool> available: true;
    callback copy(string);
    callback clear();
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px;
    padding-bottom: 4px;
    spacing: 3px;

    HorizontalLayout {
        height: 26px;
        Text {
            text: "Terakhir disalin";
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Chip { label: "Bersihkan"; clicked => { root.clear(); } }
    }

    if !root.available: Text {
        text: "Clipboard tidak tersedia";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.available && root.items.length == 0: Text {
        text: "Belum ada riwayat salin";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for item in root.items: HorizontalLayout {
        height: 24px;
        spacing: 8px;
        Text {
            text: item.preview;
            color: Theme.text;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        RoundButton {
            size: 22px;
            commands: Icons.copy;
            outline: true;
            clicked => { root.copy(item.text); }
        }
    }
}

component QuickButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    in property <bool> na;              // tidak didukung / belum terbaca
    in property <bool> soft: false;     // gaya aksen lembut (tombol aksi seperti "Pusatkan")
    callback clicked;
    horizontal-stretch: 1;
    height: 84px;
    border-radius: 22px;
    opacity: na ? 0.4 : 1;
    background: on ? Theme.accent : (soft ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.chip-hover : Theme.chip));
    animate background { duration: 140ms; }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: 22px;
                height: 22px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.label;
            color: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { enabled: !root.na; clicked => { root.clicked(); } }
}

// Nilai quick: -1 = tidak didukung/belum terbaca, 0 = false, 1 = true (aturan sama dengan quick-stats.ts)
global QuickText {
    pure public function label(v: int, name: string, t: string, f: string) -> string {
        return v < 0 ? name : (v == 1 ? t : f);
    }
}

component QuickPage inherits HorizontalLayout {
    in property <int> mic: -1;
    in property <int> wifi: -1;
    in property <int> bt: -1;
    callback toggle(string);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 14px;
    padding-bottom: 6px;
    spacing: 14px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.mic; label: QuickText.label(root.mic, "Mic", "Mic mati", "Mic aktif"); on: root.mic == 1; na: root.mic < 0; clicked => { root.toggle("mic"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.wifi; label: QuickText.label(root.wifi, "Wi-Fi", "Wi-Fi on", "Wi-Fi off"); on: root.wifi == 1; na: root.wifi < 0; clicked => { root.toggle("wifi"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.bluetooth; label: QuickText.label(root.bt, "Bluetooth", "Bluetooth on", "Bluetooth off"); on: root.bt == 1; na: root.bt < 0; clicked => { root.toggle("bt"); } }
}

component ToolsPage inherits HorizontalLayout {
    in property <int> awake: -1;
    in property <int> dark: -1;
    callback toggle(string);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 14px;
    padding-bottom: 6px;
    spacing: 12px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.awake; label: QuickText.label(root.awake, "Keep awake", "Awake: ON", "Awake: OFF"); on: root.awake == 1; na: root.awake < 0; clicked => { root.toggle("awake"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.moon; label: QuickText.label(root.dark, "Tema", "Gelap", "Terang"); on: root.dark == 1; na: root.dark < 0; clicked => { root.toggle("dark"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.lock; label: "Kunci"; clicked => { root.toggle("lock"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.center; label: "Pusatkan"; soft: true; clicked => { root.toggle("center"); } }
}

component SpeechBubble inherits Rectangle {
    in property <string> message;
    in property <string> detail;
    in property <bool> bottom: false;
    in property <bool> side: false;
    in property <bool> side-right: false;
    height: 90px;
    width: 280px;
    border-radius: 23px;
    background: #08090df5;
    border-width: 0px;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        Text {
            width: parent.width;
            height: 30px;
            text: root.message;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: clip;
        }
        Text {
            width: parent.width;
            height: 28px;
            text: root.detail;
            color: #c7c9d1;
            font-size: 11px;
            wrap: word-wrap;
            overflow: clip;
        }
    }
    Path {
        x: root.side ? (root.side-right ? parent.width - 1px : -7px) : (parent.width - 20px) / 2;
        y: root.side ? (parent.height - 18px) / 2 : (root.bottom ? -1px : parent.height - 1px);
        width: root.side ? 9px : 20px;
        height: root.side ? 18px : 13px;
        viewbox-width: root.side ? 9 : 20;
        viewbox-height: root.side ? 18 : 13;
        commands: root.side ? (root.side-right ? "M 0 0 L 9 9 L 0 18 Z" : "M 9 0 L 0 9 L 9 18 Z")
            : (root.bottom ? "M 0 13 L 10 0 L 20 13 Z" : "M 0 0 L 10 13 L 20 0 Z");
        fill: #08090df5;
        stroke: #08090df5;
        stroke-width: 1px;
    }
}

component PageToggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback toggled(bool);
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: checked ? Theme.accent.with-alpha(0.55) : (ta.has-hover ? Theme.text-dim.with-alpha(0.45) : Theme.chip);
    background: checked ? Theme.accent.with-alpha(0.16) : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 9px;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border-width: 1px;
            border-color: checked ? Theme.accent : Theme.text-faint;
            background: checked ? Theme.accent : transparent;
            animate background { duration: 120ms; }
            Text { text: checked ? "✓" : ""; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: root.label; color: Theme.text; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    ta := TouchArea { clicked => { root.toggled(!root.checked); } }
}

component SettingsPage inherits VerticalLayout {
    in property <[string]> active-pages;
    in property <string> shortcut-hub;
    in property <string> shortcut-settings;
    in property <string> shortcut-pomodoro;
