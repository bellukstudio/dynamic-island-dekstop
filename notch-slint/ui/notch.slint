    // Hub melebar (780 x 540) saat Mode Ramadan aktif di halaman shalat, seperti `ramadan-expanded` di Tauri.
    property <bool> prayer-wide: root.expanded && root.page-id == "prayer" && root.ramadan-enabled;
    in property <bool> ramadan-enabled: false;
    in property <string> ramadan-date: "";
