    in property <string> pomodoro-break: "5";
    in property <string> pomodoro-long-break: "15";
    in property <string> pomodoro-rounds: "4";
    in property <string> behavior-scale: "1.00";
    in property <string> behavior-hover-open: "150";
    in property <string> behavior-hover-close: "450";
    in property <string> behavior-sleep-after: "60";
    in property <bool> behavior-hide-fullscreen: true;
    in property <bool> autostart-enabled: false;
    in property <string> autostart-save-status: "";
