    out property <string> compress: "M 4 4 L 10 10 M 4 4 V 9 M 4 4 H 9 M 20 4 L 14 10 M 20 4 V 9 M 20 4 H 15 M 4 20 L 10 14 M 4 20 V 15 M 4 20 H 9 M 20 20 L 14 14 M 20 20 V 15 M 20 20 H 15";
    out property <string> currency: "M 16 8 C 15 6 9 6 8 9 C 7 12 17 11 16 15 C 15 18 9 18 8 16 M 12 5 V 19";
    out property <string> currency-exchange: "M 7 7 H 20 L 17 4 M 20 7 L 17 10 M 17 17 H 4 L 7 20 M 4 17 L 7 14 M 12 3 V 21";
    out property <string> eyes: "M 2 12 C 4 7 8 7 12 12 C 16 7 20 7 22 12 C 20 17 16 17 12 12 C 8 17 4 17 2 12 Z";
    out property <string> chat: "M 3 4 H 21 V 16 H 10 L 5 20 V 16 H 3 Z";
    out property <string> settings: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 5 M 12 19 V 22 M 2 12 H 5 M 19 12 H 22 M 5 5 L 7 7 M 17 17 L 19 19 M 19 5 L 17 7 M 7 17 L 5 19";
    out property <string> test: "M 12 3 V 21 M 4 7.5 L 20 16.5 M 20 7.5 L 4 16.5";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> camera: "M 3 8 A 2 2 0 0 1 5 6 H 7.5 L 9 4 H 15 L 16.5 6 H 19 A 2 2 0 0 1 21 8 V 18 A 2 2 0 0 1 19 20 H 5 A 2 2 0 0 1 3 18 Z M 8.5 13 A 3.5 3.5 0 1 0 15.5 13 A 3.5 3.5 0 1 0 8.5 13";
    // Ikon lencana privasi (setara SVG di index.html Tauri), digambar gelap di dalam lencana berwarna.
    out property <string> badge-cam: "M 4 8 H 7 L 9 5 H 15 L 17 8 H 20 V 19 H 4 Z M 8.5 13 A 3.5 3.5 0 1 0 15.5 13 A 3.5 3.5 0 1 0 8.5 13";
    out property <string> badge-mic: "M 9 6 A 3 3 0 0 1 15 6 V 11 A 3 3 0 0 1 9 11 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 V 21";
    out property <string> mic: "M 12 2 A 3 3 0 0 0 9 5 V 12 A 3 3 0 0 0 15 12 V 5 A 3 3 0 0 0 12 2 Z M 19 10 V 12 A 7 7 0 0 1 5 12 V 10 M 12 19 V 22";
    out property <string> wifi: "M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 20 L 12.1 20";
    out property <string> bluetooth: "M 7 7 L 17 17 L 12 22 V 2 L 17 7 L 7 17";
    out property <string> awake: "M 4 8 H 17 V 15 A 4 4 0 0 1 13 19 H 8 A 4 4 0 0 1 4 15 Z M 17 10 H 19 A 2 2 0 0 1 19 14 H 17 M 7 2 V 5 M 11 2 V 5";
    out property <string> moon: "M 21 12.8 A 9 9 0 1 1 11.2 3 A 7 7 0 0 0 21 12.8 Z";
    out property <string> lock: "M 5 11 H 19 V 21 H 5 Z M 8 11 V 7 A 4 4 0 0 1 16 7 V 11";
    out property <string> center: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 6 M 12 18 V 22 M 2 12 H 6 M 18 12 H 22";
    out property <string> reset: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 V 8 H 8";
    out property <string> copy: "M 8 4 H 16 A 2 2 0 0 1 18 6 V 18 A 2 2 0 0 1 16 20 H 8 A 2 2 0 0 1 6 18 V 6 A 2 2 0 0 1 8 4 Z M 4 16 H 3 A 2 2 0 0 1 1 14 V 4 A 2 2 0 0 1 3 2 H 13 A 2 2 0 0 1 15 4 V 5";
    out property <string> expand: "M 4 9 V 4 H 9 M 20 9 V 4 H 15 M 4 15 V 20 H 9 M 20 15 V 20 H 15";
    out property <string> refresh: "M 20 7 V 12 H 15 M 4 17 V 12 H 9 M 5.6 9 A 7 7 0 0 1 17.5 6 L 20 12 M 4 12 L 6.5 18 A 7 7 0 0 0 18.4 15";

    pure public function for-page(id: string) -> string {
        if id == "media" { return Icons.media; }
        if id == "clock" { return Icons.clock; }
        if id == "prayer" { return Icons.prayer; }
        if id == "weather" { return Icons.weather; }
        if id == "battery" { return Icons.battery; }
        if id == "shelf" { return Icons.shelf; }
        if id == "reminder" { return Icons.reminder; }
        if id == "notes" { return Icons.notes; }
        if id == "clipboard" { return Icons.clipboard; }
        if id == "timer" { return Icons.timer; }
        if id == "quick" { return Icons.grid; }
        if id == "tools" { return Icons.wrench; }
        if id == "stats" { return Icons.stats; }
        if id == "lyrics" { return Icons.lyrics; }
        if id == "privacy" { return Icons.privacy; }
        if id == "android" { return Icons.android; }
        if id == "transfer" { return Icons.transfer; }
        if id == "convert" { return Icons.convert; }
        if id == "compress" { return Icons.compress; }
        if id == "currency" { return Icons.currency; }
        if id == "settings" { return Icons.settings; }
        return Icons.test;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    // Ruang kiri/kanan teks. Default 0 agar chip lain tidak berubah ukuran; isi (mis. 14px) untuk tombol yang lebarnya mengikuti teks.
    in property <length> padding-x: 0px;
    callback clicked;
    height: 28px;
    min-width: 64px;
    preferred-width: label-text.preferred-width + 2 * root.padding-x;
    // Tanpa ini, preferred-width eksplisit membuat chip ikut menyerap sisa lebar HorizontalLayout (tombol jadi melebar).
    horizontal-stretch: 0;
    border-radius: 14px;
    background: root.selected ? Theme.accent.with-alpha(0.24) : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    label-text := Text {
        x: root.padding-x;
        width: parent.width - 2 * root.padding-x;
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked;
    // Menyusut otomatis kalau tab terlalu banyak untuk lebar pil (preferensi 30 px, minimum 20 px).
    preferred-width: 30px;
    min-width: 20px;
    max-width: 30px;
    height: 30px;
    border-radius: 10px;
    background: active ? Theme.accent.with-alpha(0.22) : (ta.has-hover ? Theme.chip : transparent);
    border-width: active ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.34);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: 7px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.active ? Theme.text : Theme.text-dim;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// "Telinga" cekung di sisi pil (radius 10 px seperti `--e` di position.css). Menyatukan notch dengan
// tepi layar: di atas saat menempel ke atas, di bawah (dibalik) saat menempel ke dasar layar.
component Ear inherits Path {
    // Telinga cekung 10 px x skala. `kind`: 0 = atas-kiri, 1 = atas-kanan, 2 = bawah-kiri, 3 = bawah-kanan
    // (dock atas / bawah), 4 = sisi-kiri atas, 5 = sisi-kiri bawah, 6 = sisi-kanan atas, 7 = sisi-kanan bawah.
    // Sudut terisi selalu yang menyentuh tepi layar dan badan notch; busur memakai pusat di sudut diagonalnya.
    // Telinga atas/bawah (kind 0..3) melebar 1 unit ke bawah badan pil: tepi pertemuan keduanya sama-sama di-anti-alias,
    // dan pada posisi/skala pecahan menyisakan celah 1 px berwarna latar. Tumpang-tindih (warna sama) menutupnya.
    // Telinga kanan (kind 1, 3) menggeser x induknya 1 unit ke kiri (lihat pemakaian di NotchWindow).
    in property <int> kind: 0;
    in property <float> s: 1.0;      // skala dari config (telinga 10 px x scale)
    property <bool> overlaps: kind <= 3;
    width: (overlaps ? 11px : 10px) * s;
    height: 10px * s;
    viewbox-width: overlaps ? 11 : 10;
    viewbox-height: 10;
    fill: Theme.body;
    commands: kind == 0 ? "M 0 0 L 11 0 L 11 10 L 10 10 A 10 10 0 0 0 0 0 Z"
            : kind == 1 ? "M 11 0 L 0 0 L 0 10 L 1 10 A 10 10 0 0 1 11 0 Z"
            : kind == 2 ? "M 0 10 L 11 10 L 11 0 L 10 0 A 10 10 0 0 1 0 10 Z"
            : kind == 3 ? "M 11 10 L 0 10 L 0 0 L 1 0 A 10 10 0 0 0 11 10 Z"
            : kind == 4 ? "M 0 0 L 0 10 L 10 10 A 10 10 0 0 1 0 0 Z"
            : kind == 5 ? "M 0 0 L 10 0 A 10 10 0 0 0 0 10 Z"
            : kind == 6 ? "M 10 0 L 10 10 L 0 10 A 10 10 0 0 0 10 0 Z"
            : "M 10 0 L 0 0 A 10 10 0 0 1 10 10 Z";
}

component StatBar inherits VerticalLayout {
    in property <string> label;
    in property <float> value;   // 0..100
    in property <string> text;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.text-dim; font-size: 11px; horizontal-stretch: 1; }
        Text { text: root.text; color: Theme.text; font-size: 11px; horizontal-alignment: right; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> commands;
    in property <length> size: 36px;
    in property <bool> primary: false;
    in property <bool> outline: false;   // ikon garis (tanpa isian)
    in property <float> icon-ratio: 0.42; // ukuran ikon relatif terhadap tombol
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? Theme.text : (ta.has-hover ? Theme.chip-hover : transparent);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * root.icon-ratio;
        height: root.size * root.icon-ratio;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: root.outline ? transparent : (root.primary ? Theme.body : Theme.text);
        stroke: root.primary ? Theme.body : Theme.text;
        stroke-width: root.outline ? 1.6px : 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component EqBars inherits HorizontalLayout {
    // Equalizer 4 batang (`.bars` di media.css): hanya bergerak saat media diputar.
    in property <bool> playing: false;
    in property <float> scale: 1.0;
    spacing: 3px * root.scale;
    alignment: end;
    for i in 4: Rectangle {
        width: 3px * root.scale;
        y: parent.height - self.height;
        height: root.playing
            ? (4px + 10px * Math.abs(Math.sin((animation-tick() / 520ms * 360 + i * 70) * 1deg))) * root.scale
            : 4px * root.scale;
        border-radius: 1.5px * root.scale;
        background: Theme.accent;
    }
}

component MediaPlayer inherits HorizontalLayout {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    callback open-lyrics;

    // Tata letak `.p-media` di Tauri: padding 4 26 14 20, jarak 14, cover 80x80 radius 16.
    padding-left: 20px;
    padding-right: 26px;
    padding-top: 4px;
    padding-bottom: 14px;
    spacing: 14px;

    VerticalLayout {
        width: 80px;
        alignment: center;
        Rectangle {
            width: 80px;
            height: 80px;
            border-radius: 16px;
            background: Theme.chip;
            clip: true;
            if root.has-art: Image { source: root.art; width: 80px; height: 80px; image-fit: cover; }
            if !root.has-art: Path {
                x: (parent.width - self.width) / 2;
                width: 32px;
                height: 32px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.media;
                fill: transparent;
                stroke: Theme.text-faint;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        alignment: space-between;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                Text { text: root.artist; color: Theme.text-dim; font-size: 12px; overflow: elide; }
            }
            EqBars { width: 24px; height: 14px; playing: root.playing; visible: root.playing; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.pos-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                height: 14px;
                background: transparent;
                Rectangle {
                    x: 0px;
                    y: 5px;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, Theme.accent.with-alpha(0.55), Theme.accent);
                    }
                    // Knob muncul saat hover (seperti #m-progress::after)
                    Rectangle {
                        x: parent.width * clamp(root.progress, 0, 1) - 4px;
                        y: -2px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.text;
                        visible: seek-area.has-hover || seek-area.pressed;
                    }
                }
                seek-area := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); }
                    moved => { if self.pressed { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); } }
                }
            }
            Text { text: root.dur-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            RoundButton { size: 28px; icon-ratio: 0.62; commands: "M 19 20 L 9 12 L 19 4 Z M 5 19 V 5"; clicked => { root.prev(); } }
            RoundButton {
                primary: true;
                size: 34px;
                icon-ratio: 0.5;
                commands: root.playing ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
                clicked => { root.toggle(); }
            }
            RoundButton { size: 28px; icon-ratio: 0.62; commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.next(); } }
            // Tombol lirik berupa ikon garis (#m-lyrics), bukan chip bertuliskan "Lirik"
            RoundButton { size: 28px; icon-ratio: 0.6; outline: true; opacity: 0.6; commands: "M 4 6 H 20 M 4 12 H 14 M 4 18 H 17"; clicked => { root.open-lyrics(); } }
        }
    }
}

component LyricsPanel inherits Rectangle {
    in property <[string]> lines;
    in property <int> active: -1;
    callback back;
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 28px;
            alignment: start;
            Chip { label: "\u{2039} Media"; min-width: 76px; clicked => { root.back(); } }
            Text { text: "Lirik"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
        }
        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: "Lirik belum tersedia untuk lagu ini";
                color: Theme.text-faint;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-y: max(0px, root.active * 36px - self.height / 2 + 18px);
            content-width: self.width;
            content-height: max(self.height, root.lines.length * 36px);
            VerticalLayout {
                width: parent.width;
                spacing: 0px;
                for line[i] in root.lines: Rectangle {
                    height: 36px;
                    background: i == root.active ? Theme.chip : transparent;
                    border-radius: 9px;
                    Text {
                        text: line;
                        width: parent.width - 16px;
                        x: 8px;
                        y: 0px;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-alignment: center;
                        font-size: i == root.active ? 18px : 13px;
                        font-weight: i == root.active ? 700 : 400;
                        color: i == root.active ? Theme.text : Theme.text-faint;
                    }
                }
            }
        }
    }
}

// Halaman Media: pemutar + panel lirik di dalamnya (tombol "Lirik" membuka, "Media" kembali).
component MediaPage inherits Rectangle {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    in property <[string]> lyric-lines;
    in property <int> lyric-active: -1;
    in-out property <bool> lyrics-open: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    MediaPlayer {
        width: parent.width;
        height: parent.height;
        visible: !root.lyrics-open;
        art: root.art; has-art: root.has-art; title: root.title; artist: root.artist;
        pos-text: root.pos-text; dur-text: root.dur-text; progress: root.progress; playing: root.playing;
        prev => { root.prev(); } toggle => { root.toggle(); } next => { root.next(); }
        seek(v) => { root.seek(v); }
        open-lyrics => { root.lyrics-open = true; }
    }
    if root.lyrics-open: LyricsPanel {
        lines: root.lyric-lines;
        active: root.lyric-active;
        back => { root.lyrics-open = false; }
    }
}

component ClockPage inherits HorizontalLayout {
    in property <string> clock-text;   // HH:MM
    in property <string> sec-text;     // detik (`#ck-sec`)
    in property <string> day-text;     // nama hari
    in property <string> date-text;    // tanggal lengkap
    callback open-calendar;
    // `.p-clock`: padding 0 34 0 26, jam 46px di kiri (detik 16px redup), hari + tanggal di kanan.
    padding-left: 26px;
    padding-right: 34px;
    spacing: 16px;
    alignment: stretch;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text { text: root.clock-text; color: Theme.text; font-size: 46px; font-weight: 700; letter-spacing: -1px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            padding-top: 14px;
            Text { text: root.sec-text; color: Theme.text-faint; font-size: 16px; }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    // Klik tanggal membuka kalender bulanan (seperti di Tauri)
    Rectangle {
        width: 190px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: root.day-text; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: right; }
            Text { text: root.date-text; color: da.has-hover ? Theme.text : Theme.text-dim; font-size: 12px; horizontal-alignment: right; }
        }
        da := TouchArea { clicked => { root.open-calendar(); } }
    }
}

// Satu hari di kisi kalender. Warna: hari ini = isi aksen, libur = merah, cuti bersama = oranye,
// hari peringatan = titik kecil aksen. Hari yang dipilih diberi cincin.
component CalDay inherits Rectangle {
    in property <CalCell> c;
    callback clicked;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    // jenis terpenting menentukan warna: libur > cuti > peringatan
    background: c.today ? Theme.accent
        : c.in-month && c.kind == 1 ? #ff6b6b26
        : c.in-month && c.kind == 2 ? #ffb34026
        : (ta.has-hover && c.in-month ? Theme.chip : transparent);
    border-width: c.sel ? 1.5px : 0px;
    border-color: c.today ? Theme.text : Theme.accent;
    animate background { duration: 100ms; }
    Text {
        text: "\{c.day}";
        font-size: 12px;
        font-weight: c.today || c.sel || (c.in-month && (c.kind == 1 || c.kind == 2)) ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: c.today ? Theme.on-accent
            : !c.in-month ? Theme.text-faint
            : c.kind == 1 ? #ff6b6b
            : c.kind == 2 ? #ffb340
            : c.sun ? #ff7a7a : Theme.text;
    }
    // titik kecil di bawah angka untuk hari peringatan
    Rectangle {
        visible: c.kind == 3 && c.in-month;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: c.today ? Theme.on-accent : Theme.accent;
        x: (parent.width - self.width) / 2;
        y: parent.height - 4px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Kalender bulanan: kisi 7 x 6 di kiri, kartu ringkasan (bulan, navigasi, keterangan tanggal) di kanan.
// Area halaman hub 580 x 148 px, jadi kisi memakai baris 21 px agar seluruh 6 minggu muat.
component CalendarPage inherits Rectangle {
    in property <[CalCell]> cells;
    in property <[string]> weekdays;
    in property <string> title;
    in property <string> foot-date;
    in property <string> foot-name;
    in property <int> foot-kind;
    callback prev;
    callback next;
    callback today;
    callback select(int);
    callback close;

    property <length> grid-x: 20px;
    property <length> pitch-x: 38px;
    property <length> pitch-y: 21px;
    property <length> card-x: 308px;
    property <color> kind-color: root.foot-kind == 1 ? #ff6b6b
        : root.foot-kind == 2 ? #ffb340
        : root.foot-kind == 3 ? Theme.accent : Theme.text-faint;

    // Nama hari + garis pemisah
    for wd[i] in root.weekdays: Text {
        x: root.grid-x + i * root.pitch-x;
        y: 0px;
        width: 36px;
        height: 14px;
        text: wd;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: i == 0 ? #ff7a7a : Theme.text-faint;
    }
    Rectangle {
        x: root.grid-x;
        y: 15px;
        width: 6 * root.pitch-x + 36px;
        height: 1px;
        background: Theme.track;
    }
    for cell[i] in root.cells: CalDay {
        x: root.grid-x + Math.mod(i, 7) * root.pitch-x;
        y: 19px + Math.floor(i / 7) * root.pitch-y;
        c: cell;
        clicked => { root.select(i); }
    }

    // Kartu ringkasan di kanan
    Rectangle {
        x: root.card-x;
        y: 0px;
        width: parent.width - root.card-x - 20px;
        height: 144px;
        border-radius: 14px;
        background: Theme.text.with-alpha(0.06);
        VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            spacing: 4px;
            HorizontalLayout {
                height: 24px;
                spacing: 6px;
                Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                RoundButton { size: 24px; outline: true; commands: Icons.close; clicked => { root.close(); } }
            }
            HorizontalLayout {
                height: 26px;
                spacing: 6px;
                alignment: start;
                RoundButton { size: 26px; outline: true; commands: "M 15 5 L 8 12 L 15 19"; clicked => { root.prev(); } }
                RoundButton { size: 26px; outline: true; commands: "M 9 5 L 16 12 L 9 19"; clicked => { root.next(); } }
                Chip { label: "Hari ini"; height: 26px; selected: true; clicked => { root.today(); } }
            }
            Rectangle { height: 1px; background: Theme.track; }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                padding-top: 4px;
                Rectangle { width: 3px; border-radius: 1.5px; background: root.kind-color; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: start;
                    Text { text: root.foot-date; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                    Text { text: root.foot-name; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; max-height: 36px; overflow: elide; }
                }
            }
        }
    }
}

component TimerPage inherits VerticalLayout {
    in property <string> pomo-text;
    in property <string> pomo-label;
    in property <float> pomo-progress;   // 0..1
    in property <bool> pomo-running;
    in property <bool> pomo-rest;
    callback toggle;
    callback reset;
    callback skip;
    // `.p-timer`: padding 0 34 20 26, jarak 8, tengah vertikal; waktu 38px, bar 5px, tombol 30/36.
    alignment: center;
    spacing: 8px;
    padding-left: 26px;
    padding-right: 34px;
    padding-bottom: 20px;

    HorizontalLayout {
        Text { text: root.pomo-text; color: Theme.text; font-size: 38px; font-weight: 700; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.pomo-label; color: Theme.text-dim; font-size: 12px; vertical-alignment: bottom; horizontal-alignment: right; }
    }
    Rectangle {
        height: 5px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.pomo-progress, 0, 1);
            height: parent.height;
            border-radius: 3px;
            background: root.pomo-rest ? Theme.ok : Theme.accent;
            animate width { duration: 500ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        padding-top: 4px;
        RoundButton { outline: true; size: 30px; icon-ratio: 0.55; commands: Icons.reset; clicked => { root.reset(); } }
        RoundButton {
            primary: true;
            size: 36px;
            icon-ratio: 0.5;
            commands: root.pomo-running ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
            clicked => { root.toggle(); }
        }
        RoundButton { size: 30px; icon-ratio: 0.55; commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.skip(); } }
    }
}

component StatMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> meta;
    in property <float> value;        // 0..100
    in property <float> hot-at: 90;   // di atas ini bar merah (`.hot`)
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    spacing: 2px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: root.label; color: Theme.text-dim; font-size: 11px; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.value-text; color: Theme.text; font-size: 11px; font-weight: 700; horizontal-alignment: right; }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: parent.height;
            border-radius: 2px;
            background: root.value >= root.hot-at ? #ff626b : Theme.accent;
            animate width { duration: 550ms; easing: ease-out; }
        }
    }
    Text { text: root.meta; color: Theme.text-faint; font-size: 9px; overflow: elide; preferred-width: 0px; min-width: 0px; }
}



component StatsPage inherits VerticalLayout {
    in property <StatsView> d;
    // `.p-stats`: padding 3 26 8, jarak 4; kepala, grid 2x2 (CPU/RAM/SWAP/PENYIMPANAN), footer 3 baris.
    spacing: 4px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 3px;
    padding-bottom: 8px;
    HorizontalLayout {
        spacing: 10px;
        Text { text: "STATUS SISTEM"; color: Theme.text-dim; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; }
        Text { text: root.d.host; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
    }
    GridLayout {
        spacing-horizontal: 18px;
        spacing-vertical: 4px;
        Row {
            StatMetric { label: "CPU"; value: root.d.cpu; value-text: root.d.cpu-v; meta: root.d.cpu-meta; hot-at: 85; }
            StatMetric { label: "RAM"; value: root.d.ram; value-text: root.d.ram-v; meta: root.d.ram-meta; }
        }
        Row {
            StatMetric { label: "SWAP"; value: root.d.swap; value-text: root.d.swap-v; meta: root.d.swap-meta; }
            StatMetric { label: "PENYIMPANAN"; value: root.d.disk; value-text: root.d.disk-v; meta: root.d.disk-meta; }
        }
    }
    Rectangle { vertical-stretch: 1; }
    VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            Text { text: root.d.down; color: Theme.text-dim; font-size: 10px; horizontal-stretch: 1; }
            Text { text: root.d.up; color: Theme.text-dim; font-size: 10px; horizontal-alignment: right; }
        }
        HorizontalLayout {
            Text { text: root.d.processes; color: Theme.text-faint; font-size: 10px; horizontal-stretch: 1; }
            Text { text: root.d.uptime; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; }
        }
        HorizontalLayout {
            spacing: 12px;
            Text { text: root.d.os; color: Theme.text-faint; font-size: 10px; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.d.kernel; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; overflow: elide; }
        }
    }
}

component BatteryPage inherits VerticalLayout {
    in property <bool> present: true;
    in property <int> percent: 0;
    in property <bool> charging: false;
    // `.p-battery`: padding 0 34 0 26, jarak 14, tengah vertikal; persen 34px, bar 8px.
    alignment: center;
    spacing: 14px;
    padding-left: 26px;
    padding-right: 34px;
    if !root.present: Text {
        text: "Tidak ada baterai (PC desktop)";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
    }
    if root.present: HorizontalLayout {
        Text {
            text: root.percent + "%";
            color: root.percent <= 20 && !root.charging ? #ff8a8a : Theme.text;
            font-size: 34px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.charging ? "Sedang mengisi" : "Tidak mengisi";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: bottom;
            horizontal-alignment: right;
        }
    }
    if root.present: Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: root.charging ? #ffd60a : (root.percent <= 20 ? #ff8a8a : #7dffb0);
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component WeatherPage inherits HorizontalLayout {
    in property <string> city;
    in property <string> temperature;
    in property <string> condition;
    in property <string> feels;
    in property <string> humidity;
    in property <string> rain;
    in property <string> icon;
    in property <string> status;
    callback refresh();

    // `.p-weather`: ikon bulat 58px (klik = perbarui), suhu 34px + kondisi 12px, meta rata kanan.
    padding-left: 26px;
    padding-right: 34px;
    spacing: 16px;

    VerticalLayout {
        width: 58px;
        alignment: center;
        Rectangle {
            width: 58px;
            height: 58px;
            border-radius: 29px;
            background: Theme.accent.with-alpha(0.16);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.34);
            Path {
                x: (parent.width - self.width) / 2;
                width: 30px;
                height: 30px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: Theme.text;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                visible: root.icon != "";
                y: (parent.height - self.height) / 2
                    + (root.condition == "Cerah" || root.condition == "Cerah (malam)"
                        ? 1.5px * Math.sin(animation-tick() / 650ms * 360deg)
                        : 2px * Math.sin(animation-tick() / 1100ms * 360deg));
            }
            // Detail bergerak sesuai fenomena: sinar berdenyut, tetes hujan turun, atau kilat berkedip.
            if root.condition == "Cerah": Path {
                x: 17px; y: 8px; width: 24px; height: 24px;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M 12 1 V 3 M 12 21 V 23 M 1 12 H 3 M 21 12 H 23 M 4 4 L 5.5 5.5 M 18.5 18.5 L 20 20 M 20 4 L 18.5 5.5 M 5.5 18.5 L 4 20";
                fill: transparent; stroke: #ffd166; stroke-width: 1.4px;
                opacity: 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(animation-tick() / 900ms * 360deg));
            }
            if root.condition == "Gerimis" || root.condition == "Hujan": Path {
                x: 17px; y: 32px + 5px * Math.mod(animation-tick() / 750ms, 1);
                width: 24px; height: 20px; viewbox-width: 24; viewbox-height: 20;
                commands: "M 5 1 L 3 7 M 12 1 L 10 7 M 19 1 L 17 7";
                fill: transparent; stroke: #75c9ff; stroke-width: 1.8px;
                stroke-line-cap: round;
            }
            if root.condition == "Badai petir": Path {
                x: 18px; y: 31px; width: 22px; height: 22px;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M 13 1 L 7 13 H 12 L 10 22 L 18 9 H 13 Z";
                fill: #ffd166; stroke: #ffd166; stroke-width: 1px;
                opacity: 0.25 + 0.75 * Math.abs(Math.sin(animation-tick() / 420ms * 360deg));
            }
            TouchArea { clicked => { root.refresh(); } }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.temperature; color: Theme.text; font-size: 34px; font-weight: 700; }
        Text { text: root.condition; color: Theme.text-dim; font-size: 12px; overflow: elide; }
        Text { text: root.status; color: #ff9b8f; font-size: 10px; wrap: word-wrap; visible: root.status != ""; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        min-width: 110px;
        Text { text: root.city; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-alignment: right; overflow: elide; }
        Text { text: root.feels; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
        Text { text: root.humidity; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
        Text { text: root.rain; color: Theme.accent; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
    }
}

// Shelf: header (judul, jumlah, Tambah, Kosongkan) + area drop / tile file yang bisa digulir.
// Area halaman 580 x 148 px: header 28 + area isi (min. 76) + satu baris petunjuk 12 muat tanpa meluber.
component ShelfPage inherits VerticalLayout {
    in property <[ShelfItem]> items;
    in property <string> status: "";
    in property <bool> dropping: false;
    callback add();
    callback open(string);
    callback reveal(string);
    callback drag(string);
    callback remove(string);
    callback clear();
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 4px;
    padding-bottom: 8px;
    spacing: 6px;

    HorizontalLayout {
        height: 28px;
        spacing: 8px;
        Text { text: "Shelf"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
        if root.items.length > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: count-text.preferred-width + 16px;
                height: 18px;
                border-radius: 9px;
                background: Theme.accent.with-alpha(0.18);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.34);
                count-text := Text {
                    text: root.items.length + "/30";
                    color: Theme.text;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Chip { label: "+ Tambah"; padding-x: 12px; clicked => { root.add(); } }
        if root.items.length > 0: Chip { label: "Kosongkan"; padding-x: 12px; clicked => { root.clear(); } }
    }

    if root.items.length == 0: Rectangle {
        vertical-stretch: 1;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.dropping ? Theme.accent : Theme.text-faint.with-alpha(0.35);
        background: root.dropping ? Theme.accent.with-alpha(0.13) : #ffffff08;
        animate background { duration: 140ms; }
        animate border-color { duration: 140ms; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: "⇩"; color: root.dropping ? Theme.accent : Theme.text-dim; font-size: 22px; horizontal-alignment: center; }
            Text { text: root.dropping ? "Lepaskan file di sini" : "Seret file ke notch"; color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
            Text { text: "atau klik area ini untuk memilih dari komputer"; color: Theme.text-faint; font-size: 9px; horizontal-alignment: center; }
        }
        TouchArea { clicked => { root.add(); } }
    }

    if root.items.length > 0: Rectangle {
        vertical-stretch: 1;
        border-radius: 12px;
        border-width: root.dropping ? 1px : 0px;
        border-color: Theme.accent;
        background: root.dropping ? Theme.accent.with-alpha(0.10) : #ffffff08;
        animate background { duration: 140ms; }
        // Tile 70 px diletakkan di tengah vertikal area ini (anak berukuran tetap di layout selalu menempel ke atas).
        Flickable {
            x: 6px;
            y: (parent.height - 70px) / 2;
            width: parent.width - 12px;
            height: 70px;
            HorizontalLayout {
                spacing: 8px;
                for item in root.items: Rectangle {
                        width: 58px; height: 70px; border-radius: 10px;
                        background: tile-area.has-hover ? Theme.chip-hover : #ffffff12;
                        animate background { duration: 120ms; }
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Text {
                                text: item.dir ? "📁" : (
                                    item.name.to-lowercase().ends-with(".png") || item.name.to-lowercase().ends-with(".jpg") || item.name.to-lowercase().ends-with(".jpeg") || item.name.to-lowercase().ends-with(".webp") ? "🖼️" :
                                    item.name.to-lowercase().ends-with(".mp3") || item.name.to-lowercase().ends-with(".wav") || item.name.to-lowercase().ends-with(".flac") ? "🎵" :
                                    item.name.to-lowercase().ends-with(".mp4") || item.name.to-lowercase().ends-with(".mkv") || item.name.to-lowercase().ends-with(".mov") ? "🎬" :
                                    item.name.to-lowercase().ends-with(".pdf") ? "📕" :
                                    item.name.to-lowercase().ends-with(".zip") || item.name.to-lowercase().ends-with(".rar") || item.name.to-lowercase().ends-with(".7z") ? "🗜️" : "📄");
                                font-size: 23px; horizontal-alignment: center;
                            }
                            Text { text: item.name; color: Theme.text; font-size: 9px; max-width: 50px; overflow: elide; horizontal-alignment: center; }
                        }
                        Rectangle {
                            x: 3px; y: 3px; width: 15px; height: 15px; border-radius: 8px;
                            background: #ffffff30;
                            Text { text: "×"; color: Theme.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.remove(item.path); } }
                        }
                        tile-area := TouchArea {
                            property <bool> drag-started: false;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { self.drag-started = false; }
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.reveal(item.path); }
                            }
                            moved => {
                                if (self.pressed && !self.drag-started && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) >= 6px) {
                                    self.drag-started = true;
                                    root.drag(item.path);
                                }
                            }
                            clicked => {
                                if (self.drag-started) { self.drag-started = false; } else { root.open(item.path); }
                            }
                        }
                }
            }
        }
    }

    // Petunjuk / status satu baris; tidak dirender saat kosong supaya tidak menyisakan celah.
    if root.items.length > 0 || root.dropping || root.status != "": Text {
        height: 12px;
        text: root.dropping ? "Lepaskan untuk menambahkan file ke Shelf" : (root.status != "" ? root.status : "Klik: buka  ·  Klik kanan: lokasi file  ·  Seret: keluarkan");
        color: root.dropping ? Theme.accent : Theme.text-faint;
        font-size: 9px;
        overflow: elide;
        vertical-alignment: center;
    }
}
component NoteIconButton inherits Rectangle {
    in property <string> commands;
    in property <string> badge: "";
    in property <bool> danger: false;
    in property <angle> turn: 0deg;
    callback clicked;
    border-radius: 9px;
    background: root.danger ? #ef4444 : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: Theme.text;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        transform-rotation: root.turn;
        opacity: ta.has-hover ? 1 : 0.82;
    }
    if root.badge != "": Rectangle {
        x: parent.width - self.width + 5px;
        y: -5px;
        width: max(13px, badge-text.preferred-width + 6px);
        height: 13px;
        border-radius: 7px;
        background: Theme.accent;
        badge-text := Text { text: root.badge; color: #000000; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NotesPage inherits VerticalLayout {
    in property <[NoteItem]> notes;
    in property <[ShelfItem]> shelf-items;
    in property <string> shelf-status: "File yang disimpan di sini tidak disalin";
    // Daftar catatan hanya tampil saat diperluas (hub ikut menjadi 300 px, seperti `notes-expanded` di Tauri).
    in-out property <bool> expanded: false;
    callback add(string);
    callback remove(string);
    callback open(string);
    callback clear();
    callback expand-toggled(bool);
    property <bool> confirm-clear: false;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 12px;
    padding-bottom: 14px;
    spacing: 8px;

    Timer { interval: 3s; running: root.confirm-clear; triggered => { root.confirm-clear = false; } }

    HorizontalLayout {
        height: 86px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 12px;
            background: input.has-focus ? Theme.chip-hover : Theme.chip;
            border-width: input.has-focus ? 1.5px : 0px;
            border-color: Theme.accent.with-alpha(0.55);
            FocusScope {
                // Enter menambah catatan, Shift+Enter baris baru (sama dengan #nt-input di Tauri).
                capture-key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) {
                        root.add(input.text);
                        input.text = "";
                        return accept;
                    }
                    return reject;
                }
                input := TextInput {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 28px;
                    height: parent.height - 20px;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
            if input.text == "": Text {
                x: 14px;
                y: 10px;
                text: "Tulis catatan baru\u{2026}";
                color: Theme.text-faint;
                font-size: 14px;
            }
        }
        VerticalLayout {
            width: 36px;
            spacing: 4px;
            NoteIconButton { commands: "M 12 5 V 19 M 5 12 H 19"; clicked => { root.add(input.text); input.text = ""; } }
            NoteIconButton {
                commands: root.expanded ? "M 6 15 L 12 9 L 18 15" : "M 6 9 L 12 15 L 18 9";
                clicked => { root.expanded = !root.expanded; root.expand-toggled(root.expanded); }
            }
            NoteIconButton {
                commands: "M 4 7 H 20 M 9 7 V 4 H 15 V 7 M 6 7 L 7 20 H 17 L 18 7 M 10 11 V 16 M 14 11 V 16";
                badge: root.notes.length > 0 ? root.notes.length : "";
                danger: root.confirm-clear;
                clicked => {
                    if (root.notes.length == 0) { return; }
                    if (root.confirm-clear) { root.confirm-clear = false; root.clear(); } else { root.confirm-clear = true; }
                }
            }
        }
    }

    if root.expanded && root.notes.length == 0: Text {
        text: "Belum ada catatan";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.expanded && root.notes.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: root.notes.length * 62px;
        VerticalLayout {
            width: parent.width;
            spacing: 6px;
            for n in root.notes: Rectangle {
                height: 56px;
                border-radius: 12px;
                background: card-ta.has-hover ? Theme.chip-hover : Theme.chip;
                // Klik kartu membuka jendela detail catatan (note-detail di Tauri).
                card-ta := TouchArea { clicked => { root.open(n.id); } }
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 30px;
                    padding-top: 7px;
                    padding-bottom: 6px;
                    spacing: 3px;
                    Text { text: n.text; color: Theme.text; font-size: 12.5px; wrap: word-wrap; overflow: elide; height: 34px; vertical-alignment: top; }
                    Text { text: n.meta; color: Theme.text-faint; font-size: 10px; overflow: elide; }
                }
                RoundButton {
                    x: parent.width - 28px;
                    y: 6px;
                    size: 20px;
                    commands: Icons.close;
                    outline: true;
                    clicked => { root.remove(n.id); }
                }
            }
        }
    }
}

component CurrencyPage inherits VerticalLayout {
    in property <CurrencyView> d;
    in-out property <string> amount;
    in property <[StockRow]> gainers;
    in property <[StockRow]> losers;
    in property <[CurrencyAlertItem]> alerts;
    in property <[CurrencyItem]> currencies;
    in property <[FxChartPoint]> chart-points;
    callback refresh();
    callback amount-edited(string);
    callback quick(int);
    callback step-target(int);
    callback add-alert(bool, string, bool, string, bool);
    callback remove-alert(string);
    callback chart-request(string, int);
    callback select-currency(string, int);
    in property <string> chart-line;
    in property <string> chart-area;
    in property <string> chart-status;
    in property <string> chart-max;
    in property <string> chart-y1;
    in property <string> chart-y2;
    in property <string> chart-min;
    in property <string> chart-date-start;
    in property <string> chart-date-mid;
    in property <string> chart-date-end;
    in property <float> chart-dot-y: 50;
    in property <string> chart-last;
    in property <string> chart-change;
    in property <bool> chart-up: true;
    property <bool> alert-mode: false;
    property <bool> above: true;
    property <bool> picker-open: false;
    property <bool> alert-stock-mode: false;
    property <string> alert-stock-code: "BBCA";
    property <string> alert-currency-code: "USD";
    property <string> alert-currency-name: "Dolar AS";
    property <bool> alert-repeat: false;
    // Mode diperluas tetap mempertahankan header, sama seperti halaman Currency Tauri.
    in-out property <bool> expanded: false;
    property <int> range: 0;
    function request-chart() { root.chart-request(root.d.code, [30, 90, 180, 365][root.range]); }

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 15px;
    padding-bottom: 18px;
    spacing: 14px;

    HorizontalLayout {
        height: 42px;
        spacing: 12px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.30);
            background: Theme.accent.with-alpha(0.16);
            Path {
                x: 9px; y: 9px; width: 22px; height: 22px;
                viewbox-width: 24; viewbox-height: 24;
                commands: Icons.currency-exchange;
                fill: transparent;
                stroke: Theme.text;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            alignment: center;
            spacing: 2px;
            Text { text: "Currency"; color: Theme.text; font-size: 17px; font-weight: 800; }
            Text { text: root.d.error != "" ? "Kurs belum tersedia" : (root.d.warning != "" ? root.d.warning : (root.d.updated != "" ? root.d.updated : (root.d.loading ? "Menyiapkan kurs referensi..." : "Kurs referensi"))); color: root.d.error != "" ? #ff9b8f : Theme.text-faint; font-size: 10px; overflow: elide; }
        }
        Rectangle {
            width: 40px;
            height: 34px;
            border-radius: 11px;
            background: root.alert-mode ? Theme.accent.with-alpha(0.2) : (at-ta.has-hover ? Theme.chip-hover : Theme.chip);
            border-width: 1px;
            border-color: root.alert-mode ? Theme.accent.with-alpha(0.7) : Theme.text-faint.with-alpha(0.16);
            Path {
                x: 11px; y: 9px; width: 16px; height: 16px;
                viewbox-width: 24; viewbox-height: 24;
                commands: Icons.reminder;
                fill: transparent; stroke: root.alert-mode ? Theme.accent : Theme.text;
                stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
            }
            if root.alerts.length > 0: Rectangle {
                x: 27px; y: -5px; width: 15px; height: 15px;
                border-radius: 8px; background: Theme.accent;
                Text { text: root.alerts.length > 9 ? "9+" : "" + root.alerts.length; color: #ffffff; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
            at-ta := TouchArea { clicked => {
                root.alert-mode = !root.alert-mode;
                if (root.alert-mode) {
                    root.expanded = false;
                    root.alert-stock-mode = false;
                    root.alert-currency-code = root.d.code;
                    root.alert-currency-name = root.d.name;
                    root.alert-repeat = false;
                }
                root.picker-open = false;
            } }
        }
        Rectangle {
            width: 86px;
            height: 34px;
            border-radius: 11px;
            border-width: 1px;
            border-color: root.expanded ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.13);
            background: root.expanded ? Theme.accent.with-alpha(0.18) : (ex-ta.has-hover ? Theme.text.with-alpha(0.12) : Theme.text.with-alpha(0.055));
            HorizontalLayout {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                spacing: 7px;
                alignment: center;
                Rectangle {
                    width: 14px; height: parent.height;
                    background: transparent;
                    Path {
                        x: 0px; y: (parent.height - 14px) / 2;
                        width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.expand;
                        fill: transparent; stroke: Theme.text;
                        stroke-width: 1.9px; stroke-line-cap: round; stroke-line-join: round;
                    }
                }
                Text { height: parent.height; text: root.expanded ? "Ringkas" : "Perluas"; color: Theme.text; font-size: 11px; font-weight: 650; vertical-alignment: center; }
            }
            ex-ta := TouchArea { clicked => { root.alert-mode = false; root.expanded = !root.expanded; root.picker-open = false; if (root.expanded) { root.request-chart(); } } }
        }
        Rectangle {
            width: 90px;
            height: 34px;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.13);
            background: refresh-ta.has-hover ? Theme.text.with-alpha(0.12) : Theme.text.with-alpha(0.055);
            HorizontalLayout {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                spacing: 7px;
                alignment: center;
                Rectangle {
                    width: 14px; height: parent.height;
                    background: transparent;
                    Path {
                        x: 0px; y: (parent.height - 14px) / 2;
                        width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.refresh;
                        fill: transparent; stroke: Theme.text;
                        stroke-width: 1.9px; stroke-line-cap: round; stroke-line-join: round;
                    }
                }
                Text { height: parent.height; text: "Perbarui"; color: Theme.text; font-size: 11px; font-weight: 650; vertical-alignment: center; }
            }
            refresh-ta := TouchArea { clicked => { root.refresh(); if (root.expanded) { root.request-chart(); } } }
        }
    }

    if !root.alert-mode && !root.expanded: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 14px;

        // Panel kiri: konverter Rupiah dengan dropdown mata uang dan nominal cepat.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: Theme.text.with-alpha(0.04);
            VerticalLayout {
                x: 16px; y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Konversi mata uang"; color: Theme.text; font-size: 13px; font-weight: 750; }
                        Text { text: "Hitung nilai Rupiah ke mata uang pilihan."; color: Theme.text.with-alpha(0.55); font-size: 10px; overflow: elide; }
                    }
                    Rectangle {
                        width: 90px;
                        height: 22px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: #43d9a02b;
                        background: #43d9a014;
                        HorizontalLayout {
                            x: 0px; y: 0px;
                            width: parent.width; height: parent.height;
                            padding-left: 8px; padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            Rectangle {
                                width: 11px; height: parent.height;
                                background: transparent;
                                Rectangle {
                                    x: 0px; y: (parent.height - 11px) / 2;
                                    width: 11px; height: 11px;
                                    border-radius: 6px;
                                    background: #43d9a01c;
                                    Rectangle {
                                        x: 3px; y: 3px;
                                        width: 5px; height: 5px;
                                        border-radius: 3px;
                                        background: #68dfb1;
                                    }
                                }
                            }
                            Text {
                                height: parent.height;
                                text: "Kurs referensi";
                                color: #68dfb1;
                                font-size: 9px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 66px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        spacing: 6px;
                        Text { text: "Jumlah Rupiah (IDR)"; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; }
                        Rectangle {
                            height: 44px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: Theme.text.with-alpha(0.14);
                            background: #00000030;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 22px;
                                    background: transparent;
                                    Text { text: "Rp"; color: Theme.text-dim; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                TextInput {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    text <=> root.amount;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 750;
                                    vertical-alignment: center;
                                    single-line: true;
                                    input-type: text;
                                    edited => { root.amount-edited(self.text); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        width: 138px;
                        spacing: 6px;
                        Text { text: "Mata uang tujuan"; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; }
                        Rectangle {
                            height: 44px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: Theme.text.with-alpha(0.14);
                            background: picker-ta.has-hover ? Theme.text.with-alpha(0.075) : #00000030;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text { text: root.d.code + " · " + root.d.name; color: Theme.text; font-size: 10px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: root.picker-open ? "⌃" : "⌄"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            picker-ta := TouchArea { clicked => { root.picker-open = !root.picker-open; } }
                        }
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    for q[i] in ["10 rb", "50 rb", "100 rb", "500 rb", "1 jt", "10 jt"]: Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: root.amount == ["10.000", "50.000", "100.000", "500.000", "1.000.000", "10.000.000"][i] ? Theme.accent.with-alpha(0.6) : Theme.text.with-alpha(0.11);
                        background: root.amount == ["10.000", "50.000", "100.000", "500.000", "1.000.000", "10.000.000"][i] ? Theme.accent.with-alpha(0.2) : (q-ta.has-hover ? Theme.text.with-alpha(0.11) : Theme.text.with-alpha(0.045));
                        Text { text: q; color: Theme.text.with-alpha(0.72); font-size: 10px; font-weight: 680; horizontal-alignment: center; vertical-alignment: center; }
                        q-ta := TouchArea { clicked => { root.quick(i); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 92px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.27);
                    background: Theme.accent.with-alpha(0.12);
                    VerticalLayout {
                        x: 13px; y: 11px;
                        width: parent.width - 26px;
                        height: parent.height - 22px;
                        spacing: 5px;
                        HorizontalLayout {
                            height: 18px;
                            Text { text: "Perkiraan nilai konversi"; color: Theme.text-dim; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle {
                                width: 42px; height: 19px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.text-faint.with-alpha(0.2);
                                background: #00000038;
                                Text { text: root.d.code; color: Theme.text; font-size: 9px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Text {
                            text: root.d.error != "" ? "Kurs tidak tersedia" : (root.d.loading && root.d.result == "" ? "Memuat kurs..." : (root.d.result != "" ? root.d.result : "—"));
                            color: root.d.error != "" ? #ff9b8f : Theme.text;
                            font-size: 34px;
                            font-weight: 820;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                        Text { text: root.d.rate != "" ? root.d.rate : (root.d.error != "" ? root.d.error : "Mengambil kurs referensi terbaru..."); color: root.d.error != "" ? #ff9b8f : Theme.text-dim; font-size: 8px; overflow: elide; }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Kurs referensi dapat berbeda dari kurs bank atau money changer."; color: Theme.text.with-alpha(0.48); font-size: 10px; vertical-alignment: center; overflow: elide; }
                }
            }
            // Menu pilihan dibuat mengambang di atas panel agar susunan konverter tidak bergeser.
            if root.picker-open: Rectangle {
                x: parent.width - 151px;
                y: 120px;
                width: 138px;
                height: 160px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.text-faint.with-alpha(0.24);
                background: Theme.body;
                clip: true;
                Flickable {
                    x: 4px; y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-width: self.width;
                    content-height: max(self.height, root.currencies.length * 29px);
                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                        for item[i] in root.currencies: Rectangle {
                            height: 27px;
                            border-radius: 7px;
                            background: item.selected ? Theme.accent.with-alpha(0.22) : (pick-row.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 6px; spacing: 3px;
                                Text { text: item.code; color: Theme.text; font-size: 9px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: item.value; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; }
                            }
                            pick-row := TouchArea { clicked => { root.select-currency(item.code, [30, 90, 180, 365][root.range]); root.picker-open = false; } }
                        }
                    }
                }
            }
        }

        // Panel kanan: ringkasan pasar saham IDX dengan sub-kartu gainers dan losers.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: Theme.text.with-alpha(0.04);
            VerticalLayout {
                x: 16px; y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                spacing: 13px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    Rectangle {
                        width: 31px; height: 31px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #43d9a02b;
                        background: #43d9a014;
                        Path {
                            x: 7px; y: 7px; width: 17px; height: 17px;
                            viewbox-width: 24; viewbox-height: 24;
                            commands: "M 3 17 L 9 11 L 13 14 L 21 5 M 15 5 H 21 V 11";
                            fill: transparent; stroke: #68dfb1; stroke-width: 1.8px;
                            stroke-line-cap: round; stroke-line-join: round;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Pasar saham IDX"; color: Theme.text; font-size: 13px; font-weight: 750; }
                        Text { text: "Perubahan sejak awal bulan"; color: Theme.text.with-alpha(0.53); font-size: 10px; }
                    }
                    Rectangle {
                        width: 70px; height: 24px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text-faint.with-alpha(0.14);
                        background: Theme.text.with-alpha(0.04);
                        Text { text: root.d.stock-period; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 9px;
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text.with-alpha(0.08);
                        background: #00000021;
                        VerticalLayout {
                            x: 10px; y: 11px;
                            width: parent.width - 20px;
                            height: parent.height - 22px;
                            spacing: 7px;
                            HorizontalLayout {
                                height: 17px;
                                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #68dfb1; }
                                Text { text: "Performa terbaik"; color: #68dfb1; font-size: 10px; font-weight: 650; vertical-alignment: center; }
                            }
                            if root.gainers.length == 0: Text { text: root.d.loading ? "Memuat data..." : "Data belum tersedia"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                            for g in root.gainers: Rectangle {
                                height: 43px;
                                border-radius: 9px;
                                background: Theme.text.with-alpha(0.045);
                                HorizontalLayout {
                                    padding-left: 7px; padding-right: 7px; spacing: 4px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; preferred-width: 0px;
                                        alignment: center; spacing: 2px;
                                        Text { text: g.name; color: Theme.text; font-size: 12px; font-weight: 760; overflow: elide; }
                                        Text { text: g.price; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                    }
                                    Rectangle {
                                        width: 56px; height: 20px;
                                        border-radius: 10px;
                                        background: #43d9a020;
                                        Text { text: g.change; color: #68dfb1; font-size: 10px; font-weight: 740; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text.with-alpha(0.08);
                        background: #00000021;
                        VerticalLayout {
                            x: 10px; y: 11px;
                            width: parent.width - 20px;
                            height: parent.height - 22px;
                            spacing: 7px;
                            HorizontalLayout {
                                height: 17px;
                                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #ff8e98; }
                                Text { text: "Performa terendah"; color: #ff8e98; font-size: 10px; font-weight: 650; vertical-alignment: center; }
                            }
                            if root.losers.length == 0: Text { text: root.d.loading ? "Memuat data..." : "Data belum tersedia"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                            for l in root.losers: Rectangle {
                                height: 43px;
                                border-radius: 9px;
                                background: Theme.text.with-alpha(0.045);
                                HorizontalLayout {
                                    padding-left: 7px; padding-right: 7px; spacing: 4px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; preferred-width: 0px;
                                        alignment: center; spacing: 2px;
                                        Text { text: l.name; color: Theme.text; font-size: 12px; font-weight: 760; overflow: elide; }
                                        Text { text: l.price; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                    }
                                    Rectangle {
                                        width: 56px; height: 20px;
                                        border-radius: 10px;
                                        background: #ff8e9820;
                                        Text { text: l.change; color: #ff8e98; font-size: 10px; font-weight: 740; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; preferred-width: 0px; height: 26px; text: root.d.stock-status; color: Theme.text.with-alpha(0.53); font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }

    // Tampilan diperluas: panel kurs di kiri dan grafik historis di kanan.
    if !root.alert-mode && root.expanded: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 14px;
        Rectangle {
            width: 254px;
            vertical-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: Theme.text.with-alpha(0.04);
            VerticalLayout {
                x: 12px; y: 14px;
                width: parent.width - 20px;
                height: parent.height - 22px;
                spacing: 9px;
                VerticalLayout {
                    height: 34px;
                    spacing: 3px;
                    Text { text: "Nilai tukar ke Rupiah"; color: Theme.text; font-size: 13px; font-weight: 750; }
                    Text { text: "Pilih mata uang untuk melihat grafik"; color: Theme.text.with-alpha(0.55); font-size: 10px; }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, root.currencies.length * 42px);
                    VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        for item[i] in root.currencies: Rectangle {
                            height: 39px;
                            border-radius: 9px;
                            border-width: item.selected ? 1px : 0px;
                            border-color: Theme.accent.with-alpha(0.6);
                            background: item.selected ? Theme.accent.with-alpha(0.2) : (currency-row-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.04));
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1; preferred-width: 0px;
                                    alignment: center; spacing: 2px;
                                    Text { text: "1 " + item.code; color: Theme.text; font-size: 12px; font-weight: 760; }
                                    Text { text: item.name; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                }
                                Text { text: item.value; color: item.value == "—" ? Theme.text-faint : Theme.text; font-size: 12px; font-weight: 720; vertical-alignment: center; horizontal-alignment: right; }
                            }
                            currency-row-ta := TouchArea { clicked => { root.select-currency(item.code, [30, 90, 180, 365][root.range]); } }
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: Theme.text.with-alpha(0.04);
            VerticalLayout {
                x: 14px; y: 12px;
                width: parent.width - 28px;
                height: parent.height - 24px;
                spacing: 10px;
                HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1; preferred-width: 0px;
                        alignment: center; spacing: 3px;
                        Text { text: root.d.code + " \u{00B7} " + root.d.name + " \u{2192} IDR"; color: Theme.text-dim; font-size: 9px; font-weight: 700; overflow: elide; }
                        Text { text: root.chart-last != "" ? "1 " + root.d.code + " = " + root.chart-last : root.chart-status; color: Theme.text; font-size: 17px; font-weight: 800; overflow: elide; }
                        Text { text: root.chart-change; color: root.chart-up ? #68dfb1 : #ff8e98; font-size: 9px; font-weight: 700; }
                    }
                    HorizontalLayout {
                        height: 27px;
                        spacing: 3px;
                        for lbl[i] in ["1B", "3B", "6B", "1T"]: Rectangle {
                            width: 31px; height: 24px;
                            border-radius: 12px;
                            border-width: root.range == i ? 1px : 0px;
                            border-color: Theme.accent.with-alpha(0.45);
                            background: root.range == i ? Theme.accent.with-alpha(0.32) : (rg-ta.has-hover ? Theme.text.with-alpha(0.1) : transparent);
                            Text { text: lbl; color: root.range == i ? Theme.text : Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            rg-ta := TouchArea { clicked => { root.range = i; root.request-chart(); } }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.text-faint.with-alpha(0.1);
                    background: Theme.body.with-alpha(0.28);
                    clip: true;
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: "M 0 6 L 240 6 M 0 35.33 L 240 35.33 M 0 64.67 L 240 64.67 M 0 94 L 240 94";
                        fill: transparent;
                        stroke: Theme.text-faint.with-alpha(0.18);
                        stroke-width: 0.7px;
                    }
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: root.chart-area;
                        fill: Theme.accent.with-alpha(0.16);
                        visible: root.chart-area != "";
                    }
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: root.chart-line;
                        fill: transparent;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        stroke-line-join: round;
                        stroke-line-cap: round;
                        visible: root.chart-line != "";
                    }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.06 - 7px; text: root.chart-max; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.3533 - 7px; text: root.chart-y1; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.6467 - 7px; text: root.chart-y2; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.94 - 7px; text: root.chart-min; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 46px; y: parent.height - 21px; width: 55px; text: root.chart-date-start != "" ? root.chart-date-start : "Awal"; color: Theme.text-faint; font-size: 8px; }
                    Text { x: parent.width / 2 - 27px; y: parent.height - 21px; width: 54px; text: root.chart-date-mid; color: Theme.text-faint; font-size: 8px; horizontal-alignment: center; }
                    Text { x: parent.width - 66px; y: parent.height - 21px; width: 58px; text: root.chart-date-end != "" ? root.chart-date-end : "Terbaru"; color: Theme.text-faint; font-size: 8px; horizontal-alignment: right; }
                    Rectangle {
                        x: parent.width - 17px;
                        y: 10px + (parent.height - 34px) * root.chart-dot-y / 100 - 4.5px;
                        width: 9px; height: 9px;
                        border-radius: 5px;
                        border-width: 1.5px; border-color: Theme.body;
                        background: Theme.accent;
                        visible: root.chart-line != "" && !chart-hit.has-hover;
                    }
                    // Mouse position is reactive in Slint; midpoint ranges select the nearest daily quote.
                    chart-hit := TouchArea {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        mouse-cursor: pointer;
                    }
                    for point in root.chart-points: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;
                        visible: chart-hit.has-hover
                            && chart-hit.mouse-x / max(chart-hit.width, 1px) >= point.left
                            && chart-hit.mouse-x / max(chart-hit.width, 1px) <= point.right;
                        Rectangle {
                            x: 46px + (parent.width - 58px) * point.x - 0.5px;
                            y: 10px;
                            width: 1px;
                            height: parent.height - 34px;
                            background: Theme.accent.with-alpha(0.48);
                        }
                        Rectangle {
                            x: 46px + (parent.width - 58px) * point.x - 4.5px;
                            y: 10px + (parent.height - 34px) * point.y / 100 - 4.5px;
                            width: 9px; height: 9px;
                            border-radius: 5px;
                            border-width: 1.5px; border-color: Theme.body;
                            background: Theme.accent;
                        }
                        Rectangle {
                            x: clamp(46px + (parent.width - 58px) * point.x - 77px, 4px, parent.width - 158px);
                            y: max(10px + (parent.height - 34px) * point.y / 100 - 49px, 4px);
                            width: 154px; height: 42px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.45);
                            background: Theme.body;
                            VerticalLayout {
                                x: 9px; y: 5px;
                                width: parent.width - 18px;
                                height: parent.height - 10px;
                                spacing: 2px;
                                Text { text: point.date; color: Theme.text-faint; font-size: 8px; }
                                Text { text: "1 " + root.d.code + " = " + point.value; color: Theme.text; font-size: 10px; font-weight: 750; }
                            }
                        }
                    }
                    if root.chart-line == "": Text { width: parent.width - 20px; height: parent.height - 48px; x: 10px; y: 24px; text: root.chart-status != "" ? root.chart-status : "Memuat grafik..."; color: Theme.text-faint; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 22px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
                    Text { text: root.chart-status; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }

    if root.alert-mode: Rectangle {
        vertical-stretch: 1;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.text.with-alpha(0.16);
        background: Theme.body;
        VerticalLayout {
            x: 14px; y: 13px;
            width: parent.width - 28px;
            height: parent.height - 26px;
            spacing: 9px;
            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px;
                    alignment: center; spacing: 2px;
                    Text { text: "Alert harga & kurs"; color: Theme.text; font-size: 14px; font-weight: 760; }
                    Text { text: "Data kurs & saham diperbarui tiap 10 menit"; color: Theme.text.with-alpha(0.55); font-size: 10px; }
                }
                Rectangle {
                    width: 26px; height: 26px;
                    border-radius: 8px;
                    background: alert-close-ta.has-hover ? Theme.text.with-alpha(0.16) : Theme.text.with-alpha(0.07);
                    Path {
                        x: 6px; y: 6px; width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.close;
                        fill: transparent; stroke: Theme.text-dim;
                        stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                    }
                    alert-close-ta := TouchArea { clicked => { root.alert-mode = false; root.picker-open = false; } }
                }
            }
            HorizontalLayout {
                height: 32px;
                spacing: 7px;
                Rectangle {
                    width: 66px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: root.alert-stock-mode ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.16);
                    background: root.alert-stock-mode ? Theme.accent.with-alpha(0.18) : Theme.text.with-alpha(0.07);
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.alert-stock-mode ? "Saham" : "Kurs"; color: root.alert-stock-mode ? Theme.text : Theme.text-dim; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    alert-kind-ta := TouchArea { clicked => { root.alert-stock-mode = !root.alert-stock-mode; root.picker-open = false; } }
                }
                Rectangle {
                    horizontal-stretch: 1; preferred-width: 0px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: currency-alert-picker-ta.has-hover ? Theme.text.with-alpha(0.24) : Theme.text.with-alpha(0.16);
                    background: currency-alert-picker-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.07);
                    HorizontalLayout {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        padding-left: 9px; padding-right: 9px; spacing: 6px;
                        Text { text: root.alert-stock-mode ? root.alert-stock-code + " · Saham IDX" : root.alert-currency-code + " · " + root.alert-currency-name; color: Theme.text; font-size: 11.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.picker-open ? "⌃" : "⌄"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    }
                    currency-alert-picker-ta := TouchArea { clicked => { root.picker-open = !root.picker-open; } }
                }
                Rectangle {
                    width: 96px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: Theme.text.with-alpha(0.16);
                    background: condition-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.07);
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 8px; spacing: 3px;
                        Text { text: root.above ? "Naik ke ≥" : "Turun ke ≤"; color: Theme.text; font-size: 11.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "⌄"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                    }
                    condition-ta := TouchArea { clicked => { root.above = !root.above; } }
                }
                Rectangle {
                    horizontal-stretch: 1; preferred-width: 0px;
                    height: 32px; border-radius: 9px; border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.85);
                    background: Theme.text.with-alpha(0.07);
                    alert-target-input := TextInput {
                        x: 9px; y: 0px; width: parent.width - 18px; height: parent.height;
                        color: Theme.text; font-size: 11.5px; vertical-alignment: center;
                        single-line: true; input-type: text;
                        accepted => {
                            root.add-alert(root.above, self.text, root.alert-stock-mode,
                                root.alert-stock-mode ? root.alert-stock-code : root.alert-currency-code,
                                root.alert-repeat);
                            self.text = "";
                        }
                    }
                    if alert-target-input.text == "": Text {
                        x: 9px; y: 0px; width: parent.width - 18px; height: parent.height;
                        text: root.alert-stock-mode
                            ? "Target saham (Rp)"
                            : (root.alert-currency-code == root.d.code && root.d.alert-rate != "" && root.d.alert-rate != "—"
                                ? "mis. " + root.d.alert-rate
                                : "Target (Rp)");
                        color: Theme.text.with-alpha(0.4); font-size: 11.5px; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 66px; height: 32px;
                    border-radius: 9px;
                    background: Theme.accent;
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "Pasang"; color: #11131b; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                    install-alert-ta := TouchArea { clicked => {
                        root.add-alert(root.above, alert-target-input.text, root.alert-stock-mode,
                            root.alert-stock-mode ? root.alert-stock-code : root.alert-currency-code,
                            root.alert-repeat);
                        alert-target-input.text = "";
                    } }
                }
            }
            Text {
                height: 16px;
                text: root.alert-stock-mode
                    ? "Harga saham IDX dipantau dari Yahoo Finance."
                    : (root.alert-currency-code == root.d.code
                        ? "Harga sekarang: " + (root.d.alert-rate != "" ? root.d.alert-rate : "—")
                        : "Kurs " + root.alert-currency-code + " dipantau terhadap Rupiah.");
                color: Theme.text.with-alpha(0.66); font-size: 10.5px; vertical-alignment: center;
            }
            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                Text { text: "Ulangi setelah harga kembali ke sisi sebaliknya"; color: Theme.text.with-alpha(0.55); font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 78px; height: 22px;
                    border-radius: 11px; border-width: 1px;
                    border-color: root.alert-repeat ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.13);
                    background: root.alert-repeat ? Theme.accent.with-alpha(0.2) : Theme.text.with-alpha(0.06);
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.alert-repeat ? "Berulang" : "Sekali"; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    repeat-alert-ta := TouchArea { clicked => { root.alert-repeat = !root.alert-repeat; } }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;
                Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: max(self.height, root.alerts.length * 58px);
                    VerticalLayout {
                    width: parent.width;
                    spacing: 6px;
                    if root.alerts.length == 0: Text {
                        text: "Belum ada pengingat harga atau kurs";
                        color: Theme.text-faint; font-size: 10px;
                        vertical-alignment: center;
                    }
                    for a in root.alerts: Rectangle {
                        height: 48px;
                        border-radius: 11px; border-width: 1px;
                        border-color: Theme.text.with-alpha(0.09);
                        background: Theme.text.with-alpha(0.045);
                        HorizontalLayout {
                            x: 12px; y: 0px;
                            width: parent.width - 24px; height: parent.height;
                            spacing: 10px;
                            Path {
                                width: 16px; height: 16px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: a.stock ? Icons.stats : Icons.reset;
                                fill: transparent; stroke: Theme.accent;
                                stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; preferred-width: 0px;
                                alignment: center; spacing: 2px;
                                Text { text: a.text; color: Theme.text; font-size: 12px; font-weight: 700; }
                                Text {
                                    text: a.repeat
                                        ? (a.armed ? "Berulang · menunggu target" : "Berulang · menunggu harga kembali")
                                        : (a.stock ? "Sekali · saham IDX" : "Sekali · kurs ke Rupiah");
                                    color: Theme.text.with-alpha(0.55);
                                    font-size: 10px;
                                }
                            }
                            Rectangle {
                                width: 26px; height: 26px;
                                border-radius: 8px;
                                background: remove-alert-ta.has-hover ? Theme.text.with-alpha(0.16) : Theme.text.with-alpha(0.07);
                                Path {
                                    x: 6px; y: 6px; width: 14px; height: 14px;
                                    viewbox-width: 24; viewbox-height: 24;
                                    commands: Icons.close;
                                    fill: transparent; stroke: Theme.text-dim;
                                    stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                                }
                                remove-alert-ta := TouchArea { clicked => { root.remove-alert(a.id); } }
                            }
                        }
                    }
                    }
                }
            }
        }
        if root.picker-open: Rectangle {
            x: 87px; y: 86px;
            width: 190px; height: 180px;
            border-radius: 10px; border-width: 1px;
            border-color: Theme.text-faint.with-alpha(0.24);
            background: Theme.body;
            clip: true;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-width: self.width;
                content-height: max(self.height, (root.alert-stock-mode ? 12 : root.currencies.length) * 29px);
                VerticalLayout {
                    width: parent.width; spacing: 2px;
                    if root.alert-stock-mode: VerticalLayout {
                        width: parent.width; spacing: 2px;
                        for stock[i] in ["BBCA", "BBRI", "BMRI", "BBNI", "TLKM", "ASII", "ANTM", "GOTO", "ICBP", "MDKA", "BRPT", "INDF"]: Rectangle {
                            height: 27px; border-radius: 7px;
                            background: stock == root.alert-stock-code ? Theme.accent.with-alpha(0.22) : (alert-stock-pick-ta.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 6px; spacing: 3px;
                                Text { text: stock; color: Theme.text; font-size: 10px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "Saham IDX"; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; }
                            }
                            alert-stock-pick-ta := TouchArea { clicked => { root.alert-stock-code = stock; root.picker-open = false; } }
                        }
                    }
                    if !root.alert-stock-mode: VerticalLayout {
                        width: parent.width; spacing: 2px;
                        for item[i] in root.currencies: Rectangle {
                            height: 27px; border-radius: 7px;
                            background: item.code == root.alert-currency-code ? Theme.accent.with-alpha(0.22) : (alert-currency-pick-ta.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 6px; spacing: 3px;
                                Text { text: item.code; color: Theme.text; font-size: 9px; font-weight: 750; vertical-alignment: center; }
                                Text { text: item.name; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            alert-currency-pick-ta := TouchArea { clicked => { root.alert-currency-code = item.code; root.alert-currency-name = item.name; root.picker-open = false; } }
                        }
                    }
                }
            }
        }
    }
}

// Kartu pengingat aktif: teks di kiri, tombol aksi di kanan. Tombol diposisikan di tengah vertikal
// lewat VerticalLayout + alignment: center, karena HorizontalLayout menempelkan anak ber-height
// eksplisit ke tepi atas.
component ReminderAlertCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback snooze();
    callback done();

    height: 58px;
    border-radius: 14px;
    background: #d9770628;
    border-width: 1px;
    border-color: #f59e0b88;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: "PENGINGAT AKTIF"; color: #fbbf24; font-size: 10px; font-weight: 800; }
            Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; }
            Text { text: root.subtitle; color: Theme.text-dim; font-size: 10px; overflow: elide; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Chip { label: "Tunda 5 menit"; height: 32px; padding-x: 16px; clicked => { root.snooze(); } }
                Chip { label: "Selesai"; selected: true; height: 32px; padding-x: 16px; clicked => { root.done(); } }
            }
        }
    }
}

component ReminderPage inherits VerticalLayout {
    in property <[ReminderItem]> items;
    in property <bool> compact: false;
    in property <bool> media-playing: false;
    in property <bool> nudge-visible: false;
    in property <bool> alert-visible: false;
    in property <string> alert-text;
    in property <string> alert-sub;
    in property <string> status;
    in property <int> weekdays-mask: 62;
    in property <[bool]> weekday-selected;
    in-out property <string> draft;
    in-out property <string> date-time;
    in-out property <string> repeat-mode: "none";
    callback add(string, string, string, int);
    callback toggle(string);
    callback remove(string);
    callback clear-done();
    callback stop-alert();
    callback snooze-alert();
    callback toggle-weekday(int);

    padding-left: 22px;
    padding-right: 22px;
    padding-top: 12px;
    padding-bottom: 14px;
    spacing: 12px;

    HorizontalLayout {
        height: 34px;
        spacing: 9px;
        Text { text: "Pengingat"; color: Theme.text; font-size: 21px; font-weight: 800; vertical-alignment: center; }
        Rectangle {
            height: 22px;
            width: count-text.preferred-width + 20px;
            border-radius: 11px;
            background: Theme.accent.with-alpha(0.2);
            count-text := Text {
                text: root.items.length + " pengingat";
                color: Theme.text;
                font-size: root.compact ? 10px : 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.items.length > 0: Chip { label: "Hapus selesai"; height: 32px; padding-x: 16px; clicked => { root.clear-done(); } }
    }

    if root.alert-visible: ReminderAlertCard {
        title: root.alert-text;
        subtitle: root.alert-sub;
        snooze => { root.snooze-alert(); }
        done => { root.stop-alert(); }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 14px;

        // Form di kiri dibuat terpisah agar input tidak berebut ruang dengan daftar.
        Rectangle {
            width: 300px;
            vertical-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: #ffffff18;
            background: #ffffff08;
            // Bisa digulir bila tinggi tidak cukup (banner alert 58 px atau pilihan hari mingguan); bila muat, tampil seperti biasa.
            Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                interactive: true;
                content-width: self.width;
                content-height: max(self.height, reminder-form.preferred-height);
                reminder-form := VerticalLayout {
                width: parent.width;
                padding: 14px;
                spacing: 10px;
                Text { text: "Buat pengingat"; color: Theme.text; font-size: 14px; font-weight: 700; }
                Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #ffffff20;
                    background: Theme.chip;
                    input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        text <=> root.draft;
                        color: Theme.text;
                        font-size: root.media-playing && root.nudge-visible ? 10px : 12px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); }
                    }
                    if input.text == "": Text {
                        x: 12px;
                        text: "Apa yang perlu diingat?";
                        color: Theme.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #ffffff20;
                    background: Theme.chip;
                    dt := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        text <=> root.date-time;
                        color: Theme.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        single-line: true;
                    }
                    if dt.text == "": Text {
                        x: 12px;
                        text: "DD/MM/YYYY HH:MM (opsional)";
                        color: Theme.text-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                Text { text: "Pengulangan"; color: Theme.text-dim; font-size: 10px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 4px;
                    Chip { label: "Sekali"; selected: root.repeat-mode == "none"; min-width: 58px; clicked => { root.repeat-mode = "none"; } }
                    Chip { label: "Harian"; selected: root.repeat-mode == "daily"; min-width: 58px; clicked => { root.repeat-mode = "daily"; } }
                    Chip { label: "Mingguan"; selected: root.repeat-mode == "weekly"; min-width: 72px; clicked => { root.repeat-mode = "weekly"; } }
                    Chip { label: "Bulanan"; selected: root.repeat-mode == "monthly"; min-width: 68px; clicked => { root.repeat-mode = "monthly"; } }
                }
                if root.repeat-mode == "weekly": VerticalLayout {
                    spacing: 5px;
                    Text { text: "Pilih hari"; color: Theme.text-dim; font-size: 10px; }
                    HorizontalLayout {
                        spacing: 3px;
                        for day[idx] in ["Min", "Sen", "Sel", "Rab", "Kam", "Jum", "Sab"]: Chip {
                            label: day;
                            min-width: 34px;
                            selected: root.weekday-selected[idx];
                            clicked => { root.toggle-weekday(idx); }
                        }
                    }
                }
                if root.status != "": Text {
                    text: root.status;
                    color: Theme.text-dim;
                    font-size: 10px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Rectangle { vertical-stretch: 1; }
                Chip {
                    label: "+ Tambahkan pengingat";
                    selected: true;
                    height: 38px;
                    clicked => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); }
                }
                }
            }
        }

        // Daftar mengambil sisa lebar dan tinggi; setiap item punya ruang klik yang cukup.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: #ffffff18;
            background: #ffffff06;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 24px;
                    Text { text: "Daftar pengingat"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Terbaru"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
                }
                if root.items.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    Text { text: "Belum ada pengingat"; color: Theme.text; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Buat pengingat pertama melalui form di sebelah kiri."; color: Theme.text-faint; font-size: 10px; horizontal-alignment: center; }
                }
                if root.items.length > 0: Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: root.items.length * 64px;
                    // Tanpa layout perantara: lebar layout yang bergantung pada lebar anak (dan sebaliknya) membuat binding loop.
                    // Item ditempatkan manual: tinggi 56 px + jarak 8 px = 64 px per baris.
                    for item[i] in root.items: Rectangle {
                        x: 0px;
                        y: i * 64px;
                        width: parent.width;
                        height: 56px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: item.done ? #ffffff0d : #ffffff1c;
                        background: item.done ? #ffffff08 : #ffffff0d;
                        opacity: item.done ? 0.62 : 1;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 9px;
                            spacing: 10px;
                            // Anak berukuran tetap di HorizontalLayout menempel ke atas; dibungkus VerticalLayout agar center vertikal.
                            VerticalLayout {
                                width: 28px;
                                alignment: center;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 9px;
                                    background: item.done ? Theme.ok.with-alpha(0.18) : Theme.accent.with-alpha(0.18);
                                    Path {
                                        x: 6px; y: 6px; width: 16px; height: 16px;
                                        viewbox-width: 24; viewbox-height: 24;
                                        commands: item.done ? "M 5 12 L 10 17 L 19 7" : "M 12 5 V 19 M 5 12 H 19";
                                        fill: transparent;
                                        stroke: item.done ? Theme.ok : Theme.accent;
                                        stroke-width: 2px;
                                        stroke-line-cap: round;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text { text: item.text; color: Theme.text; font-size: 12px; font-weight: 700; overflow: elide; }
                                Text { text: item.due; color: Theme.text-faint; font-size: 10px; overflow: elide; }
                            }
                            VerticalLayout {
                                width: 28px;
                                alignment: center;
                                RoundButton { size: 28px; commands: item.done ? Icons.reset : "M 4 12 L 9 17 L 20 6"; outline: true; clicked => { root.toggle(item.id); } }
                            }
                            VerticalLayout {
                                width: 28px;
                                alignment: center;
                                RoundButton { size: 28px; commands: Icons.close; outline: true; clicked => { root.remove(item.id); } }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Satu entri riwayat clipboard: nomor, pratinjau, dan ikon salin (centang hijau sesaat setelah disalin).
// Satu entri riwayat clipboard: nomor, pratinjau, dan ikon salin (centang hijau sesaat setelah disalin).
component ClipboardCard inherits Rectangle {
    in property <int> index: 0;
    in property <string> preview;
    in property <bool> copied: false;
    callback clicked;
    height: 30px;
    border-radius: 11px;
    background: root.copied ? Theme.ok.with-alpha(0.14) : (ta.has-hover ? Theme.chip-hover : #ffffff0b);
    border-width: 1px;
    border-color: root.copied ? Theme.ok.with-alpha(0.5) : (ta.has-hover ? Theme.accent.with-alpha(0.45) : #ffffff14);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 20px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 20px;
                border-radius: 7px;
                background: root.index == 0 ? Theme.accent.with-alpha(0.28) : Theme.chip;
                Text {
                    text: "" + (root.index + 1);
                    color: root.index == 0 ? Theme.text : Theme.text-dim;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.preview;
            color: Theme.text;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 16px;
            Path {
                x: 1px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.copied ? "M 5 12.5 L 10 17.5 L 19 7" : Icons.copy;
                fill: transparent;
                stroke: root.copied ? Theme.ok : (ta.has-hover ? Theme.text : Theme.text-faint);
                stroke-width: 1.9px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Keadaan kosong / tidak tersedia, ditengah area daftar.
component ClipboardEmpty inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> warn: false;
    vertical-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 5px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                background: root.warn ? #ef444424 : Theme.chip;
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 18px;
                    height: 18px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.clipboard;
                    fill: transparent;
                    stroke: root.warn ? #ff8282 : Theme.text-dim;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
        }
        Text { text: root.title; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
        Text { text: root.hint; color: Theme.text-faint; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

// Riwayat clipboard: header (judul, jumlah, Bersihkan) + kartu 2 kolom yang bisa digulir (maks. 10 item).
// Area halaman 580 x 148 px: tiga baris kartu 30 px muat tanpa menggulir (6 item).
component ClipboardPage inherits VerticalLayout {
    in property <[ClipboardItem]> items;
    in property <bool> available: true;
    in-out property <string> copied-text: "";
    property <int> cols: root.items.length > 1 ? 2 : 1;
    callback copy(string);
    callback clear();
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 4px;
    padding-bottom: 8px;
    spacing: 6px;

    Timer { interval: 1400ms; running: root.copied-text != ""; triggered => { root.copied-text = ""; } }

    HorizontalLayout {
        height: 28px;
        spacing: 8px;
        Text { text: "Clipboard"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
        if root.available && root.items.length > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: count-text.preferred-width + 16px;
                height: 18px;
                border-radius: 9px;
                background: Theme.accent.with-alpha(0.18);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.34);
                count-text := Text {
                    text: root.items.length + " item";
                    color: Theme.text;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.available && root.items.length > 0: Chip { label: "Bersihkan"; clicked => { root.clear(); } }
    }

    if !root.available: ClipboardEmpty {
        warn: true;
        title: "Clipboard tidak tersedia";
        hint: "Akses clipboard sistem gagal. Coba mulai ulang aplikasi.";
    }
    if root.available && root.items.length == 0: ClipboardEmpty {
        title: "Belum ada riwayat salin";
        hint: "Teks yang kamu salin muncul di sini. 10 terbaru, hanya disimpan di memori.";
    }
    if root.available && root.items.length > 0: Rectangle {
        vertical-stretch: 1;
        clip: true;
        flick := Flickable {
            width: parent.width - (root.items.length > 6 ? 8px : 0px);
            height: parent.height;
            content-width: self.width;
            content-height: max(self.height, Math.ceil(root.items.length / root.cols) * 35px - 5px);
            for item[i] in root.items: ClipboardCard {
                width: (flick.width - (root.cols - 1) * 8px) / root.cols;
                x: Math.mod(i, 2) * (self.width + 8px);
                y: Math.floor(i / 2) * 35px;
                index: i;
                preview: item.preview;
                copied: root.copied-text == item.text;
                clicked => { root.copied-text = item.text; root.copy(item.text); }
            }
        }
        // Indikator gulir tipis, hanya bila daftar melebihi area.
        if flick.content-height > flick.height: Rectangle {
            property <length> thumb: Math.max(18px, flick.height * flick.height / flick.content-height);
            x: parent.width - 3px;
            width: 3px;
            height: self.thumb;
            y: (flick.height - self.thumb) * (-flick.content-y) / (flick.content-height - flick.height);
            border-radius: 1.5px;
            background: #ffffff38;
        }
    }
}

component QuickButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    in property <bool> na;              // tidak didukung / belum terbaca
    in property <bool> soft: false;     // gaya aksen lembut (tombol aksi seperti "Pusatkan")
    callback clicked;
    horizontal-stretch: 1;
    height: 84px;
    border-radius: 22px;
    opacity: na ? 0.4 : 1;
    background: on ? Theme.accent : (soft ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.chip-hover : Theme.chip));
    animate background { duration: 140ms; }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: 22px;
                height: 22px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.label;
            color: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { enabled: !root.na; clicked => { root.clicked(); } }
}

// Nilai quick: -1 = tidak didukung/belum terbaca, 0 = false, 1 = true (aturan sama dengan quick-stats.ts)
global QuickText {
    pure public function label(v: int, name: string, t: string, f: string) -> string {
        return v < 0 ? name : (v == 1 ? t : f);
    }
}

component QuickPage inherits HorizontalLayout {
    in property <int> mic: -1;
    in property <int> wifi: -1;
    in property <int> bt: -1;
    callback toggle(string);
    padding-left: 22px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 32px;
    spacing: 10px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.mic; label: QuickText.label(root.mic, "Mic", "Mic mati", "Mic aktif"); on: root.mic == 1; na: root.mic < 0; clicked => { root.toggle("mic"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.wifi; label: QuickText.label(root.wifi, "Wi-Fi", "Wi-Fi on", "Wi-Fi off"); on: root.wifi == 1; na: root.wifi < 0; clicked => { root.toggle("wifi"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.bluetooth; label: QuickText.label(root.bt, "Bluetooth", "Bluetooth on", "Bluetooth off"); on: root.bt == 1; na: root.bt < 0; clicked => { root.toggle("bt"); } }
}

component ToolsPage inherits HorizontalLayout {
    in property <int> awake: -1;
    in property <int> dark: -1;
    callback toggle(string);
    padding-left: 22px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 32px;
    spacing: 10px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.awake; label: QuickText.label(root.awake, "Keep awake", "Awake: ON", "Awake: OFF"); on: root.awake == 1; na: root.awake < 0; clicked => { root.toggle("awake"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.moon; label: QuickText.label(root.dark, "Tema", "Gelap", "Terang"); on: root.dark == 1; na: root.dark < 0; clicked => { root.toggle("dark"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.lock; label: "Kunci"; clicked => { root.toggle("lock"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.center; label: "Pusatkan"; soft: true; clicked => { root.toggle("center"); } }
}

// Gambar hasil renderer font warna sistem. Teks Unicode tetap menjadi sumber data;
// image hanya cache visual untuk renderer software Slint.
component NudgeEmoji inherits Rectangle {
    in property <string> emoji;
    in property <image> rendered-image;
    in property <bool> rendered-image-available: false;
    width: 24px;
    height: 24px;
    background: transparent;
    if root.rendered-image-available: Image {
        source: root.rendered-image;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if !root.rendered-image-available: Text {
        width: parent.width;
        height: parent.height;
        text: root.emoji;
        color: Theme.text;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Awan percakapan untuk dock bawah/samping: tinggi mengikuti isi, teks dapat membungkus hingga
// beberapa baris, dan emoji tampil sebagai artwork berwarna. tail-pos mengatur ujung ekor.
component SpeechBubble inherits Rectangle {
    in property <bool> compact: false;
    in property <string> message;
    in property <string> detail;
    in property <string> emoji: "";
    in property <image> emoji-image;
    in property <bool> emoji-image-available: false;
    in property <bool> side: false;
    in property <bool> side-right: false;
    in property <length> tail-pos: -1px;
    property <length> along: root.side ? root.height : root.width;
    property <length> tail-center: Math.max(20px, Math.min(root.along - 20px, root.tail-pos < 0px ? root.along / 2 : root.tail-pos));
    width: root.compact ? 184px : 224px;
    // 4–5 baris pesan + hingga 2 baris detail. Tinggi ini ikut dipakai Shell untuk native region.
    height: (root.compact ? 7px : 10px) + msg.height + (root.detail != "" && !root.compact ? 3px + det.height : 0px) + (root.compact ? 7px : 10px);
    border-radius: root.compact ? 14px : 18px;
    clip: false;
    background: #08090df5;

    if root.emoji != "": NudgeEmoji {
        x: 10px;
        y: root.compact ? 8px : 11px;
        width: root.compact ? 22px : 24px;
        height: root.compact ? 22px : 24px;
        emoji: root.emoji;
        rendered-image: root.emoji-image;
        rendered-image-available: root.emoji-image-available;
    }
    msg := Text {
        x: root.emoji != "" ? 42px : (root.compact ? 10px : 14px);
        y: root.compact ? 7px : 10px;
        width: parent.width - (root.emoji != "" ? 54px : (root.compact ? 20px : 28px));
        height: Math.min(self.preferred-height, 68px);
        text: root.message;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        wrap: word-wrap;
        overflow: clip;
    }
    det := Text {
        x: 14px;
        y: msg.y + msg.height + 3px;
        width: parent.width - 28px;
        height: root.detail != "" && !root.compact ? Math.min(self.preferred-height, 34px) : 0px;
        text: root.detail;
        color: #c7c9d1;
        font-size: 9.5px;
        wrap: word-wrap;
        overflow: clip;
    }
    // Ekor membulat (isi dan garis berwarna sama, join berwarna sama) mengarah ke notch.
    Path {
        x: root.side ? (root.side-right ? parent.width - 2px : -10px) : root.tail-center - 9px;
        y: root.side ? root.tail-center - 9px : parent.height - 3px;
        width: root.side ? 12px : 18px;
        height: root.side ? 18px : 12px;
        viewbox-width: root.side ? 12 : 18;
        viewbox-height: root.side ? 18 : 12;
        commands: root.side ? (root.side-right ? "M 1 2 L 10 9 L 1 16 Z" : "M 11 2 L 2 9 L 11 16 Z")
            : "M 2 1 L 9 10 L 16 1 Z";
        fill: #08090df5;
        stroke: #08090df5;
        stroke-width: 3px;
        stroke-line-join: round;
    }
}

// ===================================================================================
// Jendela Pengaturan: komponen UI
// Semua warna diturunkan dari `Theme` supaya ikut tema terang/gelap. Tidak ada gradien pada
// elemen rounded (lihat catatan renderer software di atas).
// ===================================================================================

struct SettingsChoice { id: string, label: string, detail: string, tint: color }

global SUi {
    out property <color> card: Theme.text.with-alpha(0.04);
    out property <color> card-line: Theme.text.with-alpha(0.09);
    out property <color> field: Theme.text.with-alpha(0.06);
    out property <color> field-line: Theme.text.with-alpha(0.13);
    out property <color> divider: Theme.text.with-alpha(0.07);
    out property <color> hover: Theme.text.with-alpha(0.07);
    out property <color> side: Theme.text.with-alpha(0.035);
}

component SButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    callback clicked;
    height: 34px;
    min-width: 48px;
    preferred-width: sbtn-text.preferred-width + 32px;
    horizontal-stretch: 0;
    border-radius: 9px;
    border-width: (root.primary || root.quiet) ? 0px : 1px;
    border-color: SUi.field-line;
    background: root.primary ? (sbtn-ta.has-hover ? Theme.accent.with-alpha(0.86) : Theme.accent) : (root.quiet ? (sbtn-ta.has-hover ? SUi.hover : transparent) : (sbtn-ta.has-hover ? Theme.text.with-alpha(0.12) : Theme.text.with-alpha(0.07)));
    animate background { duration: 120ms; }
    sbtn-text := Text {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.label;
        color: root.primary ? Theme.on-accent : (root.quiet ? Theme.accent : Theme.text);
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    sbtn-ta := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 12px;
    background: root.checked ? Theme.accent : Theme.text.with-alpha(sw-ta.has-hover ? 0.24 : 0.17);
    animate background { duration: 130ms; }
    Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.on-accent : Theme.text.with-alpha(0.86);
        animate x { duration: 130ms; easing: ease-out; }
    }
    sw-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

component SInput inherits Rectangle {
    in-out property <string> text;
    in property <string> leading-emoji: "";
    in property <image> leading-emoji-image;
    in property <bool> leading-emoji-image-available: false;
    in property <bool> hide-text-when-leading-emoji: false;
    in property <string> placeholder: "";
    in property <string> suffix: "";
    in property <bool> disabled: false;
    callback edited;
    callback accepted;
    height: 34px;
    min-width: 60px;
    border-radius: 9px;
    background: SUi.field;
    border-width: 1px;
    border-color: si-text.has-focus ? Theme.accent.with-alpha(0.85) : SUi.field-line;
    opacity: root.disabled ? 0.45 : 1.0;
    animate border-color { duration: 120ms; }
    TouchArea { enabled: !root.disabled; clicked => { si-text.focus(); } }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 6px;
        if root.leading-emoji != "": NudgeEmoji {
            width: 22px;
            height: 22px;
            emoji: root.leading-emoji;
            rendered-image: root.leading-emoji-image;
            rendered-image-available: root.leading-emoji-image-available;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "" && root.placeholder != "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            si-text := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: root.hide-text-when-leading-emoji ? #00000000 : Theme.text;
                font-size: 13px;
                single-line: true;
                vertical-alignment: center;
                enabled: !root.disabled;
                edited => { root.edited(); }
                accepted => { root.accepted(); }
            }
        }
        if root.suffix != "": Text { text: root.suffix; color: Theme.text-faint; font-size: 11px; vertical-alignment: center; }
    }
}

component SSegItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    min-width: 40px;
    preferred-width: seg-text.preferred-width + 28px;
    border-radius: 8px;
    background: root.selected ? Theme.accent.with-alpha(0.22) : (seg-ta.has-hover ? SUi.hover : transparent);
    animate background { duration: 120ms; }
    seg-text := Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text-dim;
        font-size: 12px;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    // Area klik harus eksplisit memenuhi seluruh segmen. Tanpa ukuran eksplisit,
    // TouchArea dapat mewarisi ukuran intrinsik kecil dan klik di sisi label tidak diterima.
    seg-ta := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SSeg inherits Rectangle {
    height: 34px;
    horizontal-stretch: 0;
    preferred-width: seg-row.preferred-width;
    border-radius: 11px;
    background: SUi.field;
    border-width: 1px;
    border-color: SUi.card-line;
    seg-row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        @children
    }
}

// Delapan ekspresi mata, dipakai di tab Mata dan Pesan diam.
component SMoodSeg inherits Rectangle {
    in property <string> value;
    callback picked(string);
    height: 34px;
    horizontal-stretch: 0;
    preferred-width: mood-row.preferred-width;
    border-radius: 11px;
    background: SUi.field;
    border-width: 1px;
    border-color: SUi.card-line;
    mood-row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        SSegItem { label: "Normal"; selected: root.value == "normal"; clicked => { root.picked("normal"); } }
        SSegItem { label: "Senang"; selected: root.value == "happy"; clicked => { root.picked("happy"); } }
        SSegItem { label: "Mengantuk"; selected: root.value == "sleepy"; clicked => { root.picked("sleepy"); } }
        SSegItem { label: "Jatuh cinta"; selected: root.value == "love"; clicked => { root.picked("love"); } }
        SSegItem { label: "Kaget"; selected: root.value == "surprised"; clicked => { root.picked("surprised"); } }
        SSegItem { label: "Marah"; selected: root.value == "angry"; clicked => { root.picked("angry"); } }
        SSegItem { label: "Curiga"; selected: root.value == "suspicious"; clicked => { root.picked("suspicious"); } }
        SSegItem { label: "Sedih"; selected: root.value == "sad"; clicked => { root.picked("sad"); } }
    }
}

// Pilihan tunggal berbentuk pil, untuk daftar yang terlalu panjang bagi satu segmented control.
component SPill inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    height: 34px;
    horizontal-stretch: 1;
    min-width: 0px;
    border-radius: 17px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent.with-alpha(0.6) : SUi.field-line;
    background: root.selected ? Theme.accent.with-alpha(0.16) : (pill-ta.has-hover ? SUi.hover : transparent);
    animate background { duration: 120ms; }
    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text;
        font-size: 12px;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    pill-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Kotak centang berbentuk ubin: dipakai untuk daftar halaman dan pemicu komentar.
component PageToggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback toggled(bool);
    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: checked ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(ta.has-hover ? 0.18 : 0.09);
    background: checked ? Theme.accent.with-alpha(0.13) : Theme.text.with-alpha(ta.has-hover ? 0.08 : 0.035);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 5px;
                border-width: 1px;
                border-color: checked ? Theme.accent : Theme.text-faint;
                background: checked ? Theme.accent : transparent;
                animate background { duration: 120ms; }
                Text { text: checked ? "✓" : ""; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.label; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

// Satu baris pengaturan: judul dan keterangan di kiri, kontrol di kanan.
component SRow inherits VerticalLayout {
    in property <string> title;
    in property <string> desc: "";
    in property <bool> first: false;
    spacing: 0px;
    if !root.first: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Rectangle { height: 1px; background: SUi.divider; }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 13px; wrap: word-wrap; }
            if root.desc != "": Text { text: root.desc; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                @children
            }
        }
    }
}

// Satu blok pengaturan: judul di atas, kontrol selebar kartu di bawahnya.
component SBlock inherits VerticalLayout {
    in property <string> title;
    in property <string> desc: "";
    in property <bool> first: false;
    spacing: 0px;
    if !root.first: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Rectangle { height: 1px; background: SUi.divider; }
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        VerticalLayout {
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 13px; wrap: word-wrap; }
            if root.desc != "": Text { text: root.desc; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
        }
        @children
    }
}

component SCard inherits Rectangle {
    in property <string> title: "";
    in property <string> desc: "";
    in property <string> action: "";
    callback action-clicked;
    background: SUi.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: SUi.card-line;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 6px;
        spacing: 0px;
        if root.title != "": HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            padding-top: 14px;
            padding-bottom: 8px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; }
                if root.desc != "": Text { text: root.desc; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
            }
            if root.action != "": VerticalLayout {
                horizontal-stretch: 0;
                alignment: start;
                SButton { quiet: true; label: root.action; clicked => { root.action-clicked(); } }
            }
        }
        @children
    }
}

component SKeycap inherits Rectangle {
    in property <string> keys;
    height: 28px;
    horizontal-stretch: 0;
    preferred-width: key-text.preferred-width + 22px;
    border-radius: 7px;
    background: SUi.field;
    border-width: 1px;
    border-color: SUi.field-line;
    key-text := Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.keys;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SSwatch inherits Rectangle {
    in property <color> tint;
    in property <bool> selected: false;
    callback clicked;
    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 16px;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text;
    background: transparent;
    Rectangle {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;
        border-radius: self.width / 2;
        background: root.tint;
    }
    sw-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    // Langkah dalam persen supaya nilai tetap bulat (1.05, bukan 1.0500000000000003).
    in property <float> step-percent: 5.0;
    callback changing(float);
    callback released(float);
    height: 28px;
    property <float> frac: (clamp(root.value, root.minimum, root.maximum) - root.minimum) / max(root.maximum - root.minimum, 0.0001);
    function set-from-x(px: length) {
        root.value = clamp(Math.round((root.minimum + (px / max(root.width, 1px)) * (root.maximum - root.minimum)) * 100 / root.step-percent) * root.step-percent / 100, root.minimum, root.maximum);
        root.changing(root.value);
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width * root.frac;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: (parent.width - self.width) * root.frac;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        border-width: 4px;
        border-color: Theme.accent;
    }
    sl-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.set-from-x(self.mouse-x); }
        moved => { if self.pressed { root.set-from-x(self.mouse-x); } }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) { root.released(root.value); }
        }
    }
}

component SettingsEmojiButton inherits Rectangle {
    in property <string> emoji;
    in property <image> emoji-image;
    in property <bool> selected: false;
    in property <bool> interactive: true;
    callback clicked;
    width: 36px;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 9px;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent;
    background: emoji-ta.has-hover ? SUi.hover : SUi.field;
    Image { source: root.emoji-image; x: 5px; y: 4px; width: 26px; height: 26px; image-fit: contain; }
    emoji-ta := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <string> commands;
    in property <bool> active: false;
    callback clicked;
    height: 38px;
    border-radius: 10px;
    background: root.active ? Theme.accent.with-alpha(0.16) : (nav-ta.has-hover ? SUi.hover : transparent);
    animate background { duration: 130ms; }
    Path {
        x: 12px;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.active ? Theme.accent : Theme.text-dim;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    Text {
        x: 40px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.accent : Theme.text;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    nav-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SettingsChoiceCard inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <color> tint: #ff83c9;
    in property <string> preview-kind: "eyes";
    in property <bool> selected: false;
    callback clicked;
    horizontal-stretch: 1;
    min-width: 0px;
    height: 116px;
    border-radius: 12px;
    background: root.selected ? Theme.accent.with-alpha(0.14) : (cc-ta.has-hover ? Theme.text.with-alpha(0.07) : Theme.text.with-alpha(0.035));
    animate background { duration: 120ms; }
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : SUi.card-line;
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 60px;
        border-radius: 8px;
        background: #0b0e15;
        if root.preview-kind == "eyes": Rectangle {
            x: (parent.width - 30px) / 2;
            y: (parent.height - 20px) / 2;
            width: 30px;
            height: 20px;
            Rectangle { x: 0px; width: 10px; height: 20px; border-radius: 7px; background: root.tint; Rectangle { x: 2px; y: 3px; width: 3px; height: 5px; border-radius: 2px; background: #ffffffd9; } }
            Rectangle { x: 20px; width: 10px; height: 20px; border-radius: 7px; background: root.tint; Rectangle { x: 2px; y: 3px; width: 3px; height: 5px; border-radius: 2px; background: #ffffffd9; } }
        }
        if root.preview-kind == "notch": Rectangle {
            x: (parent.width - 88px) / 2;
            y: 0px;
            width: 88px;
            height: 31px;
            border-bottom-left-radius: 11px;
            border-bottom-right-radius: 11px;
            background: #03050b;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Rectangle { width: 5px; height: 5px; border-radius: 3px; background: root.tint; }
                Rectangle { width: 5px; height: 5px; border-radius: 3px; background: root.tint; }
                Text { text: root.label; color: #ffffff; font-size: 7px; vertical-alignment: center; }
            }
        }
    }
    VerticalLayout {
        x: 10px;
        y: 74px;
        width: parent.width - 20px;
        height: 36px;
        spacing: 1px;
        Text { text: root.label; color: Theme.text; font-size: 12px; font-weight: 700; overflow: elide; }
        Text { text: root.detail; color: Theme.text-dim; font-size: 11px; overflow: elide; }
    }
    cc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SettingsWindow inherits Window {
    title: "Notch — Pengaturan";
    icon: @image-url("../assets/tray.png");
    // Ruang kerja sedikit lebih lega agar grid kartu dan preview seimbang seperti referensi Tauri.
    preferred-width: 1240px;
    preferred-height: 860px;
    min-width: 1080px;
    min-height: 700px;
    // Theme diisi Rust (tiap jendela punya instance global sendiri). Latar sedikit lebih terang dari badan notch agar kartu tetap terbaca.
    background: Theme.body;
    default-font-size: 13px;
    property <string> active-tab: "appearance";
