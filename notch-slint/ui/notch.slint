// Notch (Slint). Hub dengan tab dinamis (mengikuti `pages` di config.toml), bahu melengkung,
// dan tema dari `[appearance]`. Semua warna berasal dari `Theme`, yang diisi Rust saat start.

export struct NoteItem { id: string, text: string, preview: string, meta: string }
export struct ShelfItem { path: string, name: string, dir: bool }
export struct ClipboardItem { preview: string, text: string }
export struct ReminderItem { id: string, text: string, due: string, done: bool }
export struct PrayerItem { name: string, time: string, state: int }
// Satu sel kalender. kind: 0 = biasa, 1 = libur, 2 = cuti bersama, 3 = hari peringatan.
export struct StatsView {
    host: string,
    cpu: float, ram: float, swap: float, disk: float,
    cpu-v: string, ram-v: string, swap-v: string, disk-v: string,
    cpu-meta: string, ram-meta: string, swap-meta: string, disk-meta: string,
    down: string, up: string, processes: string, uptime: string, os: string, kernel: string,
}
export struct CurrencyView {
    amount: string, code: string, name: string, result: string, rate: string, alert-rate: string,
    updated: string, warning: string, stock-period: string, stock-status: string, error: string, loading: bool,
}
export struct FxChartPoint { x: float, y: float, left: float, right: float, date: string, value: string }
export struct StockRow { name: string, price: string, change: string, positive: bool }
export struct CurrencyAlertItem { id: string, text: string, stock: bool, repeat: bool, armed: bool }
export struct CurrencyItem { code: string, name: string, value: string, selected: bool }
export struct CalCell { day: int, in-month: bool, sun: bool, today: bool, sel: bool, kind: int }

export global Theme {
    in-out property <color> body: #000000;
    in-out property <color> text: #ffffff;
    in-out property <color> text-dim: #ffffff9e;
    in-out property <color> text-faint: #ffffff6b;
    in-out property <color> accent: #788cff;
    in-out property <color> on-accent: #ffffff;
    in-out property <color> ok: #7bdc9a;
    in-out property <color> chip: #ffffff1a;
    in-out property <color> chip-hover: #ffffff2e;
    in-out property <color> track: #ffffff1f;
}

// Ikon garis (kotak 24x24), digambar dengan Path agar tidak perlu decoder gambar/SVG.
global Icons {
    out property <string> media: "M 9 18 V 5 L 21 3 V 16 M 3 18 A 3 3 0 1 0 9 18 A 3 3 0 1 0 3 18 M 15 16 A 3 3 0 1 0 21 16 A 3 3 0 1 0 15 16";
    out property <string> clock: "M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 M 12 6 V 12 L 16 14";
    out property <string> prayer: "M 4 21 V 11 L 12 4 L 20 11 V 21 Z M 9 21 V 14 H 15 V 21";
    out property <string> weather: "M 7 18 A 4 4 0 0 1 7 10 A 6 6 0 0 1 18.5 11 A 3.5 3.5 0 0 1 18 18 Z";
    out property <string> battery: "M 4 7 H 16 A 2 2 0 0 1 18 9 V 15 A 2 2 0 0 1 16 17 H 4 A 2 2 0 0 1 2 15 V 9 A 2 2 0 0 1 4 7 Z M 22 11 V 13";
    out property <string> shelf: "M 3 4 H 21 V 8 H 3 Z M 5 8 V 20 H 19 V 8 M 10 12 H 14";
    out property <string> reminder: "M 6 16 V 11 A 6 6 0 0 1 18 11 V 16 L 20 18 H 4 Z M 10 21 H 14";
    out property <string> notes: "M 6 2 H 14 L 20 8 V 20 A 2 2 0 0 1 18 22 H 6 A 2 2 0 0 1 4 20 V 4 A 2 2 0 0 1 6 2 Z M 8 13 H 16 M 8 17 H 13";
    out property <string> clipboard: "M 8 4 H 16 V 7 H 8 Z M 6 5 H 18 V 21 H 6 Z";
    out property <string> timer: "M 10 2 H 14 M 12 14 L 15 11 M 4 14 A 8 8 0 1 0 20 14 A 8 8 0 1 0 4 14";
    out property <string> grid: "M 3 3 H 10 V 10 H 3 Z M 14 3 H 21 V 10 H 14 Z M 14 14 H 21 V 21 H 14 Z M 3 14 H 10 V 21 H 3 Z";
    out property <string> wrench: "M 14.7 6.3 A 4 4 0 0 0 20 3.5 L 16.5 7 L 15 5.5 L 18.5 2 A 4 4 0 0 0 13.5 8.3 L 3.5 18.3 A 1.8 1.8 0 0 0 6 20.8 Z";
    out property <string> stats: "M 12 14 L 16 10 M 3.34 19 A 10 10 0 1 1 20.66 19";
    out property <string> lyrics: "M 4 6 H 20 M 4 12 H 16 M 4 18 H 12";
    out property <string> privacy: "M 12 3 L 20 6 V 12 A 9 9 0 0 1 12 21 A 9 9 0 0 1 4 12 V 6 Z";
    out property <string> android: "M 6 9 H 18 V 18 H 6 Z M 8 5 L 6 2 M 16 5 L 18 2 M 9 12 V 13 M 15 12 V 13 M 9 18 V 21 M 15 18 V 21";
    out property <string> transfer: "M 4 7 H 20 M 16 3 L 20 7 L 16 11 M 20 17 H 4 M 8 13 L 4 17 L 8 21";
    out property <string> convert: "M 5 7 H 19 L 16 4 M 19 7 L 16 10 M 19 17 H 5 L 8 14 M 5 17 L 8 20";
    out property <string> compress: "M 4 4 L 10 10 M 4 4 V 9 M 4 4 H 9 M 20 4 L 14 10 M 20 4 V 9 M 20 4 H 15 M 4 20 L 10 14 M 4 20 V 15 M 4 20 H 9 M 20 20 L 14 14 M 20 20 V 15 M 20 20 H 15";
    out property <string> currency: "M 16 8 C 15 6 9 6 8 9 C 7 12 17 11 16 15 C 15 18 9 18 8 16 M 12 5 V 19";
    out property <string> currency-exchange: "M 7 7 H 20 L 17 4 M 20 7 L 17 10 M 17 17 H 4 L 7 20 M 4 17 L 7 14 M 12 3 V 21";
    out property <string> settings: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 5 M 12 19 V 22 M 2 12 H 5 M 19 12 H 22 M 5 5 L 7 7 M 17 17 L 19 19 M 19 5 L 17 7 M 7 17 L 5 19";
    out property <string> test: "M 12 3 V 21 M 4 7.5 L 20 16.5 M 20 7.5 L 4 16.5";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> camera: "M 3 8 A 2 2 0 0 1 5 6 H 7.5 L 9 4 H 15 L 16.5 6 H 19 A 2 2 0 0 1 21 8 V 18 A 2 2 0 0 1 19 20 H 5 A 2 2 0 0 1 3 18 Z M 8.5 13 A 3.5 3.5 0 1 0 15.5 13 A 3.5 3.5 0 1 0 8.5 13";
    // Ikon lencana privasi (setara SVG di index.html Tauri), digambar gelap di dalam lencana berwarna.
    out property <string> badge-cam: "M 4 8 H 7 L 9 5 H 15 L 17 8 H 20 V 19 H 4 Z M 8.5 13 A 3.5 3.5 0 1 0 15.5 13 A 3.5 3.5 0 1 0 8.5 13";
    out property <string> badge-mic: "M 9 6 A 3 3 0 0 1 15 6 V 11 A 3 3 0 0 1 9 11 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 V 21";
    out property <string> mic: "M 12 2 A 3 3 0 0 0 9 5 V 12 A 3 3 0 0 0 15 12 V 5 A 3 3 0 0 0 12 2 Z M 19 10 V 12 A 7 7 0 0 1 5 12 V 10 M 12 19 V 22";
    out property <string> wifi: "M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 20 L 12.1 20";
    out property <string> bluetooth: "M 7 7 L 17 17 L 12 22 V 2 L 17 7 L 7 17";
    out property <string> awake: "M 4 8 H 17 V 15 A 4 4 0 0 1 13 19 H 8 A 4 4 0 0 1 4 15 Z M 17 10 H 19 A 2 2 0 0 1 19 14 H 17 M 7 2 V 5 M 11 2 V 5";
    out property <string> moon: "M 21 12.8 A 9 9 0 1 1 11.2 3 A 7 7 0 0 0 21 12.8 Z";
    out property <string> lock: "M 5 11 H 19 V 21 H 5 Z M 8 11 V 7 A 4 4 0 0 1 16 7 V 11";
    out property <string> center: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 12 2 V 6 M 12 18 V 22 M 2 12 H 6 M 18 12 H 22";
    out property <string> reset: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 V 8 H 8";
    out property <string> copy: "M 8 4 H 16 A 2 2 0 0 1 18 6 V 18 A 2 2 0 0 1 16 20 H 8 A 2 2 0 0 1 6 18 V 6 A 2 2 0 0 1 8 4 Z M 4 16 H 3 A 2 2 0 0 1 1 14 V 4 A 2 2 0 0 1 3 2 H 13 A 2 2 0 0 1 15 4 V 5";
    out property <string> expand: "M 4 9 V 4 H 9 M 20 9 V 4 H 15 M 4 15 V 20 H 9 M 20 15 V 20 H 15";
    out property <string> refresh: "M 20 7 V 12 H 15 M 4 17 V 12 H 9 M 5.6 9 A 7 7 0 0 1 17.5 6 L 20 12 M 4 12 L 6.5 18 A 7 7 0 0 0 18.4 15";

    pure public function for-page(id: string) -> string {
        if id == "media" { return Icons.media; }
        if id == "clock" { return Icons.clock; }
        if id == "prayer" { return Icons.prayer; }
        if id == "weather" { return Icons.weather; }
        if id == "battery" { return Icons.battery; }
        if id == "shelf" { return Icons.shelf; }
        if id == "reminder" { return Icons.reminder; }
        if id == "notes" { return Icons.notes; }
        if id == "clipboard" { return Icons.clipboard; }
        if id == "timer" { return Icons.timer; }
        if id == "quick" { return Icons.grid; }
        if id == "tools" { return Icons.wrench; }
        if id == "stats" { return Icons.stats; }
        if id == "lyrics" { return Icons.lyrics; }
        if id == "privacy" { return Icons.privacy; }
        if id == "android" { return Icons.android; }
        if id == "transfer" { return Icons.transfer; }
        if id == "convert" { return Icons.convert; }
        if id == "compress" { return Icons.compress; }
        if id == "currency" { return Icons.currency; }
        if id == "settings" { return Icons.settings; }
        return Icons.test;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    height: 28px;
    min-width: 64px;
    border-radius: 14px;
    background: root.selected ? Theme.accent.with-alpha(0.24) : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    Text {
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TabIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked;
    // Menyusut otomatis kalau tab terlalu banyak untuk lebar pil (preferensi 30 px, minimum 20 px).
    preferred-width: 30px;
    min-width: 20px;
    max-width: 30px;
    height: 30px;
    border-radius: 10px;
    background: active ? Theme.accent.with-alpha(0.22) : (ta.has-hover ? Theme.chip : transparent);
    border-width: active ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.34);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: 7px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.active ? Theme.text : Theme.text-dim;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// "Telinga" cekung di sisi pil (radius 10 px seperti `--e` di position.css). Menyatukan notch dengan
// tepi layar: di atas saat menempel ke atas, di bawah (dibalik) saat menempel ke dasar layar.
component Ear inherits Path {
    // Telinga cekung 10 px x skala. `kind`: 0 = atas-kiri, 1 = atas-kanan, 2 = bawah-kiri, 3 = bawah-kanan
    // (dock atas / bawah), 4 = sisi-kiri atas, 5 = sisi-kiri bawah, 6 = sisi-kanan atas, 7 = sisi-kanan bawah.
    // Sudut terisi selalu yang menyentuh tepi layar dan badan notch; busur memakai pusat di sudut diagonalnya.
    in property <int> kind: 0;
    in property <float> s: 1.0;      // skala dari config (telinga 10 px x scale)
    width: 10px * s;
    height: 10px * s;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: Theme.body;
    commands: kind == 0 ? "M 0 0 L 10 0 L 10 10 A 10 10 0 0 0 0 0 Z"
            : kind == 1 ? "M 10 0 L 0 0 L 0 10 A 10 10 0 0 1 10 0 Z"
            : kind == 2 ? "M 0 10 L 10 10 L 10 0 A 10 10 0 0 1 0 10 Z"
            : kind == 3 ? "M 10 10 L 0 10 L 0 0 A 10 10 0 0 0 10 10 Z"
            : kind == 4 ? "M 0 0 L 0 10 L 10 10 A 10 10 0 0 1 0 0 Z"
            : kind == 5 ? "M 0 0 L 10 0 A 10 10 0 0 0 0 10 Z"
            : kind == 6 ? "M 10 0 L 10 10 L 0 10 A 10 10 0 0 0 10 0 Z"
            : "M 10 0 L 0 0 A 10 10 0 0 1 10 10 Z";
}

export component StatBar inherits VerticalLayout {
    in property <string> label;
    in property <float> value;   // 0..100
    in property <string> text;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.text-dim; font-size: 11px; horizontal-stretch: 1; }
        Text { text: root.text; color: Theme.text; font-size: 11px; horizontal-alignment: right; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> commands;
    in property <length> size: 36px;
    in property <bool> primary: false;
    in property <bool> outline: false;   // ikon garis (tanpa isian)
    in property <float> icon-ratio: 0.42; // ukuran ikon relatif terhadap tombol
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? Theme.text : (ta.has-hover ? Theme.chip-hover : transparent);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * root.icon-ratio;
        height: root.size * root.icon-ratio;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: root.outline ? transparent : (root.primary ? Theme.body : Theme.text);
        stroke: root.primary ? Theme.body : Theme.text;
        stroke-width: root.outline ? 1.6px : 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component EqBars inherits HorizontalLayout {
    // Equalizer 4 batang (`.bars` di media.css): hanya bergerak saat media diputar.
    in property <bool> playing: false;
    spacing: 3px;
    alignment: end;
    for i in 4: Rectangle {
        width: 3px;
        y: parent.height - self.height;
        height: root.playing ? 4px + 10px * Math.abs(Math.sin((animation-tick() / 520ms * 360 + i * 70) * 1deg)) : 4px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

component MediaPlayer inherits HorizontalLayout {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    callback open-lyrics;

    // Tata letak `.p-media` di Tauri: padding 4 26 14 20, jarak 14, cover 80x80 radius 16.
    padding-left: 20px;
    padding-right: 26px;
    padding-top: 4px;
    padding-bottom: 14px;
    spacing: 14px;

    VerticalLayout {
        width: 80px;
        alignment: center;
        Rectangle {
            width: 80px;
            height: 80px;
            border-radius: 16px;
            background: Theme.chip;
            clip: true;
            if root.has-art: Image { source: root.art; width: 80px; height: 80px; image-fit: cover; }
            if !root.has-art: Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.media;
                fill: transparent;
                stroke: Theme.text-faint;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        alignment: space-between;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                Text { text: root.artist; color: Theme.text-dim; font-size: 12px; overflow: elide; }
            }
            EqBars { width: 24px; height: 14px; playing: root.playing; visible: root.playing; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.pos-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                height: 14px;
                background: transparent;
                Rectangle {
                    x: 0px;
                    y: 5px;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, Theme.accent.with-alpha(0.55), Theme.accent);
                    }
                    // Knob muncul saat hover (seperti #m-progress::after)
                    Rectangle {
                        x: parent.width * clamp(root.progress, 0, 1) - 4px;
                        y: -2px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.text;
                        visible: seek-area.has-hover || seek-area.pressed;
                    }
                }
                seek-area := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); }
                    moved => { if self.pressed { root.seek(clamp(self.mouse-x / max(self.width, 1px), 0, 1)); } }
                }
            }
            Text { text: root.dur-text; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 14px;
            RoundButton { size: 28px; icon-ratio: 0.62; commands: "M 19 20 L 9 12 L 19 4 Z M 5 19 V 5"; clicked => { root.prev(); } }
            RoundButton {
                primary: true;
                size: 34px;
                icon-ratio: 0.5;
                commands: root.playing ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
                clicked => { root.toggle(); }
            }
            RoundButton { size: 28px; icon-ratio: 0.62; commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.next(); } }
            // Tombol lirik berupa ikon garis (#m-lyrics), bukan chip bertuliskan "Lirik"
            RoundButton { size: 28px; icon-ratio: 0.6; outline: true; opacity: 0.6; commands: "M 4 6 H 20 M 4 12 H 14 M 4 18 H 17"; clicked => { root.open-lyrics(); } }
        }
    }
}

component LyricsPanel inherits Rectangle {
    in property <[string]> lines;
    in property <int> active: -1;
    callback back;
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 28px;
            alignment: start;
            Chip { label: "\u{2039} Media"; min-width: 76px; clicked => { root.back(); } }
            Text { text: "Lirik"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
        }
        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: "Lirik belum tersedia untuk lagu ini";
                color: Theme.text-faint;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-y: max(0px, root.active * 36px - self.height / 2 + 18px);
            content-width: self.width;
            content-height: max(self.height, root.lines.length * 36px);
            VerticalLayout {
                width: parent.width;
                spacing: 0px;
                for line[i] in root.lines: Rectangle {
                    height: 36px;
                    background: i == root.active ? Theme.chip : transparent;
                    border-radius: 9px;
                    Text {
                        text: line;
                        width: parent.width - 16px;
                        x: 8px;
                        y: 0px;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-alignment: center;
                        font-size: i == root.active ? 18px : 13px;
                        font-weight: i == root.active ? 700 : 400;
                        color: i == root.active ? Theme.text : Theme.text-faint;
                    }
                }
            }
        }
    }
}

// Halaman Media: pemutar + panel lirik di dalamnya (tombol "Lirik" membuka, "Media" kembali).
component MediaPage inherits Rectangle {
    in property <image> art;
    in property <bool> has-art: false;
    in property <string> title: "Tidak ada media";
    in property <string> artist: "Putar musik untuk memulai";
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0;
    in property <bool> playing: false;
    in property <[string]> lyric-lines;
    in property <int> lyric-active: -1;
    in-out property <bool> lyrics-open: false;
    callback prev;
    callback toggle;
    callback next;
    callback seek(float);
    MediaPlayer {
        width: parent.width;
        height: parent.height;
        visible: !root.lyrics-open;
        art: root.art; has-art: root.has-art; title: root.title; artist: root.artist;
        pos-text: root.pos-text; dur-text: root.dur-text; progress: root.progress; playing: root.playing;
        prev => { root.prev(); } toggle => { root.toggle(); } next => { root.next(); }
        seek(v) => { root.seek(v); }
        open-lyrics => { root.lyrics-open = true; }
    }
    if root.lyrics-open: LyricsPanel {
        lines: root.lyric-lines;
        active: root.lyric-active;
        back => { root.lyrics-open = false; }
    }
}

component ClockPage inherits HorizontalLayout {
    in property <string> clock-text;   // HH:MM
    in property <string> sec-text;     // detik (`#ck-sec`)
    in property <string> day-text;     // nama hari
    in property <string> date-text;    // tanggal lengkap
    callback open-calendar;
    // `.p-clock`: padding 0 34 0 26, jam 46px di kiri (detik 16px redup), hari + tanggal di kanan.
    padding-left: 26px;
    padding-right: 34px;
    spacing: 16px;
    alignment: stretch;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text { text: root.clock-text; color: Theme.text; font-size: 46px; font-weight: 700; letter-spacing: -1px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            padding-top: 14px;
            Text { text: root.sec-text; color: Theme.text-faint; font-size: 16px; }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    // Klik tanggal membuka kalender bulanan (seperti di Tauri)
    Rectangle {
        width: 190px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: root.day-text; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: right; }
            Text { text: root.date-text; color: da.has-hover ? Theme.text : Theme.text-dim; font-size: 12px; horizontal-alignment: right; }
        }
        da := TouchArea { clicked => { root.open-calendar(); } }
    }
}

component CalDay inherits Rectangle {
    in property <CalCell> c;
    callback clicked;
    width: 40px;
    height: 18px;
    border-radius: 9px;
    // jenis terpenting menentukan warna: libur > cuti > peringatan
    background: c.today ? Theme.accent
        : c.kind == 1 && c.in-month ? #ff6b6b29
        : c.kind == 2 && c.in-month ? #ffb34029
        : (ta.has-hover && c.in-month ? Theme.chip : transparent);
    border-width: c.sel ? 1.5px : 0px;
    border-color: Theme.text.with-alpha(0.7);
    Text {
        text: "\{c.day}";
        font-size: 11px;
        font-weight: c.today || (c.in-month && (c.kind == 1 || c.kind == 2)) ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: c.today ? #000000
            : !c.in-month ? Theme.text-faint
            : c.kind == 1 ? #ff6b6b
            : c.kind == 2 ? #ffb340
            : c.sun ? #ff7a7a : Theme.text;
    }
    // titik kecil di bawah angka untuk hari peringatan
    Rectangle {
        visible: c.kind == 3 && c.in-month;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: c.today ? #000000 : Theme.accent;
        x: (parent.width - self.width) / 2;
        y: parent.height - 4px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component CalendarPage inherits Rectangle {
    in property <[CalCell]> cells;
    in property <[string]> weekdays;
    in property <string> title;
    in property <string> foot-date;
    in property <string> foot-name;
    in property <int> foot-kind;
    callback prev;
    callback next;
    callback today;
    callback select(int);
    callback close;

    // Kisi 7 x 6 di kiri
    for wd[i] in root.weekdays: Text {
        x: 24px + i * 40px;
        y: 0px;
        width: 40px;
        height: 14px;
        text: wd;
        font-size: 10px;
        horizontal-alignment: center;
        color: i == 0 ? #ff7a7a : Theme.text-faint;
    }
    for cell[i] in root.cells: CalDay {
        x: 24px + Math.mod(i, 7) * 40px;
        y: 16px + Math.floor(i / 7) * 19px;
        c: cell;
        clicked => { root.select(i); }
    }

    // Judul, navigasi, dan keterangan di kanan
    VerticalLayout {
        x: 330px;
        y: 0px;
        width: parent.width - 330px - 20px;
        spacing: 10px;
        Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; height: 24px; overflow: elide; }
        HorizontalLayout {
            spacing: 6px;
            height: 26px;
            alignment: start;
            RoundButton { size: 26px; outline: true; commands: "M 15 5 L 8 12 L 15 19"; clicked => { root.prev(); } }
            RoundButton { size: 26px; outline: true; commands: "M 9 5 L 16 12 L 9 19"; clicked => { root.next(); } }
            Chip { label: "Hari ini"; height: 26px; clicked => { root.today(); } }
            RoundButton { size: 26px; outline: true; commands: Icons.close; clicked => { root.close(); } }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 10px;
                height: 10px;
                y: 3px;
                border-radius: 5px;
                background: root.foot-kind == 1 ? #ff6b6b
                    : root.foot-kind == 2 ? #ffb340
                    : root.foot-kind == 3 ? Theme.accent : Theme.text-faint;
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: root.foot-date; color: Theme.text-dim; font-size: 11px; }
                Text { text: root.foot-name; color: Theme.text; font-size: 13px; wrap: word-wrap; max-height: 44px; overflow: elide; }
            }
        }
    }
}

component TimerPage inherits VerticalLayout {
    in property <string> pomo-text;
    in property <string> pomo-label;
    in property <float> pomo-progress;   // 0..1
    in property <bool> pomo-running;
    in property <bool> pomo-rest;
    callback toggle;
    callback reset;
    callback skip;
    // `.p-timer`: padding 0 34 20 26, jarak 8, tengah vertikal; waktu 38px, bar 5px, tombol 30/36.
    alignment: center;
    spacing: 8px;
    padding-left: 26px;
    padding-right: 34px;
    padding-bottom: 20px;

    HorizontalLayout {
        Text { text: root.pomo-text; color: Theme.text; font-size: 38px; font-weight: 700; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.pomo-label; color: Theme.text-dim; font-size: 12px; vertical-alignment: bottom; horizontal-alignment: right; }
    }
    Rectangle {
        height: 5px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.pomo-progress, 0, 1);
            height: parent.height;
            border-radius: 3px;
            background: root.pomo-rest ? Theme.ok : Theme.accent;
            animate width { duration: 500ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        padding-top: 4px;
        RoundButton { outline: true; size: 30px; icon-ratio: 0.55; commands: Icons.reset; clicked => { root.reset(); } }
        RoundButton {
            primary: true;
            size: 36px;
            icon-ratio: 0.5;
            commands: root.pomo-running ? "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z" : "M 7 4 L 20 12 L 7 20 Z";
            clicked => { root.toggle(); }
        }
        RoundButton { size: 30px; icon-ratio: 0.55; commands: "M 5 4 L 15 12 L 5 20 Z M 19 5 V 19"; clicked => { root.skip(); } }
    }
}

component StatMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> meta;
    in property <float> value;        // 0..100
    in property <float> hot-at: 90;   // di atas ini bar merah (`.hot`)
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    spacing: 2px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: root.label; color: Theme.text-dim; font-size: 11px; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.value-text; color: Theme.text; font-size: 11px; font-weight: 700; horizontal-alignment: right; }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: parent.height;
            border-radius: 2px;
            background: root.value >= root.hot-at ? #ff626b : Theme.accent;
            animate width { duration: 550ms; easing: ease-out; }
        }
    }
    Text { text: root.meta; color: Theme.text-faint; font-size: 9px; overflow: elide; preferred-width: 0px; min-width: 0px; }
}



component StatsPage inherits VerticalLayout {
    in property <StatsView> d;
    // `.p-stats`: padding 3 26 8, jarak 4; kepala, grid 2x2 (CPU/RAM/SWAP/PENYIMPANAN), footer 3 baris.
    spacing: 4px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 3px;
    padding-bottom: 8px;
    HorizontalLayout {
        spacing: 10px;
        Text { text: "STATUS SISTEM"; color: Theme.text-dim; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; }
        Text { text: root.d.host; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
    }
    GridLayout {
        spacing-horizontal: 18px;
        spacing-vertical: 4px;
        Row {
            StatMetric { label: "CPU"; value: root.d.cpu; value-text: root.d.cpu-v; meta: root.d.cpu-meta; hot-at: 85; }
            StatMetric { label: "RAM"; value: root.d.ram; value-text: root.d.ram-v; meta: root.d.ram-meta; }
        }
        Row {
            StatMetric { label: "SWAP"; value: root.d.swap; value-text: root.d.swap-v; meta: root.d.swap-meta; }
            StatMetric { label: "PENYIMPANAN"; value: root.d.disk; value-text: root.d.disk-v; meta: root.d.disk-meta; }
        }
    }
    Rectangle { vertical-stretch: 1; }
    VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            Text { text: root.d.down; color: Theme.text-dim; font-size: 10px; horizontal-stretch: 1; }
            Text { text: root.d.up; color: Theme.text-dim; font-size: 10px; horizontal-alignment: right; }
        }
        HorizontalLayout {
            Text { text: root.d.processes; color: Theme.text-faint; font-size: 10px; horizontal-stretch: 1; }
            Text { text: root.d.uptime; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; }
        }
        HorizontalLayout {
            spacing: 12px;
            Text { text: root.d.os; color: Theme.text-faint; font-size: 10px; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.d.kernel; color: Theme.text-faint; font-size: 10px; horizontal-alignment: right; overflow: elide; }
        }
    }
}

component BatteryPage inherits VerticalLayout {
    in property <bool> present: true;
    in property <int> percent: 0;
    in property <bool> charging: false;
    // `.p-battery`: padding 0 34 0 26, jarak 14, tengah vertikal; persen 34px, bar 8px.
    alignment: center;
    spacing: 14px;
    padding-left: 26px;
    padding-right: 34px;
    if !root.present: Text {
        text: "Tidak ada baterai (PC desktop)";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
    }
    if root.present: HorizontalLayout {
        Text {
            text: root.percent + "%";
            color: root.percent <= 20 && !root.charging ? #ff8a8a : Theme.text;
            font-size: 34px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.charging ? "Sedang mengisi" : "Tidak mengisi";
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: bottom;
            horizontal-alignment: right;
        }
    }
    if root.present: Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: root.charging ? #ffd60a : (root.percent <= 20 ? #ff8a8a : #7dffb0);
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
}

component WeatherPage inherits HorizontalLayout {
    in property <string> city;
    in property <string> temperature;
    in property <string> condition;
    in property <string> feels;
    in property <string> humidity;
    in property <string> rain;
    in property <string> icon;
    in property <string> status;
    callback refresh();

    // `.p-weather`: ikon bulat 58px (klik = perbarui), suhu 34px + kondisi 12px, meta rata kanan.
    padding-left: 26px;
    padding-right: 34px;
    spacing: 16px;

    VerticalLayout {
        width: 58px;
        alignment: center;
        Rectangle {
            width: 58px;
            height: 58px;
            border-radius: 29px;
            background: Theme.accent.with-alpha(0.16);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.34);
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 30px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: Theme.text;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                visible: root.icon != "";
            }
            TouchArea { clicked => { root.refresh(); } }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.temperature; color: Theme.text; font-size: 34px; font-weight: 700; }
        Text { text: root.condition; color: Theme.text-dim; font-size: 12px; overflow: elide; }
        Text { text: root.status; color: #ff9b8f; font-size: 10px; wrap: word-wrap; visible: root.status != ""; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        min-width: 110px;
        Text { text: root.city; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-alignment: right; overflow: elide; }
        Text { text: root.feels; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
        Text { text: root.humidity; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
        Text { text: root.rain; color: Theme.accent; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
    }
}

component ShelfPage inherits VerticalLayout {
    in property <[ShelfItem]> items;
    in property <string> status: "File yang disimpan di sini tidak disalin";
    callback add();
    callback open(string);
    callback reveal(string);
    callback remove(string);
    callback clear();
    padding-left: 12px; padding-right: 12px; padding-top: 6px; spacing: 6px;
    HorizontalLayout {
        Text { text: "Shelf"; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-stretch: 1; }
        Chip { label: "Tambah file"; clicked => { root.add(); } }
        Chip { label: "Bersihkan"; clicked => { root.clear(); } }
    }
    Text { text: root.status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
    if root.items.length == 0: Text { text: "Belum ada file. Tambahkan file atau folder untuk menyimpannya di Shelf."; color: Theme.text-faint; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    for item in root.items: Rectangle {
        height: 44px; border-radius: 9px; background: #ffffff0b;
        HorizontalLayout {
            padding-left: 8px; padding-right: 6px; spacing: 5px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 2px;
                Text { text: item.dir ? "📁 " + item.name : "📄 " + item.name; color: Theme.text; font-size: 10px; overflow: elide; }
                Text { text: item.path; color: Theme.text-faint; font-size: 8px; overflow: elide; }
            }
            Chip { label: "Buka"; clicked => { root.open(item.path); } }
            Chip { label: "Lokasi"; clicked => { root.reveal(item.path); } }
            RoundButton { size: 22px; commands: Icons.close; outline: true; clicked => { root.remove(item.path); } }
        }
    }
}
component NoteIconButton inherits Rectangle {
    in property <string> commands;
    in property <string> badge: "";
    in property <bool> danger: false;
    in property <angle> turn: 0deg;
    callback clicked;
    border-radius: 9px;
    background: root.danger ? #ef4444 : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: Theme.text;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        transform-rotation: root.turn;
        opacity: ta.has-hover ? 1 : 0.82;
    }
    if root.badge != "": Rectangle {
        x: parent.width - self.width + 5px;
        y: -5px;
        width: max(13px, badge-text.preferred-width + 6px);
        height: 13px;
        border-radius: 7px;
        background: Theme.accent;
        badge-text := Text { text: root.badge; color: #000000; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NotesPage inherits VerticalLayout {
    in property <[NoteItem]> notes;
    in property <[ShelfItem]> shelf-items;
    in property <string> shelf-status: "File yang disimpan di sini tidak disalin";
    // Daftar catatan hanya tampil saat diperluas (hub ikut menjadi 300 px, seperti `notes-expanded` di Tauri).
    in-out property <bool> expanded: false;
    callback add(string);
    callback remove(string);
    callback open(string);
    callback clear();
    callback expand-toggled(bool);
    property <bool> confirm-clear: false;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 12px;
    padding-bottom: 14px;
    spacing: 8px;

    Timer { interval: 3s; running: root.confirm-clear; triggered => { root.confirm-clear = false; } }

    HorizontalLayout {
        height: 86px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 12px;
            background: input.has-focus ? Theme.chip-hover : Theme.chip;
            border-width: input.has-focus ? 1.5px : 0px;
            border-color: Theme.accent.with-alpha(0.55);
            FocusScope {
                // Enter menambah catatan, Shift+Enter baris baru (sama dengan #nt-input di Tauri).
                capture-key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) {
                        root.add(input.text);
                        input.text = "";
                        return accept;
                    }
                    return reject;
                }
                input := TextInput {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 28px;
                    height: parent.height - 20px;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
            if input.text == "": Text {
                x: 14px;
                y: 10px;
                text: "Tulis catatan baru\u{2026}";
                color: Theme.text-faint;
                font-size: 14px;
            }
        }
        VerticalLayout {
            width: 36px;
            spacing: 4px;
            NoteIconButton { commands: "M 12 5 V 19 M 5 12 H 19"; clicked => { root.add(input.text); input.text = ""; } }
            NoteIconButton {
                commands: root.expanded ? "M 6 15 L 12 9 L 18 15" : "M 6 9 L 12 15 L 18 9";
                clicked => { root.expanded = !root.expanded; root.expand-toggled(root.expanded); }
            }
            NoteIconButton {
                commands: "M 4 7 H 20 M 9 7 V 4 H 15 V 7 M 6 7 L 7 20 H 17 L 18 7 M 10 11 V 16 M 14 11 V 16";
                badge: root.notes.length > 0 ? root.notes.length : "";
                danger: root.confirm-clear;
                clicked => {
                    if (root.notes.length == 0) { return; }
                    if (root.confirm-clear) { root.confirm-clear = false; root.clear(); } else { root.confirm-clear = true; }
                }
            }
        }
    }

    if root.expanded && root.notes.length == 0: Text {
        text: "Belum ada catatan";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.expanded && root.notes.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: root.notes.length * 62px;
        VerticalLayout {
            width: parent.width;
            spacing: 6px;
            for n in root.notes: Rectangle {
                height: 56px;
                border-radius: 12px;
                background: card-ta.has-hover ? Theme.chip-hover : Theme.chip;
                // Klik kartu membuka jendela detail catatan (note-detail di Tauri).
                card-ta := TouchArea { clicked => { root.open(n.id); } }
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 30px;
                    padding-top: 7px;
                    padding-bottom: 6px;
                    spacing: 3px;
                    Text { text: n.text; color: Theme.text; font-size: 12.5px; wrap: word-wrap; overflow: elide; height: 34px; vertical-alignment: top; }
                    Text { text: n.meta; color: Theme.text-faint; font-size: 10px; overflow: elide; }
                }
                RoundButton {
                    x: parent.width - 28px;
                    y: 6px;
                    size: 20px;
                    commands: Icons.close;
                    outline: true;
                    clicked => { root.remove(n.id); }
                }
            }
        }
    }
}

component CurrencyPage inherits VerticalLayout {
    in property <CurrencyView> d;
    in-out property <string> amount;
    in property <[StockRow]> gainers;
    in property <[StockRow]> losers;
    in property <[CurrencyAlertItem]> alerts;
    in property <[CurrencyItem]> currencies;
    in property <[FxChartPoint]> chart-points;
    callback refresh();
    callback amount-edited(string);
    callback quick(int);
    callback step-target(int);
    callback add-alert(bool, string, bool, string, bool);
    callback remove-alert(string);
    callback chart-request(string, int);
    callback select-currency(string, int);
    in property <string> chart-line;
    in property <string> chart-area;
    in property <string> chart-status;
    in property <string> chart-max;
    in property <string> chart-y1;
    in property <string> chart-y2;
    in property <string> chart-min;
    in property <string> chart-date-start;
    in property <string> chart-date-mid;
    in property <string> chart-date-end;
    in property <float> chart-dot-y: 50;
    in property <string> chart-last;
    in property <string> chart-change;
    in property <bool> chart-up: true;
    property <bool> alert-mode: false;
    property <bool> above: true;
    property <bool> picker-open: false;
    property <bool> alert-stock-mode: false;
    property <string> alert-stock-code: "BBCA";
    property <string> alert-currency-code: "USD";
    property <string> alert-currency-name: "Dolar AS";
    property <bool> alert-repeat: false;
    // Mode diperluas tetap mempertahankan header, sama seperti halaman Currency Tauri.
    in-out property <bool> expanded: false;
    property <int> range: 0;
    function request-chart() { root.chart-request(root.d.code, [30, 90, 180, 365][root.range]); }

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 15px;
    padding-bottom: 18px;
    spacing: 14px;

    HorizontalLayout {
        height: 42px;
        spacing: 12px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.30);
            background: @linear-gradient(145deg, Theme.accent.with-alpha(0.24), Theme.accent.with-alpha(0.08));
            Path {
                x: 9px; y: 9px; width: 22px; height: 22px;
                viewbox-width: 24; viewbox-height: 24;
                commands: Icons.currency-exchange;
                fill: transparent;
                stroke: Theme.text;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            alignment: center;
            spacing: 2px;
            Text { text: "Currency"; color: Theme.text; font-size: 17px; font-weight: 800; }
            Text { text: root.d.error != "" ? "Kurs belum tersedia" : (root.d.warning != "" ? root.d.warning : (root.d.updated != "" ? root.d.updated : (root.d.loading ? "Menyiapkan kurs referensi..." : "Kurs referensi"))); color: root.d.error != "" ? #ff9b8f : Theme.text-faint; font-size: 10px; overflow: elide; }
        }
        Rectangle {
            width: 40px;
            height: 34px;
            border-radius: 11px;
            background: root.alert-mode ? Theme.accent.with-alpha(0.2) : (at-ta.has-hover ? Theme.chip-hover : Theme.chip);
            border-width: 1px;
            border-color: root.alert-mode ? Theme.accent.with-alpha(0.7) : Theme.text-faint.with-alpha(0.16);
            Path {
                x: 11px; y: 9px; width: 16px; height: 16px;
                viewbox-width: 24; viewbox-height: 24;
                commands: Icons.reminder;
                fill: transparent; stroke: root.alert-mode ? Theme.accent : Theme.text;
                stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
            }
            if root.alerts.length > 0: Rectangle {
                x: 27px; y: -5px; width: 15px; height: 15px;
                border-radius: 8px; background: Theme.accent;
                Text { text: root.alerts.length > 9 ? "9+" : "" + root.alerts.length; color: #ffffff; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
            at-ta := TouchArea { clicked => {
                root.alert-mode = !root.alert-mode;
                if (root.alert-mode) {
                    root.expanded = false;
                    root.alert-stock-mode = false;
                    root.alert-currency-code = root.d.code;
                    root.alert-currency-name = root.d.name;
                    root.alert-repeat = false;
                }
                root.picker-open = false;
            } }
        }
        Rectangle {
            width: 86px;
            height: 34px;
            border-radius: 11px;
            border-width: 1px;
            border-color: root.expanded ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.13);
            background: root.expanded ? Theme.accent.with-alpha(0.18) : (ex-ta.has-hover ? Theme.text.with-alpha(0.12) : Theme.text.with-alpha(0.055));
            HorizontalLayout {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                spacing: 7px;
                alignment: center;
                Rectangle {
                    width: 14px; height: parent.height;
                    background: transparent;
                    Path {
                        x: 0px; y: (parent.height - 14px) / 2;
                        width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.expand;
                        fill: transparent; stroke: Theme.text;
                        stroke-width: 1.9px; stroke-line-cap: round; stroke-line-join: round;
                    }
                }
                Text { height: parent.height; text: root.expanded ? "Ringkas" : "Perluas"; color: Theme.text; font-size: 11px; font-weight: 650; vertical-alignment: center; }
            }
            ex-ta := TouchArea { clicked => { root.alert-mode = false; root.expanded = !root.expanded; root.picker-open = false; if (root.expanded) { root.request-chart(); } } }
        }
        Rectangle {
            width: 90px;
            height: 34px;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.13);
            background: refresh-ta.has-hover ? Theme.text.with-alpha(0.12) : Theme.text.with-alpha(0.055);
            HorizontalLayout {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                spacing: 7px;
                alignment: center;
                Rectangle {
                    width: 14px; height: parent.height;
                    background: transparent;
                    Path {
                        x: 0px; y: (parent.height - 14px) / 2;
                        width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.refresh;
                        fill: transparent; stroke: Theme.text;
                        stroke-width: 1.9px; stroke-line-cap: round; stroke-line-join: round;
                    }
                }
                Text { height: parent.height; text: "Perbarui"; color: Theme.text; font-size: 11px; font-weight: 650; vertical-alignment: center; }
            }
            refresh-ta := TouchArea { clicked => { root.refresh(); if (root.expanded) { root.request-chart(); } } }
        }
    }

    if !root.alert-mode && !root.expanded: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 14px;

        // Panel kiri: konverter Rupiah dengan dropdown mata uang dan nominal cepat.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: @linear-gradient(145deg, Theme.text.with-alpha(0.055), Theme.text.with-alpha(0.022));
            VerticalLayout {
                x: 16px; y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                spacing: 12px;
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Konversi mata uang"; color: Theme.text; font-size: 13px; font-weight: 750; }
                        Text { text: "Hitung nilai Rupiah ke mata uang pilihan."; color: Theme.text.with-alpha(0.55); font-size: 10px; overflow: elide; }
                    }
                    Rectangle {
                        width: 90px;
                        height: 22px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: #43d9a02b;
                        background: #43d9a014;
                        HorizontalLayout {
                            x: 0px; y: 0px;
                            width: parent.width; height: parent.height;
                            padding-left: 8px; padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            Rectangle {
                                width: 11px; height: parent.height;
                                background: transparent;
                                Rectangle {
                                    x: 0px; y: (parent.height - 11px) / 2;
                                    width: 11px; height: 11px;
                                    border-radius: 6px;
                                    background: #43d9a01c;
                                    Rectangle {
                                        x: 3px; y: 3px;
                                        width: 5px; height: 5px;
                                        border-radius: 3px;
                                        background: #68dfb1;
                                    }
                                }
                            }
                            Text {
                                height: parent.height;
                                text: "Kurs referensi";
                                color: #68dfb1;
                                font-size: 9px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 66px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        spacing: 6px;
                        Text { text: "Jumlah Rupiah (IDR)"; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; }
                        Rectangle {
                            height: 44px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: Theme.text.with-alpha(0.14);
                            background: #00000030;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 22px;
                                    background: transparent;
                                    Text { text: "Rp"; color: Theme.text-dim; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                TextInput {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    text <=> root.amount;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 750;
                                    vertical-alignment: center;
                                    single-line: true;
                                    input-type: text;
                                    edited => { root.amount-edited(self.text); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        width: 138px;
                        spacing: 6px;
                        Text { text: "Mata uang tujuan"; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; }
                        Rectangle {
                            height: 44px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: Theme.text.with-alpha(0.14);
                            background: picker-ta.has-hover ? Theme.text.with-alpha(0.075) : #00000030;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text { text: root.d.code + " · " + root.d.name; color: Theme.text; font-size: 10px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: root.picker-open ? "⌃" : "⌄"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            picker-ta := TouchArea { clicked => { root.picker-open = !root.picker-open; } }
                        }
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    for q[i] in ["10 rb", "50 rb", "100 rb", "500 rb", "1 jt", "10 jt"]: Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: root.amount == ["10.000", "50.000", "100.000", "500.000", "1.000.000", "10.000.000"][i] ? Theme.accent.with-alpha(0.6) : Theme.text.with-alpha(0.11);
                        background: root.amount == ["10.000", "50.000", "100.000", "500.000", "1.000.000", "10.000.000"][i] ? Theme.accent.with-alpha(0.2) : (q-ta.has-hover ? Theme.text.with-alpha(0.11) : Theme.text.with-alpha(0.045));
                        Text { text: q; color: Theme.text.with-alpha(0.72); font-size: 10px; font-weight: 680; horizontal-alignment: center; vertical-alignment: center; }
                        q-ta := TouchArea { clicked => { root.quick(i); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 92px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.27);
                    background: @linear-gradient(120deg, Theme.accent.with-alpha(0.22), Theme.accent.with-alpha(0.065), Theme.text.with-alpha(0.03));
                    VerticalLayout {
                        x: 13px; y: 11px;
                        width: parent.width - 26px;
                        height: parent.height - 22px;
                        spacing: 5px;
                        HorizontalLayout {
                            height: 18px;
                            Text { text: "Perkiraan nilai konversi"; color: Theme.text-dim; font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                            Rectangle {
                                width: 42px; height: 19px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.text-faint.with-alpha(0.2);
                                background: #00000038;
                                Text { text: root.d.code; color: Theme.text; font-size: 9px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Text {
                            text: root.d.error != "" ? "Kurs tidak tersedia" : (root.d.loading && root.d.result == "" ? "Memuat kurs..." : (root.d.result != "" ? root.d.result : "—"));
                            color: root.d.error != "" ? #ff9b8f : Theme.text;
                            font-size: 34px;
                            font-weight: 820;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                        Text { text: root.d.rate != "" ? root.d.rate : (root.d.error != "" ? root.d.error : "Mengambil kurs referensi terbaru..."); color: root.d.error != "" ? #ff9b8f : Theme.text-dim; font-size: 8px; overflow: elide; }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Kurs referensi dapat berbeda dari kurs bank atau money changer."; color: Theme.text.with-alpha(0.48); font-size: 10px; vertical-alignment: center; overflow: elide; }
                }
            }
            // Menu pilihan dibuat mengambang di atas panel agar susunan konverter tidak bergeser.
            if root.picker-open: Rectangle {
                x: parent.width - 151px;
                y: 120px;
                width: 138px;
                height: 160px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.text-faint.with-alpha(0.24);
                background: Theme.body;
                clip: true;
                Flickable {
                    x: 4px; y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-width: self.width;
                    content-height: max(self.height, root.currencies.length * 29px);
                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                        for item[i] in root.currencies: Rectangle {
                            height: 27px;
                            border-radius: 7px;
                            background: item.selected ? Theme.accent.with-alpha(0.22) : (pick-row.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 6px; spacing: 3px;
                                Text { text: item.code; color: Theme.text; font-size: 9px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: item.value; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; }
                            }
                            pick-row := TouchArea { clicked => { root.select-currency(item.code, [30, 90, 180, 365][root.range]); root.picker-open = false; } }
                        }
                    }
                }
            }
        }

        // Panel kanan: ringkasan pasar saham IDX dengan sub-kartu gainers dan losers.
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: @linear-gradient(145deg, Theme.text.with-alpha(0.055), Theme.text.with-alpha(0.022));
            VerticalLayout {
                x: 16px; y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                spacing: 13px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    Rectangle {
                        width: 31px; height: 31px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #43d9a02b;
                        background: #43d9a014;
                        Path {
                            x: 7px; y: 7px; width: 17px; height: 17px;
                            viewbox-width: 24; viewbox-height: 24;
                            commands: "M 3 17 L 9 11 L 13 14 L 21 5 M 15 5 H 21 V 11";
                            fill: transparent; stroke: #68dfb1; stroke-width: 1.8px;
                            stroke-line-cap: round; stroke-line-join: round;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Pasar saham IDX"; color: Theme.text; font-size: 13px; font-weight: 750; }
                        Text { text: "Perubahan sejak awal bulan"; color: Theme.text.with-alpha(0.53); font-size: 10px; }
                    }
                    Rectangle {
                        width: 70px; height: 24px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text-faint.with-alpha(0.14);
                        background: Theme.text.with-alpha(0.04);
                        Text { text: root.d.stock-period; color: Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 9px;
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text.with-alpha(0.08);
                        background: #00000021;
                        VerticalLayout {
                            x: 10px; y: 11px;
                            width: parent.width - 20px;
                            height: parent.height - 22px;
                            spacing: 7px;
                            HorizontalLayout {
                                height: 17px;
                                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #68dfb1; }
                                Text { text: "Performa terbaik"; color: #68dfb1; font-size: 10px; font-weight: 650; vertical-alignment: center; }
                            }
                            if root.gainers.length == 0: Text { text: root.d.loading ? "Memuat data..." : "Data belum tersedia"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                            for g in root.gainers: Rectangle {
                                height: 43px;
                                border-radius: 9px;
                                background: Theme.text.with-alpha(0.045);
                                HorizontalLayout {
                                    padding-left: 7px; padding-right: 7px; spacing: 4px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; preferred-width: 0px;
                                        alignment: center; spacing: 2px;
                                        Text { text: g.name; color: Theme.text; font-size: 12px; font-weight: 760; overflow: elide; }
                                        Text { text: g.price; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                    }
                                    Rectangle {
                                        width: 56px; height: 20px;
                                        border-radius: 10px;
                                        background: #43d9a020;
                                        Text { text: g.change; color: #68dfb1; font-size: 10px; font-weight: 740; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.text.with-alpha(0.08);
                        background: #00000021;
                        VerticalLayout {
                            x: 10px; y: 11px;
                            width: parent.width - 20px;
                            height: parent.height - 22px;
                            spacing: 7px;
                            HorizontalLayout {
                                height: 17px;
                                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #ff8e98; }
                                Text { text: "Performa terendah"; color: #ff8e98; font-size: 10px; font-weight: 650; vertical-alignment: center; }
                            }
                            if root.losers.length == 0: Text { text: root.d.loading ? "Memuat data..." : "Data belum tersedia"; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                            for l in root.losers: Rectangle {
                                height: 43px;
                                border-radius: 9px;
                                background: Theme.text.with-alpha(0.045);
                                HorizontalLayout {
                                    padding-left: 7px; padding-right: 7px; spacing: 4px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; preferred-width: 0px;
                                        alignment: center; spacing: 2px;
                                        Text { text: l.name; color: Theme.text; font-size: 12px; font-weight: 760; overflow: elide; }
                                        Text { text: l.price; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                    }
                                    Rectangle {
                                        width: 56px; height: 20px;
                                        border-radius: 10px;
                                        background: #ff8e9820;
                                        Text { text: l.change; color: #ff8e98; font-size: 10px; font-weight: 740; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; preferred-width: 0px; height: 26px; text: root.d.stock-status; color: Theme.text.with-alpha(0.53); font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }

    // Tampilan diperluas: panel kurs di kiri dan grafik historis di kanan.
    if !root.alert-mode && root.expanded: HorizontalLayout {
        vertical-stretch: 1;
        spacing: 14px;
        Rectangle {
            width: 254px;
            vertical-stretch: 1;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: @linear-gradient(145deg, Theme.text.with-alpha(0.055), Theme.text.with-alpha(0.022));
            VerticalLayout {
                x: 12px; y: 14px;
                width: parent.width - 20px;
                height: parent.height - 22px;
                spacing: 9px;
                VerticalLayout {
                    height: 34px;
                    spacing: 3px;
                    Text { text: "Nilai tukar ke Rupiah"; color: Theme.text; font-size: 13px; font-weight: 750; }
                    Text { text: "Pilih mata uang untuk melihat grafik"; color: Theme.text.with-alpha(0.55); font-size: 10px; }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, root.currencies.length * 42px);
                    VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        for item[i] in root.currencies: Rectangle {
                            height: 39px;
                            border-radius: 9px;
                            border-width: item.selected ? 1px : 0px;
                            border-color: Theme.accent.with-alpha(0.6);
                            background: item.selected ? Theme.accent.with-alpha(0.2) : (currency-row-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.04));
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1; preferred-width: 0px;
                                    alignment: center; spacing: 2px;
                                    Text { text: "1 " + item.code; color: Theme.text; font-size: 12px; font-weight: 760; }
                                    Text { text: item.name; color: Theme.text.with-alpha(0.52); font-size: 9.5px; overflow: elide; }
                                }
                                Text { text: item.value; color: item.value == "—" ? Theme.text-faint : Theme.text; font-size: 12px; font-weight: 720; vertical-alignment: center; horizontal-alignment: right; }
                            }
                            currency-row-ta := TouchArea { clicked => { root.select-currency(item.code, [30, 90, 180, 365][root.range]); } }
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preferred-width: 0px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.095);
            background: @linear-gradient(145deg, Theme.text.with-alpha(0.055), Theme.text.with-alpha(0.022));
            VerticalLayout {
                x: 14px; y: 12px;
                width: parent.width - 28px;
                height: parent.height - 24px;
                spacing: 10px;
                HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1; preferred-width: 0px;
                        alignment: center; spacing: 3px;
                        Text { text: root.d.code + " \u{00B7} " + root.d.name + " \u{2192} IDR"; color: Theme.text-dim; font-size: 9px; font-weight: 700; overflow: elide; }
                        Text { text: root.chart-last != "" ? "1 " + root.d.code + " = " + root.chart-last : root.chart-status; color: Theme.text; font-size: 17px; font-weight: 800; overflow: elide; }
                        Text { text: root.chart-change; color: root.chart-up ? #68dfb1 : #ff8e98; font-size: 9px; font-weight: 700; }
                    }
                    HorizontalLayout {
                        height: 27px;
                        spacing: 3px;
                        for lbl[i] in ["1B", "3B", "6B", "1T"]: Rectangle {
                            width: 31px; height: 24px;
                            border-radius: 12px;
                            border-width: root.range == i ? 1px : 0px;
                            border-color: Theme.accent.with-alpha(0.45);
                            background: root.range == i ? Theme.accent.with-alpha(0.32) : (rg-ta.has-hover ? Theme.text.with-alpha(0.1) : transparent);
                            Text { text: lbl; color: root.range == i ? Theme.text : Theme.text.with-alpha(0.65); font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            rg-ta := TouchArea { clicked => { root.range = i; root.request-chart(); } }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.text-faint.with-alpha(0.1);
                    background: Theme.body.with-alpha(0.28);
                    clip: true;
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: "M 0 6 L 240 6 M 0 35.33 L 240 35.33 M 0 64.67 L 240 64.67 M 0 94 L 240 94";
                        fill: transparent;
                        stroke: Theme.text-faint.with-alpha(0.18);
                        stroke-width: 0.7px;
                    }
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: root.chart-area;
                        fill: Theme.accent.with-alpha(0.16);
                        visible: root.chart-area != "";
                    }
                    Path {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        viewbox-width: 240; viewbox-height: 100;
                        commands: root.chart-line;
                        fill: transparent;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        stroke-line-join: round;
                        stroke-line-cap: round;
                        visible: root.chart-line != "";
                    }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.06 - 7px; text: root.chart-max; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.3533 - 7px; text: root.chart-y1; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.6467 - 7px; text: root.chart-y2; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 7px; y: 10px + (parent.height - 34px) * 0.94 - 7px; text: root.chart-min; color: Theme.text-faint; font-size: 8px; }
                    Text { x: 46px; y: parent.height - 21px; width: 55px; text: root.chart-date-start != "" ? root.chart-date-start : "Awal"; color: Theme.text-faint; font-size: 8px; }
                    Text { x: parent.width / 2 - 27px; y: parent.height - 21px; width: 54px; text: root.chart-date-mid; color: Theme.text-faint; font-size: 8px; horizontal-alignment: center; }
                    Text { x: parent.width - 66px; y: parent.height - 21px; width: 58px; text: root.chart-date-end != "" ? root.chart-date-end : "Terbaru"; color: Theme.text-faint; font-size: 8px; horizontal-alignment: right; }
                    Rectangle {
                        x: parent.width - 17px;
                        y: 10px + (parent.height - 34px) * root.chart-dot-y / 100 - 4.5px;
                        width: 9px; height: 9px;
                        border-radius: 5px;
                        border-width: 1.5px; border-color: Theme.body;
                        background: Theme.accent;
                        visible: root.chart-line != "" && !chart-hit.has-hover;
                    }
                    // Mouse position is reactive in Slint; midpoint ranges select the nearest daily quote.
                    chart-hit := TouchArea {
                        x: 46px; y: 10px;
                        width: parent.width - 58px;
                        height: parent.height - 34px;
                        mouse-cursor: pointer;
                    }
                    for point in root.chart-points: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;
                        visible: chart-hit.has-hover
                            && chart-hit.mouse-x / max(chart-hit.width, 1px) >= point.left
                            && chart-hit.mouse-x / max(chart-hit.width, 1px) <= point.right;
                        Rectangle {
                            x: 46px + (parent.width - 58px) * point.x - 0.5px;
                            y: 10px;
                            width: 1px;
                            height: parent.height - 34px;
                            background: Theme.accent.with-alpha(0.48);
                        }
                        Rectangle {
                            x: 46px + (parent.width - 58px) * point.x - 4.5px;
                            y: 10px + (parent.height - 34px) * point.y / 100 - 4.5px;
                            width: 9px; height: 9px;
                            border-radius: 5px;
                            border-width: 1.5px; border-color: Theme.body;
                            background: Theme.accent;
                        }
                        Rectangle {
                            x: clamp(46px + (parent.width - 58px) * point.x - 77px, 4px, parent.width - 158px);
                            y: max(10px + (parent.height - 34px) * point.y / 100 - 49px, 4px);
                            width: 154px; height: 42px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.45);
                            background: Theme.body;
                            VerticalLayout {
                                x: 9px; y: 5px;
                                width: parent.width - 18px;
                                height: parent.height - 10px;
                                spacing: 2px;
                                Text { text: point.date; color: Theme.text-faint; font-size: 8px; }
                                Text { text: "1 " + root.d.code + " = " + point.value; color: Theme.text; font-size: 10px; font-weight: 750; }
                            }
                        }
                    }
                    if root.chart-line == "": Text { width: parent.width - 20px; height: parent.height - 48px; x: 10px; y: 24px; text: root.chart-status != "" ? root.chart-status : "Memuat grafik..."; color: Theme.text-faint; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 22px;
                    spacing: 6px;
                    Text { text: "ⓘ"; color: Theme.text-faint; font-size: 10px; vertical-alignment: center; }
                    Text { text: root.chart-status; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }

    if root.alert-mode: Rectangle {
        vertical-stretch: 1;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.text.with-alpha(0.16);
        background: Theme.body;
        VerticalLayout {
            x: 14px; y: 13px;
            width: parent.width - 28px;
            height: parent.height - 26px;
            spacing: 9px;
            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px;
                    alignment: center; spacing: 2px;
                    Text { text: "Alert harga & kurs"; color: Theme.text; font-size: 14px; font-weight: 760; }
                    Text { text: "Data kurs & saham diperbarui tiap 10 menit"; color: Theme.text.with-alpha(0.55); font-size: 10px; }
                }
                Rectangle {
                    width: 26px; height: 26px;
                    border-radius: 8px;
                    background: alert-close-ta.has-hover ? Theme.text.with-alpha(0.16) : Theme.text.with-alpha(0.07);
                    Path {
                        x: 6px; y: 6px; width: 14px; height: 14px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: Icons.close;
                        fill: transparent; stroke: Theme.text-dim;
                        stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                    }
                    alert-close-ta := TouchArea { clicked => { root.alert-mode = false; root.picker-open = false; } }
                }
            }
            HorizontalLayout {
                height: 32px;
                spacing: 7px;
                Rectangle {
                    width: 66px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: root.alert-stock-mode ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.16);
                    background: root.alert-stock-mode ? Theme.accent.with-alpha(0.18) : Theme.text.with-alpha(0.07);
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.alert-stock-mode ? "Saham" : "Kurs"; color: root.alert-stock-mode ? Theme.text : Theme.text-dim; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    alert-kind-ta := TouchArea { clicked => { root.alert-stock-mode = !root.alert-stock-mode; root.picker-open = false; } }
                }
                Rectangle {
                    horizontal-stretch: 1; preferred-width: 0px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: currency-alert-picker-ta.has-hover ? Theme.text.with-alpha(0.24) : Theme.text.with-alpha(0.16);
                    background: currency-alert-picker-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.07);
                    HorizontalLayout {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        padding-left: 9px; padding-right: 9px; spacing: 6px;
                        Text { text: root.alert-stock-mode ? root.alert-stock-code + " · Saham IDX" : root.alert-currency-code + " · " + root.alert-currency-name; color: Theme.text; font-size: 11.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.picker-open ? "⌃" : "⌄"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    }
                    currency-alert-picker-ta := TouchArea { clicked => { root.picker-open = !root.picker-open; } }
                }
                Rectangle {
                    width: 96px; height: 32px;
                    border-radius: 9px; border-width: 1px;
                    border-color: Theme.text.with-alpha(0.16);
                    background: condition-ta.has-hover ? Theme.text.with-alpha(0.1) : Theme.text.with-alpha(0.07);
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 8px; spacing: 3px;
                        Text { text: root.above ? "Naik ke ≥" : "Turun ke ≤"; color: Theme.text; font-size: 11.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "⌄"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                    }
                    condition-ta := TouchArea { clicked => { root.above = !root.above; } }
                }
                Rectangle {
                    horizontal-stretch: 1; preferred-width: 0px;
                    height: 32px; border-radius: 9px; border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.85);
                    background: Theme.text.with-alpha(0.07);
                    alert-target-input := TextInput {
                        x: 9px; y: 0px; width: parent.width - 18px; height: parent.height;
                        color: Theme.text; font-size: 11.5px; vertical-alignment: center;
                        single-line: true; input-type: text;
                        accepted => {
                            root.add-alert(root.above, self.text, root.alert-stock-mode,
                                root.alert-stock-mode ? root.alert-stock-code : root.alert-currency-code,
                                root.alert-repeat);
                            self.text = "";
                        }
                    }
                    if alert-target-input.text == "": Text {
                        x: 9px; y: 0px; width: parent.width - 18px; height: parent.height;
                        text: root.alert-stock-mode
                            ? "Target saham (Rp)"
                            : (root.alert-currency-code == root.d.code && root.d.alert-rate != "" && root.d.alert-rate != "—"
                                ? "mis. " + root.d.alert-rate
                                : "Target (Rp)");
                        color: Theme.text.with-alpha(0.4); font-size: 11.5px; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 66px; height: 32px;
                    border-radius: 9px;
                    background: Theme.accent;
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "Pasang"; color: #11131b; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                    install-alert-ta := TouchArea { clicked => {
                        root.add-alert(root.above, alert-target-input.text, root.alert-stock-mode,
                            root.alert-stock-mode ? root.alert-stock-code : root.alert-currency-code,
                            root.alert-repeat);
                        alert-target-input.text = "";
                    } }
                }
            }
            Text {
                height: 16px;
                text: root.alert-stock-mode
                    ? "Harga saham IDX dipantau dari Yahoo Finance."
                    : (root.alert-currency-code == root.d.code
                        ? "Harga sekarang: " + (root.d.alert-rate != "" ? root.d.alert-rate : "—")
                        : "Kurs " + root.alert-currency-code + " dipantau terhadap Rupiah.");
                color: Theme.text.with-alpha(0.66); font-size: 10.5px; vertical-alignment: center;
            }
            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                Text { text: "Ulangi setelah harga kembali ke sisi sebaliknya"; color: Theme.text.with-alpha(0.55); font-size: 9px; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 78px; height: 22px;
                    border-radius: 11px; border-width: 1px;
                    border-color: root.alert-repeat ? Theme.accent.with-alpha(0.55) : Theme.text.with-alpha(0.13);
                    background: root.alert-repeat ? Theme.accent.with-alpha(0.2) : Theme.text.with-alpha(0.06);
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.alert-repeat ? "Berulang" : "Sekali"; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    repeat-alert-ta := TouchArea { clicked => { root.alert-repeat = !root.alert-repeat; } }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;
                Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: max(self.height, root.alerts.length * 58px);
                    VerticalLayout {
                    width: parent.width;
                    spacing: 6px;
                    if root.alerts.length == 0: Text {
                        text: "Belum ada pengingat harga atau kurs";
                        color: Theme.text-faint; font-size: 10px;
                        vertical-alignment: center;
                    }
                    for a in root.alerts: Rectangle {
                        height: 48px;
                        border-radius: 11px; border-width: 1px;
                        border-color: Theme.text.with-alpha(0.09);
                        background: Theme.text.with-alpha(0.045);
                        HorizontalLayout {
                            x: 12px; y: 0px;
                            width: parent.width - 24px; height: parent.height;
                            spacing: 10px;
                            Path {
                                width: 16px; height: 16px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: a.stock ? Icons.stats : Icons.reset;
                                fill: transparent; stroke: Theme.accent;
                                stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; preferred-width: 0px;
                                alignment: center; spacing: 2px;
                                Text { text: a.text; color: Theme.text; font-size: 12px; font-weight: 700; }
                                Text {
                                    text: a.repeat
                                        ? (a.armed ? "Berulang · menunggu target" : "Berulang · menunggu harga kembali")
                                        : (a.stock ? "Sekali · saham IDX" : "Sekali · kurs ke Rupiah");
                                    color: Theme.text.with-alpha(0.55);
                                    font-size: 10px;
                                }
                            }
                            Rectangle {
                                width: 26px; height: 26px;
                                border-radius: 8px;
                                background: remove-alert-ta.has-hover ? Theme.text.with-alpha(0.16) : Theme.text.with-alpha(0.07);
                                Path {
                                    x: 6px; y: 6px; width: 14px; height: 14px;
                                    viewbox-width: 24; viewbox-height: 24;
                                    commands: Icons.close;
                                    fill: transparent; stroke: Theme.text-dim;
                                    stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
                                }
                                remove-alert-ta := TouchArea { clicked => { root.remove-alert(a.id); } }
                            }
                        }
                    }
                    }
                }
            }
        }
        if root.picker-open: Rectangle {
            x: 87px; y: 86px;
            width: 190px; height: 180px;
            border-radius: 10px; border-width: 1px;
            border-color: Theme.text-faint.with-alpha(0.24);
            background: Theme.body;
            clip: true;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-width: self.width;
                content-height: max(self.height, (root.alert-stock-mode ? 12 : root.currencies.length) * 29px);
                VerticalLayout {
                    width: parent.width; spacing: 2px;
                    if root.alert-stock-mode: VerticalLayout {
                        width: parent.width; spacing: 2px;
                        for stock[i] in ["BBCA", "BBRI", "BMRI", "BBNI", "TLKM", "ASII", "ANTM", "GOTO", "ICBP", "MDKA", "BRPT", "INDF"]: Rectangle {
                            height: 27px; border-radius: 7px;
                            background: stock == root.alert-stock-code ? Theme.accent.with-alpha(0.22) : (alert-stock-pick-ta.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 6px; spacing: 3px;
                                Text { text: stock; color: Theme.text; font-size: 10px; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "Saham IDX"; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; }
                            }
                            alert-stock-pick-ta := TouchArea { clicked => { root.alert-stock-code = stock; root.picker-open = false; } }
                        }
                    }
                    if !root.alert-stock-mode: VerticalLayout {
                        width: parent.width; spacing: 2px;
                        for item[i] in root.currencies: Rectangle {
                            height: 27px; border-radius: 7px;
                            background: item.code == root.alert-currency-code ? Theme.accent.with-alpha(0.22) : (alert-currency-pick-ta.has-hover ? Theme.chip-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 6px; spacing: 3px;
                                Text { text: item.code; color: Theme.text; font-size: 9px; font-weight: 750; vertical-alignment: center; }
                                Text { text: item.name; color: Theme.text-dim; font-size: 8px; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            alert-currency-pick-ta := TouchArea { clicked => { root.alert-currency-code = item.code; root.alert-currency-name = item.name; root.picker-open = false; } }
                        }
                    }
                }
            }
        }
    }
}
component ReminderPage inherits VerticalLayout {
    in property <[ReminderItem]> items;
    in property <bool> alert-visible: false;
    in property <string> alert-text;
    in property <string> alert-sub;
    in property <string> status;
    in property <int> weekdays-mask: 62;
    in property <[bool]> weekday-selected;
    in-out property <string> draft;
    in-out property <string> date-time;
    in-out property <string> repeat-mode: "none";
    callback add(string, string, string, int);
    callback toggle(string);
    callback remove(string);
    callback clear-done();
    callback stop-alert();
    callback snooze-alert();
    callback toggle-weekday(int);

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 2px;
    spacing: 3px;

    if root.alert-visible: Rectangle {
        height: 34px;
        border-radius: 11px;
        background: #d9770628;
        border-width: 1px;
        border-color: #f59e0b88;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 5px;
            spacing: 4px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: root.alert-text; color: Theme.text; font-size: 11px; font-weight: 700; overflow: elide; }
                Text { text: root.alert-sub; color: Theme.text-dim; font-size: 9px; overflow: elide; }
            }
            Chip { label: "Tunda"; clicked => { root.snooze-alert(); } }
            Chip { label: "Selesai"; selected: true; clicked => { root.stop-alert(); } }
        }
    }

    HorizontalLayout {
        height: 26px;
        spacing: 5px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 13px;
            background: Theme.chip;
            input := TextInput {
                x: 9px;
                width: parent.width - 18px;
                text <=> root.draft;
                color: Theme.text;
                font-size: 11px;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); }
            }
            if input.text == "": Text {
                x: 9px;
                text: "Ingatkan aku untuk…";
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        Chip { label: "Tambah"; clicked => { root.add(root.draft, root.date-time, root.repeat-mode, root.weekdays-mask); } }
        Chip { label: "Bersih"; clicked => { root.clear-done(); } }
    }

    HorizontalLayout {
        height: 24px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 12px;
            background: Theme.chip;
            dt := TextInput {
                x: 8px;
                width: parent.width - 16px;
                text <=> root.date-time;
                color: Theme.text;
                font-size: 10px;
                vertical-alignment: center;
                single-line: true;
            }
            if dt.text == "": Text {
                x: 8px;
                text: "DD/MM/YYYY HH:MM (opsional)";
                color: Theme.text-faint;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
        Chip { label: "Sekali"; selected: root.repeat-mode == "none"; clicked => { root.repeat-mode = "none"; } }
        Chip { label: "Harian"; selected: root.repeat-mode == "daily"; clicked => { root.repeat-mode = "daily"; } }
        Chip { label: "Mingguan"; selected: root.repeat-mode == "weekly"; clicked => { root.repeat-mode = "weekly"; } }
        Chip { label: "Bulanan"; selected: root.repeat-mode == "monthly"; clicked => { root.repeat-mode = "monthly"; } }
    }

    if root.status != "": Text {
        text: root.status;
        color: Theme.text-dim;
        font-size: 9px;
        horizontal-alignment: left;
        height: 13px;
    }

    if root.repeat-mode == "weekly": HorizontalLayout {
        height: 20px;
        spacing: 3px;
        for day[idx] in ["Min", "Sen", "Sel", "Rab", "Kam", "Jum", "Sab"]: Chip {
            label: day;
            selected: root.weekday-selected[idx];
            clicked => { root.toggle-weekday(idx); }
        }
    }

    if root.items.length == 0: Text {
        text: "Belum ada pengingat";
        color: Theme.text-faint;
        font-size: 10px;
        horizontal-alignment: center;
    }
    for item in root.items: HorizontalLayout {
        height: 20px;
        spacing: 4px;
        opacity: item.done ? 0.5 : 1;
        Text { text: item.text; color: Theme.text; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: item.due; color: Theme.text-faint; font-size: 8px; vertical-alignment: center; }
        RoundButton {
            size: 18px;
            commands: item.done ? Icons.reset : "M 4 12 L 9 17 L 20 6";
            outline: true;
            clicked => { root.toggle(item.id); }
        }
        RoundButton { size: 18px; commands: Icons.close; outline: true; clicked => { root.remove(item.id); } }
    }
}

component ClipboardPage inherits VerticalLayout {
    in property <[ClipboardItem]> items;
    in property <bool> available: true;
    callback copy(string);
    callback clear();
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px;
    padding-bottom: 4px;
    spacing: 3px;

    HorizontalLayout {
        height: 26px;
        Text {
            text: "Terakhir disalin";
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Chip { label: "Bersihkan"; clicked => { root.clear(); } }
    }

    if !root.available: Text {
        text: "Clipboard tidak tersedia";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.available && root.items.length == 0: Text {
        text: "Belum ada riwayat salin";
        color: Theme.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for item in root.items: HorizontalLayout {
        height: 24px;
        spacing: 8px;
        Text {
            text: item.preview;
            color: Theme.text;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        RoundButton {
            size: 22px;
            commands: Icons.copy;
            outline: true;
            clicked => { root.copy(item.text); }
        }
    }
}

component QuickButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    in property <bool> na;              // tidak didukung / belum terbaca
    in property <bool> soft: false;     // gaya aksen lembut (tombol aksi seperti "Pusatkan")
    callback clicked;
    horizontal-stretch: 1;
    height: 84px;
    border-radius: 22px;
    opacity: na ? 0.4 : 1;
    background: on ? Theme.accent : (soft ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.chip-hover : Theme.chip));
    animate background { duration: 140ms; }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: 22px;
                height: 22px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.label;
            color: root.on ? Theme.on-accent : (root.soft ? Theme.accent : Theme.text);
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { enabled: !root.na; clicked => { root.clicked(); } }
}

// Nilai quick: -1 = tidak didukung/belum terbaca, 0 = false, 1 = true (aturan sama dengan quick-stats.ts)
global QuickText {
    pure public function label(v: int, name: string, t: string, f: string) -> string {
        return v < 0 ? name : (v == 1 ? t : f);
    }
}

component QuickPage inherits HorizontalLayout {
    in property <int> mic: -1;
    in property <int> wifi: -1;
    in property <int> bt: -1;
    callback toggle(string);
    padding-left: 22px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 32px;
    spacing: 10px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.mic; label: QuickText.label(root.mic, "Mic", "Mic mati", "Mic aktif"); on: root.mic == 1; na: root.mic < 0; clicked => { root.toggle("mic"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.wifi; label: QuickText.label(root.wifi, "Wi-Fi", "Wi-Fi on", "Wi-Fi off"); on: root.wifi == 1; na: root.wifi < 0; clicked => { root.toggle("wifi"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.bluetooth; label: QuickText.label(root.bt, "Bluetooth", "Bluetooth on", "Bluetooth off"); on: root.bt == 1; na: root.bt < 0; clicked => { root.toggle("bt"); } }
}

component ToolsPage inherits HorizontalLayout {
    in property <int> awake: -1;
    in property <int> dark: -1;
    callback toggle(string);
    padding-left: 22px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 32px;
    spacing: 10px;
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.awake; label: QuickText.label(root.awake, "Keep awake", "Awake: ON", "Awake: OFF"); on: root.awake == 1; na: root.awake < 0; clicked => { root.toggle("awake"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.moon; label: QuickText.label(root.dark, "Tema", "Gelap", "Terang"); on: root.dark == 1; na: root.dark < 0; clicked => { root.toggle("dark"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.lock; label: "Kunci"; clicked => { root.toggle("lock"); } }
    QuickButton { horizontal-stretch: 1; min-width: 80px; icon: Icons.center; label: "Pusatkan"; soft: true; clicked => { root.toggle("center"); } }
}

// Awan percakapan untuk dock bawah/samping: kecil, sudut membulat, tinggi mengikuti isi,
// dan ekor membulat yang menunjuk ke notch. `tail-pos` = posisi ujung ekor di sepanjang sisi
// (relatif terhadap awan); nilai negatif berarti di tengah.
component SpeechBubble inherits Rectangle {
    in property <string> message;
    in property <string> detail;
    in property <bool> side: false;
    in property <bool> side-right: false;
    in property <length> tail-pos: -1px;
    property <length> along: root.side ? root.height : root.width;
    property <length> tail-center: Math.max(20px, Math.min(root.along - 20px, root.tail-pos < 0px ? root.along / 2 : root.tail-pos));
    width: 224px;
    height: 11px + msg.height + (root.detail != "" ? 3px + det.height : 0px) + 11px;
    border-radius: 20px;
    clip: false;
    background: #08090df5;

    msg := Text {
        x: 15px;
        y: 11px;
        width: parent.width - 30px;
        height: Math.min(self.preferred-height, 32px);
        text: root.message;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        wrap: word-wrap;
        overflow: clip;
    }
    det := Text {
        x: 15px;
        y: msg.y + msg.height + 3px;
        width: parent.width - 30px;
        height: root.detail != "" ? Math.min(self.preferred-height, 28px) : 0px;
        text: root.detail;
        color: #c7c9d1;
        font-size: 10.5px;
        wrap: word-wrap;
        overflow: clip;
    }
    // Ekor membulat (isi dan garis berwarna sama, join bulat) mengarah ke notch.
    Path {
        x: root.side ? (root.side-right ? parent.width - 2px : -10px) : root.tail-center - 9px;
        y: root.side ? root.tail-center - 9px : parent.height - 3px;
        width: root.side ? 12px : 18px;
        height: root.side ? 18px : 12px;
        viewbox-width: root.side ? 12 : 18;
        viewbox-height: root.side ? 18 : 12;
        commands: root.side ? (root.side-right ? "M 1 2 L 10 9 L 1 16 Z" : "M 11 2 L 2 9 L 11 16 Z")
            : "M 2 1 L 9 10 L 16 1 Z";
        fill: #08090df5;
        stroke: #08090df5;
        stroke-width: 3px;
        stroke-line-join: round;
    }
}

component PageToggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback toggled(bool);
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: checked ? Theme.accent.with-alpha(0.55) : (ta.has-hover ? Theme.text-dim.with-alpha(0.45) : Theme.chip);
    background: checked ? Theme.accent.with-alpha(0.16) : (ta.has-hover ? Theme.chip-hover : Theme.chip);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 9px;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border-width: 1px;
            border-color: checked ? Theme.accent : Theme.text-faint;
            background: checked ? Theme.accent : transparent;
            animate background { duration: 120ms; }
            Text { text: checked ? "✓" : ""; color: Theme.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: root.label; color: Theme.text; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    ta := TouchArea { clicked => { root.toggled(!root.checked); } }
}

