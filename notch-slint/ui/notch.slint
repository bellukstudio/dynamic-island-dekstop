        text: "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ";
        color: Theme.ok;
        font-size: 22px;
        horizontal-alignment: center;
    }
}

export component NotchWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Notch";

    in property <bool> expanded: false;
    in property <bool> adhan-active: false;
    in property <string> adhan-prayer: "";
    in property <int> adhan-phase: 0;
    in property <bool> meeting-active: false;
    in property <string> meeting-elapsed: "00:00";
    in property <string> meeting-source: "";
    in property <string> meeting-finished: "";
    // 0 = menempel di atas, 1 = melayang (digeser dari tepi), 2 = menempel di dasar layar.
    in property <int> dock: 0;
    // Skala bentuk (config `scale`): radius hub 32 px dan telinga 10 px dikalikan nilai ini, seperti di Tauri.
    in property <float> ui-scale: 1.0;
    // Gambar hiasan tema (cahaya, scan, rim) yang dirender Rust dengan mask sudut akurat.
    in property <image> decor;
    in property <bool> has-decor: false;
    in-out property <string> page-id: "media";
    in property <[string]> tabs;

    in property <string> media-title: "Tidak ada media";
    in property <string> media-artist: "Putar musik untuk memulai";
    in property <string> media-pos-text: "0:00";
    in property <string> media-dur-text: "0:00";
    in property <float> media-position: 0;
    in property <float> media-length: 0;
    in property <float> media-progress: 0;
    in property <bool> media-active: false;
    in property <bool> media-playing: false;
    in property <image> media-art;
    in property <bool> media-has-art: false;
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> pomo-text: "25:00";
    in property <string> pomo-label: "";
    in property <float> pomo-progress: 0;
    in property <bool> pomo-running: false;
    in property <bool> pomo-rest: false;
    // Gambar mata (8 mood x 20 skin) dirender Rust: notch-core/src/eyes.rs. Ukuran logis 130 x 34.
    in property <image> eyes-image;

    in property <float> cpu: 0;
    in property <float> ram: 0;
    in property <float> disk: 0;
    in property <string> cpu-text: "-";
    in property <string> ram-text: "-";
    in property <string> disk-text: "-";
    in property <string> net-text: "";
    in property <string> sys-text: "";

    in property <bool> battery-present: true;
    in property <int> battery-percent: 0;
    in property <bool> battery-charging: false;
    in property <[NoteItem]> notes;
    in property <[ClipboardItem]> clipboard-items;
    in property <bool> clipboard-available: true;
    in property <[ReminderItem]> reminders;
    in property <bool> reminder-alert-visible: false;
    in property <string> reminder-alert-text;
    in property <string> reminder-alert-sub;
    in property <int> reminder-weekdays-mask: 62;
    in property <[bool]> reminder-weekday-selected;
    in-out property <string> reminder-draft;
    in-out property <string> reminder-date-time;
    in-out property <string> reminder-repeat-mode: "none";
    in property <string> weather-city: "Bandung";
    in property <string> weather-temp: "--°";
    in property <string> weather-condition: "Memuat cuaca...";
    in property <string> weather-feels: "";
    in property <string> weather-humidity: "";
    in property <string> weather-rain: "";
    in property <string> weather-icon: "";
    in property <string> weather-status: "";

    in property <[string]> lyric-lines;
    in property <int> lyric-active: -1;
    in-out property <bool> lyrics-open: false;
    in-out property <bool> cal-open: false;
    in property <[CalCell]> cal-cells;
    in property <[string]> cal-weekdays;
    in property <string> cal-title;
    in property <string> cal-foot-date;
    in property <string> cal-foot-name;
    in property <int> cal-foot-kind: 0;

    in property <int> q-mic: -1;
    in property <int> q-wifi: -1;
    in property <int> q-bt: -1;
    in property <int> q-awake: -1;
    in property <int> q-dark: -1;

    in property <image> emoji-coffee;
    in property <image> emoji-tomato;
    in property <image> emoji-moon;

    callback media-control(string);
    callback adhan-stop();
    callback adhan-finished();
    callback media-seek(float);
    callback hover-changed(bool);
    callback pill-clicked();
    callback pill-double-clicked();
    callback page-changed(string);
    callback toggle-pomo();
    callback reset-pomo();
    callback skip-pomo();
    callback add-note(string);
    callback remove-note(string);
    callback clipboard-copy(string);
    callback clipboard-clear();
    callback reminder-add(string, string, string, int);
    callback reminder-toggle(string);
    callback reminder-remove(string);
    callback reminder-clear-done();
    callback reminder-stop-alert();
    callback reminder-snooze-alert();
    callback reminder-toggle-weekday(int);
    callback quick-toggle(string);
    callback cal-opened();
    callback cal-prev();
    callback cal-next();
    callback cal-today();
    callback cal-select(int);
    callback holidays-ready();

    // Kursor di pil ATAU di tombol Pusatkan (termasuk celah di antaranya) dianggap masih di dalam notch.
    property <bool> any-hover: hover.has-hover || pos-zone.has-hover;
    changed any-hover => { root.hover-changed(root.any-hover); }

    // Tombol "Pusatkan": melayang di luar badan notch, 8 px di bawahnya (di atasnya bila menempel dasar
    // layar), muncul bersama hub. TouchArea mencakup celah ke pil supaya kursor yang menyeberang tidak
    // dianggap keluar; piksel hampir transparan memastikan jendela berlapis tetap menerima kursor di celah.
    pos-zone := TouchArea {
        property <length> gap: 8px;
        width: 104px;
        height: self.gap + 22px;
        x: (root.width - self.width) / 2;
        y: root.dock == 2 ? pill.y - self.height : pill.y + pill.height;
        enabled: root.expanded;
        mouse-cursor: pointer;
        clicked => { root.quick-toggle("center"); }

        Rectangle { background: #00000001; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.dock == 2 ? 0px : parent.gap;
            width: 94px;
            height: 22px;
            border-radius: 11px;
            background: pos-zone.has-hover ? #20202af2 : #121216e6;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(pos-zone.has-hover ? 0.9 : 0.5);
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 180ms; }
            animate background { duration: 120ms; }
            Path {
                x: 9px;
                y: 5px;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 V 8 M 12 16 V 21 M 3 12 H 8 M 16 12 H 21 M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10";
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
            }
            Text {
                x: 26px;
                height: parent.height;
                text: "Pusatkan";
                color: Theme.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    pill := Rectangle {
        // Radius mengikuti Tauri: hub 32 px menempel / 28 px melayang; pil kecil 17 px.
        property <length> r: root.expanded ? (root.dock == 1 ? 28px : 32px) * root.ui-scale : 17px;
        x: (root.width - self.width) / 2;
        y: root.dock == 2 ? root.height - self.height : 0px;
        // Ukuran hub sama dengan Tauri (--hub-w / --hub-h di hub-compact.css): 580 x 202
        width: root.expanded ? 580px : 130px;
        height: root.expanded ? 202px : 34px;
        background: Theme.body;
        // Sisi yang menempel ke tepi layar dibiarkan rata; selain itu membulat.
        border-top-left-radius: root.dock == 0 ? 0px : self.r;
        border-top-right-radius: root.dock == 0 ? 0px : self.r;
        border-bottom-left-radius: root.dock == 2 ? 0px : self.r;
        border-bottom-right-radius: root.dock == 2 ? 0px : self.r;
        animate r { duration: 220ms; easing: ease-out-quart; }
        clip: true;
        animate width { duration: 220ms; easing: ease-out-quart; }
        animate height { duration: 220ms; easing: ease-out-quart; }

        // Hiasan tema (cahaya, scan, rim). Digambar sebagai gambar karena clip UI tidak mengikuti radius
        // sudut di renderer software; gambar ini sudah ber-mask sudut bulat dan sisi bebas yang benar.
        Image {
            source: root.decor;
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            visible: root.has-decor;
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 220ms; }
        }

        // Konten dibungkus TouchArea sebagai induk: has-hover tetap true saat kursor berada di atas
        // tombol (anak), dan klik tetap diteruskan ke anak.
        hover := TouchArea {
            clicked => { root.pill-clicked(); }
            double-clicked => { root.pill-double-clicked(); }

            // Mata: hanya saat menciut. Gambar dirender Rust sebesar pil kecil (130 x 34).
            Image {
                source: root.eyes-image;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                image-fit: fill;
                opacity: root.expanded ? 0 : 1;
                animate opacity { duration: 120ms; }
            }

            // Mode rapat: timer ringkas di atas wajah, tanpa mengubah animasi mata di bawahnya.
            Rectangle {
                visible: (root.meeting-active || root.meeting-finished != "") && !root.expanded;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: root.meeting-active ? #e5a84b : Theme.ok;
                HorizontalLayout {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    spacing: 5px;
                    Text { text: "●"; color: root.meeting-active ? #e5a84b : Theme.ok; font-size: 9px; vertical-alignment: center; }
                    Text {
                        text: root.meeting-active ? root.meeting-elapsed : root.meeting-finished;
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.meeting-active ? root.meeting-source : "SELESAI";
                        color: #c9cbd3;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            // Overlay Adzan saat notch menciut: status jelas dan kontrol berhenti.
            Rectangle {
                visible: root.adhan-active && !root.expanded;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.8);
                HorizontalLayout {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    spacing: 6px;
                    HorizontalLayout {
                        width: 20px;
                        height: 18px;
                        spacing: 2px;
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: root.adhan-phase % 3 == 0 ? 13px : 5px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: root.adhan-phase % 3 == 1 ? 15px : 6px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: root.adhan-phase % 3 == 2 ? 12px : 4px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                    }
                    Text {
                        text: "ADZAN  " + root.adhan-prayer;
                        color: Theme.text;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        width: 22px;
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => { root.adhan-stop(); }
                        Rectangle { background: self.parent.has-hover ? #ffffff30 : #ffffff18; border-radius: 11px; }
                        Text { text: "■"; color: #ff8b8b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Hub: tab + halaman
            Rectangle {
                visible: root.expanded;
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: 180ms; delay: 80ms; }

                HorizontalLayout {
                    x: 20px;
                    y: 14px;
                    width: parent.width - 40px;
                    height: 30px;
                    spacing: 4px;
                    alignment: start;
                    for id in root.tabs: TabIcon {
                        commands: Icons.for-page(id);
                        active: root.page-id == id;
                        clicked => { root.page-id = id; root.page-changed(id); }
                    }
                }

                Rectangle {
                    y: 56px;
                    height: parent.height - 56px - 12px;
                    if root.page-id == "media": MediaPage {
                        lyrics-open <=> root.lyrics-open; lyric-lines: root.lyric-lines; lyric-active: root.lyric-active;
                        art: root.media-art; has-art: root.media-has-art; title: root.media-title; artist: root.media-artist;
                        pos-text: root.media-pos-text; dur-text: root.media-dur-text; progress: root.media-progress; playing: root.media-playing;
                        prev => { root.media-control("prev"); } toggle => { root.media-control("toggle"); } next => { root.media-control("next"); }
                        seek(v) => { root.media-seek(v * root.media-length); }
                    }
                    if root.page-id == "clock" && !root.cal-open: ClockPage {
                        clock-text: root.clock-text;
                        date-text: root.date-text;
                        open-calendar => { root.cal-open = true; root.cal-opened(); }
                    }
                    if root.page-id == "clock" && root.cal-open: CalendarPage {
                        cells: root.cal-cells;
                        weekdays: root.cal-weekdays;
                        title: root.cal-title;
                        foot-date: root.cal-foot-date;
                        foot-name: root.cal-foot-name;
                        foot-kind: root.cal-foot-kind;
                        prev => { root.cal-prev(); }
                        next => { root.cal-next(); }
                        today => { root.cal-today(); }
                        select(i) => { root.cal-select(i); }
                        close => { root.cal-open = false; }
                    }
                    if root.page-id == "timer": TimerPage {
                        pomo-text: root.pomo-text;
                        pomo-label: root.pomo-label;
                        pomo-progress: root.pomo-progress;
                        pomo-running: root.pomo-running;
                        pomo-rest: root.pomo-rest;
                        toggle => { root.toggle-pomo(); }
                        reset => { root.reset-pomo(); }
                        skip => { root.skip-pomo(); }
                    }
                    if root.page-id == "stats": StatsPage {
                        cpu: root.cpu; ram: root.ram; disk: root.disk;
                        cpu-text: root.cpu-text; ram-text: root.ram-text; disk-text: root.disk-text;
                        net-text: root.net-text; sys-text: root.sys-text;
                    }
                    if root.page-id == "battery": BatteryPage { present: root.battery-present; percent: root.battery-percent; charging: root.battery-charging; }
                    if root.page-id == "notes": NotesPage {
                        notes: root.notes;
                        add(t) => { root.add-note(t); }
                        remove(id) => { root.remove-note(id); }
                    }
                    if root.page-id == "weather": WeatherPage {
                        city: root.weather-city;
                        temperature: root.weather-temp;
                        condition: root.weather-condition;
                        feels: root.weather-feels;
                        humidity: root.weather-humidity;
                        rain: root.weather-rain;
                        icon: root.weather-icon;
                        status: root.weather-status;
                    }
                    if root.page-id == "reminder": ReminderPage {
                        items: root.reminders;
                        alert-visible: root.reminder-alert-visible;
                        alert-text: root.reminder-alert-text;
                        alert-sub: root.reminder-alert-sub;
                        weekdays-mask: root.reminder-weekdays-mask;
                        weekday-selected: root.reminder-weekday-selected;
                        draft <=> root.reminder-draft;
                        date-time <=> root.reminder-date-time;
                        repeat-mode <=> root.reminder-repeat-mode;
                        add(text, date-time, repeat-mode, weekdays-mask) => { root.reminder-add(text, date-time, repeat-mode, weekdays-mask); }
                        toggle(id) => { root.reminder-toggle(id); }
                        remove(id) => { root.reminder-remove(id); }
                        clear-done => { root.reminder-clear-done(); }
                        stop-alert => { root.reminder-stop-alert(); }
                        snooze-alert => { root.reminder-snooze-alert(); }
                        toggle-weekday(i) => { root.reminder-toggle-weekday(i); }
                    }
                    if root.page-id == "clipboard": ClipboardPage {
                        items: root.clipboard-items;
                        available: root.clipboard-available;
                        copy(text) => { root.clipboard-copy(text); }
                        clear => { root.clipboard-clear(); }
                    }
                    if root.page-id == "quick": QuickPage {
                        mic: root.q-mic; wifi: root.q-wifi; bt: root.q-bt;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "tools": ToolsPage {
                        awake: root.q-awake; dark: root.q-dark;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "uji": RenderTestPage { coffee: root.emoji-coffee; tomato: root.emoji-tomato; moon: root.emoji-moon; }
                    if root.page-id != "media" && root.page-id != "clock" && root.page-id != "timer"
                        && root.page-id != "stats" && root.page-id != "battery" && root.page-id != "notes"
                        && root.page-id != "weather" && root.page-id != "reminder" && root.page-id != "clipboard" && root.page-id != "quick" && root.page-id != "tools" && root.page-id != "uji":
                        PlaceholderPage { name: root.page-id; }
                }
            }
        }
    }

    Ear { s: root.ui-scale; visible: root.dock != 1; x: pill.x - 10px * root.ui-scale; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; bottom: root.dock == 2; }
    Ear { s: root.ui-scale; visible: root.dock != 1; x: pill.x + pill.width; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; right: true; bottom: root.dock == 2; }
}
