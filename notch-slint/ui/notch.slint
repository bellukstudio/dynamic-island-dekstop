    in property <string> prayer-next-name: "Memuat jadwal...";
    in property <string> prayer-next-time: "--:--";
    in property <string> prayer-countdown: "--:--:--";
    in property <string> prayer-status: "";
    in property <bool> ramadan-enabled: false;
    in property <string> ramadan-date: "";
    in property <string> ramadan-imsak-countdown: "--:--:--";
    in property <string> ramadan-buka-countdown: "--:--:--";
    in property <string> ramadan-imsak-time: "";
    in property <string> ramadan-buka-time: "";
    in property <string> dhikr-arabic: "";
    in property <string> dhikr-latin: "";
    in property <string> dhikr-meaning: "";
