    in property <bool> focus-companion-enabled: true;
    in property <bool> focus-companion-on-start: true;
    in property <bool> focus-companion-on-halfway: true;
    in property <bool> focus-companion-on-focus-complete: true;
    in property <bool> focus-companion-on-break-end: true;
    in property <string> focus-companion-save-status: "";
    callback save-motion(bool, string, string, bool);
    callback test-dock-play();
    callback save-nudge(bool, string, string, string, string, string, bool, bool);
    callback test-nudge(string, string, string, string, bool);
    callback save-greeting(bool, string, string, string);
    callback test-greeting(string, string, string);
    callback save-conversation(bool, bool, bool, bool, bool, bool, bool, bool, bool, string, string);
    callback test-conversation(string, string);
    callback save-focus-companion(bool, bool, bool, bool, bool);
    callback test-focus-companion(string, string);
    in property <string> position-mode: "top";
    in property <string> hub-pages: "media, clock, weather, battery, timer, quick, tools, stats, reminder, notes, clipboard, shelf, privacy, prayer, currency";
    in property <string> pages-save-status: "Pisahkan ID halaman dengan koma";
    callback save-pages(string);
    callback toggle-page(string, bool);
    pure function page-enabled(id: string) -> bool { return (((((((((((((((((((((root.active-pages.length > 0 && root.active-pages[0] == id) || (root.active-pages.length > 1 && root.active-pages[1] == id)) || (root.active-pages.length > 2 && root.active-pages[2] == id)) || (root.active-pages.length > 3 && root.active-pages[3] == id)) || (root.active-pages.length > 4 && root.active-pages[4] == id)) || (root.active-pages.length > 5 && root.active-pages[5] == id)) || (root.active-pages.length > 6 && root.active-pages[6] == id)) || (root.active-pages.length > 7 && root.active-pages[7] == id)) || (root.active-pages.length > 8 && root.active-pages[8] == id)) || (root.active-pages.length > 9 && root.active-pages[9] == id)) || (root.active-pages.length > 10 && root.active-pages[10] == id)) || (root.active-pages.length > 11 && root.active-pages[11] == id)) || (root.active-pages.length > 12 && root.active-pages[12] == id)) || (root.active-pages.length > 13 && root.active-pages[13] == id)) || (root.active-pages.length > 14 && root.active-pages[14] == id)) || (root.active-pages.length > 15 && root.active-pages[15] == id)) || (root.active-pages.length > 16 && root.active-pages[16] == id)) || (root.active-pages.length > 17 && root.active-pages[17] == id)) || (root.active-pages.length > 18 && root.active-pages[18] == id)) || (root.active-pages.length > 19 && root.active-pages[19] == id)) || (root.active-pages.length > 20 && root.active-pages[20] == id)); }
    callback save-behavior(string, string, string, string, bool);
    callback save-autostart(bool);
    callback save-position(string);
    callback save-routines(string, string, string, string, string, string, string, string, string);
    callback save-appearance(string, string, string, string, string, string, string, string, string, float);
    callback preview-appearance(string, string, string, string, string, string, string, string, string, float);
    callback preview-nudge-mood(string);
    callback render-nudge-emoji(string);
    callback save-weather(string, string, string);
    // Pencarian kota (Open-Meteo geocoding) seperti kolom "Cari kota" di Pengaturan Tauri.
    in property <[CityHit]> weather-hits;
    in property <string> weather-search-status;
    callback search-city(string);
    // Tes suara adzan dan mulai ulang, sama seperti kartu "Suara adzan" dan tombol "Simpan & mulai ulang" di Tauri.
    in property <bool> adhan-active: false;
    in property <string> adhan-status: "";
    callback test-adhan();
    callback stop-adhan();
    callback pause-adhan(bool);
    property <bool> adhan-paused: false;
    callback restart-app();
    callback begin-drag();
    callback save-shortcuts(string, string, string, string);


    // ---- State form (properti privat). Nilai awal mengikuti properti `in` dari Rust; setelah diedit, nilainya lepas dari binding. ----
    property <string> f-theme: root.appearance-theme;
    property <string> f-eye-theme: root.appearance-eye-theme;
    property <string> f-notch-theme: root.appearance-notch-theme;
    property <string> f-mood: root.appearance-mood;
    property <string> f-accent: root.appearance-accent;
    property <string> f-custom-bg: root.appearance-custom-bg;
    property <string> f-custom-text: root.appearance-custom-text;
    property <string> f-dark-bg: root.appearance-dark-bg;
    property <string> f-light-bg: root.appearance-light-bg;
    property <string> f-scale: root.behavior-scale;

    property <string> f-hub: root.shortcut-hub;
    property <string> f-settings-key: root.shortcut-settings;
    property <string> f-pomo-key: root.shortcut-pomodoro;
    property <string> f-prayer-key: root.shortcut-prayer;

    property <string> f-prayer-province: root.prayer-province;
    property <string> f-prayer-city: root.prayer-city;
    property <string> f-prayer-mode: root.prayer-mode;
    property <string> f-prayer-remind: root.prayer-remind-before;
    property <string> f-prayer-min: root.prayer-remind-min;
    property <string> f-pomo-focus: root.pomodoro-focus;
    property <string> f-pomo-break: root.pomodoro-break;
    property <string> f-pomo-long: root.pomodoro-long-break;
    property <string> f-pomo-rounds: root.pomodoro-rounds;

    property <string> f-weather-city: root.weather-city;
    property <string> f-weather-lat: root.weather-lat;
    property <string> f-weather-lon: root.weather-lon;
    property <string> f-city-query: "";

    property <bool> f-nudge-enabled: root.nudge-enabled;
    property <string> f-nudge-idle: root.nudge-idle-min;
    property <string> f-nudge-message: root.nudge-message;
    property <string> f-nudge-emoji: root.nudge-emoji;
    changed f-nudge-emoji => { root.render-nudge-emoji(root.f-nudge-emoji); }
    property <string> f-nudge-mood: root.nudge-mood;
    property <string> f-nudge-show: root.nudge-show-ms;
    property <bool> f-nudge-silent: root.nudge-only-silent;
    property <bool> f-nudge-until: root.nudge-until-move;

    property <bool> f-greet-enabled: root.greeting-enabled;
    property <string> f-greet-mode: root.greeting-mode;
    property <string> f-greet-voice: root.greeting-voice;
    property <string> f-greet-custom: root.greeting-custom-text;

    property <bool> f-cm-enabled: root.conversation-enabled;
    property <bool> f-cm-play: root.conversation-on-play;
    property <bool> f-cm-track: root.conversation-on-track-change;
    property <bool> f-cm-pause: root.conversation-on-pause;
    property <bool> f-cm-return: root.conversation-on-return;
    property <bool> f-cm-weather: root.conversation-on-weather-change;
    property <bool> f-cm-rain: root.conversation-on-rain-soon;
    property <bool> f-cm-battery: root.conversation-on-low-battery;
    property <bool> f-cm-charging: root.conversation-on-charging;
    property <string> f-cm-return-min: root.conversation-return-after-min;
    property <string> f-cm-cooldown: root.conversation-cooldown-min;

    property <bool> f-fc-enabled: root.focus-companion-enabled;
    property <bool> f-fc-start: root.focus-companion-on-start;
    property <bool> f-fc-halfway: root.focus-companion-on-halfway;
    property <bool> f-fc-complete: root.focus-companion-on-focus-complete;
    property <bool> f-fc-break: root.focus-companion-on-break-end;

    property <string> f-hover-open: root.behavior-hover-open;
    property <string> f-hover-close: root.behavior-hover-close;
    property <string> f-sleep: root.behavior-sleep-after;
    property <bool> f-hide-fs: root.behavior-hide-fullscreen;
    property <bool> f-motion: root.motion-enabled;
    property <bool> f-dock-play: root.dock-play-enabled;
    property <string> f-motion-interval: root.motion-interval;
    property <string> f-motion-max: root.motion-max-moves;

    // ---- Katalog pilihan tema ----
    property <[SettingsChoice]> notch-themes: [
        { id: "default", label: "Bawaan", detail: "Warna manual", tint: #aeb8c8 },
        { id: "aurora", label: "Aurora", detail: "Modern", tint: #50e0c0 },
        { id: "obsidian", label: "Obsidian", detail: "Elegan", tint: #f7bd4e },
        { id: "neon", label: "Neon Tokyo", detail: "Cyber", tint: #20dce9 },
        { id: "sakura", label: "Sakura Boba", detail: "Lucu", tint: #ff83b4 },
        { id: "matcha", label: "Matcha Kodok", detail: "Lucu", tint: #99dba6 }
    ];
    property <[SettingsChoice]> eye-themes: [
        { id: "aurora", label: "Aurora", detail: "Soft glow", tint: #ff83cc },
        { id: "neon", label: "Neon", detail: "Bright", tint: #ff278c },
        { id: "pastel", label: "Pastel", detail: "Gentle", tint: #ffd7eb },
        { id: "pixel", label: "Pixel", detail: "Retro", tint: #ff48a7 },
        { id: "holo", label: "Holographic", detail: "Future", tint: #c86cff },
        { id: "ember", label: "Ember", detail: "Warm flame", tint: #ff7b5f },
        { id: "ocean", label: "Ocean", detail: "Deep aquatic", tint: #36d9ee },
        { id: "sakura", label: "Sakura", detail: "Cherry blossom", tint: #ff8dc5 },
        { id: "cyber", label: "Cyber", detail: "Cyber pulse", tint: #d63dff },
        { id: "monochrome", label: "Monochrome", detail: "Silver minimal", tint: #e8eaf4 },
        { id: "kawaii", label: "Kawaii", detail: "Bubblegum", tint: #ff9ccf },
        { id: "boba", label: "Boba", detail: "Milk tea pearl", tint: #c49a8f },
        { id: "galaxy", label: "Galaxy", detail: "Starry night", tint: #bd74ff },
        { id: "matcha", label: "Matcha", detail: "Calm green tea", tint: #9bd0a5 },
        { id: "candy", label: "Candy", detail: "Rainbow pop", tint: #ff87e3 },
        { id: "synthwave", label: "Synthwave", detail: "Retro sunset", tint: #d66cff },
        { id: "slime", label: "Slime", detail: "Jelly glossy", tint: #a7e9ae },
        { id: "cotton", label: "Cotton", detail: "Cotton candy", tint: #f7d5f4 },
        { id: "pumpkin", label: "Pumpkin", detail: "Spooky cute", tint: #ff8e55 },
        { id: "frost", label: "Frost", detail: "Ice crystal", tint: #d4f1ff }
    ];

    // ---- Judul, keterangan, dan status per tab ----
    pure function tab-title() -> string {
        if root.active-tab == "appearance" { return "Tampilan"; }
        if root.active-tab == "eyes" { return "Mata"; }
        if root.active-tab == "pages" { return "Halaman"; }
        if root.active-tab == "shortcuts" { return "Pintasan"; }
        if root.active-tab == "routines" { return "Shalat & Pomodoro"; }
        if root.active-tab == "weather" { return "Cuaca"; }
        if root.active-tab == "nudge" { return "Pesan diam"; }
        if root.active-tab == "greeting" { return "Sapaan"; }
        if root.active-tab == "moments" { return "Momen & fokus"; }
        return "Perilaku & posisi";
    }
    pure function tab-desc() -> string {
        if root.active-tab == "appearance" { return "Warna, tema, dan ukuran notch."; }
        if root.active-tab == "eyes" { return "Ekspresi mata saat notch diam, serta skin yang dipakai semua mood."; }
        if root.active-tab == "pages" { return "Pilih tab yang tampil di hub. Perubahan tersimpan otomatis; beberapa fitur tambahan perlu mulai ulang."; }
        if root.active-tab == "shortcuts" { return "Atur kombinasi tombol untuk membuka hub dan fitur utama. Langsung aktif setelah disimpan."; }
        if root.active-tab == "routines" { return "Jadwal dan pengingat shalat, serta durasi sesi fokus Pomodoro."; }
        if root.active-tab == "weather" { return "Lokasi saat ini: \{root.weather-city}. Berlaku langsung setelah disimpan, tanpa mulai ulang."; }
        if root.active-tab == "nudge" { return "Kalau pointer tidak bergerak cukup lama, notch menyapa dengan pesan imut. Muncul sekali untuk tiap periode diam."; }
        if root.active-tab == "greeting" { return "Sapaan yang tampil di notch dan dibacakan saat aplikasi mulai berjalan."; }
        if root.active-tab == "moments" { return "Komentar singkat dari notch pada momen tertentu, dan teman fokus saat sesi Pomodoro."; }
        return "Respons hover, posisi docking, dan gerakan otomatis.";
    }
    pure function tab-status() -> string {
        if root.active-tab == "appearance" || root.active-tab == "eyes" { return root.appearance-save-status; }
        if root.active-tab == "pages" { return root.pages-save-status == "Pisahkan ID halaman dengan koma" ? "Perubahan halaman tersimpan otomatis." : root.pages-save-status; }
        if root.active-tab == "shortcuts" || root.active-tab == "routines" { return root.save-status; }
        if root.active-tab == "weather" { return root.weather-save-status; }
        if root.active-tab == "nudge" { return root.nudge-save-status; }
        if root.active-tab == "greeting" { return root.greeting-save-status; }
        if root.active-tab == "moments" { return root.conversation-save-status != "" ? root.conversation-save-status : root.focus-companion-save-status; }
        return root.motion-save-status != "" ? root.motion-save-status : root.behavior-save-status;
    }

    // ---- Aksi ----
    function show-tab(id: string) {
        root.active-tab = id;
        flick.content-y = 0px;
    }

    // Kirim pratinjau sementara ke NotchWindow; callback ini tidak menulis config.toml.
    function preview-current-appearance() {
        root.preview-appearance(root.f-theme, root.f-eye-theme, root.f-notch-theme, root.f-mood, root.f-accent, root.f-custom-bg, root.f-custom-text, root.f-dark-bg, root.f-light-bg, root.behavior-scale-value);
    }
    function save-appearance-now() {
        root.save-appearance(root.f-theme, root.f-eye-theme, root.f-notch-theme, root.f-mood, root.f-accent, root.f-custom-bg, root.f-custom-text, root.f-dark-bg, root.f-light-bg, root.behavior-scale-value);
    }
    // Dipanggil dua kali, sama seperti perilaku versi sebelumnya untuk tema notch dan tema mata.
    function pick-eye-theme(id: string) {
        root.f-eye-theme = id;
        root.preview-current-appearance();
        root.preview-current-appearance();
    }
    function pick-notch-theme(id: string) {
        root.f-notch-theme = id;
        root.preview-current-appearance();
        root.preview-current-appearance();
    }
    function reset-appearance() {
        root.f-theme = "auto";
        root.f-eye-theme = "aurora";
        root.f-notch-theme = "default";
        root.f-mood = "normal";
        root.f-accent = "";
        root.f-custom-bg = "#000000";
        root.f-custom-text = "";
        root.f-dark-bg = "#000000";
        root.f-light-bg = "#f5f5f7";
        root.preview-current-appearance();
        root.preview-current-appearance();
        root.save-appearance("auto", "aurora", "default", "normal", "", "#000000", "", "#000000", "#f5f5f7", root.behavior-scale-value);
    }

    // Simpan kategori aktif; dipakai tombol "Simpan perubahan" di footer.
    function save-current-tab() {
        if root.active-tab == "appearance" || root.active-tab == "eyes" {
            root.save-appearance-now();
        } else if root.active-tab == "shortcuts" {
            root.save-shortcuts(root.f-hub, root.f-settings-key, root.f-pomo-key, root.f-prayer-key);
        } else if root.active-tab == "routines" {
            root.save-routines(root.f-prayer-mode, root.f-prayer-remind, root.f-prayer-min, root.f-pomo-focus, root.f-pomo-break, root.f-pomo-long, root.f-pomo-rounds, root.f-prayer-province, root.f-prayer-city);
        } else if root.active-tab == "weather" {
            root.save-weather(root.f-weather-city, root.f-weather-lat, root.f-weather-lon);
        } else if root.active-tab == "nudge" {
            root.save-nudge(root.f-nudge-enabled, root.f-nudge-idle, root.f-nudge-message, root.f-nudge-emoji, root.f-nudge-mood, root.f-nudge-show, root.f-nudge-silent, root.f-nudge-until);
        } else if root.active-tab == "greeting" {
            root.save-greeting(root.f-greet-enabled, root.f-greet-mode, root.f-greet-voice, root.f-greet-custom);
        } else if root.active-tab == "moments" {
            root.save-conversation(root.f-cm-enabled, root.f-cm-play, root.f-cm-track, root.f-cm-pause, root.f-cm-return, root.f-cm-weather, root.f-cm-rain, root.f-cm-battery, root.f-cm-charging, root.f-cm-return-min, root.f-cm-cooldown);
            root.save-focus-companion(root.f-fc-enabled, root.f-fc-start, root.f-fc-halfway, root.f-fc-complete, root.f-fc-break);
        } else if root.active-tab == "behavior" {
            root.save-position(root.position-mode);
            root.save-behavior(root.f-scale, root.f-hover-open, root.f-hover-close, root.f-sleep, root.f-hide-fs);
            root.save-motion(root.f-motion, root.f-motion-interval, root.f-motion-max, root.f-dock-play);
        }
    }

    HorizontalLayout {
        // ============================ Sidebar ============================
        Rectangle {
            width: 224px;
            background: SUi.side;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 18px;
                padding-bottom: 14px;
                spacing: 3px;
                HorizontalLayout {
                    height: 44px;
                    spacing: 10px;
                    padding-left: 6px;
                    alignment: start;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: #e8ecf7;
                        Rectangle { x: 8px; y: 9px; width: 18px; height: 14px; border-radius: 5px; background: #10131b; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: "Notch"; color: Theme.text; font-size: 15px; font-weight: 700; }
                        Text { text: "Pengaturan"; color: Theme.text-dim; font-size: 11px; }
                    }
                    // Area judul kustom: mulai native window drag saat mouse ditekan,
                    // tanpa menunggu maximize/minimize untuk mengaktifkan hit-test Windows.
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.begin-drag();
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }
                Rectangle { height: 26px; Text { x: 10px; width: parent.width - 10px; height: parent.height; text: "Penampilan"; color: Theme.text-faint; font-size: 11px; font-weight: 600; vertical-alignment: bottom; } }
                SettingsNavItem { label: "Tampilan"; commands: Icons.moon; active: root.active-tab == "appearance"; clicked => { root.show-tab("appearance"); } }
                SettingsNavItem { label: "Mata"; commands: Icons.eyes; active: root.active-tab == "eyes"; clicked => { root.show-tab("eyes"); } }
                Rectangle { height: 26px; Text { x: 10px; width: parent.width - 10px; height: parent.height; text: "Fitur"; color: Theme.text-faint; font-size: 11px; font-weight: 600; vertical-alignment: bottom; } }
                SettingsNavItem { label: "Halaman"; commands: Icons.grid; active: root.active-tab == "pages"; clicked => { root.show-tab("pages"); } }
                SettingsNavItem { label: "Pintasan"; commands: Icons.wrench; active: root.active-tab == "shortcuts"; clicked => { root.show-tab("shortcuts"); } }
                SettingsNavItem { label: "Shalat & Pomodoro"; commands: Icons.prayer; active: root.active-tab == "routines"; clicked => { root.show-tab("routines"); } }
                SettingsNavItem { label: "Cuaca"; commands: Icons.weather; active: root.active-tab == "weather"; clicked => { root.show-tab("weather"); } }
                Rectangle { height: 26px; Text { x: 10px; width: parent.width - 10px; height: parent.height; text: "Karakter"; color: Theme.text-faint; font-size: 11px; font-weight: 600; vertical-alignment: bottom; } }
                SettingsNavItem { label: "Pesan diam"; commands: Icons.chat; active: root.active-tab == "nudge"; clicked => { root.show-tab("nudge"); } }
                SettingsNavItem { label: "Sapaan"; commands: Icons.mic; active: root.active-tab == "greeting"; clicked => { root.show-tab("greeting"); } }
                SettingsNavItem { label: "Momen & fokus"; commands: Icons.timer; active: root.active-tab == "moments"; clicked => { root.show-tab("moments"); } }
                Rectangle { height: 26px; Text { x: 10px; width: parent.width - 10px; height: parent.height; text: "Sistem"; color: Theme.text-faint; font-size: 11px; font-weight: 600; vertical-alignment: bottom; } }
                SettingsNavItem { label: "Perilaku & posisi"; commands: Icons.settings; active: root.active-tab == "behavior"; clicked => { root.show-tab("behavior"); } }
                Rectangle { vertical-stretch: 1; }
                SButton { label: "Mulai ulang Notch"; clicked => { root.restart-app(); } }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: SUi.card-line; }
        }

        // ============================ Konten ============================
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Pratinjau tetap di atas untuk tab Tampilan dan Mata.
            if root.active-tab == "appearance" || root.active-tab == "eyes": Rectangle {
                height: 104px;
                Rectangle {
                    x: max(0px, (parent.width - min(parent.width - 56px, 904px)) / 2);
                    y: 16px;
                    width: min(parent.width - 56px, 904px);
                    height: 80px;
                    border-radius: 14px;
                    background: SUi.card;
                    border-width: 1px;
                    border-color: SUi.card-line;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 9px;
                            background: #aeb8c8;
                            preview-pill := Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                                width: 190px;
                                height: 42px;
                                border-bottom-left-radius: 17px;
                                border-bottom-right-radius: 17px;
                                background: #03050b;
                                for t in root.eye-themes: Rectangle {
                                    visible: t.id == root.f-eye-theme;
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    Rectangle { x: parent.width / 2 - 18px; y: 13px; width: 8px; height: 16px; border-radius: 4px; background: t.tint; }
                                    Rectangle { x: parent.width / 2 + 10px; y: 13px; width: 8px; height: 16px; border-radius: 4px; background: t.tint; }
                                }
                            }
                            Rectangle {
                                x: preview-pill.x + 28px;
                                y: 44px;
                                width: preview-pill.width - 56px;
                                height: 2px;
                                background: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            width: 230px;
                            alignment: center;
                            spacing: 3px;
                            Text { text: "Pratinjau"; color: Theme.text; font-size: 13px; font-weight: 700; }
                            Text { text: "Perubahan langsung terlihat pada notch asli sebelum disimpan."; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                }
            }

            flick := Flickable {
                content-width: self.width;
                content-y: 0px;
                vertical-stretch: 1;
                content-height: max(self.height, form.preferred-height + 24px);
                form := VerticalLayout {
                    width: min(parent.width, 960px);
                    x: max(0px, (parent.width - self.width) / 2);
                    y: 0px;
                    alignment: start;
                    spacing: 14px;
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 24px;
                    padding-bottom: 16px;

                    Text { text: root.tab-title(); color: Theme.text; font-size: 24px; font-weight: 700; }
                    Text { text: root.tab-desc(); color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                    Rectangle { height: 2px; }

                    // ------------------------ Tampilan ------------------------
                    if root.active-tab == "appearance": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Warna & tema";
                            action: "Pulihkan bawaan";
                            action-clicked => { root.reset-appearance(); }
                            SRow {
                                first: true;
                                title: "Tema";
                                desc: "Ikuti sistem operasi, atau pilih sendiri.";
                                SSeg {
                                    SSegItem { label: "Ikuti OS"; selected: root.f-theme == "auto"; clicked => { root.f-theme = "auto"; root.preview-current-appearance(); } }
                                    SSegItem { label: "Gelap"; selected: root.f-theme == "dark"; clicked => { root.f-theme = "dark"; root.preview-current-appearance(); } }
                                    SSegItem { label: "Terang"; selected: root.f-theme == "light"; clicked => { root.f-theme = "light"; root.preview-current-appearance(); } }
                                    SSegItem { label: "Kustom"; selected: root.f-theme == "custom"; clicked => { root.f-theme = "custom"; root.preview-current-appearance(); } }
                                }
                            }
                            SRow {
                                title: "Warna notch";
                                desc: "Dipakai pada tema Kustom.";
                                SInput { width: 150px; text <=> root.f-custom-bg; edited => { root.preview-current-appearance(); } }
                            }
                            SRow {
                                title: "Warna notch di tema gelap";
                                SInput { width: 150px; text <=> root.f-dark-bg; edited => { root.preview-current-appearance(); } }
                            }
                            SRow {
                                title: "Warna notch di tema terang";
                                SInput { width: 150px; text <=> root.f-light-bg; edited => { root.preview-current-appearance(); } }
                            }
                            SRow {
                                title: "Warna teks";
                                desc: "Kosongkan agar otomatis mengikuti latar.";
                                SButton { quiet: true; label: "Otomatis"; clicked => { root.f-custom-text = ""; root.preview-current-appearance(); } }
                                SInput { width: 150px; placeholder: "Otomatis"; text <=> root.f-custom-text; edited => { root.preview-current-appearance(); } }
                            }
                            SRow {
                                title: "Warna aksen";
                                desc: "Kosongkan agar mengikuti warna cover album.";
                                SButton { quiet: true; label: "Dari cover"; clicked => { root.f-accent = ""; root.preview-current-appearance(); } }
                                SInput { width: 150px; placeholder: "Dari cover album"; text <=> root.f-accent; edited => { root.preview-current-appearance(); } }
                            }
                            SRow {
                                title: "Aksen cepat";
                                SSwatch { tint: #6C8CFF; selected: root.f-accent == "#6C8CFF"; clicked => { root.f-accent = "#6C8CFF"; root.preview-current-appearance(); } }
                                SSwatch { tint: #A78BFA; selected: root.f-accent == "#A78BFA"; clicked => { root.f-accent = "#A78BFA"; root.preview-current-appearance(); } }
                                SSwatch { tint: #F472B6; selected: root.f-accent == "#F472B6"; clicked => { root.f-accent = "#F472B6"; root.preview-current-appearance(); } }
                                SSwatch { tint: #34D399; selected: root.f-accent == "#34D399"; clicked => { root.f-accent = "#34D399"; root.preview-current-appearance(); } }
                                SSwatch { tint: #FB923C; selected: root.f-accent == "#FB923C"; clicked => { root.f-accent = "#FB923C"; root.preview-current-appearance(); } }
                                SSwatch { tint: #22D3EE; selected: root.f-accent == "#22D3EE"; clicked => { root.f-accent = "#22D3EE"; root.preview-current-appearance(); } }
                            }
                        }
                        SCard {
                            title: "Ukuran";
                            SRow {
                                first: true;
                                title: "Skala notch";
                                desc: "Dari 50% sampai 150% dari ukuran bawaan.";
                                SSlider {
                                    width: 220px;
                                    minimum: 0.5;
                                    maximum: 1.5;
                                    value <=> root.behavior-scale-value;
                                    changing(v) => { root.f-scale = "\{v}"; }
                                    released(v) => { root.f-scale = "\{v}"; root.preview-current-appearance(); }
                                }
                                Text { width: 46px; text: "\{Math.round(root.behavior-scale-value * 100)}%"; color: Theme.text-dim; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }
                    }

                    // ------------------------ Mata ------------------------
                    if root.active-tab == "eyes": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Ekspresi mata bawaan";
                            desc: "Ekspresi yang tampil saat notch diam.";
                            action: "Pulihkan bawaan";
                            action-clicked => { root.reset-appearance(); }
                            SBlock {
                                first: true;
                                title: "Ekspresi";
                                SMoodSeg { value: root.f-mood; picked(m) => { root.f-mood = m; root.preview-current-appearance(); } }
                            }
                        }
                        SCard {
                            title: "Tema notch";
                            desc: "Tema siap pakai untuk badan notch: latar, warna teks, dan aksen.";
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    for col in 6: SettingsChoiceCard {
                                        label: root.notch-themes[col].label;
                                        detail: root.notch-themes[col].detail;
                                        tint: root.notch-themes[col].tint;
                                        preview-kind: "notch";
                                        selected: root.notch-themes[col].id == root.f-notch-theme;
                                        clicked => { root.pick-notch-theme(root.notch-themes[col].id); }
                                    }
                                }
                            }
                        }
                        SCard {
                            title: "Tema visual mata";
                            desc: "Pilih satu dari 20 skin. Setiap mood punya palet warna khusus.";
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 14px;
                                spacing: 8px;
                                for row in 4: HorizontalLayout {
                                    spacing: 8px;
                                    for col in 5: SettingsChoiceCard {
                                        label: root.eye-themes[row * 5 + col].label;
                                        detail: root.eye-themes[row * 5 + col].detail;
                                        tint: root.eye-themes[row * 5 + col].tint;
                                        selected: root.eye-themes[row * 5 + col].id == root.f-eye-theme;
                                        clicked => { root.pick-eye-theme(root.eye-themes[row * 5 + col].id); }
                                    }
                                }
                            }
                        }
                    }

                    // ------------------------ Halaman ------------------------
                    if root.active-tab == "pages": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Halaman utama";
                            desc: "Tab yang ingin ditampilkan pada hub notch. Musik wajib aktif.";
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 14px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    PageToggle { label: "Musik"; checked: root.page-enabled("media"); toggled(v) => { root.toggle-page("media", v); } }
                                    PageToggle { label: "Cuaca"; checked: root.page-enabled("weather"); toggled(v) => { root.toggle-page("weather", v); } }
                                    PageToggle { label: "Timer Pomodoro"; checked: root.page-enabled("timer"); toggled(v) => { root.toggle-page("timer", v); } }
                                    PageToggle { label: "Alat"; checked: root.page-enabled("tools"); toggled(v) => { root.toggle-page("tools", v); } }
                                    PageToggle { label: "Riwayat clipboard"; checked: root.page-enabled("clipboard"); toggled(v) => { root.toggle-page("clipboard", v); } }
                                    PageToggle { label: "Pengingat"; checked: root.page-enabled("reminder"); toggled(v) => { root.toggle-page("reminder", v); } }
                                    PageToggle { label: "Jadwal shalat"; checked: root.page-enabled("prayer"); toggled(v) => { root.toggle-page("prayer", v); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    PageToggle { label: "Jam & tanggal"; checked: root.page-enabled("clock"); toggled(v) => { root.toggle-page("clock", v); } }
                                    PageToggle { label: "Baterai"; checked: root.page-enabled("battery"); toggled(v) => { root.toggle-page("battery", v); } }
                                    PageToggle { label: "Kontrol cepat"; checked: root.page-enabled("quick"); toggled(v) => { root.toggle-page("quick", v); } }
                                    PageToggle { label: "Status sistem"; checked: root.page-enabled("stats"); toggled(v) => { root.toggle-page("stats", v); } }
                                    PageToggle { label: "Shelf file"; checked: root.page-enabled("shelf"); toggled(v) => { root.toggle-page("shelf", v); } }
                                    PageToggle { label: "Catatan"; checked: root.page-enabled("notes"); toggled(v) => { root.toggle-page("notes", v); } }
                                    PageToggle { label: "Currency · Kurs & saham"; checked: root.page-enabled("currency"); toggled(v) => { root.toggle-page("currency", v); } }
                                }
                            }
                        }
                        SCard {
                            title: "Tambahan";
                            desc: "Fitur pendamping dan alat tambahan; tidak semuanya menjadi tab utama.";
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 14px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    PageToggle { label: "Indikator mic/kamera"; checked: root.page-enabled("privacy"); toggled(v) => { root.toggle-page("privacy", v); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            SButton { label: "Pulihkan halaman default"; clicked => { root.save-pages("media, clock, weather, battery, timer, quick, tools, stats, reminder, notes, clipboard, shelf, privacy, prayer, currency"); } }
                        }
                    }

                    // ------------------------ Pintasan ------------------------
                    if root.active-tab == "shortcuts": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Pintasan keyboard";
                            desc: "Minimal satu modifier (Ctrl / Alt / Shift / Win) dan satu tombol.";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-hub = "Ctrl+Alt+N";
                                root.f-settings-key = "Ctrl+Alt+,";
                                root.f-pomo-key = "Ctrl+Alt+P";
                                root.f-prayer-key = "Ctrl+Alt+A";
                                root.save-shortcuts("Ctrl+Alt+N", "Ctrl+Alt+,", "Ctrl+Alt+P", "Ctrl+Alt+A");
                            }
                            SRow { first: true; title: "Buka / tutup hub"; SInput { width: 220px; text <=> root.f-hub; } }
                            SRow { title: "Buka pengaturan"; SInput { width: 220px; text <=> root.f-settings-key; } }
                            SRow { title: "Pomodoro"; SInput { width: 220px; text <=> root.f-pomo-key; } }
                            SRow { title: "Jadwal shalat"; SInput { width: 220px; text <=> root.f-prayer-key; } }
                        }
                        Text {
                            text: "Tombol yang bisa dipakai: A–Z, 0–9, F1–F12, Space, Enter, Esc, Tab, Backspace, koma, titik, slash, titik koma, apostrof, kurung siku, minus, dan sama dengan. Pastikan kombinasi tidak bentrok dengan aplikasi lain.";
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        SCard {
                            title: "Pintasan bawaan";
                            desc: "Tetap dan tidak bisa diubah.";
                            SRow { first: true; title: "Color Picker"; SKeycap { keys: "Ctrl+Alt+Shift+P"; } }
                            SRow { title: "Compress"; SKeycap { keys: "Ctrl+Alt+Shift+K"; } }
                            SRow { title: "Convert"; SKeycap { keys: "Ctrl+Alt+Shift+C"; } }
                            SRow { title: "Transfer file"; SKeycap { keys: "Ctrl+Alt+Shift+S"; } }
                            SRow { title: "Android & mirroring"; SKeycap { keys: "Ctrl+Alt+Shift+A"; } }
                        }
                    }

                    // ------------------------ Shalat & Pomodoro ------------------------
                    if root.active-tab == "routines": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Jadwal shalat";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-prayer-province = "Jawa Barat";
                                root.f-prayer-city = "Kota Bandung";
                                root.f-prayer-mode = "tone";
                                root.f-prayer-remind = "false";
                                root.f-prayer-min = "10";
                                root.f-pomo-focus = "25";
                                root.f-pomo-break = "5";
                                root.f-pomo-long = "15";
                                root.f-pomo-rounds = "4";
                                root.save-routines("tone", "false", "10", "25", "5", "15", "4", "Jawa Barat", "Kota Bandung");
                            }
                            SRow { first: true; title: "Provinsi"; SInput { width: 240px; text <=> root.f-prayer-province; } }
                            SRow { title: "Kabupaten / Kota"; SInput { width: 240px; text <=> root.f-prayer-city; } }
                            SRow {
                                title: "Notifikasi waktu shalat";
                                desc: "Nada singkat, suara adzan, atau tanpa suara.";
                                SSeg {
                                    SSegItem { label: "Nada"; selected: root.f-prayer-mode == "tone"; clicked => { root.f-prayer-mode = "tone"; } }
                                    SSegItem { label: "Adzan"; selected: root.f-prayer-mode == "adzan"; clicked => { root.f-prayer-mode = "adzan"; } }
                                    SSegItem { label: "Senyap"; selected: root.f-prayer-mode == "silent"; clicked => { root.f-prayer-mode = "silent"; } }
                                }
                            }
                            SRow {
                                title: "Pengingat sebelum adzan";
                                SSwitch { checked: root.f-prayer-remind == "true"; toggled(v) => { root.f-prayer-remind = v ? "true" : "false"; } }
                            }
                            SRow {
                                title: "Menit sebelum waktu shalat";
                                desc: "Antara 1 dan 120 menit.";
                                SInput { width: 120px; suffix: "menit"; disabled: root.f-prayer-remind != "true"; text <=> root.f-prayer-min; }
                            }
                        }
                        SCard {
                            title: "Pomodoro";
                            SRow { first: true; title: "Durasi fokus"; SInput { width: 120px; suffix: "menit"; text <=> root.f-pomo-focus; } }
                            SRow { title: "Istirahat pendek"; SInput { width: 120px; suffix: "menit"; text <=> root.f-pomo-break; } }
                            SRow { title: "Istirahat panjang"; SInput { width: 120px; suffix: "menit"; text <=> root.f-pomo-long; } }
                            SRow { title: "Ronde sebelum istirahat panjang"; SInput { width: 120px; suffix: "ronde"; text <=> root.f-pomo-rounds; } }
                        }
                        SCard {
                            title: "Suara adzan";
                            desc: "Putar adzan.mp3 untuk pengujian. Tidak mengubah pengingat jadwal shalat.";
                            SRow {
                                first: true;
                                title: "Status pemutaran";
                                Text { text: root.adhan-active ? (root.adhan-paused ? "Dijeda" : "Sedang diputar") : "Siap diputar"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            SBlock {
                                title: "Kontrol";
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    SButton { label: "▶ Mulai tes adzan"; primary: root.adhan-active; clicked => { if (!root.adhan-active) { root.adhan-paused = false; root.test-adhan(); } } }
                                    SButton { label: root.adhan-paused ? "▶ Lanjutkan" : "Ⅱ Jeda"; opacity: root.adhan-active ? 1.0 : 0.4; clicked => { if (root.adhan-active) { root.adhan-paused = !root.adhan-paused; root.pause-adhan(root.adhan-paused); } } }
                                    SButton { label: "Hentikan"; clicked => { root.adhan-paused = false; root.stop-adhan(); } }
                                }
                            }
                            if root.adhan-status != "": Text {
                                text: root.adhan-status;
                                color: Theme.text-dim;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ------------------------ Cuaca ------------------------
                    if root.active-tab == "weather": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Cari kota";
                            desc: "Pilih hasil pencarian untuk mengisi nama dan koordinat otomatis.";
                            SBlock {
                                first: true;
                                title: "Nama kota";
                                HorizontalLayout {
                                    spacing: 8px;
                                    SInput { horizontal-stretch: 1; placeholder: "Cari kota, mis. Surabaya"; text <=> root.f-city-query; accepted => { root.search-city(root.f-city-query); } }
                                    SButton { label: "Cari"; primary: true; clicked => { root.search-city(root.f-city-query); } }
                                }
                                for hit in root.weather-hits: Rectangle {
                                    height: 36px;
                                    border-radius: 9px;
                                    background: hit-ta.has-hover ? SUi.hover : SUi.field;
                                    Text { x: 12px; width: parent.width - 24px; height: parent.height; text: hit.label; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    hit-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.f-weather-city = hit.name;
                                            root.f-weather-lat = hit.lat;
                                            root.f-weather-lon = hit.lon;
                                        }
                                    }
                                }
                                if root.weather-search-status != "": Text { text: root.weather-search-status; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        SCard {
                            title: "Koordinat";
                            desc: "Gunakan koordinat desimal.";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-weather-city = "Bandung";
                                root.f-weather-lat = "-6.9175";
                                root.f-weather-lon = "107.6191";
                                root.save-weather("Bandung", "-6.9175", "107.6191");
                            }
                            SRow { first: true; title: "Nama lokasi"; SInput { width: 260px; text <=> root.f-weather-city; } }
                            SRow { title: "Lintang"; SInput { width: 160px; text <=> root.f-weather-lat; } }
                            SRow { title: "Bujur"; SInput { width: 160px; text <=> root.f-weather-lon; } }
                        }
                    }

                    // ------------------------ Pesan diam ------------------------
                    if root.active-tab == "nudge": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Isi pesan";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-nudge-enabled = true;
                                root.f-nudge-idle = "2";
                                root.f-nudge-message = "Kamu kemana, kok diam saja?";
                                root.f-nudge-emoji = "🥺";
                                root.f-nudge-mood = "sad";
                                root.f-nudge-show = "6000";
                                root.f-nudge-silent = true;
                                root.f-nudge-until = false;
                                root.save-nudge(true, "2", "Kamu kemana, kok diam saja?", "🥺", "sad", "6000", true, false);
                            }
                            SRow {
                                first: true;
                                title: "Aktifkan pesan diam";
                                SSwitch { checked: root.f-nudge-enabled; toggled(v) => { root.f-nudge-enabled = v; } }
                            }
                            SBlock {
                                title: "Pesan";
                                desc: "Maksimal 80 karakter.";
                                SInput { text <=> root.f-nudge-message; }
                            }
                            SBlock {
                                title: "Emoji";
                                desc: "Tekan Ctrl+A, lalu Win + . untuk memilih emoji, atau paste emoji pilihanmu.";
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    // Nilai tetap diedit sebagai teks, tetapi glyph disembunyikan dan diganti artwork warna di dalam field.
                                    SInput {
                                        width: 88px;
                                        leading-emoji: root.f-nudge-emoji;
                                        leading-emoji-image: root.nudge-emoji-image;
                                        leading-emoji-image-available: root.nudge-emoji-image-available;
                                        hide-text-when-leading-emoji: true;
                                        text <=> root.f-nudge-emoji;
                                    }
                                    SettingsEmojiButton { emoji: "🥺"; emoji-image: @image-url("../assets/emoji/nudge/1f97a.svg"); selected: root.f-nudge-emoji == "🥺"; clicked => { root.f-nudge-emoji = "🥺"; } }
                                    SettingsEmojiButton { emoji: "😳"; emoji-image: @image-url("../assets/emoji/nudge/1f633.svg"); selected: root.f-nudge-emoji == "😳"; clicked => { root.f-nudge-emoji = "😳"; } }
                                    SettingsEmojiButton { emoji: "😴"; emoji-image: @image-url("../assets/emoji/nudge/1f634.svg"); selected: root.f-nudge-emoji == "😴"; clicked => { root.f-nudge-emoji = "😴"; } }
                                    SettingsEmojiButton { emoji: "😿"; emoji-image: @image-url("../assets/emoji/nudge/1f63f.svg"); selected: root.f-nudge-emoji == "😿"; clicked => { root.f-nudge-emoji = "😿"; } }
                                    SettingsEmojiButton { emoji: "😺"; emoji-image: @image-url("../assets/emoji/nudge/1f63a.svg"); selected: root.f-nudge-emoji == "😺"; clicked => { root.f-nudge-emoji = "😺"; } }
                                    SettingsEmojiButton { emoji: "🥰"; emoji-image: @image-url("../assets/emoji/nudge/1f970.svg"); selected: root.f-nudge-emoji == "🥰"; clicked => { root.f-nudge-emoji = "🥰"; } }
                                    SettingsEmojiButton { emoji: "🤔"; emoji-image: @image-url("../assets/emoji/nudge/1f914.svg"); selected: root.f-nudge-emoji == "🤔"; clicked => { root.f-nudge-emoji = "🤔"; } }
                                }
                            }
                            SBlock {
                                title: "Ekspresi mata";
                                HorizontalLayout {
                                    alignment: start;
                                    SMoodSeg { value: root.f-nudge-mood; picked(m) => { root.f-nudge-mood = m; root.preview-nudge-mood(m); } }
                                }
                            }
                        }
                        SCard {
                            title: "Kapan muncul";
                            SRow {
                                first: true;
                                title: "Muncul setelah diam";
                                SInput { width: 120px; suffix: "menit"; text <=> root.f-nudge-idle; }
                            }
                            SRow {
                                title: "Lama tampil";
                                desc: "2–30 detik. Dipakai jika opsi \"sampai pointer bergerak\" mati.";
                                SInput { width: 120px; suffix: "detik"; disabled: root.f-nudge-until; text <=> root.f-nudge-show; }
                            }
                            SRow {
                                title: "Jangan muncul saat musik atau video diputar";
                                SSwitch { checked: root.f-nudge-silent; toggled(v) => { root.f-nudge-silent = v; } }
                            }
                            SRow {
                                title: "Tampilkan sampai pointer bergerak lagi";
                                desc: "Notch tetap menampilkan pesan sampai kamu kembali, lalu menyapa dengan ekspresi senang.";
                                SSwitch { checked: root.f-nudge-until; toggled(v) => { root.f-nudge-until = v; } }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            SButton { label: "Coba tampilkan"; clicked => { root.test-nudge(root.f-nudge-message, root.f-nudge-emoji, root.f-nudge-mood, root.f-nudge-show, root.f-nudge-until); } }
                        }
                    }

                    // ------------------------ Sapaan ------------------------
                    if root.active-tab == "greeting": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Sapaan otomatis";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-greet-enabled = true;
                                root.f-greet-mode = "random";
                                root.f-greet-voice = "cewek";
                                root.f-greet-custom = "Halo, semangat menjalani hari!";
                                root.save-greeting(true, "random", "cewek", "Halo, semangat menjalani hari!");
                            }
                            SRow {
                                first: true;
                                title: "Aktifkan greeting suara";
                                SSwitch { checked: root.f-greet-enabled; toggled(v) => { root.f-greet-enabled = v; } }
                            }
                            SBlock {
                                title: "Sapaan bawaan";
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SPill { label: "Acak lucu"; selected: root.f-greet-mode == "random"; clicked => { root.f-greet-mode = "random"; } }
                                        SPill { label: "Halo + waktu"; selected: root.f-greet-mode == "auto"; clicked => { root.f-greet-mode = "auto"; } }
                                        SPill { label: "Halo"; selected: root.f-greet-mode == "halo"; clicked => { root.f-greet-mode = "halo"; } }
                                        SPill { label: "Teks kustom"; selected: root.f-greet-mode == "custom"; clicked => { root.f-greet-mode = "custom"; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SPill { label: "Pagi"; selected: root.f-greet-mode == "morning"; clicked => { root.f-greet-mode = "morning"; } }
                                        SPill { label: "Siang"; selected: root.f-greet-mode == "noon"; clicked => { root.f-greet-mode = "noon"; } }
                                        SPill { label: "Sore"; selected: root.f-greet-mode == "afternoon"; clicked => { root.f-greet-mode = "afternoon"; } }
                                        SPill { label: "Malam"; selected: root.f-greet-mode == "evening"; clicked => { root.f-greet-mode = "evening"; } }
                                    }
                                }
                            }
                            if root.f-greet-mode == "custom": SBlock {
                                title: "Teks sapaan kustom";
                                desc: "Maksimal 120 karakter. Teks kustom dibacakan dengan suara Windows.";
                                SInput { text <=> root.f-greet-custom; }
                            }
                            SBlock {
                                title: "Mode suara";
                                desc: "Suara neural memakai Edge TTS.";
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SPill { label: "Cewek natural"; selected: root.f-greet-voice == "cewek"; clicked => { root.f-greet-voice = "cewek"; } }
                                        SPill { label: "Cowok natural"; selected: root.f-greet-voice == "cowok"; clicked => { root.f-greet-voice = "cowok"; } }
                                        SPill { label: "Suara sistem"; selected: root.f-greet-voice == "system"; clicked => { root.f-greet-voice = "system"; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SPill { label: "Anime cewek"; selected: root.f-greet-voice == "anime-cewek"; clicked => { root.f-greet-voice = "anime-cewek"; } }
                                        SPill { label: "Anime cowok"; selected: root.f-greet-voice == "anime-cowok"; clicked => { root.f-greet-voice = "anime-cowok"; } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            SButton { label: "Pratinjau"; clicked => { root.test-greeting(root.f-greet-mode, root.f-greet-custom, root.f-greet-voice); } }
                        }
                    }

                    // ------------------------ Momen & fokus ------------------------
                    if root.active-tab == "moments": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Conversation Moments";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-cm-enabled = true;
                                root.f-cm-play = true;
                                root.f-cm-track = true;
                                root.f-cm-pause = false;
                                root.f-cm-return = true;
                                root.f-cm-weather = true;
                                root.f-cm-rain = true;
                                root.f-cm-battery = true;
                                root.f-cm-charging = false;
                                root.f-cm-return-min = "10";
                                root.f-cm-cooldown = "3";
                                root.save-conversation(true, true, true, false, true, true, true, true, false, "10", "3");
                            }
                            SRow {
                                first: true;
                                title: "Aktifkan komentar kontekstual";
                                SSwitch { checked: root.f-cm-enabled; toggled(v) => { root.f-cm-enabled = v; } }
                            }
                            SBlock {
                                title: "Komentar muncul";
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        PageToggle { label: "Saat musik mulai diputar"; checked: root.f-cm-play; toggled(v) => { root.f-cm-play = v; } }
                                        PageToggle { label: "Saat lagu berganti"; checked: root.f-cm-track; toggled(v) => { root.f-cm-track = v; } }
                                        PageToggle { label: "Saat musik dijeda atau selesai"; checked: root.f-cm-pause; toggled(v) => { root.f-cm-pause = v; } }
                                        PageToggle { label: "Saat kembali setelah lama tidak aktif"; checked: root.f-cm-return; toggled(v) => { root.f-cm-return = v; } }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        PageToggle { label: "Saat kondisi cuaca berubah"; checked: root.f-cm-weather; toggled(v) => { root.f-cm-weather = v; } }
                                        PageToggle { label: "Saat hujan segera diperkirakan"; checked: root.f-cm-rain; toggled(v) => { root.f-cm-rain = v; } }
                                        PageToggle { label: "Saat baterai turun ke 15%"; checked: root.f-cm-battery; toggled(v) => { root.f-cm-battery = v; } }
                                        PageToggle { label: "Saat laptop mulai mengisi daya"; checked: root.f-cm-charging; toggled(v) => { root.f-cm-charging = v; } }
                                    }
                                }
                            }
                            SRow {
                                title: "Anggap kembali setelah";
                                desc: "Antara 5 dan 120 menit tidak aktif.";
                                SInput { width: 120px; suffix: "menit"; text <=> root.f-cm-return-min; }
                            }
                            SRow {
                                title: "Jeda antar komentar";
                                desc: "Antara 1 dan 60 menit.";
                                SInput { width: 120px; suffix: "menit"; text <=> root.f-cm-cooldown; }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            SButton { label: "Coba momen"; clicked => { root.test-conversation("Asyik, kita ketemu momen baru! ✨", "Uji Conversation Moments"); } }
                            SButton { label: "Coba momen cuaca"; clicked => { root.test-conversation("Cuaca berubah, jangan lupa sesuaikan aktivitasmu ☀️", "Uji momen cuaca"); } }
                        }
                        SCard {
                            title: "Focus Companion";
                            desc: "Teman fokus untuk sesi Pomodoro.";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-fc-enabled = true;
                                root.f-fc-start = true;
                                root.f-fc-halfway = true;
                                root.f-fc-complete = true;
                                root.f-fc-break = true;
                                root.save-focus-companion(true, true, true, true, true);
                            }
                            SRow {
                                first: true;
                                title: "Aktifkan teman fokus Pomodoro";
                                SSwitch { checked: root.f-fc-enabled; toggled(v) => { root.f-fc-enabled = v; } }
                            }
                            SBlock {
                                title: "Komentar muncul";
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        PageToggle { label: "Saat sesi fokus dimulai"; checked: root.f-fc-start; toggled(v) => { root.f-fc-start = v; } }
                                        PageToggle { label: "Saat mencapai setengah sesi"; checked: root.f-fc-halfway; toggled(v) => { root.f-fc-halfway = v; } }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        PageToggle { label: "Saat sesi fokus selesai"; checked: root.f-fc-complete; toggled(v) => { root.f-fc-complete = v; } }
                                        PageToggle { label: "Saat waktu istirahat selesai"; checked: root.f-fc-break; toggled(v) => { root.f-fc-break = v; } }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            SButton { label: "Coba Focus Companion"; clicked => { root.test-focus-companion("Yuk, fokus satu hal dulu. Kamu pasti bisa! 🎯", "Uji Focus Companion"); } }
                        }
                    }

                    // ------------------------ Perilaku & posisi ------------------------
                    if root.active-tab == "behavior": VerticalLayout {
                        spacing: 14px;
                        SCard {
                            title: "Perilaku";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-scale = "1.00";
                                root.behavior-scale-value = 1.0;
                                root.f-hover-open = "150";
                                root.f-hover-close = "450";
                                root.f-sleep = "60";
                                root.f-hide-fs = true;
                                root.save-behavior("1.00", "150", "450", "60", true);
                                root.save-autostart(false);
                            }
                            SRow { first: true; title: "Jeda hover buka"; desc: "0–2000 ms."; SInput { width: 120px; suffix: "ms"; text <=> root.f-hover-open; } }
                            SRow { title: "Jeda hover tutup"; desc: "0–5000 ms."; SInput { width: 120px; suffix: "ms"; text <=> root.f-hover-close; } }
                            SRow { title: "Idle sebelum mata mengantuk"; desc: "10–3600 detik."; SInput { width: 120px; suffix: "detik"; text <=> root.f-sleep; } }
                            SRow {
                                title: "Sembunyikan notch saat layar penuh";
                                SSwitch { checked: root.f-hide-fs; toggled(v) => { root.f-hide-fs = v; } }
                            }
                            SRow {
                                title: "Jalankan otomatis saat komputer menyala";
                                desc: root.autostart-save-status != "" ? root.autostart-save-status : "Tersedia pada build release.";
                                SSwitch { checked: root.autostart-enabled; toggled(v) => { root.save-autostart(v); } }
                            }
                        }
                        SCard {
                            title: "Posisi";
                            desc: "Klik dan seret notch saat diam, atau seret pegangan di bawah hub, untuk memindahkannya.";
                            SRow {
                                first: true;
                                title: "Posisi docking";
                                desc: root.position-mode == "top" ? "Tengah atas (bawaan)" : (root.position-mode == "floating" ? "Posisi kustom (hasil seret)" : (root.position-mode == "bottom" ? "Tengah bawah" : (root.position-mode == "left" ? "Tepi kiri" : "Tepi kanan")));
                                SSeg {
                                    SSegItem { label: "Atas"; selected: root.position-mode == "top"; clicked => { root.save-position("top"); } }
                                    SSegItem { label: "Melayang"; selected: root.position-mode == "floating"; clicked => { root.save-position("floating"); } }
                                    SSegItem { label: "Bawah"; selected: root.position-mode == "bottom"; clicked => { root.save-position("bottom"); } }
                                    SSegItem { label: "Kiri"; selected: root.position-mode == "left"; clicked => { root.save-position("left"); } }
                                    SSegItem { label: "Kanan"; selected: root.position-mode == "right"; clicked => { root.save-position("right"); } }
                                }
                            }
                            SRow {
                                title: "Kembali ke tengah";
                                desc: "Mode samping memakai pil vertikal; hub tetap terbuka ke arah dalam layar.";
                                SButton { label: "Pusatkan ke tengah lagi"; clicked => { root.save-position("top"); } }
                            }
                        }
                        SCard {
                            title: "Gerakan otomatis";
                            action: "Pulihkan bawaan";
                            action-clicked => {
                                root.f-motion = false;
                                root.f-dock-play = true;
                                root.f-motion-interval = "180";
                                root.f-motion-max = "3";
                                root.save-motion(false, "180", "3", true);
                            }
                            SRow {
                                first: true;
                                title: "Gerakan acak saat idle";
                                SSwitch { checked: root.f-motion; toggled(v) => { root.f-motion = v; } }
                            }
                            SRow {
                                title: "Animasi lucu saat notch di bawah layar";
                                desc: "Melompat, menari, dan berkeliling sampai tepi layar. Langsung berlaku.";
                                SSwitch { checked: root.f-dock-play; toggled(v) => { root.f-dock-play = v; } }
                            }
                            SRow { title: "Interval perpindahan"; desc: "60–3600 detik."; SInput { width: 120px; suffix: "detik"; text <=> root.f-motion-interval; } }
                            SRow { title: "Maksimal perpindahan per sesi"; desc: "1–10 kali."; SInput { width: 120px; suffix: "kali"; text <=> root.f-motion-max; } }
                        }
                        HorizontalLayout {
                            alignment: start;
                            SButton { label: "Tes animasi"; clicked => { root.test-dock-play(); } }
                        }
                    }
                }
            }

            // ============================ Footer ============================
            Rectangle {
                height: 64px;
                background: SUi.side;
                Rectangle { y: 0px; height: 1px; background: SUi.card-line; }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 24px;
                    padding-top: 15px;
                    padding-bottom: 15px;
                    spacing: 10px;
                    Text { text: root.tab-status(); color: Theme.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SButton { label: "Simpan & mulai ulang"; clicked => { root.save-current-tab(); root.restart-app(); } }
                    if root.active-tab != "pages": SButton { label: "Simpan perubahan"; primary: true; clicked => { root.save-current-tab(); } }
                }
            }
        }
    }
}

component CompressPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> status: "Pilih gambar atau dokumen Office untuk dikompres";
    callback run(string);
    callback pick-file();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 8px;
    Text { text: "Compress"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Kompresi batch gambar, PDF & Office · target pengurangan 30%"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: "Daftar file JPG/JPEG/PNG/BMP/PDF/DOCX/XLSX/PPTX (bisa beberapa file)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput {
                text: root.file-path;
                color: Theme.text;
                font-size: 11px;
                single-line: false;
            }
            Text { text: "Hasil disimpan sebagai nama_compressed.<format> (Office tetap memakai ekstensi aslinya) di folder yang sama."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Kompres"; clicked => { root.run(path-input.text); } }
    }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
}
component ConvertPage inherits VerticalLayout {
    in property <string> file-path: "";
    in property <string> target-format: "auto";
    in property <string> overrides-text: "";
    in property <string> status: "Pilih gambar, PDF, atau dokumen Office untuk dikonversi";
    in property <string> progress-text: "";
    in property <string> history-text: "Belum ada riwayat konversi";
    in property <string> files-text: "Belum ada file dipilih";
    in property <string> output-dir-text: "";
    in property <string> eta-text: "";
    in property <string> queue-text: "Antrean kosong";
    in property <string> preview-page-text: "Halaman 1 / 1";
    in property <string> preview-status: "";
    in property <string> preview-zoom-text: "110 DPI";
    in property <float> progress-value: 0;
    in property <image> source-preview;
    in property <image> result-preview;
    callback run(string, string, string, string, string);
    callback pick-output-dir();
    callback preview-prev();
    callback preview-next();
    callback preview-zoom-in();
    callback preview-zoom-out();
    callback pick-file();
    callback reveal();
    callback cancel();
    callback pause();
    callback resume();
    callback clear-queue();
    callback remove-queue-file(string);
    callback retry-failed();
    callback retry-one-failed(string);
    callback cancel-one-file(string);
    callback add-files();
    callback move-queue-file(string, int);
    callback remove-finished();
    callback export-history();
    callback clear-history();
    alignment: start;
    padding-left: 14px;
    padding-right: 14px;
    spacing: 7px;
    Text { text: "Convert"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Konversi gambar, PDF, dan dokumen Office"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Text { text: "Tip: seret file langsung dari Windows Explorer ke jendela ini, atau gunakan Pilih file."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 5px;
            Text { text: "File sumber (bisa pilih beberapa file sekaligus)"; color: Theme.text-faint; font-size: 10px; }
            path-input := TextInput { text: root.file-path; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Format tujuan global: auto (disarankan) atau PNG/JPG/WebP/BMP/GIF/PDF."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            format-input := TextInput { text: root.target-format; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Override per file: nama-file=png@80; dokumen.pdf=jpg@70 (kualitas 40–100)"; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
            overrides-input := TextInput { text: root.overrides-text; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Kualitas JPEG/PDF (40–100)"; color: Theme.text-faint; font-size: 10px; }
            quality-input := TextInput { text: "90"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Resolusi halaman PDF (DPI, 36–400)"; color: Theme.text-faint; font-size: 10px; }
            dpi-input := TextInput { text: "150"; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Folder output (kosong = di samping file sumber)"; color: Theme.text-faint; font-size: 10px; }
            HorizontalLayout {
                Text { text: root.output-dir-text == "" ? "Folder sumber (default)" : root.output-dir-text; color: Theme.text; font-size: 10px; wrap: word-wrap; }
                Chip { label: "Pilih folder"; clicked => { root.pick-output-dir(); } }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Chip { label: "Pilih file"; clicked => { root.pick-file(); } }
        Chip { label: "Tambah file"; clicked => { root.add-files(); } }
        Chip { label: "Konversi"; clicked => { root.run(path-input.text, format-input.text, quality-input.text, dpi-input.text, overrides-input.text); } }
        Chip { label: "Jeda"; clicked => { root.pause(); } }
        Chip { label: "Lanjut"; clicked => { root.resume(); } }
        Chip { label: "Hapus antrean"; clicked => { root.clear-queue(); } }
        queue-remove-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Hapus file"; clicked => { root.remove-queue-file(queue-remove-input.text); } }
        Chip { label: "Naik"; clicked => { root.move-queue-file(queue-remove-input.text, -1); } }
        Chip { label: "Turun"; clicked => { root.move-queue-file(queue-remove-input.text, 1); } }
        Chip { label: "Bersihkan selesai"; clicked => { root.remove-finished(); } }
        Chip { label: "Coba ulang gagal"; clicked => { root.retry-failed(); } }
        retry-failed-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Retry file"; clicked => { root.retry-one-failed(retry-failed-input.text); } }
        cancel-file-input := TextInput { text: ""; color: Theme.text; font-size: 10px; single-line: true; }
        Chip { label: "Cancel file"; clicked => { root.cancel-one-file(cancel-file-input.text); } }
        Chip { label: "Batalkan"; clicked => { root.cancel(); } }
        Chip { label: "Buka folder hasil"; clicked => { root.reveal(); } }
    }
    Rectangle {
        height: 7px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            width: parent.width * clamp(root.progress-value, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
            animate width { duration: 180ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        Text { text: root.eta-text; color: Theme.text-faint; font-size: 9px; horizontal-stretch: 1; }
        Text { text: root.progress-text; color: Theme.accent; font-size: 10px; }
    }
    Text { text: root.queue-text; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
    Text { text: root.status; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text { text: "Preview"; color: Theme.text; font-size: 11px; font-weight: 700; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Sumber"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.source-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Hasil"; color: Theme.text-faint; font-size: 10px; }
                    Rectangle {
                        background: #00000030;
                        border-radius: 6px;
                        width: 128px;
                        height: 88px;
                        Image { source: root.result-preview; width: 128px; height: 88px; image-fit: contain; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Chip { label: "‹"; clicked => { root.preview-prev(); } }
                Text { text: root.preview-page-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "›"; clicked => { root.preview-next(); } }
                Chip { label: "−"; clicked => { root.preview-zoom-out(); } }
                Text { text: root.preview-zoom-text; color: Theme.text-faint; font-size: 9px; vertical-alignment: center; }
                Chip { label: "+"; clicked => { root.preview-zoom-in(); } }
            }
            Text { text: root.preview-status; color: #ffb36b; font-size: 9px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text { text: "Daftar file"; color: Theme.text; font-size: 11px; font-weight: 700; }
            Text { text: root.files-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
    Rectangle {
        background: #ffffff08;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff14;
        VerticalLayout {
            padding: 8px;
            spacing: 5px;
            HorizontalLayout {
                Text { text: "Riwayat konversi"; color: Theme.text; font-size: 11px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                Chip { label: "Ekspor CSV"; clicked => { root.export-history(); } }
                Chip { label: "Bersihkan"; clicked => { root.clear-history(); } }
            }
            Text { text: root.history-text; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
        }
    }
}
