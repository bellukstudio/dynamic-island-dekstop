            Text { text: "Tombol: A–Z, 0–9, F1–F12, Space, Enter, Esc, Tab, Backspace, koma, titik, slash, titik koma, apostrof, kurung siku, minus, dan sama dengan."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
            Text { text: "Pintasan fitur bawaan (tetap)"; color: Theme.text-faint; font-size: 9px; }
            Text { text: "Color Picker  Ctrl+Alt+Shift+P"; color: Theme.text; font-size: 9px; }
            Text { text: "Compress  Ctrl+Alt+Shift+K"; color: Theme.text; font-size: 9px; }
            Text { text: "Convert  Ctrl+Alt+Shift+C"; color: Theme.text; font-size: 9px; }
