            Text { text: "Emoji"; color: Theme.text-faint; font-size: 9px; }
            nudge-emoji-input := TextInput { text: root.nudge-emoji; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Ekspresi saat menyapa"; color: Theme.text-faint; font-size: 9px; }
            nudge-mood-input := TextInput { text: root.nudge-mood; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Normal"; selected: nudge-mood-input.text == "normal"; clicked => { nudge-mood-input.text = "normal"; } }
                Chip { label: "Happy"; selected: nudge-mood-input.text == "happy"; clicked => { nudge-mood-input.text = "happy"; } }
                Chip { label: "Sleepy"; selected: nudge-mood-input.text == "sleepy"; clicked => { nudge-mood-input.text = "sleepy"; } }
                Chip { label: "Love"; selected: nudge-mood-input.text == "love"; clicked => { nudge-mood-input.text = "love"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Sad"; selected: nudge-mood-input.text == "sad"; clicked => { nudge-mood-input.text = "sad"; } }
                Chip { label: "Surprised"; selected: nudge-mood-input.text == "surprised"; clicked => { nudge-mood-input.text = "surprised"; } }
                Chip { label: "Angry"; selected: nudge-mood-input.text == "angry"; clicked => { nudge-mood-input.text = "angry"; } }
                Chip { label: "Suspicious"; selected: nudge-mood-input.text == "suspicious"; clicked => { nudge-mood-input.text = "suspicious"; } }
            }
            Text { text: "Lama pesan tampil (2000–30000 ms)"; color: Theme.text-faint; font-size: 9px; }
            nudge-show-input := TextInput { text: root.nudge-show-ms; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Text { text: "Hanya saat tidak ada media diputar"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip { label: nudge-silent-input.text == "true" ? "Ya" : "Tidak"; selected: nudge-silent-input.text == "true"; clicked => { nudge-silent-input.text = nudge-silent-input.text == "true" ? "false" : "true"; } }
            }
            nudge-silent-input := TextInput { text: root.nudge-only-silent ? "true" : "false"; visible: false; }
            nudge-until-move-input := TextInput { text: root.nudge-until-move ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Tampilkan sampai pointer bergerak lagi"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip {
                    label: nudge-until-move-input.text == "true" ? "Aktif" : "Nonaktif";
                    selected: nudge-until-move-input.text == "true";
                    clicked => { nudge-until-move-input.text = nudge-until-move-input.text == "true" ? "false" : "true"; }
                }
            }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    nudge-enabled-input.text = "true"; nudge-idle-input.text = "2";
                    nudge-message-input.text = "Kamu kemana, kok diam saja?"; nudge-emoji-input.text = "🥺";
                    nudge-mood-input.text = "sad"; nudge-show-input.text = "6000"; nudge-silent-input.text = "true"; nudge-until-move-input.text = "false";
                    root.save-nudge(true, "2", "Kamu kemana, kok diam saja?", "🥺", "sad", "6000", true, false);
                } }
                Chip { label: "Pratinjau"; clicked => { root.test-nudge(nudge-message-input.text, nudge-emoji-input.text, nudge-mood-input.text, nudge-show-input.text, nudge-until-move-input.text == "true"); } }
                Chip { label: "Simpan notifikasi"; selected: true; clicked => {
                    root.save-nudge(nudge-enabled-input.text == "true", nudge-idle-input.text, nudge-message-input.text, nudge-emoji-input.text, nudge-mood-input.text, nudge-show-input.text, nudge-silent-input.text == "true", nudge-until-move-input.text == "true");
                } }
            }
            Text { text: root.nudge-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Greeting & sapaan otomatis"; color: Theme.accent; font-size: 11px; font-weight: 700; }
