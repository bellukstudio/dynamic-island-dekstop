    in property <string> motion-save-status: "";
    in property <bool> nudge-enabled: true;
    in property <string> nudge-idle-min: "2";
    in property <string> nudge-message: "Kamu kemana, kok diam saja?";
    in property <string> nudge-emoji: "🥺";
    in property <string> nudge-mood: "sad";
    in property <string> nudge-show-ms: "6000";
    in property <bool> nudge-only-silent: true;
    in property <bool> nudge-until-move: false;
    in property <string> nudge-save-status: "";
    in property <bool> greeting-enabled: true;
    in property <string> greeting-mode: "random";
    in property <string> greeting-voice: "cewek";
    in property <string> greeting-custom-text: "Halo, semangat menjalani hari!";
    in property <string> greeting-save-status: "";
    in property <bool> conversation-enabled: true;
    in property <bool> conversation-on-play: true;
    in property <bool> conversation-on-track-change: true;
    in property <bool> conversation-on-pause: false;
    in property <bool> conversation-on-return: true;
    in property <bool> conversation-on-weather-change: true;
    in property <bool> conversation-on-rain-soon: true;
    in property <bool> conversation-on-low-battery: true;
    in property <bool> conversation-on-charging: false;
    in property <string> conversation-return-after-min: "10";
    in property <string> conversation-cooldown-min: "3";
    in property <string> conversation-save-status: "";
    in property <bool> focus-companion-enabled: true;
    in property <bool> focus-companion-on-start: true;
    in property <bool> focus-companion-on-halfway: true;
    in property <bool> focus-companion-on-focus-complete: true;
    in property <bool> focus-companion-on-break-end: true;
    in property <string> focus-companion-save-status: "";
    callback save-motion(bool, string, string, bool);
    callback test-dock-play();
    callback save-nudge(bool, string, string, string, string, string, bool, bool);
    callback test-nudge(string, string, string, string, bool);
    callback save-greeting(bool, string, string, string);
    callback test-greeting(string, string, string);
    callback save-conversation(bool, bool, bool, bool, bool, bool, bool, bool, bool, string, string);
    callback test-conversation(string, string);
    callback save-focus-companion(bool, bool, bool, bool, bool);
    callback test-focus-companion(string, string);
    in property <string> position-mode: "top";
    in property <string> hub-pages: "media, clock, weather, battery, timer, quick, tools, stats, reminder, notes, clipboard, shelf, lyrics, privacy, prayer, currency";
    in property <string> pages-save-status: "Pisahkan ID halaman dengan koma";
    callback save-pages(string);
    callback toggle-page(string, bool);
    pure function page-enabled(id: string) -> bool { return (((((((((((((((((((((root.active-pages.length > 0 && root.active-pages[0] == id) || (root.active-pages.length > 1 && root.active-pages[1] == id)) || (root.active-pages.length > 2 && root.active-pages[2] == id)) || (root.active-pages.length > 3 && root.active-pages[3] == id)) || (root.active-pages.length > 4 && root.active-pages[4] == id)) || (root.active-pages.length > 5 && root.active-pages[5] == id)) || (root.active-pages.length > 6 && root.active-pages[6] == id)) || (root.active-pages.length > 7 && root.active-pages[7] == id)) || (root.active-pages.length > 8 && root.active-pages[8] == id)) || (root.active-pages.length > 9 && root.active-pages[9] == id)) || (root.active-pages.length > 10 && root.active-pages[10] == id)) || (root.active-pages.length > 11 && root.active-pages[11] == id)) || (root.active-pages.length > 12 && root.active-pages[12] == id)) || (root.active-pages.length > 13 && root.active-pages[13] == id)) || (root.active-pages.length > 14 && root.active-pages[14] == id)) || (root.active-pages.length > 15 && root.active-pages[15] == id)) || (root.active-pages.length > 16 && root.active-pages[16] == id)) || (root.active-pages.length > 17 && root.active-pages[17] == id)) || (root.active-pages.length > 18 && root.active-pages[18] == id)) || (root.active-pages.length > 19 && root.active-pages[19] == id)) || (root.active-pages.length > 20 && root.active-pages[20] == id)); }
    callback save-behavior(string, string, string, string, bool);
    callback save-autostart(bool);
    callback save-position(string);
    callback save-routines(string, string, string, string, string, string, string, string, string);
    callback save-appearance(string, string, string, string, string, string, string, string, string);
    callback save-weather(string, string, string);
    callback save-shortcuts(string, string, string, string);
    alignment: start;
    spacing: 7px;
    padding-left: 12px;
    padding-right: 12px;

    Text { text: "Pengaturan"; color: Theme.text; font-size: 17px; font-weight: 700; }
    Text { text: "Pintasan global"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle {
        background: #ffffff0b;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff18;
        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text { text: "Buka / tutup hub"; color: Theme.text; font-size: 10px; }
            hub-input := TextInput {
                text: root.shortcut-hub;
                color: Theme.text;
                font-size: 12px;
                single-line: true;
            }
            Text { text: "Buka pengaturan"; color: Theme.text; font-size: 10px; }
            settings-input := TextInput {
                text: root.shortcut-settings;
                color: Theme.text;
                font-size: 12px;
                single-line: true;
            }
            Text { text: "Pomodoro"; color: Theme.text; font-size: 10px; }
            pomo-input := TextInput {
                text: root.shortcut-pomodoro;
                color: Theme.text;
                font-size: 12px;
                single-line: true;
            }
            Text { text: "Jadwal shalat"; color: Theme.text; font-size: 10px; }
            prayer-input := TextInput {
                text: root.shortcut-prayer;
                color: Theme.text;
                font-size: 12px;
                single-line: true;
            }
            Text { text: "Format shortcut: minimal satu modifier (Ctrl / Alt / Shift / Win) + satu tombol."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Tombol: A–Z, 0–9, F1–F12, Space, Enter, Esc, Tab, Backspace, koma, titik, slash, titik koma, apostrof, kurung siku, minus, dan sama dengan."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
            Text { text: "Pintasan fitur bawaan (tetap)"; color: Theme.text-faint; font-size: 9px; }
            Text { text: "Color Picker  Ctrl+Alt+Shift+P"; color: Theme.text; font-size: 9px; }
            Text { text: "Compress  Ctrl+Alt+Shift+K"; color: Theme.text; font-size: 9px; }
            Text { text: "Convert  Ctrl+Alt+Shift+C"; color: Theme.text; font-size: 9px; }
            Text { text: "Transfer  Ctrl+Alt+Shift+S · Android  Ctrl+Alt+Shift+A"; color: Theme.text; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Halaman"; color: Theme.text; font-size: 11px; font-weight: 700; }
    Text { text: "Pilih tab utama yang ingin ditampilkan pada hub notch."; color: Theme.text-faint; font-size: 9px; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    spacing: 5px;
                    PageToggle { label: "Musik"; checked: root.page-enabled("media"); toggled(v) => { root.toggle-page("media", v); } }
                    PageToggle { label: "Cuaca"; checked: root.page-enabled("weather"); toggled(v) => { root.toggle-page("weather", v); } }
                    PageToggle { label: "Timer Pomodoro"; checked: root.page-enabled("timer"); toggled(v) => { root.toggle-page("timer", v); } }
                    PageToggle { label: "Alat"; checked: root.page-enabled("tools"); toggled(v) => { root.toggle-page("tools", v); } }
                    PageToggle { label: "Riwayat clipboard"; checked: root.page-enabled("clipboard"); toggled(v) => { root.toggle-page("clipboard", v); } }
                    PageToggle { label: "Pengingat"; checked: root.page-enabled("reminder"); toggled(v) => { root.toggle-page("reminder", v); } }
                    PageToggle { label: "Jadwal shalat"; checked: root.page-enabled("prayer"); toggled(v) => { root.toggle-page("prayer", v); } }
                }
                VerticalLayout {
                    spacing: 5px;
                    PageToggle { label: "Jam & tanggal"; checked: root.page-enabled("clock"); toggled(v) => { root.toggle-page("clock", v); } }
                    PageToggle { label: "Baterai"; checked: root.page-enabled("battery"); toggled(v) => { root.toggle-page("battery", v); } }
                    PageToggle { label: "Kontrol cepat"; checked: root.page-enabled("quick"); toggled(v) => { root.toggle-page("quick", v); } }
                    PageToggle { label: "Status sistem"; checked: root.page-enabled("stats"); toggled(v) => { root.toggle-page("stats", v); } }
                    PageToggle { label: "Shelf file"; checked: root.page-enabled("shelf"); toggled(v) => { root.toggle-page("shelf", v); } }
                    PageToggle { label: "Catatan"; checked: root.page-enabled("notes"); toggled(v) => { root.toggle-page("notes", v); } }
                    PageToggle { label: "Currency · Kurs & saham"; checked: root.page-enabled("currency"); toggled(v) => { root.toggle-page("currency", v); } }
                }
            }
            Rectangle { height: 1px; background: Theme.chip; }
            Text { text: "Tambahan"; color: Theme.text; font-size: 11px; font-weight: 700; }
            Text { text: "Fitur pendamping dan alat tambahan; tidak semuanya menjadi tab utama."; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    spacing: 5px;
                    PageToggle { label: "Link lagu"; checked: root.page-enabled("lyrics"); toggled(v) => { root.toggle-page("lyrics", v); } }
                    PageToggle { label: "Indikator mic/kamera"; checked: root.page-enabled("privacy"); toggled(v) => { root.toggle-page("privacy", v); } }
                    PageToggle { label: "Convert"; checked: root.page-enabled("convert"); toggled(v) => { root.toggle-page("convert", v); } }
                }
                VerticalLayout {
                    spacing: 5px;
                    PageToggle { label: "Compress"; checked: root.page-enabled("compress"); toggled(v) => { root.toggle-page("compress", v); } }
                    PageToggle { label: "Transfer file"; checked: root.page-enabled("transfer"); toggled(v) => { root.toggle-page("transfer", v); } }
                    PageToggle { label: "Android & mirroring"; checked: root.page-enabled("android"); toggled(v) => { root.toggle-page("android", v); } }
                }
            }
            Text { text: root.pages-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            HorizontalLayout {
                Chip {
                    label: "Pulihkan halaman default";
                    clicked => {
                        root.save-pages("media, clock, weather, battery, timer, quick, tools, stats, reminder, notes, clipboard, shelf, lyrics, privacy, prayer, currency");
                    }
                }
            }
            Text { text: "Perubahan disimpan otomatis. Musik wajib aktif sebagai halaman utama."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Tampilan & ekspresi"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Tema aplikasi"; color: Theme.text-faint; font-size: 9px; }
            theme-input := TextInput { text: root.appearance-theme; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Auto"; selected: theme-input.text == "auto"; clicked => { theme-input.text = "auto"; } }
                Chip { label: "Dark"; selected: theme-input.text == "dark"; clicked => { theme-input.text = "dark"; } }
                Chip { label: "Light"; selected: theme-input.text == "light"; clicked => { theme-input.text = "light"; } }
                Chip { label: "Custom"; selected: theme-input.text == "custom"; clicked => { theme-input.text = "custom"; } }
            }
            Text { text: "Skin mata dipilih pada bagian ekspresi di bawah"; color: Theme.text-faint; font-size: 9px; }
            Text { text: "Tema badan notch"; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            notch-theme-input := TextInput { text: root.appearance-notch-theme; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Default"; selected: notch-theme-input.text == "default"; clicked => { notch-theme-input.text = "default"; } }
                Chip { label: "Aurora"; selected: notch-theme-input.text == "aurora"; clicked => { notch-theme-input.text = "aurora"; } }
                Chip { label: "Obsidian"; selected: notch-theme-input.text == "obsidian"; clicked => { notch-theme-input.text = "obsidian"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Neon"; selected: notch-theme-input.text == "neon"; clicked => { notch-theme-input.text = "neon"; } }
                Chip { label: "Sakura"; selected: notch-theme-input.text == "sakura"; clicked => { notch-theme-input.text = "sakura"; } }
                Chip { label: "Matcha"; selected: notch-theme-input.text == "matcha"; clicked => { notch-theme-input.text = "matcha"; } }
            }
            Text { text: "Ekspresi mata bawaan saat idle"; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            mood-input := TextInput { text: root.appearance-mood; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Normal"; selected: mood-input.text == "normal"; clicked => { mood-input.text = "normal"; } }
                Chip { label: "Happy"; selected: mood-input.text == "happy"; clicked => { mood-input.text = "happy"; } }
                Chip { label: "Sleepy"; selected: mood-input.text == "sleepy"; clicked => { mood-input.text = "sleepy"; } }
                Chip { label: "Love"; selected: mood-input.text == "love"; clicked => { mood-input.text = "love"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Surprised"; selected: mood-input.text == "surprised"; clicked => { mood-input.text = "surprised"; } }
                Chip { label: "Angry"; selected: mood-input.text == "angry"; clicked => { mood-input.text = "angry"; } }
                Chip { label: "Sad"; selected: mood-input.text == "sad"; clicked => { mood-input.text = "sad"; } }
                Chip { label: "Suspicious"; selected: mood-input.text == "suspicious"; clicked => { mood-input.text = "suspicious"; } }
            }
            Text { text: "Skin mata (20 pilihan tersedia)"; color: Theme.text-faint; font-size: 9px; }
            eye-theme-input := TextInput { text: root.appearance-eye-theme; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Aurora"; selected: eye-theme-input.text == "aurora"; clicked => { eye-theme-input.text = "aurora"; } }
                Chip { label: "Neon"; selected: eye-theme-input.text == "neon"; clicked => { eye-theme-input.text = "neon"; } }
                Chip { label: "Pastel"; selected: eye-theme-input.text == "pastel"; clicked => { eye-theme-input.text = "pastel"; } }
                Chip { label: "Pixel"; selected: eye-theme-input.text == "pixel"; clicked => { eye-theme-input.text = "pixel"; } }
                Chip { label: "Holo"; selected: eye-theme-input.text == "holo"; clicked => { eye-theme-input.text = "holo"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Ember"; selected: eye-theme-input.text == "ember"; clicked => { eye-theme-input.text = "ember"; } }
                Chip { label: "Ocean"; selected: eye-theme-input.text == "ocean"; clicked => { eye-theme-input.text = "ocean"; } }
                Chip { label: "Sakura"; selected: eye-theme-input.text == "sakura"; clicked => { eye-theme-input.text = "sakura"; } }
                Chip { label: "Cyber"; selected: eye-theme-input.text == "cyber"; clicked => { eye-theme-input.text = "cyber"; } }
                Chip { label: "Mono"; selected: eye-theme-input.text == "monochrome"; clicked => { eye-theme-input.text = "monochrome"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Kawaii"; selected: eye-theme-input.text == "kawaii"; clicked => { eye-theme-input.text = "kawaii"; } }
                Chip { label: "Boba"; selected: eye-theme-input.text == "boba"; clicked => { eye-theme-input.text = "boba"; } }
                Chip { label: "Galaxy"; selected: eye-theme-input.text == "galaxy"; clicked => { eye-theme-input.text = "galaxy"; } }
                Chip { label: "Matcha"; selected: eye-theme-input.text == "matcha"; clicked => { eye-theme-input.text = "matcha"; } }
                Chip { label: "Candy"; selected: eye-theme-input.text == "candy"; clicked => { eye-theme-input.text = "candy"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Synthwave"; selected: eye-theme-input.text == "synthwave"; clicked => { eye-theme-input.text = "synthwave"; } }
                Chip { label: "Slime"; selected: eye-theme-input.text == "slime"; clicked => { eye-theme-input.text = "slime"; } }
                Chip { label: "Cotton"; selected: eye-theme-input.text == "cotton"; clicked => { eye-theme-input.text = "cotton"; } }
                Chip { label: "Pumpkin"; selected: eye-theme-input.text == "pumpkin"; clicked => { eye-theme-input.text = "pumpkin"; } }
                Chip { label: "Frost"; selected: eye-theme-input.text == "frost"; clicked => { eye-theme-input.text = "frost"; } }
            }
            Text { text: "Aksen / latar gelap / terang (HEX)"; color: Theme.text-faint; font-size: 9px; }
            accent-input := TextInput { text: root.appearance-accent; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Warna aksen cepat"; color: Theme.text-faint; font-size: 9px; }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Biru"; selected: accent-input.text == "#6C8CFF"; clicked => { accent-input.text = "#6C8CFF"; } }
                Chip { label: "Ungu"; selected: accent-input.text == "#A78BFA"; clicked => { accent-input.text = "#A78BFA"; } }
                Chip { label: "Pink"; selected: accent-input.text == "#F472B6"; clicked => { accent-input.text = "#F472B6"; } }
                Chip { label: "Hijau"; selected: accent-input.text == "#34D399"; clicked => { accent-input.text = "#34D399"; } }
            }
            HorizontalLayout {
                spacing: 4px;
                Chip { label: "Oranye"; selected: accent-input.text == "#FB923C"; clicked => { accent-input.text = "#FB923C"; } }
                Chip { label: "Cyan"; selected: accent-input.text == "#22D3EE"; clicked => { accent-input.text = "#22D3EE"; } }
                Chip { label: "Default"; selected: accent-input.text == ""; clicked => { accent-input.text = ""; } }
            }
            Text { text: "Latar tema custom (HEX #RRGGBB)"; color: Theme.text-faint; font-size: 9px; }
            custom-bg-input := TextInput { text: root.appearance-custom-bg; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Warna teks custom (kosong = otomatis)"; color: Theme.text-faint; font-size: 9px; }
            custom-text-input := TextInput { text: root.appearance-custom-text; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Latar notch saat tema gelap (HEX)"; color: Theme.text-faint; font-size: 9px; }
            dark-bg-input := TextInput { text: root.appearance-dark-bg; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Latar notch saat tema terang (HEX)"; color: Theme.text-faint; font-size: 9px; }
            light-bg-input := TextInput { text: root.appearance-light-bg; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                spacing: 5px;
                Chip {
                    label: "Reset default";
                    clicked => {
                        theme-input.text = "auto";
                        eye-theme-input.text = "aurora";
                        notch-theme-input.text = "default";
                        mood-input.text = "normal";
                        accent-input.text = "";
                        custom-bg-input.text = "#000000";
                        custom-text-input.text = "";
                        dark-bg-input.text = "#000000";
                        light-bg-input.text = "#f5f5f7";
                        root.save-appearance("auto", "aurora", "default", "normal", "", "#000000", "", "#000000", "#f5f5f7");
                    }
                }
                Chip { label: "Simpan tampilan"; selected: true; clicked => { root.save-appearance(theme-input.text, eye-theme-input.text, notch-theme-input.text, mood-input.text, accent-input.text, custom-bg-input.text, custom-text-input.text, dark-bg-input.text, light-bg-input.text); } }
            }
        }
    }
    Text { text: "Lokasi cuaca"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Nama kota"; color: Theme.text-faint; font-size: 9px; }
            weather-city-input := TextInput { text: root.weather-city; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Latitude"; color: Theme.text-faint; font-size: 9px; }
            weather-lat-input := TextInput { text: root.weather-lat; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Longitude"; color: Theme.text-faint; font-size: 9px; }
            weather-lon-input := TextInput { text: root.weather-lon; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    weather-city-input.text = "Bandung";
                    weather-lat-input.text = "-6.9175";
                    weather-lon-input.text = "107.6191";
                    root.save-weather("Bandung", "-6.9175", "107.6191");
                } }
                Chip { label: "Simpan lokasi cuaca"; clicked => { root.save-weather(weather-city-input.text, weather-lat-input.text, weather-lon-input.text); } }
            }
            Text { text: root.weather-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Gunakan koordinat desimal. Contoh Bandung: -6.9175, 107.6191."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Posisi notch"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            Text { text: "Pilih posisi docking"; color: Theme.text-faint; font-size: 9px; }
            HorizontalLayout {
                Chip { label: "Atas"; selected: root.position-mode == "top"; clicked => { root.save-position("top"); } }
                Chip { label: "Melayang"; selected: root.position-mode == "floating"; clicked => { root.save-position("floating"); } }
                Chip { label: "Bawah"; selected: root.position-mode == "bottom"; clicked => { root.save-position("bottom"); } }
            }
            HorizontalLayout {
                Chip { label: "Kiri"; selected: root.position-mode == "left"; clicked => { root.save-position("left"); } }
                Chip { label: "Kanan"; selected: root.position-mode == "right"; clicked => { root.save-position("right"); } }
            }
            Text { text: "Mode samping memakai pil vertikal; hub tetap terbuka ke arah dalam layar."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Perilaku notch"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Skala UI (0.5–1.5)"; color: Theme.text-faint; font-size: 9px; }
            behavior-scale-input := TextInput { text: root.behavior-scale; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda hover buka (0–2000 ms)"; color: Theme.text-faint; font-size: 9px; }
            behavior-hover-open-input := TextInput { text: root.behavior-hover-open; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda hover tutup (0–5000 ms)"; color: Theme.text-faint; font-size: 9px; }
            behavior-hover-close-input := TextInput { text: root.behavior-hover-close; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Idle sebelum mata mengantuk (10–3600 detik)"; color: Theme.text-faint; font-size: 9px; }
            behavior-sleep-input := TextInput { text: root.behavior-sleep-after; color: Theme.text; font-size: 11px; single-line: true; }
            hide-fullscreen-input := TextInput { text: root.behavior-hide-fullscreen ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Sembunyikan notch saat aplikasi fullscreen"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip {
                    label: hide-fullscreen-input.text == "true" ? "Aktif" : "Nonaktif";
                    selected: hide-fullscreen-input.text == "true";
                    clicked => { hide-fullscreen-input.text = hide-fullscreen-input.text == "true" ? "false" : "true"; }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Chip { label: "Simpan perilaku"; clicked => { root.save-behavior(behavior-scale-input.text, behavior-hover-open-input.text, behavior-hover-close-input.text, behavior-sleep-input.text, hide-fullscreen-input.text == "true"); } }
                Chip {
                    label: "Reset default";
                    clicked => {
                        behavior-scale-input.text = "1.00";
                        behavior-hover-open-input.text = "150";
                        behavior-hover-close-input.text = "450";
                        behavior-sleep-input.text = "60";
                        hide-fullscreen-input.text = "true";
                        root.save-behavior("1.00", "150", "450", "60", true);
                        root.save-autostart(false);
                    }
                }
            }
            Text { text: root.behavior-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: "Jalankan otomatis saat komputer login"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip {
                    label: root.autostart-enabled ? "Aktif" : "Nonaktif";
                    selected: root.autostart-enabled;
                    clicked => { root.save-autostart(!root.autostart-enabled); }
                }
            }
            Text { text: root.autostart-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Pengaturan ini tersedia pada build release."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Liquid movement"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            HorizontalLayout {
                Text { text: "Gerakan acak saat idle"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: motion-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: motion-enabled-input.text == "true"; clicked => { motion-enabled-input.text = motion-enabled-input.text == "true" ? "false" : "true"; } }
            }
            motion-enabled-input := TextInput { text: root.motion-enabled ? "true" : "false"; visible: false; }
            dock-play-input := TextInput { text: root.dock-play-enabled ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Bottom Play / Side Play"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: dock-play-input.text == "true" ? "Aktif" : "Nonaktif"; selected: dock-play-input.text == "true"; clicked => { dock-play-input.text = dock-play-input.text == "true" ? "false" : "true"; } }
            }
            Text { text: "Interval perpindahan (60–3600 detik)"; color: Theme.text-faint; font-size: 9px; }
            motion-interval-input := TextInput { text: root.motion-interval; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Maksimal perpindahan per sesi (1–10)"; color: Theme.text-faint; font-size: 9px; }
            motion-max-input := TextInput { text: root.motion-max-moves; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
