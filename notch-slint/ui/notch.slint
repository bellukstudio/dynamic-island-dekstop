// Prototipe Notch (Slint). Tahap 1: pil + mata, kartu jam + timer fokus,
// dan uji render teks Arab / emoji.

component Eye inherits Rectangle {
    in property <float> dx: 0;   // -1..1
    in property <float> dy: 0;   // -1..1
    in property <bool> closed: false;

    width: 16px;
    height: closed ? 3px : 16px;
    border-radius: 8px;
    background: #f5f5f7;
    animate height { duration: 80ms; easing: ease-in-out; }

    Rectangle {
        visible: !root.closed;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: #111;
        x: (parent.width - self.width) / 2 + root.dx * 4px;
        y: (parent.height - self.height) / 2 + root.dy * 4px;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    callback clicked;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? #3a3a3f : #2a2a2e;
    animate background { duration: 120ms; }
    Text {
        text: root.label;
        color: #f5f5f7;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component NotchWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Notch";

    in property <bool> expanded: false;
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> pomo-text: "25:00";
    in property <bool> pomo-running: false;
    in property <float> eye-dx: 0;
    in property <float> eye-dy: 0;
    in property <bool> blink: false;
    in property <string> stats-text: "";

    callback hover-changed(bool);
    callback toggle-pomo();
    callback reset-pomo();

    // Ukuran jendela diatur dari Rust; isi dianimasikan di dalam.
    pill := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0px;
        width: root.expanded ? 400px : 120px;
        height: root.expanded ? 170px : 34px;
        background: #000;
        border-bottom-left-radius: root.expanded ? 28px : 17px;
        border-bottom-right-radius: root.expanded ? 28px : 17px;
        clip: true;
        animate width { duration: 220ms; easing: ease-out-quart; }
        animate height { duration: 220ms; easing: ease-out-quart; }

        // Mata (selalu terlihat di bagian atas pil)
        HorizontalLayout {
            y: 9px;
            height: 16px;
            alignment: center;
            spacing: 14px;
            Eye { dx: root.eye-dx; dy: root.eye-dy; closed: root.blink; }
            Eye { dx: root.eye-dx; dy: root.eye-dy; closed: root.blink; }
        }

        // Kartu (hanya saat melebar)
        Rectangle {
            visible: root.expanded;
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 180ms; delay: 80ms; }
            y: 40px;
            height: parent.height - 40px;

            HorizontalLayout {
                padding: 16px;
                padding-top: 4px;
                spacing: 18px;

                VerticalLayout {
                    spacing: 2px;
                    Text { text: root.clock-text; color: #fff; font-size: 38px; font-weight: 700; }
                    Text { text: root.date-text; color: #9a9aa2; font-size: 12px; }
                    Text { text: "☕ 🍅 🌙"; color: #fff; font-size: 14px; }
                    Text {
                        text: "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ";
                        color: #7bdc9a;
                        font-size: 15px;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text { text: "Fokus"; color: #9a9aa2; font-size: 11px; horizontal-alignment: center; }
                    Text { text: root.pomo-text; color: #ff8a65; font-size: 30px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px;
                        Chip { label: root.pomo-running ? "Jeda" : "Mulai"; clicked => { root.toggle-pomo(); } }
                        Chip { label: "Reset"; clicked => { root.reset-pomo(); } }
                    }
                    Text { text: root.stats-text; color: #7a7a82; font-size: 10px; horizontal-alignment: center; }
                }
            }
        }

        hover := TouchArea {
            changed has-hover => { root.hover-changed(self.has-hover); }
        }
    }
}
