    callback save-note(string, string);
    callback open-note(string);
    callback clear-notes();
    callback notes-expand-toggled(bool);
    callback currency-refresh();
    callback currency-chart-request(string, int);
    callback currency-select-target(string, int);
    in-out property <bool> currency-expanded: false;
    in property <string> fx-chart-line;
    in property <string> fx-chart-area;
    in property <string> fx-chart-status;
    in property <string> fx-chart-max;
    in property <string> fx-chart-y1;
    in property <string> fx-chart-y2;
    in property <string> fx-chart-min;
    in property <string> fx-chart-date-start;
    in property <string> fx-chart-date-mid;
    in property <string> fx-chart-date-end;
    in property <float> fx-chart-dot-y: 50;
    in property <string> fx-chart-last;
    in property <string> fx-chart-change;
    in property <bool> fx-chart-up: true;
    callback currency-amount-edited(string);
    callback currency-quick(int);
    callback currency-step-target(int);
    callback currency-add-alert(bool, string, bool, string, bool);
    callback currency-remove-alert(string);
    callback currency-data-ready();
    callback clipboard-copy(string);
    callback clipboard-clear();
    callback reminder-add(string, string, string, int);
    callback reminder-toggle(string);
    callback reminder-remove(string);
    callback reminder-clear-done();
    callback reminder-stop-alert();
    callback reminder-snooze-alert();
    callback reminder-toggle-weekday(int);
    callback quick-toggle(string);
    callback cal-opened();
    callback cal-prev();
    callback cal-next();
    callback cal-today();
    callback cal-select(int);
    callback holidays-ready();
    callback settings-save-shortcuts(string, string, string, string);
    callback compress-run(string);
    callback compress-pick();
    callback convert-run(string, string, string, string, string);
    callback convert-pick();
    callback convert-preview-prev();
    callback convert-preview-next();
    callback convert-preview-zoom-in();
    callback convert-preview-zoom-out();
    callback convert-reveal();
    callback convert-cancel();
    callback convert-pause();
    callback convert-resume();
    callback convert-clear-queue();
    callback convert-remove-queue-file(string);
    callback convert-retry-failed();
    callback convert-retry-one-failed(string);
    callback convert-cancel-one-file(string);
    callback convert-add-files();
    callback convert-move-queue-file(string, int);
    callback convert-remove-finished();
    callback convert-history-export();
    callback convert-history-clear();
    callback convert-output-dir-pick();
    callback transfer-start();
    callback transfer-stop();
    callback transfer-add-files();
    callback transfer-open-inbox();
    callback android-refresh();
    callback android-list(string);
    callback android-push(string, string);
    callback android-pull(string);
    callback android-select-device(string);
    callback android-mirror();
    callback android-stop-mirror();

    // Kursor di pil ATAU di tombol Pusatkan (termasuk celah di antaranya) dianggap masih di dalam notch.
    property <bool> any-hover: hover.has-hover || pos-zone.has-hover;
    out property <bool> drag-armed: hover.pressed;
    changed any-hover => { root.hover-changed(root.any-hover); }

    // Tombol "Pusatkan": melayang di luar badan notch, 8 px di bawahnya (di atasnya bila menempel dasar
    // layar), muncul bersama hub. TouchArea mencakup celah ke pil supaya kursor yang menyeberang tidak
    // dianggap keluar; piksel hampir transparan memastikan jendela berlapis tetap menerima kursor di celah.
    pos-zone := TouchArea {
        property <length> gap: 8px;
        width: 104px;
        height: self.gap + 22px;
        x: (root.width - self.width) / 2;
        y: root.dock == 2 ? pill.y - self.height : pill.y + pill.height;
        enabled: root.expanded;
        mouse-cursor: pointer;
        clicked => { root.quick-toggle("center"); }

        Rectangle { background: #00000001; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.dock == 2 ? 0px : parent.gap;
            width: 94px;
            height: 22px;
            border-radius: 11px;
            background: pos-zone.has-hover ? #20202af2 : #121216e6;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(pos-zone.has-hover ? 0.9 : 0.5);
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 180ms; }
            animate background { duration: 120ms; }
            Path {
                x: 9px;
                y: 5px;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 V 8 M 12 16 V 21 M 3 12 H 8 M 16 12 H 21 M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10";
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
            }
            Text {
                x: 26px;
                height: parent.height;
                text: "Pusatkan";
                color: Theme.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    pill := Rectangle {
        // Radius mengikuti Tauri: hub 32 px menempel / 28 px melayang; pil kecil 17 px.
        // Bentuk compact meniru Tauri: setengah lingkaran menghadap ke dalam layar.
        // Dock bawah 80x44, dock samping 60x120; hub terbuka tetap memakai ukuran landscape.
        property <length> r: root.expanded ? (root.dock == 1 ? 28px : 32px) * root.ui-scale
            : (root.nudge-inline ? 24px : (root.greeting-inline-visible && root.dock < 3 ? 17px : (root.dock == 0 ? 13px : (root.dock == 2 ? 40px : (root.dock >= 3 ? 60px : 17px))))) * root.ui-scale;
        x: root.dock == 3 ? 0px : (root.dock == 4 ? root.width - self.width : (root.width - self.width) / 2 + (root.dock == 2 ? root.play-offset * 1px : 0px));
        y: root.dock == 2 ? root.height - self.height : (root.dock >= 3 ? (root.height - self.height) / 2 + root.play-offset * 1px : 0px);
        width: root.expanded ? ((root.prayer-wide || root.page-id == "currency") ? 780px : 580px) : (root.nudge-inline ? 288px : (root.greeting-inline-visible && root.dock < 3 ? 385px : (root.dragging ? 58px : (root.dock == 2 ? 80px : (root.dock >= 3 ? 60px : ((root.idle-clock || root.media-mini) ? 220px : 130px))) * root.play-body-scale-x)));
        height: root.expanded ? (root.prayer-wide ? 540px : (root.page-id == "currency" ? 520px : (root.page-id == "notes" && root.notes-expanded ? 300px : 202px))) : (root.nudge-inline ? 68px : (root.greeting-inline-visible && root.dock < 3 ? 75px : (root.dragging ? 58px : (root.dock == 0 ? 26px : (root.dock == 2 ? 44px : (root.dock >= 3 ? 120px : 34px))) * root.play-body-scale-y)));
        // Dock bawah/samping saat menciut digambar sebagai Path busur (lihat `half-body`) karena Slint
        // membatasi border-radius maksimal setengah sisi terpendek: radius 40 pada 80x44 jadi 22 (bukan setengah lingkaran).
        property <bool> half: !root.expanded && !root.dragging && root.dock >= 2 && !root.greeting-inline-visible;
        background: self.half ? transparent : Theme.body;
        // Sisi yang menempel ke tepi layar dibiarkan rata; selain itu membulat.
        border-top-left-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 3) ? 0px : self.r);
        border-top-right-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 4) ? 0px : self.r);
        border-bottom-left-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 3) ? 0px : self.r);
        border-bottom-right-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 4) ? 0px : self.r);
        animate r { duration: 220ms; easing: ease-out-quart; }
        clip: true;
        animate width { duration: 220ms; easing: ease-out-quart; }
        animate height { duration: 220ms; easing: ease-out-quart; }

        // Badan setengah lingkaran menghadap ke dalam layar: bawah 80x44 (radius 40), kiri/kanan 60x120 (radius 60).
        half-body := Path {
            visible: pill.half;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: root.dock == 2 ? 80 : 60;
            viewbox-height: root.dock == 2 ? 44 : 120;
            fill: Theme.body;
            commands: root.dock == 2 ? "M 0 44 L 0 40 A 40 40 0 0 1 80 40 L 80 44 Z"
                : (root.dock == 3 ? "M 0 0 A 60 60 0 0 1 0 120 Z" : "M 60 0 A 60 60 0 0 0 60 120 Z");
        }

        // Hiasan tema (cahaya, scan, rim). Digambar sebagai gambar karena clip UI tidak mengikuti radius
        // sudut di renderer software; gambar ini sudah ber-mask sudut bulat dan sisi bebas yang benar.
        Image {
            source: root.decor;
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            visible: root.has-decor;
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 220ms; }
        }

        // Konten dibungkus TouchArea sebagai induk: has-hover tetap true saat kursor berada di atas
        // tombol (anak), dan klik tetap diteruskan ke anak.
        hover := TouchArea {
            // Jangan hapus flag di sini: event double-click dapat datang setelah clicked.
            // Timer native yang melepas flag setelah jeda release drag.
            clicked => { if (!root.suppress-next-pill-click) { root.pill-clicked(); } }
            double-clicked => { if (!root.suppress-next-pill-click) { root.pill-double-clicked(); } }

            // Mata: hanya saat menciut. Renderer Rust mengikuti orientasi dock (horizontal / vertikal).
            Image {
                source: root.eyes-image;
                x: (root.dock >= 3 ? 13px : (parent.width - self.width) / 2) + root.eyes-offset-x * 1px;
                y: (root.dock == 2 ? 7px : root.eyes-offset-y * 1px);
                width: (root.dock == 2 ? 80px : (root.dock >= 3 ? 34px : 130px)) * root.eyes-scale-x;
                height: (root.dock == 2 ? 21px : (root.dock >= 3 ? 120px : (root.dock == 0 ? 26px : 34px))) * root.eyes-scale-y;
                image-fit: fill;
                opacity: root.expanded ? 0 : 1;
                animate opacity { duration: 120ms; }
                visible: !root.dragging && !root.inline-msg && !root.media-mini && !(root.idle-clock && root.dock < 2);
            }

            // Wajah jam: jam + detik di kiri, tanggal pendek di kanan; tengah dikosongkan untuk titik privasi.
            if root.idle-clock && !root.media-mini && root.dock < 2 && !root.expanded && !root.dragging && !root.inline-msg: HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 16px;
                Text { text: root.clock-text + ":" + root.sec-text; color: Theme.text; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.date-short; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; }
            }

            // Media mini, dock atas/melayang (gambar 2): cover kecil di kiri, equalizer di kanan; tengah kosong untuk titik privasi.
            if root.media-mini && root.dock < 2: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                Rectangle {
                    x: 14px;
                    y: root.dock == 0 ? 2px : 6px;
                    width: 22px;
                    height: 22px;
                    border-radius: 4.4px;
                    background: Theme.chip;
                    clip: true;
                    if root.media-has-art: Image { source: root.media-art; width: 22px; height: 22px; image-fit: cover; }
                }
                EqBars { x: parent.width - 16px - 18px; y: root.dock == 0 ? 6px : 10px; width: 18px; height: 14px; playing: true; }
            }

            // Media mini, dock bawah/samping (gambar 1): cover bulat bercincin aksen di tengah kubah.
            if root.media-mini && root.dock >= 2: Rectangle {
                property <length> d: root.dock == 2 ? 30px : 38px;
                x: root.dock == 2 ? (parent.width - self.width) / 2 : (root.dock == 3 ? 8px : parent.width - self.width - 8px);
                y: root.dock == 2 ? 9px : (parent.height - self.height) / 2;
                width: self.d;
                height: self.d;
                border-radius: self.d / 2;
                background: Theme.chip;
                border-width: 2px;
                border-color: Theme.accent;
                clip: true;
                if root.media-has-art: Image { source: root.media-art; width: parent.width; height: parent.height; image-fit: cover; }
                // Renderer software tidak memotong gambar mengikuti radius: sudut ditutup warna badan lewat Path even-odd (persegi dikurangi lingkaran).
                if root.media-has-art: Path {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    fill-rule: evenodd;
                    fill: Theme.body;
                    commands: "M 0 0 H 100 V 100 H 0 Z M 0 50 A 50 50 0 1 0 100 50 A 50 50 0 1 0 0 50 Z";
                }
                if !root.media-has-art: EqBars { x: (parent.width - 18px) / 2; y: (parent.height - 14px) / 2; width: 18px; height: 14px; playing: true; }
            }

            // Greeting tampil sebagai companion inline di badan notch, bukan speech bubble terpisah.
            if root.greeting-inline-visible && !root.expanded: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.body;
                border-bottom-left-radius: 38px;
                border-bottom-right-radius: 38px;
                // Isi disusun dengan koordinat tetap di dalam pil 385 x 75 px.
                // Hindari layout anak yang mengukur ulang parent.width ketika teks membungkus.
                Rectangle {
                    x: 20px;
                    y: 20px;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.accent.with-alpha(0.14);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.62);
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.7);
                    }
                    Rectangle {
                        x: 22px;
                        y: 22px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.7);
                    }
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.accent;
                    }
                }
                Text {
                    x: 64px;
                    y: 8px;
                    width: 300px;
                    height: 35px;
                    text: root.greeting-message;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
                Text {
                    x: 64px;
                    y: 43px;
                    width: 300px;
                    height: 24px;
                    text: root.greeting-detail;
                    color: Theme.text-dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            // Mulut ekspresif native: port dari mood-mouth.ts untuk dock bawah dan samping.
            Rectangle {
                visible: !root.dragging && !root.expanded && !root.greeting-inline-visible && !root.media-mini && (root.dock == 2 || root.dock == 3 || root.dock == 4) && !(root.meeting-active || root.meeting-finished != "");
                x: (root.dock >= 3 ? 23px : (parent.width - self.width) / 2) + root.eyes-offset-x * 1px;
                y: (root.dock >= 3 ? 105px : (root.dock == 2 ? 27px : 27px)) + root.eyes-offset-y * 1px;
                width: (root.eyes-mood == "happy" ? 14px
                    : root.eyes-mood == "sleepy" ? 7px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "angry" ? 12px
                    : root.eyes-mood == "love" ? 15px
                    : root.eyes-mood == "suspicious" ? 10px
                    : root.eyes-mood == "sad" ? 11px : 10px) * root.eyes-scale-x;
                height: (root.eyes-mood == "happy" || root.eyes-mood == "angry" || root.eyes-mood == "love" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "sleepy" ? 2px
                    : root.eyes-mood == "suspicious" ? 5px : 3px) * root.eyes-scale-y;
                border-radius: root.eyes-mood == "surprised" ? 4px
                    : root.eyes-mood == "happy" || root.eyes-mood == "love" ? 7px
                    : root.eyes-mood == "angry" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "suspicious" ? 5px : 2px;
                background: root.eyes-mood == "happy" ? #82ffbe
                    : root.eyes-mood == "sleepy" ? #9696c880
                    : root.eyes-mood == "surprised" ? #fff08c
                    : root.eyes-mood == "angry" ? #ff5a5a
                    : root.eyes-mood == "love" ? #ff69b4
                    : root.eyes-mood == "suspicious" ? #ffbe5a
                    : root.eyes-mood == "sad" ? #82a0ff : #78dcff;
                opacity: 0.9;
                animate width { duration: 250ms; easing: ease-in-out; }
                animate height { duration: 250ms; easing: ease-in-out; }
                animate opacity { duration: 250ms; easing: ease-in-out; }
            }

            // Mode rapat: timer ringkas di atas wajah, tanpa mengubah animasi mata di bawahnya.
            Rectangle {
                visible: !root.meeting-active && root.meeting-finished != "" && !root.expanded && root.dock < 2;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: root.meeting-active ? #e5a84b : Theme.ok;
                HorizontalLayout {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    spacing: 5px;
                    Text { text: "●"; color: root.meeting-active ? #e5a84b : Theme.ok; font-size: 9px; vertical-alignment: center; }
                    Text {
                        text: root.meeting-active ? root.meeting-elapsed : root.meeting-finished;
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.meeting-active ? root.meeting-source : "SELESAI";
                        color: #c9cbd3;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            // Overlay Adzan saat notch menciut: status jelas dan kontrol berhenti.
            Rectangle {
                visible: root.adhan-active && !root.expanded;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.8);
                HorizontalLayout {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    spacing: 6px;
                    HorizontalLayout {
                        width: 20px;
                        height: 18px;
                        spacing: 2px;
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 0 ? 13px : 5px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 1 ? 15px : 6px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 2 ? 12px : 4px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                    }
                    Text {
                        text: "ADZAN  " + root.adhan-prayer;
                        color: Theme.text;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    stop-touch := TouchArea {
                        width: 22px;
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => { root.adhan-stop(); }
                        Rectangle { background: stop-touch.has-hover ? #ffffff30 : #ffffff18; border-radius: 11px; }
                        Text { text: "■"; color: #ff8b8b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Hub: tab + halaman
            Rectangle {
                visible: root.expanded;
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: 180ms; delay: 80ms; }

                HorizontalLayout {
                    x: 15px;
                    y: 19px;
                    width: parent.width - 30px;
                    height: 30px;
                    spacing: 4px;
                    alignment: start;
                    for id in root.tabs: TabIcon {
                        commands: Icons.for-page(id);
                        active: root.page-id == id;
                        clicked => { root.page-id = id; root.page-changed(id); }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 54px;
                    width: parent.width;
                    height: parent.height - 54px;
                    if root.page-id == "privacy": PrivacyPage {
                        active: root.meeting-active;
                        source: root.meeting-source;
                        elapsed: root.meeting-elapsed;
                    }
                    if root.page-id == "prayer": PrayerPage {
                        items: root.prayer-items;
                        imsakiyah: root.prayer-imsakiyah;
                        meta: root.prayer-meta;
                        next-when: root.prayer-when;
                        city: root.prayer-city;
                        dhikr-idx: root.dhikr-idx;
                        dhikr-prev => { root.prayer-dhikr-prev(); }
                        next-name: root.prayer-next-name;
                        next-time: root.prayer-next-time;
                        countdown: root.prayer-countdown;
                        status: root.prayer-status;
                        ramadan: root.ramadan-enabled;
                        ramadan-date: root.ramadan-date;
                        imsak-countdown: root.ramadan-imsak-countdown;
                        buka-countdown: root.ramadan-buka-countdown;
                        imsak-time: root.ramadan-imsak-time;
                        buka-time: root.ramadan-buka-time;
                        mode: root.prayer-mode;
                        remind-before: root.prayer-remind-before == "true";
                        remind-min: root.prayer-remind-min;
                        dhikr-arabic: root.dhikr-arabic;
                        dhikr-latin: root.dhikr-latin;
                        dhikr-meaning: root.dhikr-meaning;
                        refresh => { root.prayer-refresh(); }
                        set-mode(v) => { root.prayer-set-mode(v); }
                        set-remind(v) => { root.prayer-set-remind(v); }
                        set-remind-min(v) => { root.prayer-set-remind-min(v); }
                        toggle-ramadan => { root.prayer-toggle-ramadan(); }
                        dhikr-next => { root.prayer-dhikr-next(); }
                    }
                    if root.page-id == "android": AndroidPage {
                        status: root.android-status;
                        devices: root.android-devices;
                        entries: root.android-entries;
                        current-path: root.android-path;
                        selected-serial: root.android-serial;
                        refresh => { root.android-refresh(); }
                        list(path) => { root.android-list(path); }
                        push(serial, path) => { root.android-push(serial, path); }
                        pull(path) => { root.android-pull(path); }
                        select-device(serial) => { root.android-select-device(serial); }
                        mirror => { root.android-mirror(); }
                        stop-mirror => { root.android-stop-mirror(); }
                    }
                    if root.page-id == "transfer": TransferPage {
                        status: root.transfer-status;
                        address: root.transfer-address;
                        shared-count-text: root.transfer-shared-count-text;
                        start-server => { root.transfer-start(); }
                        stop => { root.transfer-stop(); }
                        add-files => { root.transfer-add-files(); }
