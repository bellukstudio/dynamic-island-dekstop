    callback android-mirror();
    callback android-stop-mirror();

    // Kursor di pil ATAU di tombol Pusatkan (termasuk celah di antaranya) dianggap masih di dalam notch.
    property <bool> any-hover: hover.has-hover || pos-zone.has-hover;
    out property <bool> drag-armed: hover.pressed;
    changed any-hover => { root.hover-changed(root.any-hover); }

    // Tombol "Pusatkan": melayang di luar badan notch, 8 px di bawahnya (di atasnya bila menempel dasar
    // layar), muncul bersama hub. TouchArea mencakup celah ke pil supaya kursor yang menyeberang tidak
    // dianggap keluar; piksel hampir transparan memastikan jendela berlapis tetap menerima kursor di celah.
    pos-zone := TouchArea {
        property <length> gap: 8px;
        width: 104px;
        height: self.gap + 22px;
        x: (root.width - self.width) / 2;
        y: root.dock == 2 ? pill.y - self.height : pill.y + pill.height;
        enabled: root.expanded;
        mouse-cursor: pointer;
        clicked => { root.quick-toggle("center"); }

        Rectangle { background: #00000001; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.dock == 2 ? 0px : parent.gap;
            width: 94px;
            height: 22px;
            border-radius: 11px;
            background: pos-zone.has-hover ? #20202af2 : #121216e6;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(pos-zone.has-hover ? 0.9 : 0.5);
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 180ms; }
            animate background { duration: 120ms; }
            Path {
                x: 9px;
                y: 5px;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 V 8 M 12 16 V 21 M 3 12 H 8 M 16 12 H 21 M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10";
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
            }
            Text {
                x: 26px;
                height: parent.height;
                text: "Pusatkan";
                color: Theme.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    pill := Rectangle {
        // Radius mengikuti Tauri: hub 32 px menempel / 28 px melayang; pil kecil 17 px.
        // Bentuk compact meniru Tauri: setengah lingkaran menghadap ke dalam layar.
        // Dock bawah 80x44, dock samping 60x120; hub terbuka tetap memakai ukuran landscape.
        property <length> r: root.expanded ? (root.dock == 1 ? 28px : 32px) * root.ui-scale
            : (root.dock == 2 ? 44px : (root.dock >= 3 ? 60px : 17px)) * root.ui-scale;
        x: root.dock == 3 ? 0px : (root.dock == 4 ? root.width - self.width : (root.width - self.width) / 2 + (root.dock == 2 ? root.play-offset * 1px : 0px));
        y: root.dock == 2 ? root.height - self.height : (root.dock >= 3 ? (root.height - self.height) / 2 + root.play-offset * 1px : 0px);
        width: root.expanded ? 602px : (root.greeting-inline-visible && root.dock < 3 ? 385px : (root.dragging ? 58px : (root.dock == 2 ? 80px : (root.dock >= 3 ? 60px : 130px)) * root.play-body-scale-x));
        height: root.expanded ? 202px : (root.greeting-inline-visible && root.dock < 3 ? 75px : (root.dragging ? 58px : (root.dock == 2 ? 44px : (root.dock >= 3 ? 120px : 34px)) * root.play-body-scale-y));
        background: Theme.body;
        // Sisi yang menempel ke tepi layar dibiarkan rata; selain itu membulat.
        border-top-left-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 3) ? 0px : self.r);
        border-top-right-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 4) ? 0px : self.r);
        border-bottom-left-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 3) ? 0px : self.r);
        border-bottom-right-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 4) ? 0px : self.r);
        animate r { duration: 220ms; easing: ease-out-quart; }
        clip: true;
        animate width { duration: 220ms; easing: ease-out-quart; }
        animate height { duration: 220ms; easing: ease-out-quart; }

        // Hiasan tema (cahaya, scan, rim). Digambar sebagai gambar karena clip UI tidak mengikuti radius
        // sudut di renderer software; gambar ini sudah ber-mask sudut bulat dan sisi bebas yang benar.
        Image {
            source: root.decor;
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            visible: root.has-decor;
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 220ms; }
        }

        // Konten dibungkus TouchArea sebagai induk: has-hover tetap true saat kursor berada di atas
        // tombol (anak), dan klik tetap diteruskan ke anak.
        hover := TouchArea {
            // Jangan hapus flag di sini: event double-click dapat datang setelah clicked.
            // Timer native yang melepas flag setelah jeda release drag.
            clicked => { if (!root.suppress-next-pill-click) { root.pill-clicked(); } }
            double-clicked => { if (!root.suppress-next-pill-click) { root.pill-double-clicked(); } }

            // Mata: hanya saat menciut. Renderer Rust mengikuti orientasi dock (horizontal / vertikal).
            Image {
                source: root.eyes-image;
                x: (root.dock >= 3 ? 13px : (parent.width - self.width) / 2) + root.eyes-offset-x * 1px;
                y: (root.dock == 2 ? 7px : root.eyes-offset-y * 1px);
                width: (root.dock == 2 ? 80px : (root.dock >= 3 ? 34px : 130px)) * root.eyes-scale-x;
                height: (root.dock == 2 ? 21px : (root.dock >= 3 ? 120px : 34px)) * root.eyes-scale-y;
                image-fit: fill;
                opacity: root.expanded ? 0 : 1;
                animate opacity { duration: 120ms; }
                visible: !root.dragging && !root.greeting-inline-visible;
            }

            // Greeting tampil sebagai companion inline di badan notch, bukan speech bubble terpisah.
            if root.greeting-inline-visible && !root.expanded: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.body;
                border-bottom-left-radius: 38px;
                border-bottom-right-radius: 38px;
                HorizontalLayout {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    spacing: 14px;
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 19px;
                        background: #202945;
                        border-width: 1px;
                        border-color: #7187ff;
                        Text { text: "●"; color: #91a5ff; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text { text: root.nudge-message; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                        Text { text: root.nudge-detail; color: #a7a9b3; font-size: 10px; overflow: elide; }
                    }
                }
            }

            // Mulut ekspresif native: port dari mood-mouth.ts untuk dock bawah dan samping.
            Rectangle {
                visible: !root.dragging && !root.expanded && !root.greeting-inline-visible && (root.dock == 2 || root.dock == 3 || root.dock == 4) && !(root.meeting-active || root.meeting-finished != "");
                x: (root.dock >= 3 ? 23px : (parent.width - self.width) / 2) + root.eyes-offset-x * 1px;
                y: (root.dock >= 3 ? 105px : (root.dock == 2 ? 27px : 27px)) + root.eyes-offset-y * 1px;
                width: (root.eyes-mood == "happy" ? 14px
                    : root.eyes-mood == "sleepy" ? 7px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "angry" ? 12px
                    : root.eyes-mood == "love" ? 15px
                    : root.eyes-mood == "suspicious" ? 10px
                    : root.eyes-mood == "sad" ? 11px : 10px) * root.eyes-scale-x;
                height: (root.eyes-mood == "happy" || root.eyes-mood == "angry" || root.eyes-mood == "love" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "sleepy" ? 2px
                    : root.eyes-mood == "suspicious" ? 5px : 3px) * root.eyes-scale-y;
                border-radius: root.eyes-mood == "surprised" ? 4px
                    : root.eyes-mood == "happy" || root.eyes-mood == "love" ? 7px
                    : root.eyes-mood == "angry" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "suspicious" ? 5px : 2px;
                background: root.eyes-mood == "happy" ? #82ffbe
                    : root.eyes-mood == "sleepy" ? #9696c880
                    : root.eyes-mood == "surprised" ? #fff08c
                    : root.eyes-mood == "angry" ? #ff5a5a
                    : root.eyes-mood == "love" ? #ff69b4
                    : root.eyes-mood == "suspicious" ? #ffbe5a
                    : root.eyes-mood == "sad" ? #82a0ff : #78dcff;
                opacity: 0.9;
                animate width { duration: 250ms; easing: ease-in-out; }
                animate height { duration: 250ms; easing: ease-in-out; }
                animate opacity { duration: 250ms; easing: ease-in-out; }
            }

            // Mode rapat: timer ringkas di atas wajah, tanpa mengubah animasi mata di bawahnya.
            Rectangle {
                visible: (root.meeting-active || root.meeting-finished != "") && !root.expanded && root.dock < 3;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: root.meeting-active ? #e5a84b : Theme.ok;
                HorizontalLayout {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    spacing: 5px;
                    Text { text: "●"; color: root.meeting-active ? #e5a84b : Theme.ok; font-size: 9px; vertical-alignment: center; }
                    Text {
                        text: root.meeting-active ? root.meeting-elapsed : root.meeting-finished;
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.meeting-active ? root.meeting-source : "SELESAI";
                        color: #c9cbd3;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            // Overlay Adzan saat notch menciut: status jelas dan kontrol berhenti.
            Rectangle {
                visible: root.adhan-active && !root.expanded;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.8);
                HorizontalLayout {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    spacing: 6px;
                    HorizontalLayout {
                        width: 20px;
                        height: 18px;
                        spacing: 2px;
                        alignment: center;
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 0 ? 13px : 5px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 1 ? 15px : 6px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                        Rectangle {
                            width: 3px;
                            height: Math.mod(root.adhan-phase, 3) == 2 ? 12px : 4px;
                            background: Theme.accent;
                            border-radius: 2px;
                            animate height { duration: 110ms; }
                        }
                    }
                    Text {
                        text: "ADZAN  " + root.adhan-prayer;
                        color: Theme.text;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    stop-touch := TouchArea {
                        width: 22px;
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => { root.adhan-stop(); }
                        Rectangle { background: stop-touch.has-hover ? #ffffff30 : #ffffff18; border-radius: 11px; }
                        Text { text: "■"; color: #ff8b8b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Hub: tab + halaman
            Rectangle {
                visible: root.expanded;
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: 180ms; delay: 80ms; }

                HorizontalLayout {
                    x: 20px;
                    y: 14px;
                    width: parent.width - 40px;
                    height: 30px;
                    spacing: 4px;
                    alignment: start;
                    for id in root.tabs: TabIcon {
                        commands: Icons.for-page(id);
                        active: root.page-id == id;
                        clicked => { root.page-id = id; root.page-changed(id); }
                    }
                }

                Rectangle {
                    y: 56px;
                    height: parent.height - 56px - 12px;
                    if root.page-id == "privacy": PrivacyPage {
                        active: root.meeting-active;
                        source: root.meeting-source;
                        elapsed: root.meeting-elapsed;
                    }
                    if root.page-id == "prayer": PrayerPage {
                        items: root.prayer-items;
                        next-name: root.prayer-next-name;
                        next-time: root.prayer-next-time;
                        countdown: root.prayer-countdown;
                        status: root.prayer-status;
                        ramadan: root.ramadan-enabled;
                        ramadan-date: root.ramadan-date;
                        imsak-countdown: root.ramadan-imsak-countdown;
                        buka-countdown: root.ramadan-buka-countdown;
                        imsak-time: root.ramadan-imsak-time;
                        buka-time: root.ramadan-buka-time;
                        mode: root.prayer-mode;
                        remind-before: root.prayer-remind-before == "true";
                        remind-min: root.prayer-remind-min;
                        dhikr-arabic: root.dhikr-arabic;
                        dhikr-latin: root.dhikr-latin;
                        dhikr-meaning: root.dhikr-meaning;
                        refresh => { root.prayer-refresh(); }
                        set-mode(v) => { root.prayer-set-mode(v); }
                        set-remind(v) => { root.prayer-set-remind(v); }
                        set-remind-min(v) => { root.prayer-set-remind-min(v); }
                        toggle-ramadan => { root.prayer-toggle-ramadan(); }
                        dhikr-next => { root.prayer-dhikr-next(); }
                    }
                    if root.page-id == "android": AndroidPage {
                        status: root.android-status;
                        devices: root.android-devices;
                        entries: root.android-entries;
                        current-path: root.android-path;
                        selected-serial: root.android-serial;
                        refresh => { root.android-refresh(); }
                        list(path) => { root.android-list(path); }
                        push(serial, path) => { root.android-push(serial, path); }
                        pull(path) => { root.android-pull(path); }
                        select-device(serial) => { root.android-select-device(serial); }
                        mirror => { root.android-mirror(); }
                        stop-mirror => { root.android-stop-mirror(); }
                    }
                    if root.page-id == "transfer": TransferPage {
                        status: root.transfer-status;
                        address: root.transfer-address;
                        shared-count-text: root.transfer-shared-count-text;
                        start-server => { root.transfer-start(); }
                        stop => { root.transfer-stop(); }
                        add-files => { root.transfer-add-files(); }
                        open-inbox => { root.transfer-open-inbox(); }
                    }
                    if root.page-id == "convert": ConvertPage {
                        file-path: root.convert-selected-path;
                        overrides-text: root.convert-overrides-text;
                        status: root.convert-status;
                        history-text: root.convert-history-text;
                        files-text: root.convert-files-text;
                        output-dir-text: root.convert-output-dir-text;
                        eta-text: root.convert-eta-text;
                        queue-text: root.convert-queue-text;
                        progress-value: root.convert-progress-value;
                        progress-text: root.convert-progress-text;
                        preview-page-text: root.convert-preview-page-text;
                        preview-status: root.convert-preview-status;
                        preview-zoom-text: root.convert-preview-zoom-text;
                        source-preview: root.convert-source-preview;
                        result-preview: root.convert-result-preview;
                        run(path, format, quality, dpi, overrides) => { root.convert-run(path, format, quality, dpi, overrides); }
                        pick-file => { root.convert-pick(); }
                        preview-prev => { root.convert-preview-prev(); }
                        preview-next => { root.convert-preview-next(); }
                        preview-zoom-in => { root.convert-preview-zoom-in(); }
                        preview-zoom-out => { root.convert-preview-zoom-out(); }
                        reveal => { root.convert-reveal(); }
                        cancel => { root.convert-cancel(); }
                        pause => { root.convert-pause(); }
                        resume => { root.convert-resume(); }
                        clear-queue => { root.convert-clear-queue(); }
                        remove-queue-file(value) => { root.convert-remove-queue-file(value); }
                        retry-failed => { root.convert-retry-failed(); }
                        retry-one-failed(value) => { root.convert-retry-one-failed(value); }
                        cancel-one-file(value) => { root.convert-cancel-one-file(value); }
                        add-files => { root.convert-add-files(); }
                        move-queue-file(value, direction) => { root.convert-move-queue-file(value, direction); }
                        remove-finished => { root.convert-remove-finished(); }
                        export-history => { root.convert-history-export(); }
                        clear-history => { root.convert-history-clear(); }
                        pick-output-dir => { root.convert-output-dir-pick(); }
                    }
                    if root.page-id == "compress": CompressPage {
                        status: root.compress-status;
                        file-path: root.compress-selected-path;
                        run(path) => { root.compress-run(path); }
                        pick-file => { root.compress-pick(); }
                    }
                    if root.page-id == "settings": Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-width: self.width;
                        content-height: self.height;
                        SettingsPage {
                            width: parent.width;
                        weather-city: root.weather-city;
                        weather-lat: root.weather-lat;
                        weather-lon: root.weather-lon;
                        weather-save-status: root.weather-save-status;
                        save-weather(city, lat, lon) => { root.settings-save-weather(city, lat, lon); }
                        shortcut-hub: root.shortcut-hub;
                        shortcut-settings: root.shortcut-settings;
                        shortcut-pomodoro: root.shortcut-pomodoro;
                        shortcut-prayer: root.shortcut-prayer;
                        appearance-theme: root.appearance-theme;
                        appearance-eye-theme: root.appearance-eye-theme;
                        appearance-notch-theme: root.appearance-notch-theme;
                        appearance-mood: root.appearance-mood;
                        appearance-accent: root.appearance-accent;
                        appearance-custom-bg: root.appearance-custom-bg;
                        appearance-custom-text: root.appearance-custom-text;
                        appearance-dark-bg: root.appearance-dark-bg;
                        appearance-light-bg: root.appearance-light-bg;
                        appearance-save-status: root.appearance-save-status;
                        save-appearance(theme, eye, notch, mood, accent, custom-bg, custom-text, dark, light) => { root.settings-save-appearance(theme, eye, notch, mood, accent, custom-bg, custom-text, dark, light); }
                        behavior-scale: root.behavior-scale;
                        behavior-hover-open: root.behavior-hover-open;
                        behavior-hover-close: root.behavior-hover-close;
                        behavior-sleep-after: root.behavior-sleep-after;
                        behavior-hide-fullscreen: root.behavior-hide-fullscreen;
                        autostart-enabled: root.autostart-enabled;
                        autostart-save-status: root.autostart-save-status;
                        behavior-save-status: root.behavior-save-status;
                        motion-enabled: root.motion-enabled;
                        dock-play-enabled: root.dock-play-enabled;
                        motion-interval: root.motion-interval;
                        motion-max-moves: root.motion-max-moves;
                        motion-save-status: root.motion-save-status;
                        nudge-enabled: root.nudge-enabled;
                        nudge-idle-min: root.nudge-idle-min;
                        nudge-message: root.nudge-message;
                        nudge-emoji: root.nudge-emoji;
                        nudge-mood: root.nudge-mood;
                        nudge-show-ms: root.nudge-show-ms;
                        nudge-only-silent: root.nudge-only-silent;
                        nudge-until-move: root.nudge-until-move;
                        nudge-save-status: root.nudge-save-status;
                        greeting-enabled: root.greeting-enabled;
                        greeting-mode: root.greeting-mode;
                        greeting-voice: root.greeting-voice;
                        greeting-custom-text: root.greeting-custom-text;
                        greeting-save-status: root.greeting-save-status;
                        conversation-enabled: root.conversation-enabled;
                        conversation-on-play: root.conversation-on-play;
                        conversation-on-track-change: root.conversation-on-track-change;
                        conversation-on-pause: root.conversation-on-pause;
                        conversation-on-return: root.conversation-on-return;
                        conversation-on-weather-change: root.conversation-on-weather-change;
                        conversation-on-rain-soon: root.conversation-on-rain-soon;
                        conversation-on-low-battery: root.conversation-on-low-battery;
                        conversation-on-charging: root.conversation-on-charging;
                        conversation-return-after-min: root.conversation-return-after-min;
                        conversation-cooldown-min: root.conversation-cooldown-min;
                        conversation-save-status: root.conversation-save-status;
                        focus-companion-enabled: root.focus-companion-enabled;
                        focus-companion-on-start: root.focus-companion-on-start;
                        focus-companion-on-halfway: root.focus-companion-on-halfway;
                        focus-companion-on-focus-complete: root.focus-companion-on-focus-complete;
                        focus-companion-on-break-end: root.focus-companion-on-break-end;
                        focus-companion-save-status: root.focus-companion-save-status;
                        save-nudge(enabled, idle, message, emoji, mood, show, silent, until-move) => { root.settings-save-nudge(enabled, idle, message, emoji, mood, show, silent, until-move); }
                        test-nudge(message, emoji, mood, show, until-move) => { root.settings-test-nudge(message, emoji, mood, show, until-move); }
                        save-greeting(enabled, mode, voice, custom-text) => { root.settings-save-greeting(enabled, mode, voice, custom-text); }
                        test-greeting(mode, custom-text, voice) => { root.settings-test-greeting(mode, custom-text, voice); }
                        save-conversation(enabled, play, track, pause, returning, weather, rain, battery, charging, return-after, cooldown) => { root.settings-save-conversation(enabled, play, track, pause, returning, weather, rain, battery, charging, return-after, cooldown); }
                        test-conversation(message, detail) => { root.settings-test-conversation(message, detail); }
                        save-focus-companion(enabled, start, halfway, complete, break-end) => { root.settings-save-focus-companion(enabled, start, halfway, complete, break-end); }
                        test-focus-companion(message, detail) => { root.settings-test-focus-companion(message, detail); }
                        position-mode: root.position-mode;
                        save-behavior(scale, open, close, sleep, hide-fullscreen) => { root.settings-save-behavior(scale, open, close, sleep, hide-fullscreen); }
                        save-autostart(enabled) => { root.settings-save-autostart(enabled); }
                        save-position(mode) => { root.settings-save-position(mode); }
                        save-motion(enabled, interval, maximum, dock-play) => { root.settings-save-motion(enabled, interval, maximum, dock-play); }
                        test-dock-play => { root.settings-test-dock-play(); }
                        active-pages: root.active-pages;
                        hub-pages: root.hub-pages;
                        pages-save-status: root.pages-save-status;
                        save-pages(value) => { root.settings-save-pages(value); }
                        toggle-page(id, enabled) => { root.settings-toggle-page(id, enabled); }
                        prayer-province: root.prayer-province;
                        prayer-city: root.prayer-city;
                        prayer-mode: root.prayer-mode;
                        prayer-remind-before: root.prayer-remind-before;
                        prayer-remind-min: root.prayer-remind-min;
                        pomodoro-focus: root.pomodoro-focus;
                        pomodoro-break: root.pomodoro-break;
                        pomodoro-long-break: root.pomodoro-long-break;
                        pomodoro-rounds: root.pomodoro-rounds;
                        save-routines(mode, remind, minutes, focus, rest, long, rounds, province, city) => { root.settings-save-routines(mode, remind, minutes, focus, rest, long, rounds, province, city); }
                        save-status: root.settings-save-status;
                        save-shortcuts(hub, settings, pomo, prayer) => { root.settings-save-shortcuts(hub, settings, pomo, prayer); }
                        }
                    }
                    if root.page-id == "media": MediaPage {
                        width: parent.width;
                        height: parent.height;
                        lyrics-open <=> root.lyrics-open; lyric-lines: root.lyric-lines; lyric-active: root.lyric-active;
                        art: root.media-art; has-art: root.media-has-art; title: root.media-title; artist: root.media-artist;
                        pos-text: root.media-pos-text; dur-text: root.media-dur-text; progress: root.media-progress; playing: root.media-playing;
                        prev => { root.media-control("prev"); } toggle => { root.media-control("toggle"); } next => { root.media-control("next"); }
                        seek(v) => { root.media-seek(v * root.media-length); }
                    }
                    if root.page-id == "clock" && !root.cal-open: ClockPage {
                        clock-text: root.clock-text;
                        date-text: root.date-text;
                        open-calendar => { root.cal-open = true; root.cal-opened(); }
                    }
                    if root.page-id == "clock" && root.cal-open: CalendarPage {
                        cells: root.cal-cells;
                        weekdays: root.cal-weekdays;
                        title: root.cal-title;
                        foot-date: root.cal-foot-date;
                        foot-name: root.cal-foot-name;
                        foot-kind: root.cal-foot-kind;
                        prev => { root.cal-prev(); }
                        next => { root.cal-next(); }
                        today => { root.cal-today(); }
                        select(i) => { root.cal-select(i); }
                        close => { root.cal-open = false; }
                    }
                    if root.page-id == "timer": TimerPage {
                        pomo-text: root.pomo-text;
                        pomo-label: root.pomo-label;
                        pomo-progress: root.pomo-progress;
                        pomo-running: root.pomo-running;
                        pomo-rest: root.pomo-rest;
                        toggle => { root.toggle-pomo(); }
                        reset => { root.reset-pomo(); }
                        skip => { root.skip-pomo(); }
                    }
                    if root.page-id == "stats": StatsPage {
                        cpu: root.cpu; ram: root.ram; disk: root.disk;
                        cpu-text: root.cpu-text; ram-text: root.ram-text; disk-text: root.disk-text;
                        net-text: root.net-text; sys-text: root.sys-text;
                    }
                    if root.page-id == "battery": BatteryPage { present: root.battery-present; percent: root.battery-percent; charging: root.battery-charging; }
                    if root.page-id == "shelf": ShelfPage {
                        items: root.shelf-items;
                        status: root.shelf-status;
                        add => { root.shelf-add(); }
                        open(path) => { root.shelf-open(path); }
                        reveal(path) => { root.shelf-reveal(path); }
                        remove(path) => { root.shelf-remove(path); }
                        clear => { root.shelf-clear(); }
                    }
                    if root.page-id == "notes": NotesPage {
                        notes: root.notes;
                        add(t) => { root.add-note(t); }
                        remove(id) => { root.remove-note(id); }
                    }
                    if root.page-id == "weather": WeatherPage {
                        refresh => { root.weather-refresh(); }
                        city: root.weather-city;
                        temperature: root.weather-temp;
                        condition: root.weather-condition;
                        feels: root.weather-feels;
                        humidity: root.weather-humidity;
                        rain: root.weather-rain;
                        icon: root.weather-icon;
                        status: root.weather-status;
                    }
                    if root.page-id == "reminder": ReminderPage {
                        items: root.reminders;
                        alert-visible: root.reminder-alert-visible;
                        alert-text: root.reminder-alert-text;
                        alert-sub: root.reminder-alert-sub;
                        status: root.reminder-status;
                        weekdays-mask: root.reminder-weekdays-mask;
                        weekday-selected: root.reminder-weekday-selected;
                        draft <=> root.reminder-draft;
                        date-time <=> root.reminder-date-time;
                        repeat-mode <=> root.reminder-repeat-mode;
                        add(text, date-time, repeat-mode, weekdays-mask) => { root.reminder-add(text, date-time, repeat-mode, weekdays-mask); }
                        toggle(id) => { root.reminder-toggle(id); }
                        remove(id) => { root.reminder-remove(id); }
                        clear-done => { root.reminder-clear-done(); }
                        stop-alert => { root.reminder-stop-alert(); }
                        snooze-alert => { root.reminder-snooze-alert(); }
                        toggle-weekday(i) => { root.reminder-toggle-weekday(i); }
                    }
                    if root.page-id == "clipboard": ClipboardPage {
                        items: root.clipboard-items;
                        available: root.clipboard-available;
                        copy(text) => { root.clipboard-copy(text); }
                        clear => { root.clipboard-clear(); }
                    }
                    if root.page-id == "quick": QuickPage {
                        mic: root.q-mic; wifi: root.q-wifi; bt: root.q-bt;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "tools": ToolsPage {
                        awake: root.q-awake; dark: root.q-dark;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "uji": RenderTestPage { coffee: root.emoji-coffee; tomato: root.emoji-tomato; moon: root.emoji-moon; }
                    if root.page-id != "settings" && root.page-id != "media" && root.page-id != "clock" && root.page-id != "timer"
                        && root.page-id != "stats" && root.page-id != "battery" && root.page-id != "notes"
                        && root.page-id != "weather" && root.page-id != "reminder" && root.page-id != "clipboard" && root.page-id != "shelf" && root.page-id != "quick" && root.page-id != "tools" && root.page-id != "privacy" && root.page-id != "prayer" && root.page-id != "uji":
                        PlaceholderPage { name: root.page-id; }
                }
            }
        }
    }

    // Balon berada di luar pill agar tidak terpotong oleh clip:true. Ruang ekstra disediakan saat menciut.
    if !root.expanded && !root.greeting-inline-visible && (root.reminder-alert-visible || root.adhan-active || root.meeting-active || root.meeting-finished != "" || root.nudge-visible): SpeechBubble {
        x: root.dock == 3 ? 34px : (root.dock == 4 ? 16px : (root.width - self.width) / 2);
        y: root.dock >= 3 ? (root.height - self.height) / 2 : (root.dock == 2 ? 0px : 42px);
        bottom: root.dock != 2;
        side: root.dock >= 3;
        side-right: root.dock == 4;
        message: root.adhan-active ? ("Waktu " + root.adhan-prayer) : (root.meeting-active ? "Rapat berlangsung" : (root.meeting-finished != "" ? "Rapat selesai" : (root.nudge-visible ? root.nudge-message : root.reminder-alert-text)));
        detail: root.adhan-active ? "Adzan sedang diputar" : (root.meeting-active ? root.meeting-elapsed + " · " + root.meeting-source : (root.meeting-finished != "" ? root.meeting-finished : (root.nudge-visible ? root.nudge-detail : root.reminder-alert-sub)));
    }

    Ear { s: root.ui-scale; visible: root.dock < 3 && root.dock != 1; x: pill.x - 10px * root.ui-scale; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; bottom: root.dock == 2; }
    Ear { s: root.ui-scale; visible: root.dock < 3 && root.dock != 1; x: pill.x + pill.width; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; right: true; bottom: root.dock == 2; }
}
