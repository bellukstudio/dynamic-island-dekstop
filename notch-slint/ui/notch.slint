    // Kursor di pil ATAU di tombol Pusatkan (termasuk celah di antaranya) dianggap masih di dalam notch.
    property <bool> any-hover: hover.has-hover || pos-zone.has-hover;
    out property <bool> drag-armed: hover.pressed;
    changed any-hover => { root.hover-changed(root.any-hover); }
    // Lebar badan notch menciut (adzan 220, musik/jam 220, biasa 130) menentukan area klik di Rust; hitung ulang tiap berubah.
    changed adhan-active => { root.adhan-layout-changed(); root.region-layout-changed(); }
    changed idle-clock => { root.adhan-layout-changed(); root.region-layout-changed(); }
    changed media-playing => { root.adhan-layout-changed(); root.region-layout-changed(); }
    changed nudge-visible => { root.region-layout-changed(); }
    changed reminder-alert-visible => { root.region-layout-changed(); }
    changed greeting-speech-visible => { root.region-layout-changed(); }
    changed meeting-finished => { root.region-layout-changed(); }

    pill := Rectangle {
        opacity: root.pill-fade;
        // Radius mengikuti Tauri: hub 32 px menempel / 28 px melayang; pil kecil 17 px.
        // Bentuk compact meniru Tauri: setengah lingkaran menghadap ke dalam layar.
        // Dock bawah 80x44, dock samping 60x120; hub terbuka tetap memakai ukuran landscape.
        property <length> r: root.adhan-inline ? 17px * root.ui-scale : (root.expanded ? (root.dock == 1 ? 28px : 32px) * root.ui-scale
            : (root.nudge-inline ? 24px : (root.greeting-inline-visible && root.dock < 3 ? 17px : (root.dock == 0 ? 13px : (root.dock == 2 ? 40px : (root.dock >= 3 ? 40px : 17px))))) * root.ui-scale);
        x: root.dock == 3 ? 0px : (root.dock == 4 ? root.width - self.width : (root.width - self.width) / 2 + (root.dock == 2 ? root.play-offset * 1px : 0px));
        y: root.dock == 2 ? root.height - self.height : (root.dock >= 3 ? (root.height - self.height) / 2 + root.play-offset * 1px : 0px);
        width: root.adhan-inline ? 220px * root.ui-scale : ((root.expanded ? ((root.prayer-wide || root.reminder-wide || root.page-id == "currency") ? 780px : 580px) : (root.nudge-inline ? (root.media-playing && root.nudge-visible ? 220px : 288px) : (root.greeting-inline-visible && root.dock < 3 ? 385px : (root.dragging ? 58px : (root.dock == 2 ? 80px : (root.dock >= 3 ? 40px : (root.idle-clock ? 300px : (root.media-mini ? 220px : 130px)))) * root.play-body-scale-x)))) * (root.expanded ? 1.0 : root.ui-scale));
        height: root.adhan-inline ? 34px * root.ui-scale : ((root.expanded ? (root.prayer-wide ? 540px : (root.reminder-wide ? 502px : (root.page-id == "currency" ? 520px : (root.page-id == "notes" && root.notes-expanded ? 300px : 202px)))) : (root.nudge-inline ? (root.media-playing && root.nudge-visible ? 40px : 68px) : (root.greeting-inline-visible && root.dock < 3 ? 75px : (root.dragging ? 58px : (root.dock == 0 ? 26px : (root.dock == 2 ? 44px : (root.dock >= 3 ? 80px : 34px))) * root.play-body-scale-y)))) * (root.expanded ? 1.0 : root.ui-scale));
        // Dock bawah/samping saat menciut digambar sebagai Path busur (lihat `half-body`) karena Slint
        // membatasi border-radius maksimal setengah sisi terpendek: radius 40 pada 80x44 jadi 22 (bukan setengah lingkaran).
        // Jangan meregangkan Path kubah saat panel masih mengecil dari ukuran hub.
        // Selama transisi gunakan badan rounded biasa seperti dock atas; bentuk setengah lingkaran
        // baru aktif ketika badan sudah mencapai ukuran compact (termasuk skala Bottom/Side Play).
        property <bool> half: !root.expanded && !root.dragging && root.dock >= 2 && !root.greeting-inline-visible
            && self.width <= (root.dock == 2 ? 80px : 40px) * root.ui-scale * root.play-body-scale-x + 1px
            && self.height <= (root.dock == 2 ? 44px : 80px) * root.ui-scale * root.play-body-scale-y + 1px;
        background: self.half ? transparent : Theme.body;
        // Sisi yang menempel ke tepi layar dibiarkan rata; selain itu membulat.
        border-top-left-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 3) ? 0px : self.r);
        border-top-right-radius: root.dragging ? 29px : ((root.dock == 0 || root.dock == 4) ? 0px : self.r);
        border-bottom-left-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 3) ? 0px : self.r);
        border-bottom-right-radius: root.dragging ? 29px : ((root.dock == 2 || root.dock == 4) ? 0px : self.r);
        animate r { duration: 300ms; easing: cubic-bezier(0.42, 0, 0.58, 1); }
        clip: true;
        // Membuka dan menutup sama dengan transisi #notch di Tauri (base.css): 300 ms cubic-bezier(.42, 0, .58, 1).
        // Kurva ease-out (gerak menumpuk di awal) membuat pil tampak melompat karena renderer software hanya
        // sempat menggambar beberapa frame; ease-in-out menyebar gerak merata seperti di video Tauri.
        animate width { duration: 300ms; easing: cubic-bezier(0.42, 0, 0.58, 1); }
        animate height { duration: 300ms; easing: cubic-bezier(0.42, 0, 0.58, 1); }

        // Badan setengah lingkaran menghadap ke dalam layar: bawah 80x44 (radius 40), kiri/kanan 60x120 (radius 60).
        half-body := Path {
            visible: pill.half;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: root.dock == 2 ? 80 : 40;
            viewbox-height: root.dock == 2 ? 44 : 80;
            fill: Theme.body;
            commands: root.dock == 2 ? "M 0 44 L 0 40 A 40 40 0 0 1 80 40 L 80 44 Z"
                : (root.dock == 3 ? "M 0 0 A 40 40 0 0 1 0 80 Z" : "M 40 0 A 40 40 0 0 0 40 80 Z");
        }

        // Hiasan tema (cahaya, scan, rim). Digambar sebagai gambar karena clip UI tidak mengikuti radius
        // sudut di renderer software; gambar ini sudah ber-mask sudut bulat dan sisi bebas yang benar.
        Image {
            source: root.decor;
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            visible: root.has-decor;
            opacity: root.expanded ? 1 : 0;
            animate opacity { duration: 220ms; }
        }

        // Konten dibungkus TouchArea sebagai induk: has-hover tetap true saat kursor berada di atas
        // tombol (anak), dan klik tetap diteruskan ke anak.
        hover := TouchArea {
            // Jangan hapus flag di sini: event double-click dapat datang setelah clicked.
            // Timer native yang melepas flag setelah jeda release drag.
            clicked => { if (!root.suppress-next-pill-click) { root.pill-clicked(); } }
            double-clicked => { if (!root.suppress-next-pill-click) { root.pill-double-clicked(); } }

            // Mata: hanya saat menciut. Renderer Rust mengikuti orientasi dock (horizontal / vertikal).
            Image {
                source: root.eyes-image;
                x: (parent.width - self.width) / 2 + root.eyes-offset-x * root.ui-scale * 1px;
                // Dock samping memakai gerak pada sumbu vertikal; offset ini sebelumnya belum diterapkan ke gambar mata.
                y: (root.dock == 2 ? 7px : (root.dock >= 3 ? 31px : root.eyes-offset-y * 1px)) * root.ui-scale
                    + (root.dock >= 3 ? root.eyes-offset-y * root.ui-scale * 1px : 0px);
                width: (root.dock == 2 ? 80px : (root.dock >= 3 ? 36px : 130px)) * root.eyes-scale-x * root.ui-scale;
                height: (root.dock == 2 ? 21px : (root.dock >= 3 ? 18px : (root.dock == 0 ? 26px : 34px))) * root.eyes-scale-y * root.ui-scale;
                image-fit: fill;
                opacity: root.expanded ? 0 : 1;
                // Crossfade seperti Tauri: mata baru muncul setelah isi hub mulai memudar.
                animate opacity { duration: root.expanded ? 100ms : 180ms; delay: root.expanded ? 0ms : 100ms; }
                visible: !root.dragging && !root.inline-msg && !root.media-mini && !root.adhan-active && !(root.idle-clock && root.dock < 2);
            }

            // Wajah jam: jam + detik di kiri, tanggal pendek di kanan; tengah dikosongkan untuk titik privasi.
            if root.idle-clock && !root.media-mini && root.dock < 2 && !root.expanded && !root.dragging && !root.inline-msg: HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 16px;
                Text { text: root.clock-text + ":" + root.sec-text; color: Theme.text; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.date-short; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; }
            }

            // Media mini, dock atas/melayang (gambar 2): cover kecil di kiri, equalizer di kanan; tengah kosong untuk titik privasi.
            if root.media-mini && root.dock < 2: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                // Seluruh kontrol mini mengikuti skala Notch, bukan hanya badan pil.
                property <float> media-scale: root.ui-scale;
                Rectangle {
                    x: 14px * parent.media-scale;
                    y: (root.dock == 0 ? 2px : 6px) * parent.media-scale;
                    width: 22px * parent.media-scale;
                    height: 22px * parent.media-scale;
                    border-radius: 4.4px * parent.media-scale;
                    background: Theme.chip;
                    clip: true;
                    if root.media-has-art: Image {
                        source: root.media-art;
                        width: 22px * root.ui-scale;
                        height: 22px * root.ui-scale;
                        image-fit: cover;
                    }
                }
                EqBars {
                    x: parent.width - (16px + 18px) * parent.media-scale;
                    y: (root.dock == 0 ? 6px : 10px) * parent.media-scale;
                    width: 18px * parent.media-scale;
                    height: 14px * parent.media-scale;
                    scale: parent.media-scale;
                    playing: root.media-playing;
                }
            }

            // Media mini dock bawah/samping: piringan vinyl berputar saat playback aktif.
            // Lebar side-pill hanya 40 px, maka cover dipusatkan dan diberi margin simetris agar tidak terpotong.
            if root.media-mini && root.dock >= 2: Rectangle {
                property <float> media-scale: root.ui-scale;
                property <length> d: (root.dock == 2 ? 32px : 36px) * self.media-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: self.d;
                height: self.d;
                border-radius: self.d / 2;
                background: #0d0f13;
                // Pinggiran piringan memakai warna metalik netral, bukan Theme.accent
                // yang mengikuti warna dominan cover dan dapat menjadi halo neon.
                border-width: 1px * self.media-scale;
                border-color: #626975;
                clip: true;
                if root.media-has-art: Image {
                    source: root.media-disc-art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }
                // Renderer software tidak memotong gambar mengikuti radius; sudut luar ditutup warna badan.
                if root.media-has-art: Path {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    fill-rule: evenodd;
                    fill: Theme.body;
                    commands: "M 0 0 H 100 V 100 H 0 Z M 0 50 A 50 50 0 1 0 100 50 A 50 50 0 1 0 0 50 Z";
                }
                if !root.media-has-art: EqBars {
                    x: (parent.width - 18px * parent.media-scale) / 2;
                    y: (parent.height - 14px * parent.media-scale) / 2;
                    width: 18px * parent.media-scale;
                    height: 14px * parent.media-scale;
                    scale: parent.media-scale;
                    playing: root.media-playing;
                }
                // Ketuk cover untuk play/pause tanpa harus membuka hub terlebih dahulu.
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.media-control("toggle"); }
                }
            }

            // Greeting tampil sebagai companion inline di badan notch, bukan speech bubble terpisah.
            if root.greeting-inline-visible && !root.expanded: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.body;
                border-bottom-left-radius: 38px;
                border-bottom-right-radius: 38px;
                // Isi disusun dengan koordinat tetap di dalam pil 385 x 75 px.
                // Hindari layout anak yang mengukur ulang parent.width ketika teks membungkus.
                Rectangle {
                    x: 20px;
                    y: 20px;
                    width: 34px;
                    height: 34px;
                    border-radius: root.media-playing && root.nudge-visible ? 12px : 17px;
                    background: Theme.accent.with-alpha(0.14);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.62);
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.7);
                    }
                    Rectangle {
                        x: 22px;
                        y: 22px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.7);
                    }
                    Rectangle {
                        x: root.media-playing && root.nudge-visible ? 8px : 12px;
                        y: root.media-playing && root.nudge-visible ? 8px : 12px;
                        width: root.media-playing && root.nudge-visible ? 8px : 10px;
                        height: root.media-playing && root.nudge-visible ? 8px : 10px;
                        border-radius: 5px;
                        background: Theme.accent;
                    }
                }
                Text {
                    x: 64px;
                    y: 8px;
                    width: 300px;
                    height: 35px;
                    text: root.greeting-message;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
                Text {
                    x: 64px;
                    y: 43px;
                    width: 300px;
                    height: 24px;
                    text: root.greeting-detail;
                    color: Theme.text-dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            // Mulut ekspresif native: port dari mood-mouth.ts untuk dock bawah dan samping.
            Rectangle {
                visible: !root.dragging && !root.expanded && !root.greeting-inline-visible && !root.media-mini && !root.adhan-active && (root.dock == 2 || root.dock == 3 || root.dock == 4) && !(root.meeting-active || root.meeting-finished != "");
                x: (parent.width - self.width) / 2 + root.eyes-offset-x * root.ui-scale * 1px;
                y: ((root.dock >= 3 ? 58px : 27px) + root.eyes-offset-y * 1px) * root.ui-scale;
                width: (root.eyes-mood == "happy" ? 14px
                    : root.eyes-mood == "sleepy" ? 7px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "angry" ? 12px
                    : root.eyes-mood == "love" ? 15px
                    : root.eyes-mood == "suspicious" ? 10px
                    : root.eyes-mood == "sad" ? 11px : 10px) * root.eyes-scale-x * root.ui-scale;
                height: (root.eyes-mood == "happy" || root.eyes-mood == "angry" || root.eyes-mood == "love" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "surprised" ? 7px
                    : root.eyes-mood == "sleepy" ? 2px
                    : root.eyes-mood == "suspicious" ? 5px : 3px) * root.eyes-scale-y * root.ui-scale;
                border-radius: (root.eyes-mood == "surprised" ? 4px
                    : root.eyes-mood == "happy" || root.eyes-mood == "love" ? 7px
                    : root.eyes-mood == "angry" || root.eyes-mood == "sad" ? 6px
                    : root.eyes-mood == "suspicious" ? 5px : 2px) * root.ui-scale;
                background: root.eyes-mood == "happy" ? #82ffbe
                    : root.eyes-mood == "sleepy" ? #9696c880
                    : root.eyes-mood == "surprised" ? #fff08c
                    : root.eyes-mood == "angry" ? #ff5a5a
                    : root.eyes-mood == "love" ? #ff69b4
                    : root.eyes-mood == "suspicious" ? #ffbe5a
                    : root.eyes-mood == "sad" ? #82a0ff : #78dcff;
                opacity: 0.9;
                animate width { duration: 250ms; easing: ease-in-out; }
                animate height { duration: 250ms; easing: ease-in-out; }
                animate opacity { duration: 250ms; easing: ease-in-out; }
            }

            // Mode rapat: timer ringkas di atas wajah, tanpa mengubah animasi mata di bawahnya.
            Rectangle {
                visible: !root.meeting-active && root.meeting-finished != "" && !root.expanded && root.dock < 2;
                x: (parent.width - 130px) / 2;
                y: 0px;
                width: 130px;
                height: 34px;
                border-radius: 17px;
                background: #171923f5;
                border-width: 1px;
                border-color: root.meeting-active ? #e5a84b : Theme.ok;
                HorizontalLayout {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    spacing: 5px;
                    Text { text: "●"; color: root.meeting-active ? #e5a84b : Theme.ok; font-size: 9px; vertical-alignment: center; }
                    Text {
                        text: root.meeting-active ? root.meeting-elapsed : root.meeting-finished;
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.meeting-active ? root.meeting-source : "SELESAI";
                        color: #c9cbd3;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            // Overlay Adzan saat notch menciut: status jelas dan tombol berhenti, mengikuti skala notch.
            if root.adhan-active && !root.expanded && !root.dragging: AdhanOverlay {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                dock: root.dock;
                ui-scale: root.ui-scale;
                prayer: root.adhan-prayer;
                phase: root.adhan-phase;
                stop => { root.adhan-stop(); }
            }

            // Hub: tab + halaman
            Rectangle {
                // Tetap tergambar selama memudar keluar, supaya hub tidak lenyap seketika saat pil menciut.
                visible: root.expanded || self.opacity > 0.01;
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: root.expanded ? 180ms : 120ms; delay: root.expanded ? 80ms : 0ms; }

                HorizontalLayout {
                    x: 15px;
                    y: 19px;
                    width: parent.width - 30px;
                    height: 30px;
                    spacing: 4px;
                    alignment: start;
                    for id in root.tabs: TabIcon {
                        commands: Icons.for-page(id);
                        active: root.page-id == id;
                        clicked => { if (id == "settings") { root.open-settings(); } else { root.page-id = id; root.page-changed(id); } }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 54px;
                    width: parent.width;
                    height: parent.height - 54px;
                    if root.page-id == "privacy": PrivacyPage {
                        active: root.meeting-active;
                        source: root.meeting-source;
                        elapsed: root.meeting-elapsed;
                    }
                    if root.page-id == "prayer": PrayerPage {
                        items: root.prayer-items;
                        imsakiyah: root.prayer-imsakiyah;
                        meta: root.prayer-meta;
                        next-when: root.prayer-when;
                        city: root.prayer-city;
                        dhikr-idx: root.dhikr-idx;
                        dhikr-prev => { root.prayer-dhikr-prev(); }
                        next-name: root.prayer-next-name;
                        next-time: root.prayer-next-time;
                        countdown: root.prayer-countdown;
                        status: root.prayer-status;
                        ramadan: root.ramadan-enabled;
                        ramadan-date: root.ramadan-date;
                        imsak-countdown: root.ramadan-imsak-countdown;
                        buka-countdown: root.ramadan-buka-countdown;
                        imsak-time: root.ramadan-imsak-time;
                        buka-time: root.ramadan-buka-time;
                        mode: root.prayer-mode;
                        remind-before: root.prayer-remind-before == "true";
                        remind-min: root.prayer-remind-min;
                        dhikr-arabic: root.dhikr-arabic;
                        dhikr-latin: root.dhikr-latin;
                        dhikr-meaning: root.dhikr-meaning;
                        refresh => { root.prayer-refresh(); }
                        set-mode(v) => { root.prayer-set-mode(v); }
                        set-remind(v) => { root.prayer-set-remind(v); }
                        set-remind-min(v) => { root.prayer-set-remind-min(v); }
                        toggle-ramadan => { root.prayer-toggle-ramadan(); }
                        dhikr-next => { root.prayer-dhikr-next(); }
                    }
                    if root.page-id == "android": AndroidPage {
                        status: root.android-status;
                        devices: root.android-devices;
                        entries: root.android-entries;
                        current-path: root.android-path;
                        selected-serial: root.android-serial;
                        refresh => { root.android-refresh(); }
                        list(path) => { root.android-list(path); }
                        push(serial, path) => { root.android-push(serial, path); }
                        pull(path) => { root.android-pull(path); }
                        select-device(serial) => { root.android-select-device(serial); }
                        mirror => { root.android-mirror(); }
                        stop-mirror => { root.android-stop-mirror(); }
                    }
                    if root.page-id == "transfer": TransferPage {
                        status: root.transfer-status;
                        address: root.transfer-address;
                        shared-count-text: root.transfer-shared-count-text;
                        start-server => { root.transfer-start(); }
                        stop => { root.transfer-stop(); }
                        add-files => { root.transfer-add-files(); }
                        open-inbox => { root.transfer-open-inbox(); }
                    }
                    if root.page-id == "convert": ConvertPage {
                        file-path: root.convert-selected-path;
                        overrides-text: root.convert-overrides-text;
                        status: root.convert-status;
                        history-text: root.convert-history-text;
                        files-text: root.convert-files-text;
                        output-dir-text: root.convert-output-dir-text;
                        eta-text: root.convert-eta-text;
                        queue-text: root.convert-queue-text;
                        progress-value: root.convert-progress-value;
                        progress-text: root.convert-progress-text;
                        preview-page-text: root.convert-preview-page-text;
                        preview-status: root.convert-preview-status;
                        preview-zoom-text: root.convert-preview-zoom-text;
                        source-preview: root.convert-source-preview;
                        result-preview: root.convert-result-preview;
                        run(path, format, quality, dpi, overrides) => { root.convert-run(path, format, quality, dpi, overrides); }
                        pick-file => { root.convert-pick(); }
                        preview-prev => { root.convert-preview-prev(); }
                        preview-next => { root.convert-preview-next(); }
                        preview-zoom-in => { root.convert-preview-zoom-in(); }
                        preview-zoom-out => { root.convert-preview-zoom-out(); }
                        reveal => { root.convert-reveal(); }
                        cancel => { root.convert-cancel(); }
                        pause => { root.convert-pause(); }
                        resume => { root.convert-resume(); }
                        clear-queue => { root.convert-clear-queue(); }
                        remove-queue-file(value) => { root.convert-remove-queue-file(value); }
                        retry-failed => { root.convert-retry-failed(); }
                        retry-one-failed(value) => { root.convert-retry-one-failed(value); }
                        cancel-one-file(value) => { root.convert-cancel-one-file(value); }
                        add-files => { root.convert-add-files(); }
                        move-queue-file(value, direction) => { root.convert-move-queue-file(value, direction); }
                        remove-finished => { root.convert-remove-finished(); }
                        export-history => { root.convert-history-export(); }
                        clear-history => { root.convert-history-clear(); }
                        pick-output-dir => { root.convert-output-dir-pick(); }
                    }
                    if root.page-id == "compress": CompressPage {
                        status: root.compress-status;
                        file-path: root.compress-selected-path;
                        run(path) => { root.compress-run(path); }
                        pick-file => { root.compress-pick(); }
                    }
                    if root.page-id == "media": MediaPage {
                        width: parent.width;
                        height: parent.height;
                        lyrics-open <=> root.lyrics-open; lyric-lines: root.lyric-lines; lyric-active: root.lyric-active;
                        art: root.media-art; has-art: root.media-has-art; title: root.media-title; artist: root.media-artist;
                        pos-text: root.media-pos-text; dur-text: root.media-dur-text; progress: root.media-progress; playing: root.media-playing;
                        prev => { root.media-control("prev"); } toggle => { root.media-control("toggle"); } next => { root.media-control("next"); }
                        seek(v) => { root.media-seek(v * root.media-length); }
                    }
                    if root.page-id == "clock" && !root.cal-open: ClockPage {
                        clock-text: root.clock-text;
                        sec-text: root.sec-text;
                        day-text: root.day-text;
                        date-text: root.date-text;
                        open-calendar => { root.cal-open = true; root.cal-opened(); }
                    }
                    if root.page-id == "clock" && root.cal-open: CalendarPage {
                        cells: root.cal-cells;
                        weekdays: root.cal-weekdays;
                        title: root.cal-title;
                        foot-date: root.cal-foot-date;
                        foot-name: root.cal-foot-name;
                        foot-kind: root.cal-foot-kind;
                        prev => { root.cal-prev(); }
                        next => { root.cal-next(); }
                        today => { root.cal-today(); }
                        select(i) => { root.cal-select(i); }
                        close => { root.cal-open = false; }
                    }
                    if root.page-id == "timer": TimerPage {
                        pomo-text: root.pomo-text;
                        pomo-label: root.pomo-label;
                        pomo-progress: root.pomo-progress;
                        pomo-running: root.pomo-running;
                        pomo-rest: root.pomo-rest;
                        toggle => { root.toggle-pomo(); }
                        reset => { root.reset-pomo(); }
                        skip => { root.skip-pomo(); }
                    }
                    if root.page-id == "stats": StatsPage { d: root.stats; }
                    if root.page-id == "battery": BatteryPage { present: root.battery-present; percent: root.battery-percent; charging: root.battery-charging; }
                    if root.page-id == "shelf": ShelfPage {
                        items: root.shelf-items;
                        status: root.shelf-status;
                        dropping: root.shelf-dropping;
                        add => { root.shelf-add(); }
                        open(path) => { root.shelf-open(path); }
                        reveal(path) => { root.shelf-reveal(path); }
                        drag(path) => { root.shelf-drag(path); }
                        remove(path) => { root.shelf-remove(path); }
                        clear => { root.shelf-clear(); }
                    }
                    if root.page-id == "currency": CurrencyPage {
                        width: parent.width;
                        height: parent.height;
                        d: root.currency;
                        amount <=> root.currency-amount;
                        gainers: root.stock-gainers;
                        losers: root.stock-losers;
                        alerts: root.currency-alerts;
                        currencies: root.currency-items;
                        chart-points: root.fx-chart-points;
                        refresh => { root.currency-refresh(); }
                        amount-edited(t) => { root.currency-amount-edited(t); }
                        quick(i) => { root.currency-quick(i); }
                        step-target(n) => { root.currency-step-target(n); }
                        add-alert(up, t, stock, code, repeat) => { root.currency-add-alert(up, t, stock, code, repeat); }
                        remove-alert(id) => { root.currency-remove-alert(id); }
                        chart-request(code, days) => { root.currency-chart-request(code, days); }
                        select-currency(code, days) => { root.currency-select-target(code, days); }
                        expanded <=> root.currency-expanded;
                        chart-line: root.fx-chart-line;
                        chart-area: root.fx-chart-area;
                        chart-status: root.fx-chart-status;
                        chart-max: root.fx-chart-max;
                        chart-y1: root.fx-chart-y1;
                        chart-y2: root.fx-chart-y2;
                        chart-min: root.fx-chart-min;
                        chart-date-start: root.fx-chart-date-start;
                        chart-date-mid: root.fx-chart-date-mid;
                        chart-date-end: root.fx-chart-date-end;
                        chart-dot-y: root.fx-chart-dot-y;
                        chart-last: root.fx-chart-last;
                        chart-change: root.fx-chart-change;
                        chart-up: root.fx-chart-up;
                    }
                    if root.page-id == "notes": NotesPage {
                        notes: root.notes;
                        add(t) => { root.add-note(t); }
                        remove(id) => { root.remove-note(id); }
                        open(id) => { root.open-note(id); }
                        clear => { root.clear-notes(); }
                        expand-toggled(v) => { root.notes-expand-toggled(v); }
                        expanded <=> root.notes-expanded;
                    }
                    if root.page-id == "weather": WeatherPage {
                        refresh => { root.weather-refresh(); }
                        city: root.weather-city;
                        temperature: root.weather-temp;
                        condition: root.weather-condition;
                        feels: root.weather-feels;
                        humidity: root.weather-humidity;
                        rain: root.weather-rain;
                        icon: root.weather-icon;
                        status: root.weather-status;
                    }
                    if root.page-id == "reminder": ReminderPage {
                        items: root.reminders;
                        compact: root.media-playing && root.nudge-visible;
                        media-playing: root.media-playing;
                        nudge-visible: root.nudge-visible;
                        alert-visible: root.reminder-alert-visible;
                        alert-text: root.reminder-alert-text;
                        alert-sub: root.reminder-alert-sub;
                        status: root.reminder-status;
                        weekdays-mask: root.reminder-weekdays-mask;
                        weekday-selected: root.reminder-weekday-selected;
                        draft <=> root.reminder-draft;
                        date-time <=> root.reminder-date-time;
                        repeat-mode <=> root.reminder-repeat-mode;
                        add(text, date-time, repeat-mode, weekdays-mask) => { root.reminder-add(text, date-time, repeat-mode, weekdays-mask); }
                        toggle(id) => { root.reminder-toggle(id); }
                        remove(id) => { root.reminder-remove(id); }
                        clear-done => { root.reminder-clear-done(); }
                        stop-alert => { root.reminder-stop-alert(); }
                        snooze-alert => { root.reminder-snooze-alert(); }
                        toggle-weekday(i) => { root.reminder-toggle-weekday(i); }
                    }
                    if root.page-id == "clipboard": ClipboardPage {
                        items: root.clipboard-items;
                        available: root.clipboard-available;
                        copy(text) => { root.clipboard-copy(text); }
                        clear => { root.clipboard-clear(); }
                    }
                    if root.page-id == "quick": QuickPage {
                        mic: root.q-mic; wifi: root.q-wifi; bt: root.q-bt;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "tools": ToolsPage {
                        awake: root.q-awake; dark: root.q-dark;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "uji": RenderTestPage { coffee: root.emoji-coffee; tomato: root.emoji-tomato; moon: root.emoji-moon; }
                    if root.page-id != "settings" && root.page-id != "media" && root.page-id != "clock" && root.page-id != "timer"
                        && root.page-id != "stats" && root.page-id != "battery" && root.page-id != "notes"
                        && root.page-id != "weather" && root.page-id != "reminder" && root.page-id != "clipboard" && root.page-id != "shelf" && root.page-id != "quick" && root.page-id != "tools" && root.page-id != "privacy" && root.page-id != "prayer" && root.page-id != "currency" && root.page-id != "uji":
                        PlaceholderPage { name: root.page-id; }
                }
            }

            // Pesan (nudge / alert kurs-saham / pengingat) di dalam badan notch untuk dock atas.
            if root.nudge-inline: Rectangle {
                width: parent.width;
                height: parent.height;
                if root.nudge-visible: NudgeEmoji {
                    x: root.media-playing ? 8px : 16px;
                    y: root.media-playing ? 8px : 17px;
                    width: root.media-playing ? 24px : 34px;
                    height: root.media-playing ? 24px : 34px;
                    emoji: root.nudge-emoji;
                    rendered-image: root.nudge-emoji-image;
                    rendered-image-available: root.nudge-emoji-image-available;
                }
                if !root.nudge-visible: Rectangle {
                    x: 16px; y: 17px; width: 34px; height: 34px;
                    border-radius: 17px;
                    background: Theme.accent.with-alpha(0.14);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.62);
                    Rectangle {
                        x: 12px; y: 12px; width: 10px; height: 10px;
                        border-radius: 5px; background: Theme.accent;
                    }
                }
                Text {
                    x: root.media-playing && root.nudge-visible ? 40px : 60px;
                    y: root.media-playing && root.nudge-visible ? 5px : 9px;
                    width: root.media-playing && root.nudge-visible ? 170px : 212px;
                    height: 30px;
                    text: root.nudge-visible ? root.nudge-message : root.reminder-alert-text;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
                Text {
                    x: 60px;
                    y: 40px;
                    width: 212px;
                    height: 20px;
                    visible: !(root.media-playing && root.nudge-visible);
                    text: root.nudge-visible ? root.nudge-detail : root.reminder-alert-sub;
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            // Indikator privasi ala Tauri. Dock atas: kanan sejajar mata (tengah untuk jam/musik, titik kecil saat hub terbuka).
            // Dock bawah/samping: di bagian paling atas badan, di atas mata.
            if (root.priv-mic || root.priv-cam) && !root.dragging && !root.inline-msg: PrivacyIndicator {
                mic: root.priv-mic;
                cam: root.priv-cam;
                dot: root.expanded;
                ui-scale: root.expanded ? 1.0 : root.ui-scale;
                size: root.expanded ? 7px : (root.dock >= 2 ? 13px : 16px) * root.ui-scale;
                x: root.expanded ? (parent.width - self.width) / 2
                    : (root.dock == 3 ? 4px * root.ui-scale
                    : (root.dock == 4 ? parent.width - self.width - 4px * root.ui-scale
                    : (root.dock == 2 || root.idle-clock || root.media-mini ? (parent.width - self.width) / 2
                    : parent.width - self.width - 8px * root.ui-scale)));
                y: root.expanded ? 6px : (root.dock >= 3 ? 14px * root.ui-scale : (root.dock == 2 ? 3px * root.ui-scale : (parent.height - self.height) / 2));
            }
        }
    }

    // Tombol "Pusatkan": melayang di luar badan notch, 8 px di bawahnya (di atasnya bila menempel dasar
    // layar), muncul bersama hub. TouchArea mencakup celah ke pil supaya kursor yang menyeberang tidak
    // dianggap keluar; piksel hampir transparan memastikan jendela berlapis tetap menerima kursor di celah.
    pos-zone := TouchArea {
        property <length> gap: 8px;
        width: 104px;
        height: self.gap + 22px;
        x: (root.width - self.width) / 2;
        y: root.dock == 2 ? pill.y - self.height : pill.y + pill.height;
        enabled: root.expanded;
        mouse-cursor: pointer;
        clicked => { root.quick-toggle("center"); }

        Rectangle { background: #00000001; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.dock == 2 ? 0px : parent.gap;
            width: 94px;
            height: 22px;
            border-radius: 11px;
            background: pos-zone.has-hover ? #20202af2 : #121216e6;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(pos-zone.has-hover ? 0.9 : 0.5);
            // Saat menciut chip harus lenyap cepat: kalau memudar 180 ms ia tertinggal di bawah notch.
            opacity: root.expanded ? root.pill-fade : 0;
            animate opacity { duration: root.expanded ? 180ms : 90ms; }
            animate background { duration: 120ms; }
            Path {
                x: 9px;
                y: 5px;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 V 8 M 12 16 V 21 M 3 12 H 8 M 16 12 H 21 M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10";
                fill: transparent;
                stroke: Theme.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
            }
            Text {
                x: 26px;
                height: parent.height;
                text: "Pusatkan";
                color: Theme.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // Balon berada di luar pill agar tidak terpotong oleh clip:true. Ruang ekstra disediakan saat menciut.
    if root.dock >= 2 && !root.expanded && !root.geometry-hold && !root.greeting-inline-visible && (root.reminder-alert-visible || root.adhan-active || root.meeting-finished != "" || root.greeting-speech-visible || root.nudge-visible): SpeechBubble {
        compact: root.media-playing && root.nudge-visible;
        width: root.media-playing && root.nudge-visible ? 184px : 224px;
        // Jarak 11 px dari notch: ekor (sekitar 8,5 px) berakhir tepat di depan badan notch.
        x: root.dock == 3 ? pill.x + pill.width + 11px : (root.dock == 4 ? pill.x - 11px - self.width : (root.width - self.width) / 2);
        y: root.dock >= 3 ? Math.max(0px, Math.min(root.height - self.height, pill.y + pill.height / 2 - self.height / 2)) : pill.y - 11px - self.height;
        side: root.dock >= 3;
        side-right: root.dock == 4;
        tail-pos: root.dock >= 3 ? pill.y + pill.height / 2 - self.y : pill.x + pill.width / 2 - self.x;
        message: root.adhan-active ? ("Waktu " + root.adhan-prayer) : (root.meeting-finished != "" ? "Rapat selesai" : (root.greeting-speech-visible ? root.greeting-message : (root.nudge-visible ? root.nudge-message : root.reminder-alert-text)));
        detail: root.adhan-active ? "Adzan sedang diputar" : (root.meeting-finished != "" ? root.meeting-finished : (root.greeting-speech-visible ? root.greeting-detail : (root.nudge-visible ? root.nudge-detail : root.reminder-alert-sub)));
        emoji: root.nudge-visible ? root.nudge-emoji : "";
        emoji-image: root.nudge-emoji-image;
        emoji-image-available: root.nudge-emoji-image-available;
    }

    // Telinga cekung: atas/bawah mengapit pil secara horizontal; dock samping mengapitnya secara vertikal.
    Ear { s: root.ui-scale; visible: root.dock == 0 || root.dock == 2; opacity: root.pill-fade; kind: root.dock == 2 ? 2 : 0; x: pill.x - 10px * root.ui-scale; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; }
    Ear { s: root.ui-scale; visible: root.dock == 0 || root.dock == 2; opacity: root.pill-fade; kind: root.dock == 2 ? 3 : 1; x: pill.x + pill.width - 1px * root.ui-scale; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; }
    Ear { s: root.ui-scale; visible: (root.dock == 3 || root.dock == 4) && !root.dragging; opacity: root.pill-fade; kind: root.dock == 3 ? 4 : 6; x: root.dock == 3 ? 0px : root.width - 10px * root.ui-scale; y: pill.y - 10px * root.ui-scale; }
    Ear { s: root.ui-scale; visible: (root.dock == 3 || root.dock == 4) && !root.dragging; opacity: root.pill-fade; kind: root.dock == 3 ? 5 : 7; x: root.dock == 3 ? 0px : root.width - 10px * root.ui-scale; y: pill.y + pill.height; }
}

// Jendela detail catatan (setara note-detail.html di Tauri): toolbar, editor, status bar, toast.
export component NoteDetailWindow inherits Window {
    title: "Catatan";
    preferred-width: 680px;
    preferred-height: 520px;
    min-width: 400px;
    min-height: 300px;
    background: root.bg;
    in property <color> bg: #0f0f11;
    in property <color> fg: #f0f0f2;
    in property <color> accent: #3b82f6;
    in property <string> meta;
    in-out property <string> text;
    in property <string> chars: "0 karakter";
    in property <string> lines: "0 baris";
    in property <bool> dirty: false;
    in property <bool> can-save: false;
    in property <bool> confirm-delete: false;
    in property <string> toast;
    callback edited(string);
    callback save();
    callback delete();
    callback esc();

    FocusScope {
        capture-key-pressed(event) => {
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) { root.save(); return accept; }
            if (event.text == Key.Escape) { root.esc(); return accept; }
            return reject;
        }
        VerticalLayout {
            Rectangle {
                height: 53px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    Text { text: "CATATAN"; color: root.fg.with-alpha(0.5); font-size: 13px; font-weight: 600; letter-spacing: 0.3px; vertical-alignment: center; }
                    Text { text: root.meta; color: root.fg.with-alpha(0.35); font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
                    Rectangle {
                        width: 74px;
                        height: 30px;
                        border-radius: 8px;
                        background: root.confirm-delete ? #ef4444 : (del-ta.has-hover ? #ef444447 : #ef444426);
                        Text { text: root.confirm-delete ? "Yakin?" : "Hapus"; color: root.confirm-delete ? #ffffff : #ef4444; font-size: 12.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        del-ta := TouchArea { clicked => { root.delete(); } }
                    }
                    Rectangle {
                        width: 78px;
                        height: 30px;
                        border-radius: 8px;
                        background: root.accent.with-alpha(save-ta.has-hover && root.can-save ? 1.0 : 0.85);
                        opacity: root.can-save ? 1.0 : 0.35;
                        Text { text: "Simpan"; color: #ffffff; font-size: 12.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        save-ta := TouchArea { enabled: root.can-save; clicked => { root.save(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: root.fg.with-alpha(0.10); }
            }
            Rectangle {
                vertical-stretch: 1;
                flick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-height: max(self.height, editor.preferred-height + 36px);
                    editor := TextInput {
                        x: 18px;
                        y: 16px;
                        width: parent.width - 36px;
                        height: max(flick.height - 32px, self.preferred-height);
                        text <=> root.text;
                        color: root.fg;
                        font-size: 15px;
                        wrap: word-wrap;
                        single-line: false;
                        edited => { root.edited(self.text); }
                        init => { self.focus(); }
                        cursor-position-changed(p) => {
                            if (p.y + flick.content-y < 0px) { flick.content-y = -p.y; }
                            else if (p.y + 26px + flick.content-y > flick.height) { flick.content-y = flick.height - p.y - 26px; }
                        }
                    }
                }
                if root.text == "": Text { x: 18px; y: 16px; text: "Tulis catatan di sini\u{2026}"; color: root.fg.with-alpha(0.3); font-size: 15px; }
                if root.toast != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 14px;
                    width: toast-text.preferred-width + 28px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.fg.with-alpha(0.92);
                    toast-text := Text { text: root.toast; color: root.bg; font-size: 12.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 28px;
                Rectangle { y: 0px; height: 1px; background: root.fg.with-alpha(0.10); }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: root.chars; color: root.fg.with-alpha(0.5); font-size: 11px; vertical-alignment: center; }
                    Text { text: root.dirty ? "\u{25CF} Belum disimpan" : ""; color: root.accent; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.lines; color: root.fg.with-alpha(0.5); font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
                }
            }
        }
    }
}
