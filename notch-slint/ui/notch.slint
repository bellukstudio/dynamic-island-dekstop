// Indikator privasi ala Tauri (privacy.css): lencana bulat, hijau = kamera, oranye = mikrofon,
// ikon gelap di dalam dan cincin berdenyut. Mode `dot` hanya titik kecil (dipakai saat hub terbuka).
component PrivacyBadge inherits Rectangle {
    in property <color> tone;
    in property <string> icon;
    in property <length> size: 16px;
    in property <bool> dot: false;
    in property <float> pulse: 0.0;
    in property <float> ui-scale: 1.0;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tone;
    Rectangle {
        x: -(2px + 2.5px * root.pulse) * root.ui-scale;
        y: -(2px + 2.5px * root.pulse) * root.ui-scale;
        width: root.size + 2 * (2px + 2.5px * root.pulse) * root.ui-scale;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5px * root.ui-scale;
        border-color: root.tone.with-alpha(0.34 - 0.24 * root.pulse);
    }
    if !root.dot: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.64;
        height: root.size * 0.64;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: #000000c7;
        stroke-width: root.size * 0.11;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component PrivacyIndicator inherits Rectangle {
    in property <bool> mic: false;
    in property <bool> cam: false;
    in property <length> size: 16px;
    in property <bool> dot: false;
    in property <float> ui-scale: 1.0;
    property <length> gap: (root.dot ? 3px : 5px) * root.ui-scale;
    property <int> count: (root.mic ? 1 : 0) + (root.cam ? 1 : 0);
    // Hanya dievaluasi saat indikator tampil, jadi tidak membuat render terus-menerus saat tidak ada aktivitas.
    property <float> pulse: 0.5 - 0.5 * Math.cos(Math.mod(animation-tick() / 1ms, 2000.0) / 2000.0 * 360deg);
    width: root.count * root.size + (root.count > 1 ? root.gap : 0px);
    height: root.size;
    if root.cam: PrivacyBadge {
        x: 0px;
        tone: #30d158;
        icon: Icons.badge-cam;
        size: root.size;
        dot: root.dot;
        pulse: root.pulse;
        ui-scale: root.ui-scale;
    }
    if root.mic: PrivacyBadge {
        x: root.cam ? root.size + root.gap : 0px;
        tone: #ff9f0a;
        icon: Icons.badge-mic;
        size: root.size;
        dot: root.dot;
        pulse: root.pulse;
        ui-scale: root.ui-scale;
    }
}

// Kartu sensor (mikrofon / kamera) pada Privacy Hub.
component PrivacySensor inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> state-on: "Sedang digunakan";
    in property <string> state-off: "Tidak aktif";
    in property <bool> on: false;
    in property <color> tone: #e5a84b;
    border-radius: 14px;
    background: root.on ? root.tone.with-alpha(0.14) : #ffffff0b;
    border-width: 1px;
    border-color: root.on ? root.tone.with-alpha(0.5) : #ffffff14;
    animate background { duration: 220ms; }
    animate border-color { duration: 220ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            width: 34px;
            alignment: center;
            Rectangle {
            height: 34px;
            border-radius: 11px;
            background: root.on ? root.tone.with-alpha(0.26) : Theme.chip;
            animate background { duration: 220ms; }
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: root.on ? root.tone : Theme.text-dim;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.label; color: Theme.text; font-size: 12px; font-weight: 700; overflow: elide; }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                VerticalLayout {
                    width: 6px;
                    alignment: center;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: root.on ? root.tone : Theme.text-faint;
                    }
                }
                Text {
                    text: root.on ? root.state-on : root.state-off;
                    color: root.on ? root.tone : Theme.text-faint;
                    font-size: 9.5px;
                    font-weight: root.on ? 700 : 500;
                    overflow: elide;
                }
            }
        }
    }
}

// Privacy Hub: perisai berdenyut + status, kartu mikrofon/kamera, dan durasi sesi.
// Hanya memakai `active` / `source` / `elapsed` dari monitor di privacy.rs (tanpa perubahan Rust).
// Area halaman 580 x 148 px, jadi tata letaknya horizontal.
component PrivacyPage inherits Rectangle {
    in property <bool> active: false;
    in property <string> source: "";
    in property <string> elapsed: "00:00";
    property <bool> mic-on: root.active && (root.source == "MIC" || root.source == "MIC + CAM");
    property <bool> cam-on: root.active && (root.source == "CAM" || root.source == "MIC + CAM");
    property <color> tone: root.active ? #e5a84b : Theme.ok;
    // Hanya berjalan saat aktif, jadi tidak membuat render terus-menerus ketika aman.
    property <float> phase: Math.mod(animation-tick() / 1ms, 1800.0) / 1800.0;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 4px;
        padding-bottom: 10px;
        spacing: 12px;

        // Kiri: perisai
        Rectangle {
            width: 146px;
            border-radius: 18px;
            // Warna solid (rata-rata gradien lama 0.26 -> 0.05): renderer software mengabaikan border-radius pada gradien,
            // sehingga latar keluar dari garis border.
            background: root.tone.with-alpha(0.15);
            border-width: 1px;
            border-color: root.tone.with-alpha(0.38);
            clip: true;
            animate background { duration: 300ms; }

            if root.active: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px + (68px - self.height) / 2;
                width: 42px + 14px * root.phase;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: root.tone.with-alpha(0.55 * (1.0 - root.phase));
            }
            if root.active: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px + (68px - self.height) / 2;
                width: 42px + 14px * Math.mod(root.phase + 0.5, 1.0);
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: root.tone.with-alpha(0.4 * (1.0 - Math.mod(root.phase + 0.5, 1.0)));
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px;
                width: 68px;
                height: 68px;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 23px;
                    background: root.tone.with-alpha(0.22);
                }
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.privacy;
                    fill: root.tone.with-alpha(0.18);
                    stroke: root.tone;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 + 1px;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.active ? "M 12 8 V 13 M 12 16.2 L 12.01 16.2" : "M 8.5 12 L 11 14.5 L 15.5 9.5";
                    fill: transparent;
                    stroke: root.tone;
                    stroke-width: 2.2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
            VerticalLayout {
                y: 80px;
                height: parent.height - 80px;
                alignment: start;
                spacing: 1px;
                Text { text: root.active ? "AKTIF" : "AMAN"; color: root.tone; font-size: 14px; font-weight: 800; horizontal-alignment: center; letter-spacing: 1.5px; }
                Text { text: root.active ? "Sensor sedang dipakai" : "Tidak ada sensor aktif"; color: Theme.text-dim; font-size: 9px; horizontal-alignment: center; }
            }
        }

        // Kanan: judul, sensor, durasi
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                Text { text: "Privacy Hub"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    width: badge-text.preferred-width + 20px;
                    Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: root.tone.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.tone.with-alpha(0.4);
                    badge-text := Text {
                        text: root.active ? (root.source == "" ? "RAPAT" : root.source) : "TERLINDUNGI";
                        color: root.tone;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                PrivacySensor {
                    horizontal-stretch: 1;
                    icon: Icons.mic;
                    label: "Mikrofon";
                    on: root.mic-on;
                    tone: #e5a84b;
                }
                PrivacySensor {
                    horizontal-stretch: 1;
                    icon: Icons.camera;
                    label: "Kamera";
                    on: root.cam-on;
                    tone: #ef6b73;
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 12px;
                background: #ffffff0b;
                if root.active: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text { text: "DURASI SESI"; color: Theme.text-faint; font-size: 9px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.elapsed; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                }
                if !root.active: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: "Mendeteksi sesi audio aktif dan sensor kamera Windows. Status diperbarui otomatis.";
                        color: Theme.text-faint;
                        font-size: 9px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
component PrayerSeg inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked;
    preferred-width: seg-text.preferred-width + 14px;
    min-width: seg-text.preferred-width + 14px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.text.with-alpha(0.2) : transparent;
    seg-text := Text {
        text: root.label;
        color: root.on || ta.has-hover ? Theme.text : Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PrayerPage inherits VerticalLayout {
    in property <[PrayerItem]> items;
    in property <[PrayerItem]> imsakiyah;
    in property <string> next-name: "Memuat jadwal...";
    in property <string> next-time: "--:--";
    in property <string> next-when: "";
    in property <string> countdown: "--:--:--";
    in property <string> meta: "Imsak --:-- \u{00B7} Terbit --:--";
    in property <string> city: "";
    in property <string> status: "";
    in property <bool> ramadan: false;
    in property <string> ramadan-date: "";
    in property <string> imsak-countdown: "--:--:--";
    in property <string> buka-countdown: "--:--:--";
    in property <string> imsak-time: "";
    in property <string> buka-time: "";
    in property <string> mode: "tone";
    in property <bool> remind-before: true;
    in property <string> remind-min: "10";
    in property <string> dhikr-arabic: "";
    in property <string> dhikr-latin: "";
    in property <string> dhikr-meaning: "";
    in property <int> dhikr-idx: 0;
    callback refresh();
    callback set-mode(string);
    callback set-remind(bool);
    callback set-remind-min(int);
    callback toggle-ramadan();
    callback dhikr-next();
    callback dhikr-prev();
    // `.p-prayer`: padding 2 26 12 24, jarak 18; kiri 176 px (hitung mundur + kota), kanan (busur + kontrol).
    // Tombol Ramadan memperluas hub (780 x 540) dan menampilkan panel sahur/buka, imsakiyah, dzikir.
    padding-left: 24px;
    padding-right: 26px;
    padding-top: 2px;
    padding-bottom: 12px;
    spacing: 10px;

    HorizontalLayout {
        spacing: 14px;
        vertical-stretch: root.ramadan ? 0 : 1;
        min-height: 104px;
        VerticalLayout {
            width: 160px;
            alignment: space-between;
            padding-top: 2px;
            VerticalLayout {
                spacing: 2px;
                Text { text: root.next-name; color: Theme.accent; font-size: 14px; font-weight: 700; overflow: elide; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.countdown; color: Theme.text; font-size: 27px; font-weight: 700; vertical-alignment: bottom; }
                    VerticalLayout {
                        alignment: end;
                        Text { text: root.next-time; color: Theme.text; font-size: 13px; font-weight: 700; }
                        Text { text: root.next-when; color: Theme.text-faint; font-size: 10.5px; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    Text { text: root.city; color: Theme.text; font-size: 12.5px; font-weight: 700; overflow: elide; }
                    Text { text: root.status != "" ? root.status : "Dari config"; color: root.status != "" ? #ff8282 : Theme.text-faint; font-size: 10.5px; overflow: elide; }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: 0px;
                    border-radius: 8px;
                    background: rf-ta.has-hover ? Theme.chip-hover : Theme.chip;
                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 13px;
                        height: 13px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.reset;
                        fill: transparent;
                        stroke: Theme.text;
                        stroke-width: 1.5px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                    rf-ta := TouchArea { clicked => { root.refresh(); } }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: space-between;
            Text { text: root.meta; color: Theme.text-dim; font-size: 11px; horizontal-alignment: right; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 70px;
                    // Busur titik-titik (dasar `.pr-path`), titik 5 waktu shalat, dan label di bawahnya.
                    for k in 29: Rectangle {
                        x: k / 28 * 300px - 1px;
                        y: 31px - 22px * Math.sin(k / 28 * 180deg) - 1px;
                        width: 2px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.text.with-alpha(0.35);
                    }
                    for item[i] in root.items: Rectangle {
                        x: (i + 0.5) / 5 * 300px - self.width / 2;
                        y: 31px - 22px * Math.sin((i + 0.5) / 5 * 180deg) - self.height / 2;
                        width: item.state == 1 ? 14px : 8px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: item.state == 1 ? Theme.accent.with-alpha(0.25) : (item.state == 2 ? Theme.text.with-alpha(0.25) : Theme.text.with-alpha(0.55));
                        border-width: item.state == 1 ? 1.5px : 0px;
                        border-color: Theme.accent;
                        if item.state == 1: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                    }
                    for item[i] in root.items: VerticalLayout {
                        x: i * 60px;
                        y: 36px;
                        width: 60px;
                        height: 32px;
                        alignment: start;
                        opacity: item.state == 2 ? 0.35 : (item.state == 1 ? 1.0 : 0.65);
                        Text { text: item.name; color: item.state == 1 ? Theme.accent : Theme.text; font-size: 10.5px; horizontal-alignment: center; }
                        Text { text: item.time; color: Theme.text; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 28px;
                Rectangle {
                    preferred-width: segs.preferred-width + 4px;
                    min-width: segs.min-width + 4px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.chip;
                    segs := HorizontalLayout {
                        padding: 2px;
                        PrayerSeg { label: "Adzan"; on: root.mode == "adzan"; clicked => { root.set-mode("adzan"); } }
                        PrayerSeg { label: "Nada"; on: root.mode == "tone"; clicked => { root.set-mode("tone"); } }
                        PrayerSeg { label: "Senyap"; on: root.mode == "silent"; clicked => { root.set-mode("silent"); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.remind-min + " mnt sebelum";
                        color: Theme.text-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                        TouchArea { clicked => { root.set-remind-min(5); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 15px;
                            border-radius: 8px;
                            background: root.remind-before ? Theme.accent : Theme.chip;
                            Rectangle {
                                x: root.remind-before ? parent.width - self.width - 2px : 2px;
                                y: 2px;
                                width: 11px;
                                height: 11px;
                                border-radius: 6px;
                                background: root.remind-before ? #000000 : Theme.text-dim;
                                animate x { duration: 120ms; }
                            }
                            TouchArea { clicked => { root.set-remind(!root.remind-before); } }
                        }
                    }
                }
                Rectangle {
                    preferred-width: rm-row.preferred-width;
                    min-width: rm-row.min-width;
                    max-width: rm-row.preferred-width;
                    horizontal-stretch: 0;
                    height: 28px;
                    border-radius: 14px;
                    background: root.ramadan ? Theme.accent.with-alpha(0.3) : (rm-ta.has-hover ? Theme.chip-hover : Theme.chip);
                    rm-row := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        padding-left: 10px;
                        padding-right: 10px;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 13px;
                                height: 13px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z";
                                fill: root.ramadan ? Theme.accent : transparent;
                                stroke: root.ramadan ? Theme.accent : Theme.text;
                                stroke-width: 1.8px;
                                stroke-line-join: round;
                            }
                        }
                        Text { text: "Ramadan"; color: root.ramadan ? Theme.accent : Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    }
                    rm-ta := TouchArea { clicked => { root.toggle-ramadan(); } }
                }
            }
        }
    }

    if root.ramadan: VerticalLayout {
        vertical-stretch: 1;
        spacing: 10px;
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Path {
                width: 20px;
                height: 20px;
                y: 10px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z";
                fill: Theme.accent;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Mode Ramadan"; color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { text: "Hitung mundur sahur dan buka puasa, imsakiyah, serta dzikir setelah adzan."; color: Theme.text-faint; font-size: 11px; overflow: elide; }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 17px;
                        border-radius: 9px;
                        background: Theme.accent;
                        Rectangle { x: parent.width - self.width - 2px; y: 2px; width: 13px; height: 13px; border-radius: 7px; background: #000000; }
                        TouchArea { clicked => { root.toggle-ramadan(); } }
                    }
                }
                Text { text: "Aktif"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            height: 74px;
            spacing: 12px;
            for c[i] in [0, 1]: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                border-radius: 14px;
                border-width: 1px;
                border-color: #50dcaa59;
                background: #14785a2b;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        width: 28px;
                        alignment: center;
                        Path {
                            width: 26px;
                            height: 26px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: i == 0 ? "M 12 3 a 6 6 0 0 0 9 9 a 9 9 0 1 1 -9 -9 Z" : "M 3 18 H 21 M 6.5 18 A 5.5 5.5 0 0 1 17.5 18 M 12 5 V 8 M 4.5 10.5 L 6.5 12.5 M 19.5 10.5 L 17.5 12.5";
                            fill: transparent;
                            stroke: #7dffc8;
                            stroke-width: 1.6px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text { text: i == 0 ? "Menuju Imsak (Sahur)" : "Menuju Maghrib (Buka Puasa)"; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                        Text { text: i == 0 ? root.imsak-countdown : root.buka-countdown; color: Theme.text; font-size: 22px; font-weight: 700; }
                        Text { text: i == 0 ? "Imsak " + root.imsak-time : "Maghrib " + root.buka-time; color: Theme.text-faint; font-size: 10.5px; }
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            Rectangle {
                horizontal-stretch: 1.1;
                preferred-width: 0px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.text.with-alpha(0.10);
                background: Theme.text.with-alpha(0.035);
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Imsakiyah Hari Ini"; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: root.ramadan-date; color: Theme.text-faint; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                    }
                    GridLayout {
                        spacing: 6px;
                        for item[i] in root.imsakiyah: Rectangle {
                            row: Math.floor(i / 4);
                            col: Math.mod(i, 4);
                            height: 40px;
                            border-radius: 10px;
                            background: i == 0 ? Theme.accent.with-alpha(0.22) : Theme.chip;
                            VerticalLayout {
                                alignment: center;
                                Text { text: item.name; color: i == 0 ? Theme.accent : Theme.text-dim; font-size: 10.5px; horizontal-alignment: center; }
                                Text { text: item.time; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    Text { text: "Jadwal mengikuti lokasi dan data salat yang sudah tersimpan di Notch. Countdown sahur berakhir pada waktu imsak."; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.text.with-alpha(0.10);
                background: Theme.text.with-alpha(0.035);
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Dzikir Setelah Adzan"; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: "\u{2039}"; color: Theme.text-dim; font-size: 16px; TouchArea { clicked => { root.dhikr-prev(); } } }
                        Text { text: (root.dhikr-idx + 1) + "/3"; color: Theme.text-faint; font-size: 11px; vertical-alignment: center; }
                        Text { text: "\u{203A}"; color: Theme.text-dim; font-size: 16px; TouchArea { clicked => { root.dhikr-next(); } } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 12px;
                        background: Theme.chip;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 5px;
                            alignment: center;
                            Text { text: root.dhikr-arabic; color: Theme.text; font-size: 22px; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: root.dhikr-latin; color: Theme.accent; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: root.dhikr-meaning; color: Theme.text-faint; font-size: 10.5px; horizontal-alignment: center; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for d[i] in 3: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: i == root.dhikr-idx ? Theme.accent : Theme.text.with-alpha(0.25); }
                    }
                }
            }
        }
    }
}
component PlaceholderPage inherits VerticalLayout {
    in property <string> name;
    alignment: center;
    spacing: 4px;
    Text { text: root.name; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
    Text { text: "Belum tersedia di versi Slint"; color: Theme.text-faint; font-size: 12px; horizontal-alignment: center; }
}

// Halaman uji render: teks Arab (teks asli) dan emoji (gambar). Muncul jika "uji" ada di `pages`.
component RenderTestPage inherits VerticalLayout {
    in property <image> coffee;
    in property <image> tomato;
    in property <image> moon;
    alignment: center;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image { source: root.coffee; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.tomato; width: 28px; height: 28px; image-fit: contain; }
        Image { source: root.moon; width: 28px; height: 28px; image-fit: contain; }
    }
    Text {
        text: "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ";
        color: Theme.ok;
        font-size: 22px;
        horizontal-alignment: center;
    }
}

// Equalizer 3 batang adzan. Batang diposisikan manual (bukan HorizontalLayout) supaya tengah secara vertikal.
component AdhanBars inherits Rectangle {
    in property <float> s: 1.0;
    in property <int> phase: 0;
    width: 17px * root.s;
    height: 18px * root.s;
    for i in 3: Rectangle {
        property <bool> hot: Math.mod(root.phase, 3) == i;
        width: 3px * root.s;
        height: (i == 0 ? (self.hot ? 13px : 5px) : (i == 1 ? (self.hot ? 15px : 6px) : (self.hot ? 12px : 4px))) * root.s;
        x: i * 7px * root.s;
        y: (root.height - self.height) / 2;
        background: Theme.accent;
        border-radius: 1.5px * root.s;
        animate height { duration: 110ms; }
    }
}

component AdhanStopButton inherits Rectangle {
    in property <float> s: 1.0;
    callback clicked;
    width: 22px * root.s;
    height: 22px * root.s;
    border-radius: self.width / 2;
    background: ta.has-hover ? #ffffff30 : #ffffff18;
    Text {
        width: parent.width;
        height: parent.height;
        text: "■";
        color: #ff8b8b;
        font-size: 10px * root.s;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Isi notch saat adzan diputar. Semua ukuran dikali `ui-scale` sehingga ikut skala yang diatur di pengaturan.
// Dock atas/melayang: equalizer + label "ADZAN"/nama shalat + tombol berhenti.
// Dock bawah/samping: hanya equalizer + tombol berhenti (teks tampil di SpeechBubble).
component AdhanOverlay inherits Rectangle {
    in property <int> dock: 0;
    in property <float> ui-scale: 1.0;
    in property <string> prayer;
    in property <int> phase: 0;
    callback stop();

    if root.dock < 2: HorizontalLayout {
        padding-left: 12px * root.ui-scale;
        padding-right: 8px * root.ui-scale;
        spacing: 8px * root.ui-scale;
        VerticalLayout {
            alignment: center;
            AdhanBars { s: root.ui-scale; phase: root.phase; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px * root.ui-scale;
            Text { text: "ADZAN"; color: Theme.accent; font-size: 8px * root.ui-scale; font-weight: 800; overflow: elide; }
            Text { text: root.prayer; color: Theme.text; font-size: 12px * root.ui-scale; font-weight: 700; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            AdhanStopButton { s: root.ui-scale; clicked => { root.stop(); } }
        }
    }

    // Kubah bawah 80x44: ruang terlebar ada di bagian bawah, jadi konten diturunkan sedikit.
    if root.dock == 2: Rectangle {
        y: 15px * root.ui-scale;
        width: parent.width;
        height: 24px * root.ui-scale;
        AdhanBars { s: root.ui-scale; phase: root.phase; x: (parent.width - 47px * root.ui-scale) / 2; y: (parent.height - self.height) / 2; }
        AdhanStopButton { s: root.ui-scale; x: (parent.width - 47px * root.ui-scale) / 2 + 25px * root.ui-scale; y: (parent.height - self.height) / 2; clicked => { root.stop(); } }
    }

    // Kubah samping 60x120: tersusun vertikal, dipusatkan pada bagian yang tebal.
    if root.dock >= 3: Rectangle {
        x: root.dock == 3 ? 6px * root.ui-scale : 18px * root.ui-scale;
        y: (parent.height - 50px * root.ui-scale) / 2;
        width: 36px * root.ui-scale;
        height: 50px * root.ui-scale;
        AdhanBars { s: root.ui-scale; phase: root.phase; x: (parent.width - self.width) / 2; y: 0px; }
        AdhanStopButton { s: root.ui-scale; x: (parent.width - self.width) / 2; y: 28px * root.ui-scale; clicked => { root.stop(); } }
    }
}

export component NotchWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Notch";

    in property <bool> expanded: false;
    in property <bool> adhan-active: false;
    in property <string> adhan-prayer: "";
    in property <int> adhan-phase: 0;
    in property <bool> meeting-active: false;
    in property <string> meeting-elapsed: "00:00";
    in property <string> meeting-source: "";
    in property <string> meeting-finished: "";
    // 0 = atas, 1 = melayang, 2 = bawah, 3 = kiri, 4 = kanan.
    in property <int> dock: 0;
    in property <bool> play-interaction-active: false;
    in property <bool> dragging: false;
    // True selama notch menciut dan jendela native diperkecil: notch memudar keluar, jendela diubah saat notch
    // tak terlihat (frame basi di koordinat baru jadi transparan), lalu notch memudar masuk di ukuran baru.
    in property <bool> geometry-hold: false;
    property <float> pill-fade: root.geometry-hold ? 0.0 : 1.0;
    // Hold: sembunyi seketika (0 ms) agar tidak ada sisa notch setengah transparan saat jendela di-resize.
    // Setelah menciut, notch tampil seketika (tanpa memudar) agar kedipan hanya selama jendela diubah ukurannya.
    in property <bool> hold-instant: false;
    animate pill-fade { duration: (root.geometry-hold || root.hold-instant) ? 0ms : 140ms; easing: ease-out; }
    in property <bool> suppress-next-pill-click: false;
    in property <bool> dock-play-enabled: true;
    in property <bool> play-test-request: false;
    // Skala bentuk (config `scale`): radius hub 32 px dan telinga 10 px dikalikan nilai ini, seperti di Tauri.
    in property <float> ui-scale: 1.0;
    // Gambar hiasan tema (cahaya, scan, rim) yang dirender Rust dengan mask sudut akurat.
    in property <image> decor;
    in property <bool> has-decor: false;
    in-out property <string> page-id: "media";
    in property <[string]> tabs;

    in property <string> media-title: "Tidak ada media";
    in property <string> media-artist: "Putar musik untuk memulai";
    in property <string> media-pos-text: "0:00";
    in property <string> media-dur-text: "0:00";
    in property <float> media-position: 0;
    in property <float> media-length: 0;
    in property <float> media-progress: 0;
    in property <bool> media-active: false;
    in property <bool> media-playing: false;
    in property <image> media-art;
    in property <image> media-disc-art;
    in property <bool> media-has-art: false;
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> sec-text: "00";
    in property <string> date-short: "";
    // Wajah idle berupa jam + tanggal (menggantikan mata) saat hub terakhir ditutup di halaman Jam.
    in property <bool> idle-clock: false;
    // Notch menciut saat musik diputar: pil lebar (dock atas/melayang) atau kubah berisi cover bulat (bawah/samping).
    // Dock atas/melayang: nudge dan pengingat tampil di dalam badan notch (tanpa awan percakapan).
    // Dock bawah/samping memakai SpeechBubble.
    property <bool> nudge-inline: root.dock < 2 && !root.expanded && !root.dragging && !root.greeting-inline-visible
        && !root.meeting-active && !root.adhan-active && (root.nudge-visible || root.reminder-alert-visible);
    // Adzan tampil di dalam badan notch (dock atas/melayang): pil melebar supaya teks dan tombol berhenti muat.
    property <bool> adhan-inline: root.adhan-active && root.dock < 2 && !root.expanded && !root.dragging && !root.greeting-inline-visible;
    property <bool> inline-msg: root.greeting-inline-visible || root.nudge-inline || root.adhan-inline;
    property <bool> priv-mic: root.meeting-active && (root.meeting-source == "MIC" || root.meeting-source == "MIC + CAM");
    property <bool> priv-cam: root.meeting-active && (root.meeting-source == "CAM" || root.meeting-source == "MIC + CAM");
    // Diekspos sebagai output agar Rust dapat memakai geometri mini-player yang sama dengan UI.
    out property <bool> media-mini: root.media-active && !root.expanded && !root.dragging && !root.inline-msg && !root.adhan-active;
    in property <string> day-text: "";
    in property <StatsView> stats;
    in property <CurrencyView> currency;
    in-out property <string> currency-amount;
    in-out property <bool> notes-expanded: false;
    in property <[StockRow]> stock-gainers;
    in property <[StockRow]> stock-losers;
    in property <[CurrencyAlertItem]> currency-alerts;
    in property <[CurrencyItem]> currency-items;
