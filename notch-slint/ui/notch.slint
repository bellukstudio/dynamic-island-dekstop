    in property <string> shortcut-hub: "Ctrl+Alt+N";
    in property <string> shortcut-settings: "Ctrl+Alt+,";
    in property <string> shortcut-pomodoro: "Ctrl+Alt+P";
    in property <string> shortcut-prayer: "Ctrl+Alt+A";
