                        nudge-show-ms: root.nudge-show-ms;
                        nudge-only-silent: root.nudge-only-silent;
                        nudge-until-move: root.nudge-until-move;
                        nudge-save-status: root.nudge-save-status;
                        greeting-enabled: root.greeting-enabled;
                        greeting-mode: root.greeting-mode;
                        greeting-voice: root.greeting-voice;
                        greeting-custom-text: root.greeting-custom-text;
                        greeting-save-status: root.greeting-save-status;
                        conversation-enabled: root.conversation-enabled;
                        conversation-on-play: root.conversation-on-play;
                        conversation-on-track-change: root.conversation-on-track-change;
                        conversation-on-pause: root.conversation-on-pause;
                        conversation-on-return: root.conversation-on-return;
                        conversation-on-weather-change: root.conversation-on-weather-change;
                        conversation-on-rain-soon: root.conversation-on-rain-soon;
                        conversation-on-low-battery: root.conversation-on-low-battery;
                        conversation-on-charging: root.conversation-on-charging;
                        conversation-return-after-min: root.conversation-return-after-min;
                        conversation-cooldown-min: root.conversation-cooldown-min;
                        conversation-save-status: root.conversation-save-status;
                        focus-companion-enabled: root.focus-companion-enabled;
                        focus-companion-on-start: root.focus-companion-on-start;
                        focus-companion-on-halfway: root.focus-companion-on-halfway;
                        focus-companion-on-focus-complete: root.focus-companion-on-focus-complete;
                        focus-companion-on-break-end: root.focus-companion-on-break-end;
                        focus-companion-save-status: root.focus-companion-save-status;
                        save-nudge(enabled, idle, message, emoji, mood, show, silent, until-move) => { root.settings-save-nudge(enabled, idle, message, emoji, mood, show, silent, until-move); }
                        test-nudge(message, emoji, mood, show, until-move) => { root.settings-test-nudge(message, emoji, mood, show, until-move); }
                        save-greeting(enabled, mode, voice, custom-text) => { root.settings-save-greeting(enabled, mode, voice, custom-text); }
                        test-greeting(mode, custom-text, voice) => { root.settings-test-greeting(mode, custom-text, voice); }
                        save-conversation(enabled, play, track, pause, returning, weather, rain, battery, charging, return-after, cooldown) => { root.settings-save-conversation(enabled, play, track, pause, returning, weather, rain, battery, charging, return-after, cooldown); }
                        test-conversation(message, detail) => { root.settings-test-conversation(message, detail); }
                        save-focus-companion(enabled, start, halfway, complete, break-end) => { root.settings-save-focus-companion(enabled, start, halfway, complete, break-end); }
                        test-focus-companion(message, detail) => { root.settings-test-focus-companion(message, detail); }
                        position-mode: root.position-mode;
                        save-behavior(scale, open, close, sleep, hide-fullscreen) => { root.settings-save-behavior(scale, open, close, sleep, hide-fullscreen); }
                        save-autostart(enabled) => { root.settings-save-autostart(enabled); }
                        save-position(mode) => { root.settings-save-position(mode); }
                        save-motion(enabled, interval, maximum, dock-play) => { root.settings-save-motion(enabled, interval, maximum, dock-play); }
                        test-dock-play => { root.settings-test-dock-play(); }
                        active-pages: root.active-pages;
                        hub-pages: root.hub-pages;
                        pages-save-status: root.pages-save-status;
                        save-pages(value) => { root.settings-save-pages(value); }
                        toggle-page(id, enabled) => { root.settings-toggle-page(id, enabled); }
                        prayer-province: root.prayer-province;
                        prayer-city: root.prayer-city;
                        prayer-mode: root.prayer-mode;
                        prayer-remind-before: root.prayer-remind-before;
                        prayer-remind-min: root.prayer-remind-min;
                        pomodoro-focus: root.pomodoro-focus;
                        pomodoro-break: root.pomodoro-break;
                        pomodoro-long-break: root.pomodoro-long-break;
                        pomodoro-rounds: root.pomodoro-rounds;
                        save-routines(mode, remind, minutes, focus, rest, long, rounds, province, city) => { root.settings-save-routines(mode, remind, minutes, focus, rest, long, rounds, province, city); }
                        save-status: root.settings-save-status;
                        save-shortcuts(hub, settings, pomo, prayer) => { root.settings-save-shortcuts(hub, settings, pomo, prayer); }
                        }
                    }
                    if root.page-id == "media": MediaPage {
                        width: parent.width;
                        height: parent.height;
                        lyrics-open <=> root.lyrics-open; lyric-lines: root.lyric-lines; lyric-active: root.lyric-active;
                        art: root.media-art; has-art: root.media-has-art; title: root.media-title; artist: root.media-artist;
                        pos-text: root.media-pos-text; dur-text: root.media-dur-text; progress: root.media-progress; playing: root.media-playing;
                        prev => { root.media-control("prev"); } toggle => { root.media-control("toggle"); } next => { root.media-control("next"); }
                        seek(v) => { root.media-seek(v * root.media-length); }
                    }
                    if root.page-id == "clock" && !root.cal-open: ClockPage {
                        clock-text: root.clock-text;
                        sec-text: root.sec-text;
                        day-text: root.day-text;
                        date-text: root.date-text;
                        open-calendar => { root.cal-open = true; root.cal-opened(); }
                    }
                    if root.page-id == "clock" && root.cal-open: CalendarPage {
                        cells: root.cal-cells;
                        weekdays: root.cal-weekdays;
                        title: root.cal-title;
                        foot-date: root.cal-foot-date;
                        foot-name: root.cal-foot-name;
                        foot-kind: root.cal-foot-kind;
                        prev => { root.cal-prev(); }
                        next => { root.cal-next(); }
                        today => { root.cal-today(); }
                        select(i) => { root.cal-select(i); }
                        close => { root.cal-open = false; }
                    }
                    if root.page-id == "timer": TimerPage {
                        pomo-text: root.pomo-text;
                        pomo-label: root.pomo-label;
                        pomo-progress: root.pomo-progress;
                        pomo-running: root.pomo-running;
                        pomo-rest: root.pomo-rest;
                        toggle => { root.toggle-pomo(); }
                        reset => { root.reset-pomo(); }
                        skip => { root.skip-pomo(); }
                    }
                    if root.page-id == "stats": StatsPage { d: root.stats; }
                    if root.page-id == "battery": BatteryPage { present: root.battery-present; percent: root.battery-percent; charging: root.battery-charging; }
                    if root.page-id == "shelf": ShelfPage {
                        items: root.shelf-items;
                        status: root.shelf-status;
                        add => { root.shelf-add(); }
                        open(path) => { root.shelf-open(path); }
                        reveal(path) => { root.shelf-reveal(path); }
                        remove(path) => { root.shelf-remove(path); }
                        clear => { root.shelf-clear(); }
                    }
                    if root.page-id == "currency": CurrencyPage {
                        width: parent.width;
                        height: parent.height;
                        d: root.currency;
                        amount <=> root.currency-amount;
                        gainers: root.stock-gainers;
                        losers: root.stock-losers;
                        alerts: root.currency-alerts;
                        currencies: root.currency-items;
                        chart-points: root.fx-chart-points;
                        refresh => { root.currency-refresh(); }
                        amount-edited(t) => { root.currency-amount-edited(t); }
                        quick(i) => { root.currency-quick(i); }
                        step-target(n) => { root.currency-step-target(n); }
                        add-alert(up, t, stock, code, repeat) => { root.currency-add-alert(up, t, stock, code, repeat); }
                        remove-alert(id) => { root.currency-remove-alert(id); }
                        chart-request(code, days) => { root.currency-chart-request(code, days); }
                        select-currency(code, days) => { root.currency-select-target(code, days); }
                        expanded <=> root.currency-expanded;
                        chart-line: root.fx-chart-line;
                        chart-area: root.fx-chart-area;
                        chart-status: root.fx-chart-status;
                        chart-max: root.fx-chart-max;
                        chart-y1: root.fx-chart-y1;
                        chart-y2: root.fx-chart-y2;
                        chart-min: root.fx-chart-min;
                        chart-date-start: root.fx-chart-date-start;
                        chart-date-mid: root.fx-chart-date-mid;
                        chart-date-end: root.fx-chart-date-end;
                        chart-dot-y: root.fx-chart-dot-y;
                        chart-last: root.fx-chart-last;
                        chart-change: root.fx-chart-change;
                        chart-up: root.fx-chart-up;
                    }
                    if root.page-id == "notes": NotesPage {
                        notes: root.notes;
                        add(t) => { root.add-note(t); }
                        remove(id) => { root.remove-note(id); }
                        open(id) => { root.open-note(id); }
                        clear => { root.clear-notes(); }
                        expand-toggled(v) => { root.notes-expand-toggled(v); }
                        expanded <=> root.notes-expanded;
                    }
                    if root.page-id == "weather": WeatherPage {
                        refresh => { root.weather-refresh(); }
                        city: root.weather-city;
                        temperature: root.weather-temp;
                        condition: root.weather-condition;
                        feels: root.weather-feels;
                        humidity: root.weather-humidity;
                        rain: root.weather-rain;
                        icon: root.weather-icon;
                        status: root.weather-status;
                    }
                    if root.page-id == "reminder": ReminderPage {
                        items: root.reminders;
                        alert-visible: root.reminder-alert-visible;
                        alert-text: root.reminder-alert-text;
                        alert-sub: root.reminder-alert-sub;
                        status: root.reminder-status;
                        weekdays-mask: root.reminder-weekdays-mask;
                        weekday-selected: root.reminder-weekday-selected;
                        draft <=> root.reminder-draft;
                        date-time <=> root.reminder-date-time;
                        repeat-mode <=> root.reminder-repeat-mode;
                        add(text, date-time, repeat-mode, weekdays-mask) => { root.reminder-add(text, date-time, repeat-mode, weekdays-mask); }
                        toggle(id) => { root.reminder-toggle(id); }
                        remove(id) => { root.reminder-remove(id); }
                        clear-done => { root.reminder-clear-done(); }
                        stop-alert => { root.reminder-stop-alert(); }
                        snooze-alert => { root.reminder-snooze-alert(); }
                        toggle-weekday(i) => { root.reminder-toggle-weekday(i); }
                    }
                    if root.page-id == "clipboard": ClipboardPage {
                        items: root.clipboard-items;
                        available: root.clipboard-available;
                        copy(text) => { root.clipboard-copy(text); }
                        clear => { root.clipboard-clear(); }
                    }
                    if root.page-id == "quick": QuickPage {
                        mic: root.q-mic; wifi: root.q-wifi; bt: root.q-bt;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "tools": ToolsPage {
                        awake: root.q-awake; dark: root.q-dark;
                        toggle(k) => { root.quick-toggle(k); }
                    }
                    if root.page-id == "uji": RenderTestPage { coffee: root.emoji-coffee; tomato: root.emoji-tomato; moon: root.emoji-moon; }
                    if root.page-id != "settings" && root.page-id != "media" && root.page-id != "clock" && root.page-id != "timer"
                        && root.page-id != "stats" && root.page-id != "battery" && root.page-id != "notes"
                        && root.page-id != "weather" && root.page-id != "reminder" && root.page-id != "clipboard" && root.page-id != "shelf" && root.page-id != "quick" && root.page-id != "tools" && root.page-id != "privacy" && root.page-id != "prayer" && root.page-id != "currency" && root.page-id != "uji":
                        PlaceholderPage { name: root.page-id; }
                }
            }

            // Pesan (nudge / alert kurs-saham / pengingat) di dalam badan notch untuk dock atas.
            if root.nudge-inline: Rectangle {
                width: parent.width;
                height: parent.height;
                Rectangle {
                    x: 16px;
                    y: 17px;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.accent.with-alpha(0.14);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.62);
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.accent;
                    }
                }
                Text {
                    x: 60px;
                    y: 9px;
                    width: 212px;
                    height: 30px;
                    text: root.nudge-visible ? root.nudge-message : root.reminder-alert-text;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
                Text {
                    x: 60px;
                    y: 40px;
                    width: 212px;
                    height: 20px;
                    text: root.nudge-visible ? root.nudge-detail : root.reminder-alert-sub;
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            // Indikator privasi ala Tauri. Dock atas: kanan sejajar mata (tengah untuk jam/musik, titik kecil saat hub terbuka).
            // Dock bawah/samping: di bagian paling atas badan, di atas mata.
            if (root.priv-mic || root.priv-cam) && !root.dragging && !root.inline-msg: PrivacyIndicator {
                mic: root.priv-mic;
                cam: root.priv-cam;
                dot: root.expanded;
                size: root.expanded ? 7px : (root.dock >= 2 ? 13px : 16px);
                x: root.expanded ? (parent.width - self.width) / 2
                    : (root.dock == 3 ? 4px
                    : (root.dock == 4 ? parent.width - self.width - 4px
                    : (root.dock == 2 || root.idle-clock || root.media-mini ? (parent.width - self.width) / 2
                    : parent.width - self.width - 8px)));
                y: root.expanded ? 6px : (root.dock >= 3 ? 14px : (root.dock == 2 ? 3px : (parent.height - self.height) / 2));
            }
        }
    }

    // Balon berada di luar pill agar tidak terpotong oleh clip:true. Ruang ekstra disediakan saat menciut.
    if root.dock >= 2 && !root.expanded && !root.greeting-inline-visible && (root.reminder-alert-visible || root.adhan-active || root.meeting-finished != "" || root.greeting-speech-visible || root.nudge-visible): SpeechBubble {
        width: root.dock >= 3 ? 200px : 224px;
        // Jarak 11 px dari notch: ekor (sekitar 8,5 px) berakhir tepat di depan badan notch.
        x: root.dock == 3 ? pill.x + pill.width + 11px : (root.dock == 4 ? pill.x - 11px - self.width : (root.width - self.width) / 2);
        y: root.dock >= 3 ? Math.max(0px, Math.min(root.height - self.height, pill.y + pill.height / 2 - self.height / 2)) : pill.y - 11px - self.height;
        side: root.dock >= 3;
        side-right: root.dock == 4;
        tail-pos: root.dock >= 3 ? pill.y + pill.height / 2 - self.y : pill.x + pill.width / 2 - self.x;
        message: root.adhan-active ? ("Waktu " + root.adhan-prayer) : (root.meeting-finished != "" ? "Rapat selesai" : (root.greeting-speech-visible ? root.greeting-message : (root.nudge-visible ? root.nudge-message : root.reminder-alert-text)));
        detail: root.adhan-active ? "Adzan sedang diputar" : (root.meeting-finished != "" ? root.meeting-finished : (root.greeting-speech-visible ? root.greeting-detail : (root.nudge-visible ? root.nudge-detail : root.reminder-alert-sub)));
    }

    // Telinga cekung: atas/bawah mengapit pil secara horizontal; dock samping mengapitnya secara vertikal.
    Ear { s: root.ui-scale; visible: root.dock == 0 || root.dock == 2; kind: root.dock == 2 ? 2 : 0; x: pill.x - 10px * root.ui-scale; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; }
    Ear { s: root.ui-scale; visible: root.dock == 0 || root.dock == 2; kind: root.dock == 2 ? 3 : 1; x: pill.x + pill.width; y: root.dock == 2 ? root.height - 10px * root.ui-scale : 0px; }
    Ear { s: root.ui-scale; visible: (root.dock == 3 || root.dock == 4) && !root.dragging; kind: root.dock == 3 ? 4 : 6; x: root.dock == 3 ? 0px : root.width - 10px * root.ui-scale; y: pill.y - 10px * root.ui-scale; }
    Ear { s: root.ui-scale; visible: (root.dock == 3 || root.dock == 4) && !root.dragging; kind: root.dock == 3 ? 5 : 7; x: root.dock == 3 ? 0px : root.width - 10px * root.ui-scale; y: pill.y + pill.height; }
}

// Jendela detail catatan (setara note-detail.html di Tauri): toolbar, editor, status bar, toast.
export component NoteDetailWindow inherits Window {
    title: "Catatan";
    preferred-width: 680px;
    preferred-height: 520px;
    min-width: 400px;
    min-height: 300px;
    background: root.bg;
    in property <color> bg: #0f0f11;
    in property <color> fg: #f0f0f2;
    in property <color> accent: #3b82f6;
    in property <string> meta;
    in-out property <string> text;
    in property <string> chars: "0 karakter";
    in property <string> lines: "0 baris";
    in property <bool> dirty: false;
    in property <bool> can-save: false;
    in property <bool> confirm-delete: false;
    in property <string> toast;
    callback edited(string);
    callback save();
    callback delete();
    callback esc();

    FocusScope {
        capture-key-pressed(event) => {
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) { root.save(); return accept; }
            if (event.text == Key.Escape) { root.esc(); return accept; }
            return reject;
        }
        VerticalLayout {
            Rectangle {
                height: 53px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    Text { text: "CATATAN"; color: root.fg.with-alpha(0.5); font-size: 13px; font-weight: 600; letter-spacing: 0.3px; vertical-alignment: center; }
                    Text { text: root.meta; color: root.fg.with-alpha(0.35); font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
                    Rectangle {
                        width: 74px;
                        height: 30px;
                        border-radius: 8px;
                        background: root.confirm-delete ? #ef4444 : (del-ta.has-hover ? #ef444447 : #ef444426);
                        Text { text: root.confirm-delete ? "Yakin?" : "Hapus"; color: root.confirm-delete ? #ffffff : #ef4444; font-size: 12.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        del-ta := TouchArea { clicked => { root.delete(); } }
                    }
                    Rectangle {
                        width: 78px;
                        height: 30px;
                        border-radius: 8px;
                        background: root.accent.with-alpha(save-ta.has-hover && root.can-save ? 1.0 : 0.85);
                        opacity: root.can-save ? 1.0 : 0.35;
                        Text { text: "Simpan"; color: #ffffff; font-size: 12.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        save-ta := TouchArea { enabled: root.can-save; clicked => { root.save(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: root.fg.with-alpha(0.10); }
            }
            Rectangle {
                vertical-stretch: 1;
                flick := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-height: max(self.height, editor.preferred-height + 36px);
                    editor := TextInput {
                        x: 18px;
                        y: 16px;
                        width: parent.width - 36px;
                        height: max(flick.height - 32px, self.preferred-height);
                        text <=> root.text;
                        color: root.fg;
                        font-size: 15px;
                        wrap: word-wrap;
                        single-line: false;
                        edited => { root.edited(self.text); }
                        init => { self.focus(); }
                        cursor-position-changed(p) => {
                            if (p.y + flick.content-y < 0px) { flick.content-y = -p.y; }
                            else if (p.y + 26px + flick.content-y > flick.height) { flick.content-y = flick.height - p.y - 26px; }
                        }
                    }
                }
                if root.text == "": Text { x: 18px; y: 16px; text: "Tulis catatan di sini\u{2026}"; color: root.fg.with-alpha(0.3); font-size: 15px; }
                if root.toast != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 14px;
                    width: toast-text.preferred-width + 28px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.fg.with-alpha(0.92);
                    toast-text := Text { text: root.toast; color: root.bg; font-size: 12.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 28px;
                Rectangle { y: 0px; height: 1px; background: root.fg.with-alpha(0.10); }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: root.chars; color: root.fg.with-alpha(0.5); font-size: 11px; vertical-alignment: center; }
                    Text { text: root.dirty ? "\u{25CF} Belum disimpan" : ""; color: root.accent; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.lines; color: root.fg.with-alpha(0.5); font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
                }
            }
        }
    }
}
