    Text { text: "Lokasi cuaca"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Nama kota"; color: Theme.text-faint; font-size: 9px; }
            weather-city-input := TextInput { text: root.weather-city; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Latitude"; color: Theme.text-faint; font-size: 9px; }
            weather-lat-input := TextInput { text: root.weather-lat; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Longitude"; color: Theme.text-faint; font-size: 9px; }
            weather-lon-input := TextInput { text: root.weather-lon; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    weather-city-input.text = "Bandung";
                    weather-lat-input.text = "-6.9175";
                    weather-lon-input.text = "107.6191";
                    root.save-weather("Bandung", "-6.9175", "107.6191");
                } }
                Chip { label: "Simpan lokasi cuaca"; clicked => { root.save-weather(weather-city-input.text, weather-lat-input.text, weather-lon-input.text); } }
            }
            Text { text: root.weather-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Gunakan koordinat desimal. Contoh Bandung: -6.9175, 107.6191."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Posisi notch"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            Text { text: "Pilih posisi docking"; color: Theme.text-faint; font-size: 9px; }
            HorizontalLayout {
                Chip { label: "Atas"; selected: root.position-mode == "top"; clicked => { root.save-position("top"); } }
                Chip { label: "Melayang"; selected: root.position-mode == "floating"; clicked => { root.save-position("floating"); } }
                Chip { label: "Bawah"; selected: root.position-mode == "bottom"; clicked => { root.save-position("bottom"); } }
            }
            HorizontalLayout {
                Chip { label: "Kiri"; selected: root.position-mode == "left"; clicked => { root.save-position("left"); } }
                Chip { label: "Kanan"; selected: root.position-mode == "right"; clicked => { root.save-position("right"); } }
            }
            Text { text: "Mode samping memakai pil vertikal; hub tetap terbuka ke arah dalam layar."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Perilaku notch"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 5px;
            Text { text: "Skala UI (0.5–1.5)"; color: Theme.text-faint; font-size: 9px; }
            behavior-scale-input := TextInput { text: root.behavior-scale; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda hover buka (0–2000 ms)"; color: Theme.text-faint; font-size: 9px; }
            behavior-hover-open-input := TextInput { text: root.behavior-hover-open; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Jeda hover tutup (0–5000 ms)"; color: Theme.text-faint; font-size: 9px; }
            behavior-hover-close-input := TextInput { text: root.behavior-hover-close; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Idle sebelum mata mengantuk (10–3600 detik)"; color: Theme.text-faint; font-size: 9px; }
            behavior-sleep-input := TextInput { text: root.behavior-sleep-after; color: Theme.text; font-size: 11px; single-line: true; }
            hide-fullscreen-input := TextInput { text: root.behavior-hide-fullscreen ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Sembunyikan notch saat aplikasi fullscreen"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip {
                    label: hide-fullscreen-input.text == "true" ? "Aktif" : "Nonaktif";
                    selected: hide-fullscreen-input.text == "true";
                    clicked => { hide-fullscreen-input.text = hide-fullscreen-input.text == "true" ? "false" : "true"; }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Chip { label: "Simpan perilaku"; clicked => { root.save-behavior(behavior-scale-input.text, behavior-hover-open-input.text, behavior-hover-close-input.text, behavior-sleep-input.text, hide-fullscreen-input.text == "true"); } }
                Chip {
                    label: "Reset default";
                    clicked => {
                        behavior-scale-input.text = "1.00";
                        behavior-hover-open-input.text = "150";
                        behavior-hover-close-input.text = "450";
                        behavior-sleep-input.text = "60";
                        hide-fullscreen-input.text = "true";
                        root.save-behavior("1.00", "150", "450", "60", true);
                        root.save-autostart(false);
                    }
                }
            }
            Text { text: root.behavior-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: "Jalankan otomatis saat komputer login"; color: Theme.text; font-size: 9px; horizontal-stretch: 1; }
                Chip {
                    label: root.autostart-enabled ? "Aktif" : "Nonaktif";
                    selected: root.autostart-enabled;
                    clicked => { root.save-autostart(!root.autostart-enabled); }
                }
            }
            Text { text: root.autostart-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
            Text { text: "Pengaturan ini tersedia pada build release."; color: Theme.text-faint; font-size: 8px; wrap: word-wrap; }
        }
    }
    Text { text: "Liquid movement"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            HorizontalLayout {
                Text { text: "Gerakan acak saat idle"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: motion-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: motion-enabled-input.text == "true"; clicked => { motion-enabled-input.text = motion-enabled-input.text == "true" ? "false" : "true"; } }
            }
            motion-enabled-input := TextInput { text: root.motion-enabled ? "true" : "false"; visible: false; }
            dock-play-input := TextInput { text: root.dock-play-enabled ? "true" : "false"; visible: false; }
            HorizontalLayout {
                Text { text: "Bottom Play / Side Play"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: dock-play-input.text == "true" ? "Aktif" : "Nonaktif"; selected: dock-play-input.text == "true"; clicked => { dock-play-input.text = dock-play-input.text == "true" ? "false" : "true"; } }
            }
            Text { text: "Interval perpindahan (60–3600 detik)"; color: Theme.text-faint; font-size: 9px; }
            motion-interval-input := TextInput { text: root.motion-interval; color: Theme.text; font-size: 11px; single-line: true; }
            Text { text: "Maksimal perpindahan per sesi (1–10)"; color: Theme.text-faint; font-size: 9px; }
            motion-max-input := TextInput { text: root.motion-max-moves; color: Theme.text; font-size: 11px; single-line: true; }
            HorizontalLayout {
                Chip { label: "Reset default"; clicked => {
                    motion-enabled-input.text = "false";
                    dock-play-input.text = "true";
                    motion-interval-input.text = "180";
                    motion-max-input.text = "3";
                    root.save-motion(false, "180", "3", true);
                } }
                Chip { label: "Simpan pengaturan gerakan"; clicked => { root.save-motion(motion-enabled-input.text == "true", motion-interval-input.text, motion-max-input.text, dock-play-input.text == "true"); } }
                Chip { label: "Tes animasi"; clicked => { root.test-dock-play(); } }
            }
            Text { text: root.motion-save-status; color: Theme.text-faint; font-size: 9px; wrap: word-wrap; }
        }
    }
    Text { text: "Notifikasi & perilaku otomatis"; color: Theme.accent; font-size: 11px; font-weight: 700; }
    Rectangle { background: #ffffff0b; border-radius: 10px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout { padding: 9px; spacing: 6px;
            HorizontalLayout {
                Text { text: "Sapaan otomatis saat idle"; color: Theme.text; font-size: 10px; horizontal-stretch: 1; }
                Chip { label: nudge-enabled-input.text == "true" ? "Aktif" : "Nonaktif"; selected: nudge-enabled-input.text == "true"; clicked => { nudge-enabled-input.text = nudge-enabled-input.text == "true" ? "false" : "true"; } }
            }
            nudge-enabled-input := TextInput { text: root.nudge-enabled ? "true" : "false"; visible: false; }
            Text { text: "Waktu idle sebelum sapaan (1–240 menit)"; color: Theme.text-faint; font-size: 9px; }
            nudge-idle-input := TextInput { text: root.nudge-idle-min; color: Theme.text; font-size: 11px; single-line: true; }
