                        save-appearance(theme, eye, notch, mood, accent, custom-bg, custom-text, dark, light) => { root.settings-save-appearance(theme, eye, notch, mood, accent, custom-bg, custom-text, dark, light); }
                        behavior-scale: root.behavior-scale;
                        behavior-hover-open: root.behavior-hover-open;
